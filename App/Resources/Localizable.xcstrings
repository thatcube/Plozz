    "Couldn’t reach that server. Check the address and that it’s on the same network, then try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan die server niet bereiken. Controleer het adres en of deze zich op hetzelfde netwerk bevindt, en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
