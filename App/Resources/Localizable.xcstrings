    "Turn on Share Crash Reports below to enable this. Your recent activity is then sent anonymously — no logins, tokens, servers, or titles.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel hieronder Crashrapporten delen in om dit mogelijk te maken. Je recente activiteit wordt dan anoniem verzonden — geen aanmeldgegevens, tokens, servers of titels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby to włączyć, włącz poniżej opcję Udostępniaj raporty o awariach. Ostatnia aktywność zostanie wtedy wysłana anonimowo — bez danych logowania, tokenów, serwerów ani tytułów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative Compartilhar relatórios de falha abaixo para habilitar isso. Sua atividade recente será enviada anonimamente — sem logins, tokens, servidores nem títulos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå Del fejlrapporter til nedenfor for at aktivere dette. Din seneste aktivitet sendes derefter anonymt — ingen logins, tokens, servere eller titler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez ci-dessous Partager les rapports de plantage pour l’activer. Votre activité récente sera ensuite envoyée anonymement — sans identifiants, jetons, serveurs ni titres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чтобы включить это, ниже включите «Отправлять отчёты о сбоях». После этого ваша недавняя активность будет отправляться анонимно — без данных для входа, токенов, серверов и названий материалов."
          }
        }
      }
    },
    "Turn on Share Crash Reports in Help & Diagnostics to enable this. Your recent activity is then sent anonymously — no logins, tokens, servers, or titles.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel Crashrapporten delen in bij Help en diagnostiek om dit mogelijk te maken. Je recente activiteit wordt dan anoniem verzonden — geen aanmeldgegevens, tokens, servers of titels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby to włączyć, włącz opcję Udostępniaj raporty o awariach w sekcji Pomoc i diagnostyka. Ostatnia aktywność zostanie wtedy wysłana anonimowo — bez danych logowania, tokenów, serwerów ani tytułów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative Compartilhar relatórios de falha em Ajuda e Diagnóstico para habilitar isso. Sua atividade recente será enviada anonimamente — sem logins, tokens, servidores nem títulos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå Del fejlrapporter til i Hjælp & Diagnostik for at aktivere dette. Din seneste aktivitet sendes derefter anonymt — ingen logins, tokens, servere eller titler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez Partager les rapports de plantage dans Aide et diagnostics pour l’activer. Votre activité récente sera ensuite envoyée anonymement — sans identifiants, jetons, serveurs ni titres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чтобы включить это, включите «Отправлять отчёты о сбоях» в разделе «Помощь и диагностика». После этого ваша недавняя активность будет отправляться анонимно — без данных для входа, токенов, серверов и названий материалов."
          }
        }
      }
    },
    "Turn servers and libraries on or off, and pick who you watch as.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel servers en bibliotheken in of uit, en kies als wie je kijkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Włączaj i wyłączaj serwery oraz biblioteki i wybieraj konto używane do oglądania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative ou desative servidores e bibliotecas e escolha com qual perfil você assiste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå servere og biblioteker til eller fra, og vælg, hvem du ser som."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez ou désactivez les serveurs et les bibliothèques multimédia, et choisissez avec quel profil vous regardez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включайте и выключайте серверы и медиатеки, а также выбирайте, от чьего имени смотреть."
          }
        }
      }
    },
