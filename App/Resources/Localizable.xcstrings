    "Leave every library selected to include all enabled libraries.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laat elke bibliotheek geselecteerd om alle ingeschakelde bibliotheken op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
