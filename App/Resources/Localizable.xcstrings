    "Couldn’t reach that server. Check the address and that it’s on the same network, then try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan die server niet bereiken. Controleer het adres en of deze zich op hetzelfde netwerk bevindt, en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się połączyć z tym serwerem. Sprawdź adres i czy jest w tej samej sieci, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível acessar esse servidor. Verifique o endereço e se ele está na mesma rede, depois tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke få forbindelse til den server. Tjek adressen, og at den er på samme netværk, og prøv igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de joindre ce serveur. Vérifiez l’adresse, assurez-vous qu’il se trouve sur le même réseau, puis réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось подключиться к этому серверу. Проверьте адрес и убедитесь, что он находится в той же сети, затем повторите попытку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
