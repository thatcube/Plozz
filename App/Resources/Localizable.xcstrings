              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "Això baixarà %lld episodi amb la qualitat original i pot fer servir molt espai d'emmagatzematge i dades. El pots eliminar en qualsevol moment des de Baixades."
