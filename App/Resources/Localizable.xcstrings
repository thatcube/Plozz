    "themeMusic.detail.medium": {
      "comment": "One-line explanation shown under the theme-music volume picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "More present, while staying below normal playback volume."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Meer aanwezig, maar nog onder het normale afspeelvolume."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bardziej słyszalne, ale wciąż ciszej niż zwykłe odtwarzanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mais presente, sem chegar ao volume normal de reprodução."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mere tydelig, men stadig under normal afspilningslydstyrke."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plus présent, tout en restant sous le volume normal de lecture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заметнее, но всё ещё тише обычной громкости воспроизведения."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Výraznější, ale stále pod běžnou hlasitostí přehrávání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Präsenter, bleibt aber unter der normalen Wiedergabelautstärke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Più udibile, ma sempre al di sotto del normale volume di riproduzione."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mer närvarande, men fortfarande under normal uppspelningsvolym."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izraženije, ali i dalje ispod uobičajene glasnoće reprodukcije."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lebih ketara, sambil kekal di bawah kelantangan main balik biasa."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Výraznejšie, ale stále pod bežnou hlasitosťou prehrávania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Помітніша, але все одно тихіша за звичайне відтворення."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lebih terasa, tetapi tetap di bawah volume putar normal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daha belirgin, ama normal oynatma ses düzeyinin altında."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Més present, però per sota del volum normal de reproducció."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mai prezent, păstrându-se sub volumul normal de redare."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "נוכח יותר, תוך שמירה מתחת לעוצמת ההשמעה הרגילה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bolj izrazita, a še vedno pod običajno glasnostjo predvajanja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ได้ยินชัดขึ้น แต่ยังเบากว่าระดับเสียงเล่นปกติ"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "По-осезаема, но под обичайната сила на звука при възпроизвеждане."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selvemmin kuuluva, mutta silti tavallista toistoäänenvoimakkuutta hiljaisempi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tydeligere, men fortsatt under vanlig avspillingsvolum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音量更明显，但仍低于正常播放音量。"
          }
        }
      }
    },
