    "Bring all of your media together into one unified experience. Free forever and open source.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Breng al je media samen in één centrale ervaring. Voor altijd gratis en open source."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystkie Twoje multimedia w jednym, spójnym miejscu. Bezpłatnie na zawsze i na otwartej licencji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reúna toda a sua mídia em uma experiência única. Grátis para sempre e de código aberto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saml alle dine medier i én samlet oplevelse. Gratis for altid og open source."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réunissez tous vos médias dans une expérience unifiée. Toujours gratuit et à code source libre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Соберите все свои медиа в одном приложении. Бесплатно навсегда и с открытым исходным кодом."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mějte všechna svá média pohromadě v jednom sjednoceném prostředí. Navždy zdarma a s otevřeným zdrojovým kódem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Führe alle deine Medien in einer einheitlichen Oberfläche zusammen. Für immer kostenlos und Open Source."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riunisci tutti i tuoi contenuti multimediali in un’unica esperienza. Gratis per sempre e open source."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samla alla dina medier i en enhetlig upplevelse. Gratis för alltid, med öppen källkod."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Objedinite sve svoje medije u jedno jedinstveno iskustvo. Besplatno zauvijek i otvorenog koda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Himpunkan semua media anda dalam satu pengalaman bersepadu. Percuma selama-lamanya dan sumber terbuka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spojte všetky svoje médiá do jedného jednotného prostredia. Navždy zadarmo a s otvoreným zdrojovým kódom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Об’єднайте всі свої медіа в одному цілісному просторі. Назавжди безплатно й із відкритим кодом."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Satukan semua media Anda dalam satu pengalaman terpadu. Gratis selamanya dan kode sumber terbuka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tüm medyanızı tek bir deneyimde bir araya getirin. Sonsuza dek ücretsiz ve açık kaynaklı."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reuneix tot el teu contingut multimèdia en una única experiència unificada. Gratuït per sempre i de codi obert."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reunește toate materialele tale media într-o singură experiență unificată. Gratuit pentru totdeauna și cu sursă deschisă."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כל המדיה שלך בחוויה מאוחדת אחת. חינם לתמיד ובקוד פתוח."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Združite vse svoje medije v eno enotno izkušnjo. Brezplačno za vedno in odprtokodno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รวมสื่อทั้งหมดของคุณไว้ในประสบการณ์เดียว ฟรีตลอดไปและโอเพนซอร์ส"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Съберете цялото си медийно съдържание в едно общо изживяване. Безплатно завинаги и с отворен код."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kokoa kaikki mediasi yhteen. Aina ilmainen ja avointa lähdekoodia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samle alle mediene dine i én opplevelse. Gratis for alltid og med åpen kildekode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将您的所有媒体整合到一个统一的体验中。永久免费且开源。"
          }
        }
      }
    },
