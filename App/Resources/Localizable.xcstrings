    "When credits can't be detected": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wanneer de aftiteling niet kan worden gedetecteerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdy nie można wykryć napisów końcowych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando não for possível detectar os créditos"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når rulletekster ikke kan registreres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quand le générique ne peut pas être détecté"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Если не удаётся определить титры"
