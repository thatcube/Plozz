    "Anonymous crash and freeze reports. No servers, logins, credentials, or viewing activity." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تقارير مجهولة عن الأعطال والتجمّد. لا تتضمن الخوادم أو بيانات تسجيل الدخول أو بيانات الاعتماد أو نشاط المشاهدة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Анонимни отчети за сривове и замръзвания. Без сървъри, влизания, идентификационни данни или активност на гледане."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Informes anònims de bloquejos i congelacions. Sense servidors, inicis de sessió, credencials ni activitat de visualització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anonymní hlášení o pádech a zamrznutí. Žádné servery, přihlášení, přístupové údaje ani aktivita sledování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anonyme fejl- og fastfrysningsrapporter. Ingen servere, logins, legitimationsoplysninger eller visningsaktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anonyme Berichte über Abstürze und Einfrieren. Keine Server, Anmeldungen, Zugangsdaten oder Wiedergabeaktivitäten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ανώνυμες αναφορές σφαλμάτων και παγώματος. Χωρίς διακομιστές, συνδέσεις, διαπιστευτήρια ή δραστηριότητα προβολής."
          }
        },
        "es" : {
          "stringUnit" : {
