    "Something went wrong searching or downloading. Try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er is iets misgegaan bij het zoeken of downloaden. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coś poszło nie tak podczas wyszukiwania lub pobierania. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algo deu errado ao buscar ou baixar. Tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noget gik galt under søgning eller download. Prøv igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une erreur est survenue pendant la recherche ou le téléchargement. Réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Во время поиска или загрузки что-то пошло не так. Повторите попытку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Při hledání nebo stahování se něco pokazilo. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Suchen oder Herunterladen ist etwas schiefgelaufen. Versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qualcosa è andato storto durante la ricerca o il download. Riprova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Något gick fel vid sökning eller nedladdning. Försök igen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nešto je pošlo po zlu pri pretraživanju ili preuzimanju. Pokušajte ponovno."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ada masalah semasa mencari atau memuat turun. Cuba lagi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri vyhľadávaní alebo sťahovaní sa niečo pokazilo. Skúste to znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щось пішло не так під час пошуку або завантаження. Спробуйте ще раз."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terjadi kesalahan saat mencari atau mengunduh. Coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arama veya indirme sırasında bir sorun oluştu. Yeniden deneyin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S'ha produït un error en cercar o baixar. Torna-ho a provar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A apărut o problemă la căutare sau descărcare. Reîncearcă."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "משהו השתבש בחיפוש או בהורדה. נסה שוב."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Med iskanjem ali prenosom je šlo nekaj narobe. Poskusite znova."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เกิดข้อผิดพลาดขณะค้นหาหรือดาวน์โหลด ลองอีกครั้ง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нещо се обърка при търсенето или изтеглянето. Опитайте отново."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haussa tai lataamisessa meni jokin pieleen. Yritä uudelleen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noe gikk galt under søk eller nedlasting. Prøv igjen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "搜索或下载时出错。请重试。"
          }
        }
      }
    },
    "Something went wrong talking to this server.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
