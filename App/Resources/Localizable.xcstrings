    "On This %@": {
      "comment": "Section header in the iOS Settings root for device-local pages such as Profiles, Servers, Downloads, and iCloud Sync. %@ is the current device name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Op deze %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
