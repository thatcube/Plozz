          }
        }
      }
    },
    "Plozz scans the selected export for movies and TV episodes. NFS uses your server’s existing network permissions.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz scant de geselecteerde export op films en tv-afleveringen. NFS gebruikt de bestaande netwerkrechten van je server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz skanuje wybrany eksport w poszukiwaniu filmów i odcinków seriali. NFS korzysta z istniejących uprawnień sieciowych serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz examina a exportação selecionada em busca de filmes e episódios de TV. O NFS usa as permissões de rede que seu servidor já tem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz scanner den valgte eksport for film og serieepisoder. NFS bruger din servers eksisterende netværkstilladelser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz analyse l’export sélectionné à la recherche de films et d’épisodes TV. NFS utilise les autorisations réseau existantes de votre serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz сканирует выбранный экспорт на наличие фильмов и эпизодов сериалов. NFS использует существующие сетевые разрешения вашего сервера."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz prohledá vybraný export a hledá v něm filmy a TV díly. NFS používá stávající síťová oprávnění vašeho serveru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz durchsucht den ausgewählten Export nach Filmen und Serienfolgen. NFS verwendet die bestehenden Netzwerkberechtigungen deines Servers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz esegue la scansione dell’esportazione selezionata per trovare film ed episodi TV. NFS usa le autorizzazioni di rete già configurate sul server."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz skannar den valda exporten efter filmer och TV-avsnitt. NFS använder serverns befintliga nätverksbehörigheter."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz pretražuje odabrani izvoz i traži filmove i epizode serija. NFS koristi postojeća mrežna dopuštenja vašeg poslužitelja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz mengimbas eksport yang dipilih untuk mencari filem dan episod siri TV. NFS menggunakan kebenaran rangkaian sedia ada pada pelayan anda."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz prehľadá vybraný export a vyhľadá v ňom filmy a televízne diely. NFS používa existujúce sieťové oprávnenia vášho servera."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz сканує вибраний експорт на наявність фільмів і епізодів серіалів. NFS використовує наявні мережеві дозволи вашого сервера."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz memindai ekspor yang dipilih untuk film dan episode TV. NFS menggunakan izin jaringan server Anda yang sudah ada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz seçilen dışa aktarımda filmleri ve dizi bölümlerini tarar. NFS, sunucunuzun mevcut ağ izinlerini kullanır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz escaneja l'exportació seleccionada per detectar pel·lícules i episodis de sèries. NFS utilitza els permisos de xarxa que ja té configurats el teu servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz scanează exportul selectat pentru filme și episoade TV. NFS folosește permisiunile de rețea existente ale serverului tău."
          }
        }
      }
    },
    "Point your camera at the code on your other device — pinch to zoom": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Richt je camera op de code op je andere apparaat — knijp om in te zoomen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skieruj aparat na kod na drugim urządzeniu — zsuń lub rozsuń palce, aby zmienić powiększenie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aponte a câmera para o código no outro dispositivo — use o gesto de pinça para dar zoom"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ret kameraet mod koden på din anden enhed — knib for at zoome"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pointez l’appareil photo vers le code affiché sur votre autre appareil — pincez pour zoomer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Наведите камеру на код на другом устройстве — сведите или разведите пальцы для масштабирования"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Namiřte fotoaparát na kód na druhém zařízení — přiblížení provedete sevřením prstů"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Richte die Kamera auf den Code auf deinem anderen Gerät – zum Zoomen zwei Finger aufziehen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inquadra con la fotocamera il codice sull’altro dispositivo — pizzica per ingrandire"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rikta kameran mot koden på din andra enhet – nyp för att zooma"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usmjerite kameru prema kodu na drugom uređaju — uštipnite za povećanje"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Halakan kamera anda ke kod pada peranti lain anda — cubit untuk zum"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Namierte fotoaparát na kód na vašom druhom zariadení — priblížte štipnutím"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спрямуйте камеру на код на іншому пристрої — збільшуйте щипком"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arahkan kamera ke kode di perangkat Anda yang lain — cubit untuk memperbesar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kameranızı diğer aygıtınızdaki koda doğrultun — yakınlaştırmak için sıkıştırın"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apunta la càmera al codi de l'altre dispositiu — ajunta o separa dos dits per ampliar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Îndreaptă camera spre codul de pe celălalt dispozitiv — apropie sau depărtează două degete pentru a ajusta zoomul"
          }
        }
      }
    },
