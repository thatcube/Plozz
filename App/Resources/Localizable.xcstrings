    "navigationLibraries.footnote" : {
      "comment" : "Explains that hiding a library from the navigation is not the same as turning it off.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إخفاء مكتبة هنا يزيلها من التنقل فقط، وتبقى في الرئيسية وفي البحث. لتعطيل مكتبة في كل مكان، استخدم «مكتباتك»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скриването на медиатека тук я маха само от навигацията. Тя остава в Начало и в Търсене. За да изключите медиатека навсякъде, използвайте „Вашите медиатеки“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Amagar una biblioteca aquí només la treu de la navegació: es manté a Inici i a Cerca. Per desactivar-la a tot arreu, fes servir «Les teves biblioteques»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skrytím knihovny ji odeberete jen z navigace. Zůstane v sekci Domů i v sekci Hledat. Pokud ji chcete vypnout všude, použijte Vaše knihovny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skjuler du et bibliotek her, fjernes det kun fra navigationen. Det bliver på Hjem og i Søg. Vil du slå et bibliotek fra alle steder, skal du bruge Dine biblioteker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn du eine Medienbibliothek hier ausblendest, verschwindet sie nur aus der Navigation. Unter „Start“ und „Suchen“ bleibt sie verfügbar. Um eine Medienbibliothek überall zu deaktivieren, verwende „Deine Medienbibliotheken“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η απόκρυψη μιας βιβλιοθήκης εδώ την αφαιρεί μόνο από την πλοήγηση. Παραμένει στην Αρχική και στην Αναζήτηση. Για να απενεργοποιήσετε μια βιβλιοθήκη παντού, χρησιμοποιήστε τις Βιβλιοθήκες σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hiding a library here only removes it from the navigation. It stays on Home and in Search. To turn a library off everywhere, use Your Libraries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ocultar una biblioteca multimedia aquí solo la quita de la navegación. Sigue en Inicio y en Buscar. Para desactivarla en toda la app, usa Tus bibliotecas multimedia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پنهان کردن کتابخانه در اینجا فقط آن را از ناوبری برمی‌دارد. در خانه و جستجو باقی می‌ماند. برای غیرفعال کردن کتابخانه در همه‌جا، از کتابخانه‌های شما استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kirjaston piilottaminen täällä poistaa sen vain navigoinnista. Se säilyy Kodissa ja Haussa. Jos haluat poistaa kirjaston käytöstä kaikkialla, käytä Omat kirjastot -näkymää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masquer une bibliothèque ici la retire uniquement de la navigation. Elle reste accessible depuis Accueil et Recherche. Pour désactiver une bibliothèque partout, utilisez Vos bibliothèques."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הסתרת ספרייה כאן מסירה אותה מהניווט בלבד. היא נשארת בבית ובחיפוש. כדי לכבות ספרייה בכל מקום, השתמש ב״הספריות שלך״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यहाँ लाइब्रेरी छिपाने से वह सिर्फ़ नेविगेशन से हटती है। वह होम और खोज में बनी रहती है। किसी लाइब्रेरी को हर जगह बंद करने के लिए ‘आपकी लाइब्रेरी’ का उपयोग करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skrivanje knjižnice ovdje uklanja je samo iz navigacije. Ostaje na Početnoj i u Pretraživanju. Da biste knjižnicu isključili posvuda, upotrijebite Vaše knjižnice."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ha itt elrejt egy könyvtárat, az csak a navigációból tűnik el. A Kezdőlapon és a Keresésben továbbra is megmarad. Ha mindenhol ki szeretné kapcsolni, használja a Saját könyvtárak lehetőséget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menyembunyikan pustaka di sini hanya menghapusnya dari navigasi. Pustaka tetap ada di Beranda dan Cari. Untuk menonaktifkan pustaka di mana saja, gunakan Pustaka Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nascondere una libreria qui la rimuove solo dalla navigazione. Resta nella Home e in Cerca. Per disattivarla ovunque, usa Le tue librerie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ここでライブラリを非表示にしても、ナビゲーションから消えるだけです。ホームと検索には残ります。すべての場所でオフにするには「自分のライブラリ」を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "여기서 미디어 보관함을 숨겨도 탐색에서만 사라집니다. 홈과 검색에는 계속 표시됩니다. 모든 곳에서 끄려면 ‘미디어 보관함 선택’을 사용하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menyembunyikan pustaka di sini hanya mengeluarkannya daripada navigasi. Ia tetap ada di Laman Utama dan dalam Carian. Untuk mematikan pustaka di semua tempat, gunakan “Pilih Pustaka Anda”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Å skjule et bibliotek her fjerner det bare fra navigasjonen. Det vises fortsatt på Hjem og i Søk. Bruk «Velg bibliotekene dine» for å slå av et bibliotek overalt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Een bibliotheek hier verbergen haalt deze alleen uit de navigatie. Hij blijft op Start en in Zoeken staan. Gebruik ‘Kies je bibliotheken’ om een bibliotheek overal uit te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ukrycie biblioteki w tym miejscu usuwa ją tylko z nawigacji. Nadal będzie widoczna w sekcjach „Strona główna” i „Szukaj”. Aby wyłączyć bibliotekę wszędzie, użyj opcji „Wybierz swoje biblioteki”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ocultar uma biblioteca aqui só a remove da navegação. Ela continua no Início e na tela Buscar. Para desativar uma biblioteca em todos os lugares, use “Escolha suas bibliotecas”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dacă ascunzi aici o bibliotecă, o scoți doar din navigare. Rămâne pe ecranul Acasă și în Căutare. Ca să dezactivezi o bibliotecă peste tot, folosește „Alege-ți bibliotecile”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Если скрыть медиатеку здесь, она исчезнет только из навигации. Она останется в разделах «Главная» и «Поиск». Чтобы отключить медиатеку везде, используйте раздел «Выберите медиатеки»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skrytím knižnice tu ju odstránite iba z navigácie. Zostane v sekcii Domov aj v sekcii Hľadať. Ak chcete knižnicu vypnúť všade, použite „Vyberte svoje knižnice“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Če knjižnico skrijete tukaj, jo odstranite samo iz navigacije. Ostane v razdelkih »Domov« in »Iskanje«. Če želite knjižnico izklopiti povsod, uporabite »Izberite svoje knjižnice«."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skrivanjem biblioteke ovde uklanjate je samo iz navigacije. Ostaje u odeljcima „Početna“ i „Pretraga“. Da biste biblioteku isključili svuda, koristite „Izaberite svoje biblioteke“."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Att dölja ett bibliotek här tar bara bort det från navigeringen. Det finns kvar på Hem och i Sök. Använd ”Välj dina bibliotek” för att stänga av ett bibliotek överallt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การซ่อนไลบรารีที่นี่จะนำออกจากการนำทางเท่านั้น โดยยังคงอยู่ในหน้าแรกและในการค้นหา หากต้องการปิดไลบรารีในทุกที่ ให้ใช้ “เลือกไลบรารีของคุณ”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir kitaplığı burada gizlemek onu yalnızca gezinmeden kaldırır. “Ana Sayfa” ve “Ara” bölümlerinde kalır. Bir kitaplığı her yerde kapatmak için “Medya kitaplıklarınızı seçin” seçeneğini kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Приховування медіатеки тут лише прибирає її з навігації. Вона залишається в розділах «Головна» та «Пошук». Щоб вимкнути медіатеку всюди, скористайтеся розділом «Виберіть свої медіатеки»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ẩn một thư viện ở đây chỉ gỡ nó khỏi điều hướng. Thư viện vẫn còn ở Trang chủ và trong Tìm kiếm. Để tắt thư viện ở mọi nơi, hãy dùng “Chọn thư viện”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在此隐藏媒体库只会将其从导航中移除，首页和搜索中仍会显示。若要在所有位置停用某个媒体库，请使用“选择您的媒体库”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在此隱藏媒體庫只會將其從導覽中移除，首頁和搜尋中仍會顯示。若要在所有地方停用某個媒體庫，請使用「選擇你的媒體庫」。"
          }
        }
      }
    },
    "navigationLibraries.hiddenDivider" : {
      "comment" : "Divider in the navigation-libraries list; libraries below it are not shown in the navigation.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مخفي"
          }
        },
        "bg" : {
