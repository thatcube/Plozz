{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "comment": "Shown when iOS asks permission to use the local network, which is how servers and shares are discovered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plozz uses your local network to discover media servers and network shares."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz gebruikt je lokale netwerk om mediaservers en gedeelde netwerkmappen te vinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz potrzebuje dostępu do sieci lokalnej, aby wykrywać serwery multimediów i udziały sieciowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz usa sua rede local para encontrar servidores de mídia e compartilhamentos de rede."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz bruger dit lokale netværk til at finde medieservere og netværksdelinger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz utilise votre réseau local pour détecter les serveurs multimédias et les partages réseau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz использует локальную сеть для поиска медиасерверов и сетевых ресурсов."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz používá místní síť k vyhledání mediálních serverů a síťových sdílení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz verwendet dein lokales Netzwerk, um Medienserver und Netzwerkfreigaben zu finden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz usa la rete locale per trovare server multimediali e condivisioni di rete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz använder ditt lokala nätverk för att hitta medieservrar och nätverksdelningar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz koristi lokalnu mrežu za pronalaženje medijskih poslužitelja i mrežnih dijeljenja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz menggunakan rangkaian setempat anda untuk mengesan pelayan media dan perkongsian rangkaian."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz používa miestnu sieť na vyhľadanie mediálnych serverov a sieťových zdieľaní."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz використовує локальну мережу, щоб знаходити медіасервери й мережеві ресурси."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz menggunakan jaringan lokal Anda untuk menemukan server media dan folder bersama jaringan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz, medya sunucularını ve ağ paylaşımlarını bulmak için yerel ağınızı kullanır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz utilitza la teva xarxa local per trobar servidors multimèdia i recursos compartits de xarxa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz folosește rețeaua ta locală pentru a găsi servere media și resurse de rețea partajate."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz משתמשת ברשת המקומית שלך כדי למצוא שרתי מדיה ושיתופי רשת."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz uporablja lokalno omrežje za iskanje predstavnostnih strežnikov in omrežnih souporab."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz ใช้เครือข่ายภายในของคุณเพื่อค้นหาเซิร์ฟเวอร์สื่อและโฟลเดอร์ที่แชร์บนเครือข่าย"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Shown when iOS asks permission to use the camera, which is only used to scan the pairing code on another device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plozz uses the camera to scan the setup code shown on your other device."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz gebruikt de camera om de installatiecode te scannen die op je andere apparaat wordt weergegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz używa aparatu do skanowania kodu konfiguracji wyświetlanego na innym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz usa a câmera para escanear o código de configuração exibido no outro dispositivo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz bruger kameraet til at scanne den opsætningskode, der vises på din anden enhed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz utilise l’appareil photo pour scanner le code de configuration affiché sur votre autre appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz использует камеру для сканирования кода настройки, показанного на другом устройстве."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz používá fotoaparát k naskenování nastavovacího kódu zobrazeného na druhém zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz verwendet die Kamera, um den Einrichtungscode auf deinem anderen Gerät zu scannen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz usa la fotocamera per scansionare il codice di configurazione visualizzato sull’altro dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz använder kameran för att skanna konfigurationskoden som visas på din andra enhet."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz koristi kameru za skeniranje koda za postavljanje prikazanog na drugom uređaju."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz menggunakan kamera untuk mengimbas kod persediaan yang dipaparkan pada peranti anda yang lain."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz používa fotoaparát na naskenovanie nastavovacieho kódu zobrazeného na druhom zariadení."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz використовує камеру, щоб сканувати код налаштування, показаний на іншому пристрої."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz menggunakan kamera untuk memindai kode penyiapan yang ditampilkan di perangkat Anda yang lain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz, diğer aygıtınızda gösterilen kurulum kodunu taramak için kameranızı kullanır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz utilitza la càmera per escanejar el codi de configuració que es mostra a l'altre dispositiu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz folosește camera pentru a scana codul de configurare afișat pe celălalt dispozitiv al tău."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz משתמשת במצלמה כדי לסרוק את קוד ההגדרה שמוצג במכשיר האחר שלך."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz uporablja kamero za optično branje nastavitvene kode, prikazane na drugi napravi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz ใช้กล้องเพื่อสแกนรหัสตั้งค่าที่แสดงบนอุปกรณ์อีกเครื่องของคุณ"
          }
        }
      }
    }
  },
  "version": "1.0"
}
