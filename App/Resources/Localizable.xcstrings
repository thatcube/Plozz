            "value": "Något gick fel"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nešto je pošlo po zlu"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ada masalah"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niečo sa pokazilo"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щось пішло не так"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terjadi kesalahan"
          }
        },
        "tr": {
