    "trakt.error.clientRejected" : {
      "comment" : "Shown when Trakt refuses the app's own client credentials, so no sign-in can succeed until they are replaced.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "رفض Trakt بيانات اعتماد API لهذا التطبيق. ربما أُزيل التطبيق، أو لم يعد وصوله إلى API نشطًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt отхвърли API идентификационните данни на това приложение. Приложението може да е премахнато или API достъпът му вече да не е активен."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt ha rebutjat les credencials d'API d'aquesta app. És possible que l'aplicació s'hagi eliminat o que el seu accés a l'API ja no estigui actiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt odmítl přihlašovací údaje API této aplikace. Aplikace mohla být odstraněna nebo její přístup k API už nemusí být aktivní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt afviste denne apps API-legitimationsoplysninger. Appen kan være blevet fjernet, eller dens API-adgang er muligvis ikke længere aktiv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt hat die API-Zugangsdaten dieser App abgelehnt. Die Anwendung wurde möglicherweise entfernt oder ihr API-Zugriff ist nicht mehr aktiv."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Trakt απέρριψε τα διαπιστευτήρια API αυτής της εφαρμογής. Η εφαρμογή μπορεί να έχει αφαιρεθεί ή η πρόσβασή της στο API να μην είναι πλέον ενεργή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trakt rejected this app's API credentials. The application may have been removed, or its API access may no longer be active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt rechazó las credenciales de API de esta app. Es posible que la aplicación se haya eliminado o que su acceso a la API ya no esté activo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt اعتبارنامه‌های API این برنامه را رد کرد. ممکن است برنامه حذف شده باشد یا دسترسی API آن دیگر فعال نباشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt hylkäsi tämän apin API-tunnistetiedot. Sovellus on ehkä poistettu tai sen API-käyttöoikeus ei ole enää aktiivinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt a rejeté les identifiants d’API de cette app. L’application a peut-être été supprimée ou son accès à l’API n’est peut-être plus actif."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt דחה את פרטי ה-API של האפליקציה הזו. ייתכן שהאפליקציה הוסרה או שגישת ה-API שלה כבר אינה פעילה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt ने इस ऐप के API क्रेडेंशियल अस्वीकार कर दिए हैं। एप्लिकेशन हटाया गया हो सकता है, या इसका API एक्सेस अब सक्रिय न हो."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt je odbio API vjerodajnice ove aplikacije. Aplikacija je možda uklonjena ili njezin API pristup više nije aktivan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt elutasította az alkalmazás API-hitelesítő adatait. Lehet, hogy az alkalmazást eltávolították, vagy az API-hozzáférése már nem aktív."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt menolak kredensial API aplikasi ini. Aplikasi mungkin telah dihapus, atau akses API-nya tidak lagi aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt ha rifiutato le credenziali API di questa app. L'applicazione potrebbe essere stata rimossa oppure il suo accesso API potrebbe non essere più attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trakt がこのアプリの API 認証情報を拒否しました。アプリケーションが削除されたか、API アクセスが無効になっている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
