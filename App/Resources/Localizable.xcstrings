    "Connections are stored separately for each Plozz profile. Playback progress is sent to every connected tracker.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbindingen worden apart opgeslagen voor elk Plozz-profiel. Kijkvoortgang wordt naar elke verbonden tracker gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połączenia są przechowywane osobno dla każdego profilu Plozz. Postęp odtwarzania jest wysyłany do każdego połączonego serwisu śledzącego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As conexões são armazenadas separadamente para cada perfil do Plozz. O progresso da reprodução é enviado para todos os rastreadores conectados."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbindelser gemmes separat for hver Plozz-profil. Afspilningsfremgang sendes til alle forbundne trackere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les connexions sont stockées séparément pour chaque profil Plozz. La progression de lecture est envoyée à chaque service de suivi connecté."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключения хранятся отдельно для каждого профиля Plozz. Прогресс воспроизведения отправляется в каждый подключённый трекер."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojení se ukládají zvlášť pro každý profil Plozz. Postup přehrávání se odesílá do všech připojených služeb sledování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbindungen werden für jedes Plozz-Profil separat gespeichert. Der Wiedergabefortschritt wird an alle verbundenen Tracker gesendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le connessioni sono memorizzate separatamente per ciascun profilo Plozz. I progressi di riproduzione sono inviati a tutti i tracker connessi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anslutningar sparas separat för varje Plozz-profil. Uppspelningsförlopp skickas till alla anslutna spårningstjänster."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veze se pohranjuju zasebno za svaki Plozz profil. Napredak reprodukcije šalje se svakom povezanom servisu za praćenje."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungan disimpan secara berasingan untuk setiap profil Plozz. Kemajuan main balik dihantar ke setiap penjejak yang disambungkan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pripojenia sa ukladajú samostatne pre každý profil Plozz. Priebeh prehrávania sa odosiela do všetkých pripojených služieb sledovania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підключення зберігаються окремо для кожного профілю Plozz. Стан перегляду надсилається до кожного підключеного трекера."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koneksi disimpan terpisah untuk setiap profil Plozz. Progres pemutaran dikirim ke setiap pelacak yang terhubung."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bağlantılar her Plozz profili için ayrı saklanır. Oynatma ilerlemesi bağlı tüm takip hizmetlerine gönderilir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les connexions es desen per separat per a cada perfil de Plozz. El progrés de reproducció s’envia a tots els serveis de seguiment connectats."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conexiunile sunt stocate separat pentru fiecare profil Plozz. Progresul redării este trimis către fiecare serviciu de urmărire conectat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "החיבורים נשמרים בנפרד לכל פרופיל Plozz. התקדמות הצפייה נשלחת לכל שירות מעקב מחובר."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povezave se shranijo ločeno za vsak profil Plozz. Napredek predvajanja se pošilja vsem povezanim storitvam sledenja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเชื่อมต่อจะจัดเก็บแยกกันสำหรับแต่ละโปรไฟล์ Plozz ความคืบหน้าในการเล่นจะส่งไปยังตัวติดตามทุกตัวที่เชื่อมต่ออยู่"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Връзките се съхраняват отделно за всеки профил на Plozz. Напредъкът при гледане се изпраща към всяка свързана услуга за проследяване."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhteydet tallennetaan erikseen jokaiselle Plozz-profiilille. Toiston edistyminen lähetetään kaikkiin yhdistettyihin seurantapalveluihin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilkoblinger lagres separat for hver Plozz-profil. Avspillingsfremdrift sendes til alle tilkoblede trackere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个 Plozz 账户的连接信息独立存储。播放进度会发送至所有已连接的追踪器。"
          }
        }
      }
    },
