    "Uses intro and credit markers from your server. Requires Plex Pass on Plex, or Media Segments / Intro Skipper on Jellyfin.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gebruikt intro- en aftitelingsmarkeringen van je server. Vereist Plex Pass op Plex, of Media Segments/Intro Skipper op Jellyfin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Używa znaczników intro i napisów końcowych z serwera. W Plex wymaga Plex Pass, a w Jellyfin Media Segments / Intro Skipper."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa os marcadores de introdução e créditos do seu servidor. Requer Plex Pass no Plex ou Media Segments / Intro Skipper no Jellyfin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bruger intro- og rulletekstmarkører fra din server. Kræver Plex Pass på Plex eller Media Segments/Intro Skipper på Jellyfin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilise les marqueurs d’intro et de générique de votre serveur. Nécessite Plex Pass sur Plex, ou Media Segments / Intro Skipper sur Jellyfin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Использует маркеры заставки и титров с вашего сервера. На Plex требуется Plex Pass, а на Jellyfin — Media Segments / Intro Skipper."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Používá značky úvodů a závěrečných titulků ze serveru. Ve službě Plex vyžaduje Plex Pass, ve službě Jellyfin pak Media Segments / Intro Skipper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwendet Intro- und Abspann-Marker von deinem Server. Erfordert Plex Pass bei Plex oder Media Segments / Intro Skipper bei Jellyfin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa i marcatori di intro e titoli di coda forniti dal server. Richiede Plex Pass su Plex oppure Media Segments / Intro Skipper su Jellyfin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Använder intro- och eftertextmarkeringar från din server. Kräver Plex Pass på Plex, eller Media Segments/Intro Skipper på Jellyfin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koristi oznake uvoda i odjavne špice s vašeg poslužitelja. Zahtijeva Plex Pass na Plexu ili Media Segments / Intro Skipper na Jellyfinu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menggunakan penanda intro dan kredit daripada pelayan anda. Memerlukan Plex Pass pada Plex, atau Media Segments / Intro Skipper pada Jellyfin."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Používa značky úvodov a záverečných titulkov zo servera. V službe Plex vyžaduje Plex Pass, v službe Jellyfin zase Media Segments / Intro Skipper."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Використовує маркери вступів і титрів із вашого сервера. Потрібен Plex Pass для Plex або Media Segments / Intro Skipper для Jellyfin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menggunakan penanda intro dan kredit dari server Anda. Memerlukan Plex Pass di Plex, atau Media Segments / Intro Skipper di Jellyfin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sunucunuzdaki açılış ve kapanış jeneriği işaretlerini kullanır. Plex için Plex Pass, Jellyfin için Media Segments / Intro Skipper gerekir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilitza les marques d'introducció i crèdits del teu servidor. Requereix Plex Pass a Plex, o Media Segments / Intro Skipper a Jellyfin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Folosește marcajele pentru introduceri și generice de pe serverul tău. Necesită Plex Pass pe Plex sau Media Segments / Intro Skipper pe Jellyfin."
          }
        }
      }
    },
