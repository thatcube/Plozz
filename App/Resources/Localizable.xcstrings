    "It's now playing and available in your subtitle list.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De ondertitel wordt nu weergegeven en staat in je lijst met ondertitels."
          }
        },
        "pl": {
          "stringUnit": {
