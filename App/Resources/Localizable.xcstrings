          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP 传输凭据和媒体时未加密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP 會以未加密方式傳送登入資訊與媒體內容。"
          }
        }
