          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dit profiel heeft alle servers uitgeschakeld, dus de bibliotheken worden niet weergegeven. Schakel een server weer in via Instellingen › Bibliotheken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ten profil ma wyłączone wszystkie serwery, więc biblioteki nie są wyświetlane. Włącz ponownie jeden w menu Ustawienia › Biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este perfil desativou todos os servidores, então as bibliotecas não são exibidas. Reative um em Ajustes › Bibliotecas."
