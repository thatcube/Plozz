    "error.plex.rateLimited": {
      "comment": "Shown when plex.tv throttles repeated sign-in attempts.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Plex is temporarily limiting sign-in attempts. Wait a minute and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex beperkt tijdelijk het aantal aanmeldpogingen. Wacht een minuutje en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
