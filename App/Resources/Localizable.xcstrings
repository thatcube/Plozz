          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Как Plozz выбирает язык аудио, если у материала доступно несколько вариантов, — с дополнительными правилами по типу контента и запоминанием для каждого сериала."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jak Plozz vybírá jazyk zvuku, když titul nabízí víc možností — s volitelnými pravidly podle typu obsahu a s pamětí pro jednotlivé seriály."
          }
        },
        "de": {
          "stringUnit": {
