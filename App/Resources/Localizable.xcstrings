    "Make sure the same number shows on your other device, then confirm there.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zorg dat hetzelfde nummer wordt weergegeven op je andere apparaat en bevestig dit daar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upewnij się, że na drugim urządzeniu wyświetla się ten sam numer, a potem potwierdź tam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confira se o mesmo número aparece no outro dispositivo e confirme por lá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sørg for, at det samme tal vises på din anden enhed, og bekræft det der."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiez que le même numéro s’affiche sur votre autre appareil, puis confirmez-y."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Убедитесь, что на другом устройстве показан тот же номер, затем подтвердите его там."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ujistěte se, že se stejné číslo zobrazuje i na druhém zařízení, a pak ho tam potvrďte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vergewissere dich, dass auf deinem anderen Gerät dieselbe Zahl angezeigt wird, und bestätige dort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Assicurati che sull’altro dispositivo appaia lo stesso numero, quindi conferma su quel dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrollera att samma nummer visas på din andra enhet och bekräfta där."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Provjerite prikazuje li se isti broj na drugom uređaju, a zatim ga potvrdite tamo."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pastikan nombor yang sama dipaparkan pada peranti lain anda, kemudian sahkan di sana."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uistite sa, že sa na vašom druhom zariadení zobrazuje rovnaké číslo, a potom to tam potvrďte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переконайтеся, що такий же номер відображається на іншому пристрої, а потім підтвердіть там."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pastikan nomor yang sama muncul di perangkat lain Anda, lalu konfirmasikan di sana."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer aygıtınızda da aynı sayının göründüğünden emin olun, ardından orada onaylayın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprova que el mateix número es mostra a l'altre dispositiu i confirma-ho allà."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Asigură-te că pe celălalt dispozitiv apare același număr, apoi confirmă acolo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ודא שאותו מספר מוצג במכשיר האחר שלך, ולאחר מכן אשר שם."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prepričajte se, da je na drugi napravi prikazana ista številka, nato tam potrdite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตรวจสอบให้แน่ใจว่ามีตัวเลขเดียวกันแสดงบนอุปกรณ์อีกเครื่องของคุณ แล้วไปยืนยันที่นั่น"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Уверете се, че същият номер се показва на другото устройство, след което потвърдете там."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varmista, että toisessa laitteessa näkyy sama numero, ja vahvista siellä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontroller at det samme tallet vises på den andre enheten, og bekreft der."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请确认另一台设备上显示相同的数字，然后确认。"
          }
        }
      }
    },
