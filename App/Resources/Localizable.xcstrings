    "circadianMode.detail.alwaysOn": {
      "comment": "One-line explanation shown under the Circadian mode picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Always warm, at full strength, around the clock."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altijd warm, op volle sterkte, de klok rond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zawsze ociepla obraz z pełną siłą, przez całą dobę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sempre aquecida, na intensidade máxima, o tempo todo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altid varm, med fuld styrke, hele døgnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réchauffement constant, à pleine intensité, jour et nuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Постоянно делает изображение теплее с максимальной интенсивностью."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pořád zahřívá obraz na plnou sílu, po celý den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Immer warm, mit voller Stärke, rund um die Uhr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tonalità calda sempre attiva, alla massima intensità, 24 ore su 24."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alltid varm, med full styrka, dygnet runt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uvijek toplo, punim intenzitetom, tijekom cijelog dana."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sentiasa hangat, pada kekuatan penuh, sepanjang masa."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vždy teplé, v plnej sile, po celý deň."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цілодобово підігріває екран із повною інтенсивністю."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selalu hangat dengan kekuatan penuh, sepanjang waktu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Günün her saati, tam güçte sıcak tutar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sempre càlid, a màxima intensitat, les 24 hores del dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Întotdeauna cald, la intensitate maximă, pe tot parcursul zilei."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "תמיד חם, בעוצמה מלאה, מסביב לשעון."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vedno toplo, s polno močjo, ves čas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โทนอุ่นตลอดเวลา ที่ความเข้มสูงสุด ตลอด 24 ชั่วโมง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Винаги топло, с пълна интензивност, денонощно."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aina lämmin, täydellä voimakkuudella, ympäri vuorokauden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alltid varm, med full styrke, hele døgnet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "全天保持温暖，强度最大。"
          }
        }
      }
    },
    "circadianMode.detail.auto": {
      "comment": "One-line explanation shown under the Circadian mode picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Warms automatically from sunset to sunrise for your location."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geeft het beeld van zonsondergang tot zonsopgang automatisch een warmere tint op basis van je locatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Automatycznie ociepla obraz od zachodu do wschodu słońca w tej lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquece automaticamente do pôr do sol ao nascer do sol de acordo com sua localização."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varmer automatisk fra solnedgang til solopgang på din placering."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réchauffe automatiquement l’image du coucher au lever du soleil selon votre position."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Автоматически делает изображение теплее от заката до рассвета для вашего местоположения."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro vaše umístění zahřívá obraz automaticky od západu do východu slunce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wärmt das Bild automatisch von Sonnenuntergang bis Sonnenaufgang an deinem Standort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Applica automaticamente una tonalità calda dal tramonto all’alba in base alla posizione."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Värmer bilden automatiskt från solnedgång till soluppgång där du befinner dig."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Automatski zagrijava ton slike od zalaska do izlaska sunca za vašu lokaciju."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menghangat secara automatik dari matahari terbenam hingga matahari terbit mengikut lokasi anda."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Automaticky zohreje farby od západu do východu slnka pre vašu polohu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Автоматично підігріває екран від заходу до сходу сонця у вашому місці."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menghangat otomatis dari matahari terbenam hingga matahari terbit di lokasi Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konumunuz için gün batımından gün doğumuna kadar otomatik olarak ısıtır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S’escalfa automàticament des de la posta de sol fins a la sortida del sol segons la teva ubicació."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încălzește automat imaginea de la apus la răsărit pentru locația ta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מתחמם אוטומטית מהשקיעה עד הזריחה במיקום שלך."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samodejno ogreje od sončnega zahoda do sončnega vzhoda za vašo lokacijo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปรับเป็นโทนอุ่นอัตโนมัติตั้งแต่พระอาทิตย์ตกถึงพระอาทิตย์ขึ้นตามตำแหน่งของคุณ"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Затопля се автоматично от залез до изгрев за вашето местоположение."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lämmittää kuvaa automaattisesti auringonlaskusta auringonnousuun sijainnin mukaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varmer automatisk fra solnedgang til soloppgang på din plassering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "根据您所在位置，从日落到日出自动调节。"
          }
        }
      }
    },
    "circadianMode.detail.manual": {
      "comment": "One-line explanation shown under the Circadian mode picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Warms between two times you set each day."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geeft het beeld elke dag tussen twee door jou ingestelde tijden een warmere tint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ociepla obraz między dwoma godzinami ustawionymi na każdy dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquece entre dois horários que você define todos os dias."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varmer mellem to tidspunkter, du selv angiver hver dag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réchauffe l’image entre deux heures que vous définissez chaque jour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Делает изображение теплее между двумя заданными вами моментами времени каждый день."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zahřívá obraz mezi dvěma časy, které nastavíte pro každý den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wärmt das Bild täglich zwischen zwei von dir festgelegten Zeiten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Applica una tonalità calda tra i due orari impostati ogni giorno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Värmer bilden mellan två tider som du anger för varje dag."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zagrijava ton slike između dvaju vremena koja postavite svaki dan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menghangat antara dua waktu yang anda tetapkan setiap hari."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zohreje farby medzi dvoma časmi, ktoré nastavíte každý deň."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підігріває екран щодня між двома заданими моментами часу."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menghangat di antara dua waktu yang Anda atur setiap hari."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her gün belirlediğiniz iki saat arasında ısıtır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S’escalfa entre dues hores que estableixes cada dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încălzește imaginea între două ore stabilite de tine în fiecare zi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מתחמם בין שני זמנים שתגדיר בכל יום."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogreje med dvema urama, ki ju nastavite za vsak dan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปรับเป็นโทนอุ่นระหว่างสองเวลาที่คุณตั้งไว้ในแต่ละวัน"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Затопля изображението във всекидневно зададен от вас часови интервал."
