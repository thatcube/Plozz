        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "關於 Plozz。版本 %1$@，組建 %2$@。將你的所有媒體匯集成統一的體驗。永久免費且開放原始碼。掃描螢幕上的代碼即可檢視 GitHub 儲存庫。"
          }
        }
