    "Active now (%@). Manual: on %@, off %@ · %@ fade.": {
      "comment": "Status summary for Circadian Mode when manual scheduling is currently active. The first %@ is current tint intensity as a percentage, the second %@ is the on time, the third %@ is the off time, and the fourth %@ is the fade duration.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Active now (%1$@). Manual: on %2$@, off %3$@ · %4$@ fade."
          }
