    "Send recent app logs to help diagnose a problem. Logins, servers, and media titles are excluded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أرسل سجلات التطبيق الحديثة للمساعدة في تشخيص مشكلة. تُستبعد بيانات تسجيل الدخول والخوادم وعناوين الوسائط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изпратете последните регистри на приложението, за да помогнете при диагностицирането на проблем. Данните за вход, сървърите и заглавията на медиите се изключват."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envieu els registres recents de l’aplicació per ajudar a diagnosticar un problema. S’exclouen els inicis de sessió, els servidors i els títols multimèdia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odešlete nedávné protokoly aplikace, které pomohou určit problém. Přihlášení, servery a názvy médií jsou vynechány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Send de seneste applogfiler for at hjælpe med at diagnosticere et problem. Logins, servere og medietitler er udeladt."
          }
        },
        "de" : {
          "stringUnit" : {
