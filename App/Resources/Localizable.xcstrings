    "FTPS uses TLS from connection start. Explicit TLS (AUTH TLS) is not supported." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم FTPS TLS من بداية الاتصال. TLS صريح (AUTH TLS) غير مدعوم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTPS използва TLS от началото на връзката. Явният TLS (AUTH TLS) не се поддържа."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTPS utilitza TLS des de l'inici de la connexió. El TLS explícit (AUTH TLS) no és compatible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTPS používá TLS od začátku spojení. Explicit TLS (AUTH TLS) není podporováno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTPS bruger TLS fra forbindelsens start. Eksplicit TLS (AUTH TLS) understøttes ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTPS verwendet TLS ab dem Verbindungsaufbau. Explizites TLS (AUTH TLS) wird nicht unterstützt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το FTPS χρησιμοποιεί TLS από την έναρξη της σύνδεσης. Το ρητό TLS (AUTH TLS) δεν υποστηρίζεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTPS usa TLS desde el inicio de la conexión. No se admite TLS explícito (AUTH TLS)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTPS از TLS از ابتدا استفاده می‌کند. TLS صریح (AUTH TLS) پشتیبانی نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTPS käyttää TLS:ää heti yhteyden alusta. Eksplisiittistä TLS:ää (AUTH TLS) ei tueta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTPS utilise TLS dès le début de la connexion. TLS explicite (AUTH TLS) n’est pas pris en charge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTPS משתמש ב-TLS מתחילת החיבור. TLS מפורש (AUTH TLS) אינו נתמך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTPS कनेक्शन शुरू होते ही TLS का इस्तेमाल करता है. Explicit TLS (AUTH TLS) समर्थित नहीं है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTPS koristi TLS od početka veze. Eksplicitni TLS (AUTH TLS) nije podržan."
          }
        },
        "hu" : {
          "stringUnit" : {
