        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fra. Manuel: til %1$@, fra %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé. Manuel : activé à %1$@, désactivé à %2$@."
