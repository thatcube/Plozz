    "Signs everyone out and removes this server.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Meldt iedereen af en verwijdert deze server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wylogowuje wszystkich i usuwa ten serwer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desconecta todos e remove este servidor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logger alle ud og fjerner denne server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déconnecte tout le monde et supprime ce serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выйдет из учётных записей всех пользователей и удалит этот сервер."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odhlásí všechny a odebere tento server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Meldet alle ab und entfernt diesen Server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esce da tutti gli account e rimuove questo server."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Loggar ut alla och tar bort den här servern."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odjavljuje sve i uklanja ovaj poslužitelj."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Melog keluar semua orang dan membuang pelayan ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odhlási všetkých a odstráni tento server."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завершує сеанси всіх користувачів і видаляє цей сервер."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keluarkan semua akun dan hapus server ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Herkesin oturumunu kapatır ve bu sunucuyu kaldırır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tanca la sessió de tothom i elimina aquest servidor."
          }
        },
