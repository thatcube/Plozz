    "Warms and dims the display at night to help you sleep.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maakt het scherm 's nachts warmer en donkerder, zodat je beter slaapt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nocą ociepla i przyciemnia obraz, aby ułatwić zasypianie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquece e reduz o brilho da tela à noite para ajudar você a dormir."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varmer og dæmper skærmen om natten for at hjælpe dig med at sove."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réchauffe et assombrit l’image la nuit pour vous aider à dormir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ночью делает изображение теплее и темнее, чтобы вам было легче заснуть."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "V noci obraz oteplí a ztmaví, aby vám pomohl spát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wärmt und dimmt das Display nachts, damit du besser schlafen kannst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rende più caldo e attenua lo schermo di notte per favorire il sonno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gör skärmen varmare och mörkare på natten för att underlätta sömnen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noću zagrijava ton slike i prigušuje zaslon kako bi vam pomogao spavati."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menghangatkan dan meredupkan paparan pada waktu malam untuk membantu anda tidur."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "V noci zohreje farby a stlmí displej, aby vám pomohol spať."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пом’якшує та зменшує яскравість екрана вночі, щоб допомогти вам спати."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menghangatkan dan meredupkan layar pada malam hari untuk membantu Anda tidur."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uyumanıza yardımcı olmak için geceleri ekranın renklerini ısıtır ve parlaklığını azaltır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escalfa i atenua la pantalla a la nit per ajudar-te a dormir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încălzește culorile și reduce luminozitatea ecranului noaptea pentru a te ajuta să dormi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מחמם ומעמעם את התצוגה בלילה כדי לעזור לך להירדם."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ponoči ogreje in zatemni zaslon, da lažje zaspite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทำให้หน้าจออุ่นขึ้นและมืดลงในเวลากลางคืนเพื่อช่วยให้คุณนอนหลับ"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Затопля и затъмнява дисплея през нощта, за да ви помогне да спите."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lämmittää ja himmentää näyttöä yöllä unen tueksi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varmer og demper skjermen om natten for å hjelpe deg med å sove."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "夜间调暖并降低屏幕亮度以助睡眠。"
          }
        }
      }
    },
