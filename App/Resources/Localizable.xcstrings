        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "อนุมัติเฉพาะเมื่อลายนิ้วมือ SHA-256 ตรงกับเซิร์ฟเวอร์ของคุณ การอนุมัติจะตรึงใบรับรองนี้ไว้ หากใบรับรองเปลี่ยนจะต้องอนุมัติใหม่"
