          }
        }
      }
    },
    "Something went wrong searching or downloading. Try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er is iets misgegaan bij het zoeken of downloaden. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coś poszło nie tak podczas wyszukiwania lub pobierania. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algo deu errado ao buscar ou baixar. Tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noget gik galt under søgning eller download. Prøv igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une erreur est survenue pendant la recherche ou le téléchargement. Réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Во время поиска или загрузки что-то пошло не так. Повторите попытку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Při hledání nebo stahování se něco pokazilo. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Suchen oder Herunterladen ist etwas schiefgelaufen. Versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qualcosa è andato storto durante la ricerca o il download. Riprova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Något gick fel vid sökning eller nedladdning. Försök igen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nešto je pošlo po zlu pri pretraživanju ili preuzimanju. Pokušajte ponovno."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ada masalah semasa mencari atau memuat turun. Cuba lagi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri vyhľadávaní alebo sťahovaní sa niečo pokazilo. Skúste to znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щось пішло не так під час пошуку або завантаження. Спробуйте ще раз."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terjadi kesalahan saat mencari atau mengunduh. Coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arama veya indirme sırasında bir sorun oluştu. Yeniden deneyin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S'ha produït un error en cercar o baixar. Torna-ho a provar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A apărut o problemă la căutare sau descărcare. Reîncearcă."
          }
        }
      }
    },
    "Something went wrong talking to this server.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er is iets misgegaan bij de communicatie met deze server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coś poszło nie tak podczas komunikacji z tym serwerem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algo deu errado ao falar com este servidor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noget gik galt i kommunikationen med denne server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une erreur est survenue lors de la communication avec ce serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось связаться с этим сервером."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Při komunikaci s tímto serverem se něco pokazilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei der Kommunikation mit diesem Server ist etwas schiefgelaufen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qualcosa è andato storto nella comunicazione con questo server."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Något gick fel vid kommunikationen med den här servern."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Došlo je do pogreške pri komunikaciji s ovim poslužiteljem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ada masalah semasa berkomunikasi dengan pelayan ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri komunikácii s týmto serverom sa niečo pokazilo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Під час зв’язку із цим сервером сталася помилка."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terjadi kesalahan saat menghubungi server ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sunucuyla iletişimde bir sorun oluştu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S'ha produït un error en comunicar-se amb aquest servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A apărut o problemă la comunicarea cu acest server."
          }
        }
      }
    },
