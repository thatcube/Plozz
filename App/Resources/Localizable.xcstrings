    "transparency.detail.off" : {
      "comment" : "One-line explanation shown under the transparency picker.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استخدم دائماً خلفيات مصمتة بلا شفافية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Винаги използвайте плътни фонове — без прозрачност."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilitza sempre fons sòlids — sense translucidesa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vždy používat plná pozadí — bez průhlednosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brug altid ensfarvede baggrunde — ingen gennemsigtighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Immer deckende Hintergründe — keine Transparenz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Χρησιμοποιεί πάντα συμπαγή φόντα — χωρίς διαφάνεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Always use solid backgrounds — no translucency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa siempre fondos sólidos, sin translucidez."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "همیشه از پس‌زمینه‌های جامد استفاده شود — بدون شفافیت."
          }
        },
