            "value": "Tryck på fönstret för att fortsätta uppspelningen här."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodirnite prozor da vratite reprodukciju ovamo."
          }
        },
        "ms": {
