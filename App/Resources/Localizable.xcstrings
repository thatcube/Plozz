                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Ta czynność pobierze %lld odcinka w oryginalnej jakości i może zużyć dużo miejsca oraz danych. Możesz je w każdej chwili usunąć w sekcji Pobrane."
                }
              }
            }
