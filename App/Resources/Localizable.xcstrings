    "Connect a Seerr server (Overseerr / Jellyseerr) to discover and request movies, shows & anime for everyone on this Apple TV.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koppel een Seerr-server (Overseerr/Jellyseerr) om films, series en anime te ontdekken en aan te vragen voor iedereen op deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połącz serwer Seerr (Overseerr / Jellyseerr), aby odkrywać filmy, seriale i anime oraz prosić o nie dla wszystkich na tym Apple TV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conecte um servidor Seerr (Overseerr / Jellyseerr) para descobrir e solicitar filmes, séries e animes para todo mundo nesta Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbind en Seerr-server (Overseerr / Jellyseerr) for at opdage og anmode om film, serier og anime for alle på dette Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez un serveur Seerr (Overseerr / Jellyseerr) pour découvrir et demander des films, des séries et des anime pour tout le monde sur cette Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключите сервер Seerr (Overseerr / Jellyseerr), чтобы находить и запрашивать фильмы, сериалы и аниме для всех пользователей этого Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojte server Seerr (Overseerr / Jellyseerr) a umožněte všem na této Apple TV vyhledávat filmy, seriály a anime a žádat o ně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbinde einen Seerr-Server (Overseerr / Jellyseerr), um Filme, Serien und Anime für alle auf diesem Apple TV zu entdecken und anzufragen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connetti un server Seerr (Overseerr / Jellyseerr) per scoprire e richiedere film, serie TV e anime per tutti su questa Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anslut en Seerr-server (Overseerr/Jellyseerr) för att upptäcka och begära filmer, serier och anime åt alla på den här Apple TV:n."
          }
        }
      }
    },
    "Connect a media server or an NFS network share to start watching.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak verbinding met een mediaserver of NFS-netwerkshare om te beginnen met kijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połącz serwer multimediów albo udział sieciowy NFS, aby zacząć oglądać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conecte um servidor de mídia ou um compartilhamento de rede NFS para começar a assistir."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbind en medieserver eller en NFS-netværksdeling for at begynde at se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez un serveur multimédia ou un partage réseau NFS pour commencer à regarder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключите медиасервер или сетевой ресурс NFS, чтобы начать просмотр."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojte server médií nebo síťové sdílení NFS a začněte sledovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbinde einen Medienserver oder eine NFS-Netzwerkfreigabe, um loszulegen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connetti un server multimediale o una condivisione di rete NFS per iniziare a guardare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anslut en medieserver eller en NFS-nätverksdelning för att börja titta."
          }
        }
      }
    },
    "Connect one Overseerr or Jellyseerr server for the household. Each Plozz profile can make requests as a different user.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbind één Overseerr- of Jellyseerr-server voor het huishouden. Elk Plozz-profiel kan aanvragen doen als een andere gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połącz jeden serwer Overseerr lub Jellyseerr dla całego domu. Każdy profil Plozz może składać prośby jako inny użytkownik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conecte um servidor Overseerr ou Jellyseerr para o grupo familiar. Cada perfil do Plozz pode fazer solicitações como um usuário diferente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbind én Overseerr- eller Jellyseerr-server for husstanden. Hver Plozz-profil kan sende anmodninger som en anden bruger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez un serveur Overseerr ou Jellyseerr pour tout le foyer. Chaque profil Plozz peut faire des demandes au nom d’un utilisateur différent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключите один сервер Overseerr или Jellyseerr для всего дома. Каждый профиль Plozz может отправлять запросы от имени другого пользователя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojte pro domácnost jeden server Overseerr nebo Jellyseerr. Každý profil Plozz může podávat žádosti jako jiný uživatel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbinde einen Overseerr- oder Jellyseerr-Server für den ganzen Haushalt. Jedes Plozz-Profil kann Anfragen über einen eigenen Benutzer stellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connetti un server Overseerr o Jellyseerr per la famiglia. Ogni profilo Plozz può effettuare richieste come utente diverso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anslut en Overseerr- eller Jellyseerr-server för hushållet. Varje Plozz-profil kan göra förfrågningar som en annan användare."
          }
        }
      }
    },
