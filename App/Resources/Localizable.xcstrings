    "Active now (%@). %@ sunrise %@ · %@ fade.": {
      "comment": "Status summary for Circadian Mode when automatic solar scheduling is currently active. The first %@ is current tint intensity as a percentage, the second %@ is the selected region name, the third %@ is today's sunrise time, and the fourth %@ is the fade duration.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Active now (%1$@). %2$@ sunrise %3$@ · %4$@ fade."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nu actief (%1$@). %2$@: zonsopgang %3$@ · overgang van %4$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktywne teraz (%1$@). %2$@ — wschód słońca %3$@ · przejście %4$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ativo agora (%1$@). Em %2$@, nascer do sol às %3$@ · transição de %4$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiv nu (%1$@). Solopgang i %2$@: %3$@ · %4$@ udtoning."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Actif maintenant (%1$@). %2$@ · lever du soleil à %3$@ · fondu de %4$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Активно сейчас (%1$@). %2$@: восход %3$@ · переход %4$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktivní nyní (%1$@). %2$@, východ slunce v %3$@ · prolnutí %4$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jetzt aktiv (%1$@). %2$@ – Sonnenaufgang %3$@ · %4$@ Übergang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attivo ora (%1$@). %2$@: alba alle %3$@ · dissolvenza %4$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktivt nu (%1$@). %2$@ soluppgång %3$@ · %4$@ uttoning."
          }
        }
      }
    },
    "Active now (%@). Manual: on %@, off %@ · %@ fade.": {
      "comment": "Status summary for Circadian Mode when manual scheduling is currently active. The first %@ is current tint intensity as a percentage, the second %@ is the on time, the third %@ is the off time, and the fourth %@ is the fade duration.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Active now (%1$@). Manual: on %2$@, off %3$@ · %4$@ fade."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nu actief (%1$@). Handmatig: aan om %2$@, uit om %3$@ · overgang van %4$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktywne teraz (%1$@). Ręcznie: włącz %2$@, wyłącz %3$@ · przejście %4$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ativo agora (%1$@). Manual: liga às %2$@, desliga às %3$@ · transição de %4$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiv nu (%1$@). Manuel: tændes %2$@, slukkes %3$@ · %4$@ udtoning."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Actif maintenant (%1$@). Manuel : activé à %2$@, désactivé à %3$@ · fondu de %4$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Активно сейчас (%1$@). Вручную: вкл. %2$@, выкл. %3$@ · переход %4$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktivní nyní (%1$@). Ručně: zap. %2$@, vyp. %3$@ · prolnutí %4$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jetzt aktiv (%1$@). Manuell: an %2$@, aus %3$@ · %4$@ Übergang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attivo ora (%1$@). Manuale: dalle %2$@ alle %3$@ · dissolvenza %4$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktivt nu (%1$@). Manuellt: på %2$@, av %3$@ · %4$@ uttoning."
          }
        }
      }
    },
