    "How Plozz picks the audio language when a title offers more than one — with optional per-content-type rules and per-series memory." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كيف يختار Plozz لغة الصوت عندما توفر عنوان أكثر من لغة واحدة — مع قواعد اختيارية لكل نوع محتوى وذاكرة لكل سلسلة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Как Plozz избира езика на аудиото, когато заглавието предлага повече от един — с правила по тип съдържание и запомняне за всеки сериал."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Com Plozz tria l'idioma de l'àudio quan un títol n'ofereix més d'un, amb regles opcionals per tipus de contingut i memòria per sèrie."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jak Plozz vybírá jazyk zvuku, když titul nabízí víc možností — s volitelnými pravidly podle typu obsahu a s pamětí pro jednotlivé seriály."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sådan vælger Plozz lydsprog, når en titel tilbyder mere end ét — med valgfrie regler pr. indholdstype og hukommelse pr. serie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie Plozz die Audiosprache auswählt, wenn ein Titel mehrere anbietet — mit optionalen Regeln je Inhaltstyp und gemerkter Auswahl je Serie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Πώς το Plozz επιλέγει τη γλώσσα ήχου όταν ένας τίτλος προσφέρει περισσότερες από μία — με προαιρετικούς κανόνες ανά τύπο περιεχομένου και μνήμη ανά σειρά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cómo Plozz selecciona el idioma de audio cuando un título ofrece más de uno, con reglas opcionales por tipo de contenido y memoria por serie."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "چگونه Plozz زبان صدا را انتخاب می‌کند وقتی یک عنوان چند زبانه ارائه می‌دهد — با قوانین اختیاری هر نوع محتوا و حافظه‌ی هر سری."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Miten Plozz valitsee äänen kielen, kun nimikkeessä on useampi vaihtoehto — halutessasi sisältötyyppikohtaisilla säännöillä ja sarjakohtaisella muistilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comment Plozz choisit la langue audio lorsqu’un titre en propose plusieurs — avec des règles facultatives par type de contenu et une mémorisation par série."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "איך Plozz בוחרת את שפת השמע כשכותר מציע יותר מאחת — עם כללים אופציונליים לכל סוג תוכן וזיכרון לכל סדרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जब किसी टाइटल में एक से ज़्यादा ऑडियो भाषाएं हों, तो Plozz ऑडियो भाषा कैसे चुनता है — हर कॉन्टेंट टाइप के लिए वैकल्पिक नियमों और हर सीरीज़ के लिए याद रखने की सुविधा के साथ."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kako Plozz odabire jezik zvuka kada naslov nudi više njih — uz neobavezna pravila po vrsti sadržaja i pamćenje po seriji."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hogyan választja ki a Plozz a hang nyelvét, amikor egy cím több nyelvet is kínál – beállítható tartalomtípusonkénti szabályokkal és sorozatonkénti emlékezéssel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cara Plozz memilih bahasa audio saat judul menawarkan lebih dari satu opsi — dengan aturan opsional per jenis konten serta mengingat pilihan per serial."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Come Plozz sceglie la lingua audio quando un titolo ne offre più di una, con regole opzionali per tipo di contenuto e memoria per serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "タイトルに複数の音声言語が提供されている場合、Plozzが音声言語を選択する方法 — オプションのコンテンツタイプごとのルールとシリーズごとの記憶機能付き。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "제목에 여러 오디오 언어가 제공될 때 Plozz가 언어를 선택하는 방식 — 내용 유형별 규칙과 시리즈별 기억 기능이 선택적으로 제공됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cara Plozz memilih bahasa audio apabila sesuatu tajuk menawarkan lebih daripada satu — dengan peraturan pilihan mengikut jenis kandungan dan ingatan mengikut siri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slik velger Plozz lydspråk når en tittel tilbyr flere — med valgfrie regler per innholdstype og minne per serie."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoe Plozz de audiotaal kiest wanneer een titel er meerdere aanbiedt — met optionele regels per inhoudstype en geheugen per serie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jak Plozz wybiera język ścieżki dźwiękowej, gdy tytuł ma ich kilka — z opcjonalnymi regułami dla typów treści i zapamiętywaniem wyboru dla seriali."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Como o Plozz escolhe o idioma do áudio quando um título oferece mais de um — com regras opcionais por tipo de conteúdo e memória por série."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cum alege Plozz limba audio când un titlu oferă mai multe opțiuni — cu reguli opționale pe tip de conținut și memorare pentru fiecare serial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Как Plozz выбирает язык аудио, если у материала доступно несколько вариантов, — с дополнительными правилами по типу контента и запоминанием для каждого сериала."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ako Plozz vyberá jazyk zvuku, keď titul ponúka viac možností — s voliteľnými pravidlami podľa typu obsahu a pamätaním pre jednotlivé seriály."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kako Plozz izbere jezik zvoka, ko naslov ponuja več možnosti — z izbirnimi pravili po vrsti vsebine in pomnjenjem po posamezni seriji."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kako Plozz bira jezik zvuka kada naslov nudi više od jednog — uz opcionalna pravila po vrsti sadržaja i pamćenje po seriji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Så väljer Plozz ljudspråk när en titel har fler än ett, med valfria regler för olika innehållstyper och minne per serie."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "วิธีที่ Plozz เลือกภาษาของเสียงเมื่อรายการมีให้เลือกมากกว่าหนึ่งภาษา — พร้อมกฎแยกตามประเภทเนื้อหาและการจดจำแยกตามซีรีส์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir yapım birden fazla ses dili sunduğunda Plozz’un hangisini seçeceğini belirler; içerik türüne göre isteğe bağlı kurallar ve dizi bazında hatırlama sunar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Як Plozz вибирає мову аудіо, якщо для контенту доступно кілька мов: з необов’язковими правилами для кожного типу контенту та запам’ятовуванням вибору для серіалів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Làm thế nào Plozz chọn ngôn ngữ âm thanh khi một tiêu đề cung cấp nhiều hơn một với các quy tắc tùy chọn cho mỗi loại nội dung và bộ nhớ cho mỗi loạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plozz 如何在内容提供多种音频语言时进行选择，支持按内容类型设置规则并按剧集记忆选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plozz 在作品有多種音訊語言時如何選擇 — 可選擇依內容類型設定規則，並依影集記憶偏好。"
          }
        }
      }
    },
    "How far the remote's left and right buttons jump during playback." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المسافة التي تنتقل فيها أزرار الاتجاه اليسرى واليمنى أثناء التشغيل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Колко далеч скачат левият и десният бутон на дистанционното по време на възпроизвеждане."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A quina distància salten els botons esquerre i dret del comandament durant la reproducció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O kolik tlačítka vlevo a vpravo na ovladači posouvají přehrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvor langt fjernbetjeningens venstre- og højreknapper springer under afspilning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie weit die linke und rechte Taste der Fernbedienung während der Wiedergabe springen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Πόσο μετακινούνται τα αριστερά και δεξιά κουμπιά του τηλεχειριστηρίου κατά την αναπαραγωγή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Distancia que avanzan los botones izquierdo y derecho del control remoto durante la reproducción."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فاصله‌ی دکمه‌های ریموت چپ و راست در حین پخش."
          }
        },
        "fi" : {
          "stringUnit" : {
