    "· +%lld more": {
      "comment": "Overflow indicator in the secondary line of the tvOS Libraries row in Settings when more watched servers exist than are shown. %lld is the number of additional servers not listed.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· +%lld meer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· +%lld więcej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· +%lld mais"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· +%lld flere"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· +%lld de plus"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· ещё %lld"
          }
        }
      }
    },
    "“%@” is set up on another device. Sign in to watch it here — your login stays private to each device. You can also find it later under Settings ▸ iCloud Sync.": {
      "comment": "Alert message on tvOS when a server synced from another device is available to add locally. %@ is the server name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” is ingesteld op een ander apparaat. Meld je aan om hier te kijken — je aanmeldgegevens blijven privé per apparaat. Je vindt dit later ook onder Instellingen ▸ iCloud-synchronisatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@” skonfigurowano na innym urządzeniu. Zaloguj się, aby oglądać tutaj — dane logowania pozostają prywatne na każdym urządzeniu. Można też znaleźć ten serwer później w Ustawieniach ▸ Synchronizacja z iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” está configurado em outro dispositivo. Faça login para assistir aqui — seu login continua privado em cada dispositivo. Você também pode encontrá-lo depois em Ajustes ▸ Sincronização do iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” er sat op på en anden enhed. Log ind for at se den her — dit login forbliver privat for hver enhed. Du kan også finde den senere under Indstillinger ▸ iCloud-synkronisering."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %@ » est configuré sur un autre appareil. Connectez-vous ici pour y regarder du contenu — vos identifiants restent privés sur chaque appareil. Vous pourrez aussi le retrouver plus tard dans Réglages ▸ Synchronisation iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» настроен на другом устройстве. Войдите здесь, чтобы смотреть на этом устройстве — данные входа остаются отдельными для каждого устройства. Вы также можете найти его позже в разделе «Настройки» ▸ «Синхронизация iCloud»."
          }
        }
      }
    },
    "“%@” will also be removed from your other devices signed in to iCloud.": {
      "comment": "Warning text in the Remove Everywhere alert on tvOS and iOS server settings. %@ is the server name that will also be removed from other iCloud-signed devices.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” wordt ook verwijderd van je andere apparaten die zijn aangemeld bij iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Serwer „%@” zostanie też usunięty z innych urządzeń zalogowanych do iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” também será removido dos seus outros dispositivos conectados ao iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” bliver også fjernet fra dine andre enheder, der er logget ind på iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %@ » sera aussi supprimé de vos autres appareils connectés à iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» также будет удалён с других ваших устройств, на которых выполнен вход в iCloud."
          }
        }
      }
    },
    "− shows subtitles earlier\n+ shows them later": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "− toont ondertitels eerder\n+ toont ze later"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "− pokazuje napisy wcześniej\n+ pokazuje je później"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "− mostra as legendas mais cedo\n+ mostra as legendas mais tarde"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "− viser undertekster tidligere\n+ viser dem senere"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "− affiche les sous-titres plus tôt\n+ les affiche plus tard"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "− показывает субтитры раньше\n+ показывает их позже"
          }
        }
      }
    },
