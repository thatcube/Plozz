    "Still wrong? Wipe the iCloud copy and re-upload from this Apple TV.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog steeds fout? Wis de iCloud-kopie en upload opnieuw vanaf deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadal coś się nie zgadza? Wymaż kopię w iCloud i prześlij ją ponownie z tego Apple TV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda está errado? Apague a cópia do iCloud e envie novamente desta Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stadig forkert? Slet iCloud-kopien, og upload igen fra dette Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toujours incorrect ? Effacez la copie iCloud et renvoyez-la depuis cette Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всё ещё не так? Удалите копию из iCloud и загрузите её заново с этого Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stále to není v pořádku? Smažte kopii na iCloudu a znovu ji nahrajte z této Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Immer noch falsch? Lösche die iCloud-Kopie und lade sie von diesem Apple TV neu hoch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ancora problemi? Cancella la copia su iCloud e caricala di nuovo da questa Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortfarande fel? Radera iCloud-kopian och ladda upp den igen från denna Apple TV."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još nije dobro? Obrišite iCloud kopiju i ponovno prenesite s ovog Apple TV-a."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masih salah? Padamkan salinan iCloud dan muat naik semula daripada Apple TV ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stále je to nesprávne? Vymažte kópiu v iCloude a znova ju nahrajte z tejto Apple TV."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ще не так? Вилучіть копію з iCloud та завантажте її заново з цього Apple TV."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masih salah? Hapus salinan iCloud dan unggah ulang dari Apple TV ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hâlâ yanlış mı? iCloud kopyasını silin ve bu Apple TV’den yeniden yükleyin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Segueix sent incorrecte? Esborra la còpia de l'iCloud i torna-la a pujar des d'aquest Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tot nu este corect? Șterge copia din iCloud și încarc-o din nou de pe acest Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "עדיין לא נכון? מחק את העותק ב-iCloud והעלה מחדש מה-Apple TV הזה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Še vedno napačno? Izbrišite kopijo v iCloudu in jo znova naložite s tega Apple TV-ja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่ถูกต้องใช่ไหม? ลบสำเนาใน iCloud แล้วอัปโหลดใหม่จาก Apple TV เครื่องนี้"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Още има проблем? Изтрийте копието в iCloud и го качете отново от този Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onko yhä vialla? Tyhjennä iCloud-kopio ja lähetä tiedot uudelleen tästä Apple TV:stä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortsatt feil? Slett iCloud-kopien og last den opp på nytt fra denne Apple TV-en."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍不正确？清除 iCloud 中的副本并从当前 Apple TV 重新上传。"
          }
        }
      }
    },
