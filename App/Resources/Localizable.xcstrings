    "Not seeing it nearby? Scan the QR or type the short code shown on the other device." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا ترى الجهاز بالقرب منك؟ امسح رمز الاستجابة السريعة أو اكتب الرمز القصير المعروض على الجهاز الآخر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не го виждате наблизо? Сканирайте QR кода или въведете кода, показан на другото устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No el veus a prop? Escaneja el QR o introdueix el codi curt que es mostra a l'altre dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nevidíte ho poblíž? Naskenujte QR nebo zadejte krátký kód zobrazený na druhém zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kan du ikke se den i nærheden? Scan QR-koden, eller indtast den korte kode, der vises på den anden enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird es in der Nähe nicht angezeigt? Scanne den QR-Code oder gib den Kurzcode ein, der auf dem anderen Gerät angezeigt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δεν το βλέπετε κοντά; Σαρώστε το QR ή πληκτρολογήστε τον σύντομο κωδικό που εμφανίζεται στην άλλη συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿No lo ves cerca? Escanea el código QR o escribe el código corto que aparece en el otro dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "در نزدیکی نمی‌بینید؟ کد QR را اسکن کنید یا کد کوتاهی که روی دستگاه دیگر نمایش داده شده است را تایپ کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eikö laite näy lähistöllä? Skannaa QR-koodi tai kirjoita toisessa laitteessa näkyvä lyhyt koodi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous ne le voyez pas à proximité ? Scannez le code QR ou saisissez le code court affiché sur l’autre appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לא רואה אותו בקרבת מקום? סרוק את קוד ה-QR או הקלד את הקוד הקצר המוצג במכשיר האחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्या यह पास में नहीं दिख रहा? QR स्कैन करें या दूसरे डिवाइस पर दिख रहा छोटा कोड टाइप करें."
