          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Синхронізуйте історію перегляду та відстежуйте, що дивитися далі, за допомогою Simkl."
          }
        },
        "id": {
          "stringUnit": {
