    "The server had a problem. Please try again in a moment.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er is een probleem opgetreden op de server. Probeer het straks opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wystąpił problem z serwerem. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O servidor teve um problema. Tente novamente em instantes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Serveren løb ind i et problem. Prøv igen om et øjeblik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le serveur a rencontré un problème. Veuillez réessayer dans un instant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На сервере возникла проблема. Повторите попытку чуть позже."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Server měl problém. Zkuste to prosím za chvíli znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf dem Server ist ein Problem aufgetreten. Bitte versuche es gleich noch einmal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il server ha riscontrato un problema. Riprova tra poco."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Servern stötte på ett problem. Försök igen om en liten stund."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poslužitelj je imao problem. Pokušajte ponovno za trenutak."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pelayan mengalami masalah. Sila cuba lagi sebentar lagi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Server mal problém. Skúste to znova o chvíľu, prosím."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На сервері сталася помилка. Спробуйте ще раз за мить."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Server mengalami masalah. Coba lagi sebentar lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sunucuda bir sorun oluştu. Lütfen birazdan yeniden deneyin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El servidor ha tingut un problema. Torna-ho a provar d'aquí a un moment."
