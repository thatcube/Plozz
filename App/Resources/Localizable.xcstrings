    "Leave all selected to use every library on Home.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laat alles geselecteerd om elke bibliotheek op Start te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozostaw wszystko zaznaczone, aby używać każdej biblioteki na stronie głównej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deixe tudo selecionado para usar todas as bibliotecas no Início."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lad alle være markeret for at bruge alle biblioteker på Hjem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laissez tout sélectionné pour utiliser toutes les bibliothèques sur l’accueil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оставьте всё выбранным, чтобы использовать на Главной все медиатеки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chcete-li na obrazovce Domů používat všechny knihovny, nechte je všechny vybrané."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lass alle ausgewählt, um auf Start jede Medienbibliothek zu verwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lascia tutto selezionato per usare ogni libreria in Home."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Låt alla vara markerade för att använda samtliga bibliotek på Hem."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ostavite sve odabrano kako biste na Početnoj koristili sve knjižnice."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biarkan semua dipilih untuk menggunakan setiap pustaka pada Laman Utama."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ak chcete na obrazovke Domov používať všetky knižnice, nechajte ich všetky vybraté."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Залиште всі медіатеки вибраними, щоб використовувати кожну з них на Головній."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biarkan semua tetap dipilih untuk menggunakan semua pustaka di Beranda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ana Sayfa’da tüm kitaplıkları kullanmak için hepsini seçili bırakın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deixa-ho tot seleccionat per utilitzar totes les biblioteques a Inici."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lasă-le pe toate selectate pentru a folosi toate bibliotecile în Acasă."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "השאר הכול מסומן כדי להשתמש בכל הספריות במסך הבית."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pustite vse izbrano, če želite na zaslonu Domov uporabljati vse knjižnice."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปล่อยให้เลือกทั้งหมดไว้เพื่อใช้ทุกไลบรารีในหน้าแรก"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оставете всички избрани, за да използвате всяка медиатека в Начало."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jätä kaikki valituiksi, niin Kodissa käytetään kaikkia kirjastoja."
          }
