    "Drag providers to set priority. Anything below the line is turned off.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep providers om de prioriteit in te stellen. Alles onder de lijn is uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeciągnij dostawców, aby ustawić priorytet. Wszystko poniżej linii jest wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
