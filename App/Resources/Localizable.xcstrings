    "Enable a library on Your Libraries to give it its own rows.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel een bibliotheek in bij Jouw bibliotheken om deze eigen rijen te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Włącz bibliotekę w sekcji Twoje biblioteki, aby miała własne sekcje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative uma biblioteca em Suas bibliotecas para que ela tenha linhas próprias."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktivér et bibliotek under Dine biblioteker for at give det sine egne rækker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez une bibliothèque dans Vos bibliothèques pour lui donner ses propres rangées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включите медиатеку в разделе «Ваши медиатеки», чтобы у неё появились собственные строки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapněte knihovnu v části Vaše knihovny, aby měla vlastní řádky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiviere eine Medienbibliothek unter „Deine Bibliotheken“, damit sie eigene Reihen erhält."
          }
        },
        "it": {
