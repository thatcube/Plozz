    },
    "These are signed in on your iPad or Apple TV. To use them here without retyping anything, tap “Set up this device from another” below and confirm on that device.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze zijn aangemeld op je iPad of Apple TV. Tik hieronder op “Dit apparaat instellen vanaf een ander apparaat” om ze hier te gebruiken zonder iets opnieuw te typen, en bevestig op dat apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Te konta są zalogowane na iPadzie lub Apple TV. Aby użyć ich tutaj bez ponownego wpisywania danych, stuknij poniżej „Skonfiguruj to urządzenie z innego urządzenia” i potwierdź na tamtym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eles já estão conectados no seu iPad ou Apple TV. Para usá-los aqui sem digitar tudo de novo, toque em “Configurar este dispositivo a partir de outro” abaixo e confirme nesse dispositivo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disse er logget ind på din iPad eller Apple TV. For at bruge dem her uden at skrive noget igen skal du trykke på “Opsæt denne enhed fra en anden” nedenfor og bekræfte på den enhed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces comptes sont connectés sur votre iPad ou Apple TV. Pour les utiliser ici sans rien ressaisir, touchez « Configurer cet appareil à partir d’un autre » ci-dessous, puis confirmez sur cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для них уже выполнен вход на вашем iPad или Apple TV. Чтобы использовать их здесь без повторного ввода, нажмите ниже «Настроить это устройство с другого» и подтвердите на том устройстве."
          }
        }
      }
    },
    "These servers are set up on another device on your iCloud account. Sign in to watch them here — your login stays private to each device.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze servers zijn ingesteld op een ander apparaat met jouw iCloud-account. Meld je aan om hier te kijken — je aanmelding blijft privé per apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Te serwery są skonfigurowane na innym urządzeniu na koncie iCloud. Zaloguj się, aby oglądać je tutaj — dane logowania pozostają prywatne na każdym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estes servidores estão configurados em outro dispositivo da sua conta do iCloud. Faça login para assistir aqui — seu acesso fica privado em cada dispositivo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disse servere er konfigureret på en anden enhed på din iCloud-konto. Log ind for at se dem her — dit login forbliver privat på hver enhed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces serveurs sont configurés sur un autre appareil de votre compte iCloud. Connectez-vous pour les regarder ici — vos identifiants restent privés sur chaque appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эти серверы настроены на другом устройстве в вашей учётной записи iCloud. Войдите, чтобы смотреть их здесь — данные входа остаются отдельными на каждом устройстве."
          }
        }
      }
    },
    "They're rendered as images by the source, so font, colour, size and position controls don't apply.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ze worden door de bron als afbeeldingen weergegeven, dus lettertype-, kleur-, grootte- en positie-instellingen zijn niet van toepassing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Są renderowane przez źródło jako obrazy, więc ustawienia czcionki, koloru, rozmiaru i położenia nie mają zastosowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elas são renderizadas como imagens pela origem, então os controles de fonte, cor, tamanho e posição não se aplicam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De vises som billeder fra kilden, så indstillinger for skrifttype, farve, størrelse og placering gælder ikke."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ils sont rendus sous forme d’images par la source ; les réglages de police, couleur, taille et position ne s’appliquent donc pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Источник отрисовывает их как изображения, поэтому настройки шрифта, цвета, размера и положения не применяются."
          }
        }
      }
    },
