        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat mengesahkan sijil pelayan ini. Jika ia ditandatangani sendiri, luluskan cap jarinya untuk meneruskan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepodarilo sa overiť certifikát tohto servera. Ak je podpísaný sám sebou, schváľte jeho odtlačok a pokračujte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося перевірити сертифікат цього сервера. Якщо він самопідписаний, схваліть його відбиток, щоб продовжити."
          }
        },
        "id": {
          "stringUnit": {
