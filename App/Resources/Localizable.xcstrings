    "PIN-protected users must unlock when their Plozz profile becomes active.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gebruikers met PIN-beveiliging moeten ontgrendelen zodra hun Plozz-profiel actief wordt."
          }
        },
        "pl": {
