          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите тему для этого профиля. Её можно изменить в любой момент."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vyberte pro tento profil motiv. Kdykoli ho můžete změnit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle ein Design für dieses Profil. Du kannst es jederzeit ändern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli un tema per questo profilo. Puoi cambiarlo in qualsiasi momento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Välj ett tema för den här profilen. Du kan ändra det när som helst."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite temu za ovaj profil. Možete je promijeniti u bilo kojem trenutku."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih tema untuk profil ini. Anda boleh menukarnya bila-bila masa."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vyberte tému pre tento profil. Kedykoľvek ju môžete zmeniť."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть тему для цього профілю. Ви можете змінити її будь-коли."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih tema untuk profil ini. Anda bisa mengubahnya kapan saja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu profil için bir tema seçin. Bunu istediğiniz zaman değiştirebilirsiniz."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tria un tema per a aquest perfil. El pots canviar quan vulguis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alege o temă pentru acest profil. O poți schimba oricând."
          }
        }
      }
    },
    "Pick up where you left off, front and centre.": {
      "comment": "Explanation shown under the Continue Watching hero source option in Settings.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ga direct verder waar je was gebleven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wznów od miejsca, w którym przerwano — od razu na pierwszym planie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continue de onde parou, bem em destaque."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortsæt, hvor du slap, helt centralt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retrouvez ce que vous regardiez, bien en évidence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Продолжайте с того места, где остановились, — на самом видном месте."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokračujte tam, kde jste skončili, hned na očích."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Direkt dort weiterschauen, wo du aufgehört hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riprendi da dove avevi interrotto, in primo piano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortsätt där du slutade, i blickfånget."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nastavite tamo gdje ste stali, u prvom planu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambung semula di tempat anda berhenti, di tengah-tengah tumpuan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokračujte tam, kde ste skončili, priamo na očiach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Продовжуйте з місця, де зупинилися, — на найпомітнішому місці."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lanjutkan dari terakhir Anda berhenti, tampil paling depan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“İzlemeye Devam Et” satırını en öne çıkarır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continua on ho vas deixar, en primer pla."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reia de unde ai rămas, chiar în prim-plan."
          }
        }
      }
    },
