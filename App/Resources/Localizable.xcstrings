    "Yes, they match": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja, ze komen overeen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tak, pasują"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sim, correspondem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja, de matcher"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oui, ça correspond"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Да, совпадают"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ano, shodují se"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja, sie stimmen überein"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sì, corrispondono"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja, de stämmer överens"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Da, podudaraju se"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ya, ia sepadan"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Áno, zhodujú sa"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Так, вони збігаються"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ya, cocok"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Evet, eşleşiyorlar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sí, coincideixen"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Da, se potrivesc"
          }
        }
      }
    },
    "You can also scan this from the other device’s iCloud Sync settings.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je kunt dit ook scannen in de instellingen voor iCloud-synchronisatie op het andere apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Można też zeskanować kod w ustawieniach synchronizacji z iCloud na drugim urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você também pode escanear isto nos ajustes de Sincronização do iCloud do outro dispositivo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan også scanne denne fra den anden enheds iCloud Sync-indstillinger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez aussi le scanner depuis les réglages de synchronisation iCloud de l’autre appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы также можете отсканировать этот код в настройках синхронизации iCloud на другом устройстве."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Můžete ho také naskenovat z nastavení Synchronizace s iCloudem na druhém zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kannst dies auch in den Einstellungen zur iCloud-Synchronisierung des anderen Geräts scannen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puoi scansionarlo anche dalle impostazioni di Sincronizzazione iCloud sull’altro dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan även skanna detta från inställningarna för iCloud-synkronisering på den andra enheten."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To možete skenirati i iz postavki Sinkronizacije s iCloudom na drugom uređaju."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda juga boleh mengimbas ini daripada tetapan Penyegerakan iCloud peranti lain."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toto môžete naskenovať aj z nastavení Synchronizácie s iCloudom na druhom zariadení."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ви також можете відсканувати це в налаштуваннях синхронізації iCloud на іншому пристрої."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda juga bisa memindainya dari pengaturan Sinkronisasi iCloud di perangkat lain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunu diğer aygıtın iCloud eşzamanlama ayarlarından da tarayabilirsiniz."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "També pots escanejar-ho des de la configuració de sincronització d'iCloud de l'altre dispositiu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poți scana acest cod și din setările Sincronizare iCloud ale celuilalt dispozitiv."
          }
        }
      }
    },
    "You can change these choices later in Settings.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je kunt deze keuzes later wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Te wybory można później zmienić w Ustawieniach."
