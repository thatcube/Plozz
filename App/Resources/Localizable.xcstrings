    "You've made changes that haven't been saved. Going back now will lose them.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je hebt wijzigingen aangebracht die niet zijn opgeslagen. Als je nu teruggaat, gaan ze verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wprowadzono niezapisane zmiany. Powrót spowoduje ich utratę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você fez alterações que ainda não foram salvas. Se voltar agora, vai perdê-las."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du har foretaget ændringer, der ikke er gemt. Går du tilbage nu, mister du dem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez effectué des modifications qui n’ont pas été enregistrées. Si vous revenez en arrière maintenant, elles seront perdues."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У вас есть несохранённые изменения. Если вернуться сейчас, они будут потеряны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Provedli jste změny, které nebyly uloženy. Když se teď vrátíte, ztratí se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast Änderungen vorgenommen, die noch nicht gesichert wurden. Wenn du jetzt zurückgehst, gehen sie verloren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hai apportato modifiche non salvate. Tornando indietro ora le perderai."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du har gjort ändringar som inte har sparats. Om du går tillbaka nu förloras de."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napravili ste promjene koje nisu spremljene. Ako se sada vratite, izgubit ćete ih."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda telah membuat perubahan yang belum disimpan. Kembali sekarang akan menghilangkannya."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Urobili ste zmeny, ktoré neboli uložené. Ak sa teraz vrátite, stratíte ich."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ви зробили зміни, які не були збережені. Повернення назад зараз їх втратить."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda punya perubahan yang belum disimpan. Jika kembali sekarang, perubahan itu akan hilang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaydedilmemiş değişiklikler yaptınız. Şimdi geri dönerseniz bunlar kaybolacak."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Has fet canvis que no s'han desat. Si tornes enrere ara, es perdran."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ai făcut modificări care nu au fost salvate. Dacă revii acum, le vei pierde."
          }
        }
      }
    },
