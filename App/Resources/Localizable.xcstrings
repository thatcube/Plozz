    "The media server returned HTTP %lld instead of a media file.": {
      "comment": "Error message for a failed iOS background download when the server responds with an HTTP status instead of media data. %lld is the HTTP status code.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De mediaserver gaf HTTP %lld terug in plaats van een mediabestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Serwer multimediów zwrócił HTTP %lld zamiast pliku multimedialnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O servidor de mídia retornou HTTP %lld em vez de um arquivo de mídia."
          }
        },
        "da": {
