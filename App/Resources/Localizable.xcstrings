    "%@ subtitles are rendered as images and can’t be restyled.": {
      "comment": "Secondary text in the iOS player subtitle Appearance section when the selected subtitle track is bitmap-based. %@ is the subtitle format name, such as PGS or VobSub.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-ondertitels worden weergegeven als afbeeldingen en kunnen niet worden aangepast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napisy %@ są renderowane jako obrazy i nie można zmienić ich stylu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As legendas %@ são renderizadas como imagens e não podem ter o estilo alterado."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-undertekster gengives som billeder, og deres udseende kan ikke ændres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sous-titres %@ sont rendus sous forme d’images et ne peuvent pas être personnalisés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Субтитры %@ отображаются как изображения, и их оформление нельзя изменить."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Titulky %@ se vykreslují jako obrázky a nelze změnit jejich styl."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-Untertitel werden als Bilder dargestellt und lassen sich nicht anpassen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I sottotitoli %@ sono visualizzati come immagini e non possono essere personalizzati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-undertexter visas som bilder och kan inte anpassas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ titlovi prikazuju se kao slike i ne mogu se stilizirati."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sari kata %@ dipaparkan sebagai imej dan tidak boleh diubah gayanya."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Titulky %@ sa vykresľujú ako obrázky a ich štýl sa nedá zmeniť."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Субтитри %@ показуються як зображення, тому змінити їх стиль неможливо."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Subtitle %@ dirender sebagai gambar dan gayanya tidak dapat diubah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ altyazıları görüntü olarak işlenir ve yeniden biçimlendirilemez."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els subtítols %@ es renderitzen com a imatges i no es poden personalitzar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Subtitrările %@ sunt randate ca imagini și nu pot fi restilizate."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כתוביות %@ מוצגות כתמונות ולא ניתן לעצב אותן מחדש."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podnapisi %@ so upodobljeni kot slike in njihovega sloga ni mogoče spremeniti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คำบรรยาย %@ แสดงผลเป็นรูปภาพและไม่สามารถปรับแต่งสไตล์ได้"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Субтитрите %@ се показват като изображения и стилът им не може да се променя."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tekstitykset näytetään kuvina, joten niiden ulkoasua ei voi muuttaa (muoto: %@)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-undertekster gjengis som bilder, og deres utseende kan ikke endres."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 字幕已渲染为图像，无法重新样式化。"
          }
        }
      }
    },
