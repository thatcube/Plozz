            "value": "%1$@ af %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ sur %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ из %2$@"
          }
        }
      }
    },
    "%@ rating %@": {
      "comment": "Accessibility label for one rating badge in a ratings row. %@ is the rating source name, and the second %@ is the displayed score.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ rating %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-beoordeling: %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ocena %1$@: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nota %2$@ no %1$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-bedømmelse: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Note %2$@ de %1$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рейтинг %1$@: %2$@"
          }
        }
      }
    },
    "%@ share": {
      "comment": "Subtitle in server details for a direct network share connection. %@ is the share transport name, such as SMB or WebDAV.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-share"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "udział %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "compartilhamento via %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-deling"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "partage %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "сетевой ресурс %@"
          }
        }
      }
    },
    "%@ subtitles are rendered as images and can’t be restyled.": {
      "comment": "Secondary text in the iOS player subtitle Appearance section when the selected subtitle track is bitmap-based. %@ is the subtitle format name, such as PGS or VobSub.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-ondertitels worden weergegeven als afbeeldingen en kunnen niet worden aangepast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napisy %@ są renderowane jako obrazy i nie można zmienić ich stylu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As legendas %@ são renderizadas como imagens e não podem ter o estilo alterado."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-undertekster gengives som billeder, og deres udseende kan ikke ændres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sous-titres %@ sont rendus sous forme d’images et ne peuvent pas être personnalisés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Субтитры %@ отображаются как изображения, и их оформление нельзя изменить."
          }
        }
      }
    },
    "%@ subtitles can't be restyled": {
      "comment": "Headline on the tvOS subtitle style screen when the current subtitle track is bitmap-based and styling controls are unavailable. %@ is the subtitle format name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-ondertitels kunnen niet worden aangepast"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można zmienić stylu napisów %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não é possível alterar o estilo das legendas %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-underteksters udseende kan ikke ændres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sous-titres %@ ne peuvent pas être personnalisés"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оформление субтитров %@ изменить нельзя"
          }
        }
      }
    },
    "%@ support is coming soon": {
      "comment": "Headline on the iOS placeholder screen for a detected share protocol that Plozz does not support yet. %@ is the transport name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ondersteuning voor %@ komt binnenkort"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obsługa %@ już wkrótce"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suporte a %@ em breve"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Understøttelse af %@ kommer snart"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La prise en charge de %@ arrive bientôt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поддержка %@ скоро появится"
          }
        }
      }
    },
    "%@ support is on the way. This device was detected, but Plozz can’t connect over %@ just yet.": {
      "comment": "Body text on the tvOS coming-soon screen for a detected network share protocol. The first %@ is the transport name in the sentence subject, and the second %@ is the same transport name after 'over'.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ support is on the way. This device was detected, but Plozz can’t connect over %2$@ just yet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ondersteuning voor %1$@ komt eraan. Dit apparaat is gedetecteerd, maar Plozz kan nog geen verbinding maken via %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obsługa %1$@ jest już w drodze. To urządzenie zostało wykryte, ale Plozz nie może się jeszcze połączyć przez %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Em breve, haverá suporte a %1$@. Este dispositivo foi detectado, mas o Plozz ainda não consegue se conectar por %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Understøttelse af %1$@ er på vej. Denne enhed blev fundet, men Plozz kan endnu ikke oprette forbindelse via %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La prise en charge de %1$@ arrive. Cet appareil a été détecté, mais Plozz ne peut pas encore se connecter via %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поддержка %1$@ уже в пути. Это устройство обнаружено, но Plozz пока не может подключаться по %2$@."
          }
        }
      }
    },
    "%@ used by downloads": {
      "comment": "iOS Downloads storage summary showing how much device space downloaded media currently uses. %@ is the formatted size.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ in gebruik door downloads"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pobrane pliki zajmują %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
