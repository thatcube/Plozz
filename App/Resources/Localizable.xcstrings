    "No servers found yet. Make sure the server is on and that Plozz is allowed Local Network access, then rescan — or enter an address below.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog geen servers gevonden. Zorg dat de server aanstaat en dat Plozz toegang heeft tot het lokale netwerk, scan dan opnieuw — of voer hieronder een adres in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie znaleziono jeszcze żadnych serwerów. Upewnij się, że serwer jest włączony i że Plozz ma dostęp do sieci lokalnej, a potem zeskanuj ponownie — albo wpisz adres poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum servidor encontrado ainda. Verifique se o servidor está ligado e se o Plozz tem acesso à Rede Local, depois faça uma nova busca — ou digite um endereço abaixo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der er endnu ikke fundet nogen servere. Sørg for, at serveren er tændt, og at Plozz har adgang til det lokale netværk, og genscan derefter — eller indtast en adresse nedenfor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun serveur trouvé pour le moment. Vérifiez que le serveur est allumé et que Plozz est autorisé à accéder au réseau local, puis relancez l’analyse — ou saisissez une adresse ci-dessous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Серверы пока не найдены. Убедитесь, что сервер включён и у Plozz есть доступ к локальной сети, затем выполните повторное сканирование — или введите адрес ниже."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatím nebyly nalezeny žádné servery. Ujistěte se, že je server zapnutý a že má Plozz povolený přístup k místní síti, pak spusťte nové hledání — nebo níže zadejte adresu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch keine Server gefunden. Stelle sicher, dass der Server eingeschaltet ist und Plozz auf das lokale Netzwerk zugreifen darf, und suche dann erneut — oder gib unten eine Adresse ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun server trovato. Assicurati che il server sia acceso e che Plozz abbia accesso a Rete locale, quindi esegui di nuovo la scansione oppure inserisci un indirizzo qui sotto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inga servrar hittades. Kontrollera att servern är påslagen och att Plozz har åtkomst till det lokala nätverket. Sök sedan igen eller ange en adress nedan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još nisu pronađeni poslužitelji. Provjerite je li poslužitelj uključen i ima li Plozz dopušten pristup lokalnoj mreži, zatim ponovno skenirajte — ili unesite adresu ispod."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada pelayan ditemui lagi. Pastikan pelayan dihidupkan dan Plozz dibenarkan akses Rangkaian Setempat, kemudian imbas semula — atau masukkan alamat di bawah."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatiaľ sa nenašli žiadne servery. Uistite sa, že je server zapnutý a že má Plozz povolený prístup k miestnej sieti, potom spustite nové vyhľadávanie — alebo nižšie zadajte adresu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Серверів ще не знайдено. Переконайтеся, що сервер увімкнено, а Plozz має доступ до локальної мережі, потім повторіть сканування або введіть адресу нижче."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum ada server yang ditemukan. Pastikan server menyala dan Plozz diizinkan mengakses Jaringan Lokal, lalu pindai ulang — atau masukkan alamat di bawah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henüz sunucu bulunamadı. Sunucunun açık olduğundan ve Plozz’a Yerel Ağ erişimi verildiğinden emin olun, ardından yeniden tarayın — veya aşağıya bir adres girin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encara no s'ha trobat cap servidor. Comprova que el servidor estigui engegat i que Plozz tingui accés a la xarxa local, i torna a escanejar — o introdueix una adreça a sota."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încă nu au fost găsite servere. Asigură-te că serverul este pornit și că Plozz are acces la Rețea locală, apoi scanează din nou — sau introdu mai jos o adresă."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "טרם נמצאו שרתים. ודא שהשרת פועל ושל-Plozz יש הרשאת גישה לרשת מקומית, ולאחר מכן סרוק שוב — או הזן כתובת למטה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strežniki še niso bili najdeni. Prepričajte se, da je strežnik vklopljen in da ima Plozz dovoljen dostop do lokalnega omrežja, nato znova preiščite — ali pa spodaj vnesite naslov."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่พบเซิร์ฟเวอร์ ตรวจสอบให้แน่ใจว่าเซิร์ฟเวอร์เปิดอยู่และ Plozz ได้รับอนุญาตให้เข้าถึงเครือข่ายภายในแล้ว จากนั้นสแกนอีกครั้ง — หรือป้อนที่อยู่ด้านล่าง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все още няма намерени сървъри. Уверете се, че сървърът е включен и че Plozz има достъп до локалната мрежа, след което сканирайте отново — или въведете адрес по-долу."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palvelimia ei ole vielä löytynyt. Varmista, että palvelin on päällä ja että Plozzilla on lupa käyttää lähiverkkoa. Etsi sitten uudelleen tai syötä osoite alle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen servere er funnet ennå. Kontroller at serveren er slått på og at Plozz har tilgang til det lokale nettverket, og skann på nytt — eller skriv inn en adresse nedenfor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚未发现服务器。请确保服务器已开启，并允许 Plozz 访问本地网络，然后重新扫描 — 或在下方输入地址。"
          }
        }
      }
    },
    "No servers found yet. Make sure your server is on and that Plozz is allowed Local Network access (tvOS Settings ▸ General ▸ Privacy), then rescan — or enter an address below.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog geen servers gevonden. Zorg dat je server aanstaat en dat Plozz toegang heeft tot het lokale netwerk (tvOS-instellingen ▸ Algemeen ▸ Privacy), scan dan opnieuw — of voer hieronder een adres in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie znaleziono jeszcze żadnych serwerów. Upewnij się, że serwer jest włączony i że Plozz ma dostęp do sieci lokalnej (Ustawienia tvOS ▸ Ogólne ▸ Prywatność), a potem zeskanuj ponownie — albo wpisz adres poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum servidor encontrado ainda. Verifique se o servidor está ligado e se o Plozz tem acesso à Rede Local (Ajustes do tvOS ▸ Geral ▸ Privacidade), depois faça uma nova busca — ou digite um endereço abaixo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der er endnu ikke fundet nogen servere. Sørg for, at din server er tændt, og at Plozz har adgang til det lokale netværk (tvOS-indstillinger ▸ Generelt ▸ Privatliv), og genscan derefter — eller indtast en adresse nedenfor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun serveur trouvé pour le moment. Vérifiez que votre serveur est allumé et que Plozz est autorisé à accéder au réseau local (Réglages tvOS ▸ Général ▸ Confidentialité), puis relancez l’analyse — ou saisissez une adresse ci-dessous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Серверы пока не найдены. Убедитесь, что ваш сервер включён и у Plozz есть доступ к локальной сети (Настройки tvOS ▸ Основные ▸ Конфиденциальность), затем выполните повторное сканирование — или введите адрес ниже."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatím nebyly nalezeny žádné servery. Ujistěte se, že je váš server zapnutý a že má Plozz povolený přístup k místní síti (Nastavení tvOS ▸ Obecné ▸ Soukromí), pak spusťte nové hledání — nebo níže zadejte adresu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch keine Server gefunden. Stelle sicher, dass dein Server eingeschaltet ist und Plozz auf das lokale Netzwerk zugreifen darf (tvOS-Einstellungen ▸ Allgemein ▸ Datenschutz), und suche dann erneut — oder gib unten eine Adresse ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun server trovato. Assicurati che il server sia acceso e che Plozz abbia accesso a Rete locale (Impostazioni tvOS ▸ Generali ▸ Privacy), quindi esegui di nuovo la scansione oppure inserisci un indirizzo qui sotto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inga servrar hittades. Kontrollera att servern är påslagen och att Plozz har åtkomst till det lokala nätverket (tvOS Inställningar ▸ Allmänt ▸ Integritet). Sök sedan igen eller ange en adress nedan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još nisu pronađeni poslužitelji. Provjerite je li vaš poslužitelj uključen i ima li Plozz dopušten pristup lokalnoj mreži (tvOS Postavke ▸ Općenito ▸ Privatnost), zatim ponovno skenirajte — ili unesite adresu ispod."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada pelayan ditemui lagi. Pastikan pelayan anda dihidupkan dan Plozz dibenarkan akses Rangkaian Setempat (tvOS Tetapan ▸ Umum ▸ Privasi), kemudian imbas semula — atau masukkan alamat di bawah."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatiaľ sa nenašli žiadne servery. Uistite sa, že je váš server zapnutý a že má Plozz povolený prístup k miestnej sieti (Nastavenia tvOS ▸ Všeobecné ▸ Súkromie), potom spustite nové vyhľadávanie — alebo nižšie zadajte adresu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Серверів ще не знайдено. Переконайтеся, що ваш сервер увімкнено, а Plozz має доступ до локальної мережі («Налаштування tvOS» ▸ «Загальні» ▸ «Конфіденційність»), потім повторіть сканування або введіть адресу нижче."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum ada server yang ditemukan. Pastikan server Anda menyala dan Plozz diizinkan mengakses Jaringan Lokal (Pengaturan tvOS ▸ Umum ▸ Privasi), lalu pindai ulang — atau masukkan alamat di bawah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henüz sunucu bulunamadı. Sunucunuzun açık olduğundan ve Plozz’a Yerel Ağ erişimi verildiğinden (tvOS Ayarlar ▸ Genel ▸ Gizlilik) emin olun, ardından yeniden tarayın — veya aşağıya bir adres girin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encara no s'ha trobat cap servidor. Comprova que el teu servidor estigui engegat i que Plozz tingui accés a la xarxa local (Configuració de tvOS ▸ General ▸ Privadesa), i torna a escanejar — o introdueix una adreça a sota."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încă nu au fost găsite servere. Asigură-te că serverul este pornit și că Plozz are acces la Rețea locală (Setări tvOS ▸ General ▸ Confidențialitate), apoi scanează din nou — sau introdu mai jos o adresă."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "טרם נמצאו שרתים. ודא שהשרת שלך פועל ושל-Plozz יש הרשאת גישה לרשת מקומית (הגדרות tvOS ▸ כללי ▸ פרטיות), ולאחר מכן סרוק שוב — או הזן כתובת למטה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strežniki še niso bili najdeni. Prepričajte se, da je vaš strežnik vklopljen in da ima Plozz dovoljen dostop do lokalnega omrežja (tvOS Nastavitve ▸ Splošno ▸ Zasebnost), nato znova preiščite — ali pa spodaj vnesite naslov."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่พบเซิร์ฟเวอร์ ตรวจสอบให้แน่ใจว่าเซิร์ฟเวอร์ของคุณเปิดอยู่และ Plozz ได้รับอนุญาตให้เข้าถึงเครือข่ายภายในแล้ว (การตั้งค่า tvOS ▸ ทั่วไป ▸ ความเป็นส่วนตัว) จากนั้นสแกนอีกครั้ง — หรือป้อนที่อยู่ด้านล่าง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все още няма намерени сървъри. Уверете се, че сървърът е включен и че Plozz има достъп до локалната мрежа (Настройки на tvOS ▸ Основни ▸ Поверителност), след което сканирайте отново — или въведете адрес по-долу."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palvelimia ei ole vielä löytynyt. Varmista, että palvelin on päällä ja että Plozzilla on lupa käyttää lähiverkkoa (tvOS:n Asetukset ▸ Yleiset ▸ Tietosuoja). Etsi sitten uudelleen tai syötä osoite alle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen servere er funnet ennå. Kontroller at serveren er slått på og at Plozz har tilgang til det lokale nettverket (tvOS-innstillinger ▸ Generelt ▸ Personvern), og skann på nytt — eller skriv inn en adresse nedenfor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚未发现服务器。请确保服务器已开启，并允许 Plozz 访问本地网络（tvOS 设置 ▸ 通用 ▸ 隐私），然后重新扫描 — 或在下方输入地址。"
          }
        }
      }
    },
