        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synchronisiere deinen Wiedergabeverlauf und behalte mit Simkl im Blick, was du als Nächstes ansehen willst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
