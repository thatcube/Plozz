    "PIN-protected users must unlock when their Plozz profile becomes active.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gebruikers met PIN-beveiliging moeten ontgrendelen zodra hun Plozz-profiel actief wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Po aktywowaniu profilu Plozz użytkownik chroniony kodem PIN musi podać ten kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usuários protegidos por PIN precisam desbloquear quando o perfil do Plozz ficar ativo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PIN-beskyttede brugere skal låses op, når deres Plozz-profil bliver aktiv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les utilisateurs protégés par un code PIN doivent se déverrouiller lorsque leur profil Plozz devient actif."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Если профиль Plozz защищён PIN, при его активации потребуется разблокировка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uživatelé chránění PINem se musí odemknout, když se jejich profil Plozz aktivuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PIN-geschützte Benutzer müssen entsperren, sobald ihr Plozz-Profil aktiv wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli utenti protetti da PIN devono inserire il PIN quando il loro profilo Plozz diventa attivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PIN-skyddade användare måste ange sin PIN-kod när deras Plozz-profil aktiveras."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Korisnici zaštićeni PIN-om moraju se otključati kada njihov Plozz profil postane aktivan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pengguna yang dilindungi PIN mesti membuka kunci apabila profil Plozz mereka menjadi aktif."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Používatelia chránení PINom sa musia odomknúť, keď sa ich profil Plozz aktivuje."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Користувачі, захищені PIN-кодом, мають розблокуватися, коли їхній профіль Plozz стає активним."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pengguna yang dilindungi PIN harus membuka kunci saat profil Plozz mereka menjadi aktif."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PIN korumalı kullanıcıların, Plozz profili etkin olduğunda kilidi açması gerekir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els usuaris protegits amb PIN han de desbloquejar-se quan el seu perfil de Plozz s'activa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilizatorii protejați cu PIN trebuie deblocați când profilul lor Plozz devine activ."
          }
        }
      }
    },
