    "This build has no crash-reporting endpoint configured, so nothing can be sent. Crash reporting is available in TestFlight and release builds.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voor deze build is geen eindpunt voor crashrapportage geconfigureerd, dus er kan niets worden verzonden. Crashrapportage is beschikbaar in TestFlight- en release-builds."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "W tej kompilacji nie skonfigurowano punktu końcowego raportowania awarii, więc nie można niczego wysłać. Raportowanie awarii jest dostępne w kompilacjach TestFlight i wydaniach produkcyjnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta compilação não tem um serviço de relatório de falhas configurado, portanto nada pode ser enviado. O relatório de falhas está disponível nas compilações do TestFlight e de lançamento."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne build har intet slutpunkt til fejlrapportering, så der kan ikke sendes noget. Fejlrapportering er tilgængelig i TestFlight- og release-builds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette version ne comporte aucun point de terminaison pour le signalement des plantages ; aucun envoi n’est donc possible. Le signalement des plantages est disponible dans TestFlight et les versions publiques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В этой сборке не настроена конечная точка для отправки сбоев, поэтому отправить ничего нельзя. Отчёты о сбоях доступны в сборках TestFlight и релизных сборках."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toto sestavení nemá nakonfigurovaný koncový bod pro hlášení pádů, takže nelze nic odeslat. Hlášení pádů je k dispozici v TestFlightu a produkčních sestaveních."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für diesen Build ist kein Endpunkt für Absturzberichte konfiguriert, daher kann nichts gesendet werden. Absturzberichte sind in TestFlight- und Release-Builds verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In questa build non è configurato alcun endpoint per le segnalazioni di crash, quindi non è possibile inviare nulla. La segnalazione dei crash è disponibile nelle build di TestFlight e nelle versioni di rilascio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den här versionen saknar en konfigurerad slutpunkt för kraschrapportering, så inget kan skickas. Kraschrapportering är tillgänglig i TestFlight- och utgåveversioner."
          }
        }
      }
    },
