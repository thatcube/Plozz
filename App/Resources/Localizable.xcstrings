          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les profils gardent séparés l’accueil, l’historique de lecture, les réglages et les téléchargements de chacun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У каждого человека будут отдельные Главная, история просмотров, настройки и загрузки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profily uchovávají obrazovku Domů, historii sledování, nastavení a stažené položky každého uživatele odděleně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profile trennen die Startseite, den Wiedergabeverlauf, die Einstellungen und die Downloads jeder Person."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I profili mantengono separati Home, cronologia di visione, impostazioni e download di ogni persona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Med profiler får varje person ett eget Hem samt egen tittarhistorik, egna inställningar och egna nedladdningar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profili razdvajaju Početnu, povijest gledanja, postavke i preuzimanja svake osobe."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profil mengasingkan Laman Utama, sejarah tontonan, tetapan dan muat turun bagi setiap orang."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profily uchovávajú obrazovku Domov, históriu pozerania, nastavenia a stiahnuté položky každého používateľa oddelene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Профілі зберігають Головну, історію перегляду, налаштування й завантаження кожної людини окремо."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profil memisahkan Beranda, riwayat tontonan, pengaturan, dan unduhan setiap orang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiller her kişinin Ana Sayfa’sını, izleme geçmişini, ayarlarını ve indirmelerini ayrı tutar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els perfils mantenen separats l'Inici, l'historial de visualització, la configuració i les baixades de cada persona."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profilurile păstrează separat pentru fiecare persoană Acasă, istoricul de vizionare, setările și descărcările."
          }
        }
      }
    },
    "Profiles stay enabled while more than one household profile exists.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profielen blijven ingeschakeld zolang er meer dan één huishoudprofiel bestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profile pozostają włączone, gdy istnieje więcej niż jeden profil domowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os perfis permanecem ativados enquanto houver mais de um perfil no grupo familiar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler forbliver aktiveret, så længe der findes mere end én husstandsprofil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les profils restent activés tant qu’il existe plus d’un profil dans le foyer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Профили остаются включёнными, пока существует более одного домашнего профиля."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profily zůstanou zapnuté, dokud existuje více než jeden domácí profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profile bleiben aktiviert, solange mehr als ein Haushaltsprofil vorhanden ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I profili restano attivi finché esiste più di un profilo nel nucleo familiare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler förblir aktiverade så länge det finns fler än en hushållsprofil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profili ostaju uključeni dok postoji više od jednog kućnog profila."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profil kekal diaktifkan selagi lebih daripada satu profil isi rumah wujud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profily zostanú zapnuté, kým existuje viac než jeden profil domácnosti."
          }
        },
