    "Turn on Share Crash Reports below to enable this. Your recent activity is then sent anonymously — no logins, tokens, servers, or titles.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel hieronder Crashrapporten delen in om dit mogelijk te maken. Je recente activiteit wordt dan anoniem verzonden — geen aanmeldgegevens, tokens, servers of titels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby to włączyć, włącz poniżej opcję Udostępniaj raporty o awariach. Ostatnia aktywność zostanie wtedy wysłana anonimowo — bez danych logowania, tokenów, serwerów ani tytułów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative Compartilhar relatórios de falha abaixo para habilitar isso. Sua atividade recente será enviada anonimamente — sem logins, tokens, servidores nem títulos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå Del fejlrapporter til nedenfor for at aktivere dette. Din seneste aktivitet sendes derefter anonymt — ingen logins, tokens, servere eller titler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez ci-dessous Partager les rapports de plantage pour l’activer. Votre activité récente sera ensuite envoyée anonymement — sans identifiants, jetons, serveurs ni titres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чтобы включить это, ниже включите «Отправлять отчёты о сбоях». После этого ваша недавняя активность будет отправляться анонимно — без данных для входа, токенов, серверов и названий материалов."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokud to chcete povolit, níže zapněte Sdílet hlášení pádů. Vaše nedávná aktivita se pak odešle anonymně — bez přihlášení, tokenů, serverů a titulů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiviere unten „Absturzberichte teilen“, um dies zu ermöglichen. Deine letzten Aktivitäten werden dann anonym gesendet — keine Anmeldedaten, Tokens, Server oder Titel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attiva Condividi segnalazioni di crash qui sotto per abilitare la funzione. Le attività recenti verranno inviate anonimamente: senza dati di accesso, token, server o titoli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå på Dela kraschrapporter nedan. Din senaste aktivitet skickas då anonymt utan inloggningar, åtkomsttoken, servrar eller titlar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uključite Dijeli izvješća o rušenjima u nastavku da biste to omogućili. Tada će se vaša nedavna aktivnost slati anonimno — bez prijava, tokena, poslužitelja ili naslova."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hidupkan Kongsi Laporan Ranap di bawah untuk mendayakan ini. Aktiviti terkini anda kemudian dihantar secara tanpa nama — tiada log masuk, token, pelayan, atau tajuk."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nižšie zapnite Zdieľať hlásenia o pádoch, aby sa to povolilo. Vaša nedávna aktivita sa potom odošle anonymne — bez prihlásení, tokenov, serverov či titulov."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Увімкніть нижче «Надсилати звіти про збої». Після цього останню активність буде надіслано анонімно — без даних входу, токенів, серверів і назв контенту."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktifkan Bagikan Laporan Kerusakan di bawah untuk mengaktifkannya. Aktivitas terbaru Anda lalu dikirim secara anonim — tanpa login, token, server, atau judul."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunu etkinleştirmek için aşağıdaki “Çökme raporlarını paylaş” seçeneğini açın. Son etkinliğiniz anonim olarak gönderilir; oturum bilgileri, belirteçler, sunucular ve yapım adları gönderilmez."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activa Comparteix informes de fallades a continuació per habilitar-ho. Llavors s'enviarà la teva activitat recent de manera anònima — sense inicis de sessió, testimonis, servidors ni títols."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activează mai jos opțiunea Trimite rapoarte de blocare pentru a activa această funcție. Activitatea ta recentă va fi trimisă anonim — fără autentificări, tokenuri, servere sau titluri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הפעל את שיתוף דוחות קריסה למטה כדי לאפשר זאת. הפעילות האחרונה שלך תישלח אז באופן אנונימי — ללא פרטי כניסה, טוקנים, שרתים או כותרים."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vklopite spodnje Deli poročila o zrušitvah, da to omogočite. Vaša nedavna dejavnost se nato pošlje anonimno — brez prijav, žetonov, strežnikov ali naslovov."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด “แชร์รายงานข้อขัดข้อง” ด้านล่างเพื่อเปิดใช้งาน จากนั้นกิจกรรมล่าสุดของคุณจะถูกส่งแบบไม่ระบุตัวตน — ไม่มีข้อมูลการลงชื่อเข้าใช้ โทเค็น เซิร์ฟเวอร์ หรือชื่อเรื่อง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включете Споделяне на доклади за сривове по-долу, за да активирате това. Вашата скорошна дейност се изпраща анонимно — без влизания, токени, сървъри или заглавия."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ota alta käyttöön Jaa kaatumisraportit, jotta voit käyttää tätä. Viimeaikainen toiminta lähetetään nimettömänä — mukana ei ole kirjautumistietoja, pääsytunnisteita, palvelimia eikä nimikkeitä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå på Del feilrapporter nedenfor for å aktivere dette. Din siste aktivitet sendes deretter anonymt — ingen pålogginger, tokens, servere eller titler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在下方开启“分享崩溃报告”以启用此功能。您的近期活动将被匿名发送——无需登录信息、令牌、服务器或标题。"
          }
        }
      }
    },
    "Turn on Share Crash Reports in Help & Diagnostics to enable this. Your recent activity is then sent anonymously — no logins, tokens, servers, or titles.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel Crashrapporten delen in bij Help en diagnostiek om dit mogelijk te maken. Je recente activiteit wordt dan anoniem verzonden — geen aanmeldgegevens, tokens, servers of titels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby to włączyć, włącz opcję Udostępniaj raporty o awariach w sekcji Pomoc i diagnostyka. Ostatnia aktywność zostanie wtedy wysłana anonimowo — bez danych logowania, tokenów, serwerów ani tytułów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative Compartilhar relatórios de falha em Ajuda e Diagnóstico para habilitar isso. Sua atividade recente será enviada anonimamente — sem logins, tokens, servidores nem títulos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå Del fejlrapporter til i Hjælp & Diagnostik for at aktivere dette. Din seneste aktivitet sendes derefter anonymt — ingen logins, tokens, servere eller titler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez Partager les rapports de plantage dans Aide et diagnostics pour l’activer. Votre activité récente sera ensuite envoyée anonymement — sans identifiants, jetons, serveurs ni titres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чтобы включить это, включите «Отправлять отчёты о сбоях» в разделе «Помощь и диагностика». После этого ваша недавняя активность будет отправляться анонимно — без данных для входа, токенов, серверов и названий материалов."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "V části Nápověda a diagnostika zapněte Sdílet hlášení pádů. Vaše nedávná aktivita se pak odešle anonymně — bez přihlášení, tokenů, serverů a titulů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiviere „Absturzberichte teilen“ unter „Hilfe & Diagnose“, um dies zu ermöglichen. Deine letzten Aktivitäten werden dann anonym gesendet — keine Anmeldedaten, Tokens, Server oder Titel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attiva Condividi segnalazioni di crash in Assistenza e diagnostica per abilitare la funzione. Le attività recenti verranno inviate anonimamente: senza dati di accesso, token, server o titoli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå på Dela kraschrapporter under Hjälp och diagnostik. Din senaste aktivitet skickas då anonymt utan inloggningar, åtkomsttoken, servrar eller titlar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uključite Dijeli izvješća o rušenjima u Pomoći i dijagnostici da biste to omogućili. Tada će se vaša nedavna aktivnost slati anonimno — bez prijava, tokena, poslužitelja ili naslova."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hidupkan Kongsi Laporan Ranap dalam Bantuan & Diagnostik untuk mendayakan ini. Aktiviti terkini anda kemudian dihantar secara tanpa nama — tiada log masuk, token, pelayan, atau tajuk."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "V časti Pomoc a diagnostika zapnite Zdieľať hlásenia o pádoch, aby sa to povolilo. Vaša nedávna aktivita sa potom odošle anonymne — bez prihlásení, tokenov, serverov či titulov."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Увімкніть «Надсилати звіти про збої» в розділі «Допомога й діагностика». Після цього останню активність буде надіслано анонімно — без даних входу, токенів, серверів і назв контенту."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktifkan Bagikan Laporan Kerusakan di Bantuan & Diagnostik untuk mengaktifkannya. Aktivitas terbaru Anda lalu dikirim secara anonim — tanpa login, token, server, atau judul."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunu etkinleştirmek için Yardım ve tanılama bölümündeki “Çökme raporlarını paylaş” seçeneğini açın. Son etkinliğiniz anonim olarak gönderilir; oturum bilgileri, belirteçler, sunucular ve yapım adları gönderilmez."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activa Comparteix informes de fallades a Ajuda i diagnòstic per habilitar-ho. Llavors s'enviarà la teva activitat recent de manera anònima — sense inicis de sessió, testimonis, servidors ni títols."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activează Trimite rapoarte de blocare în Ajutor și diagnosticare pentru a activa această funcție. Activitatea ta recentă va fi trimisă anonim — fără autentificări, tokenuri, servere sau titluri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הפעל את שיתוף דוחות קריסה בעזרה ואבחון כדי לאפשר זאת. הפעילות האחרונה שלך תישלח אז באופן אנונימי — ללא פרטי כניסה, טוקנים, שרתים או כותרים."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vklopite Deli poročila o zrušitvah v Pomoč in diagnostika, da to omogočite. Vaša nedavna dejavnost se nato pošlje anonimno — brez prijav, žetonov, strežnikov ali naslovov."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด “แชร์รายงานข้อขัดข้อง” ใน ช่วยเหลือและการวินิจฉัย เพื่อเปิดใช้งาน จากนั้นกิจกรรมล่าสุดของคุณจะถูกส่งแบบไม่ระบุตัวตน — ไม่มีข้อมูลการลงชื่อเข้าใช้ โทเค็น เซิร์ฟเวอร์ หรือชื่อเรื่อง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включете Споделяне на доклади за сривове в Помощ и диагностика, за да активирате това. Вашата скорошна дейност се изпраща анонимно — без влизания, токени, сървъри или заглавия."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ota Jaa kaatumisraportit käyttöön kohdassa Ohjeet ja diagnostiikka, jotta voit käyttää tätä. Viimeaikainen toiminta lähetetään nimettömänä — mukana ei ole kirjautumistietoja, pääsytunnisteita, palvelimia eikä nimikkeitä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå på Del feilrapporter i Hjelp og diagnostikk for å aktivere dette. Din siste aktivitet sendes deretter anonymt — ingen pålogginger, tokens, servere eller titler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在“帮助与诊断”中开启“分享崩溃报告”以启用此功能。您的近期活动将被匿名发送——无需登录信息、令牌、服务器或标题。"
          }
        }
      }
    },
    "Turn servers and libraries on or off, and pick who you watch as.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel servers en bibliotheken in of uit, en kies als wie je kijkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Włączaj i wyłączaj serwery oraz biblioteki i wybieraj konto używane do oglądania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative ou desative servidores e bibliotecas e escolha com qual perfil você assiste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå servere og biblioteker til eller fra, og vælg, hvem du ser som."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez ou désactivez les serveurs et les bibliothèques multimédia, et choisissez avec quel profil vous regardez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включайте и выключайте серверы и медиатеки, а также выбирайте, от чьего имени смотреть."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapínejte nebo vypínejte servery a knihovny a vyberte, jako kdo obsah sledujete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schalte Server und Medienbibliotheken ein oder aus und wähle, mit welchem Benutzer du schaust."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attiva o disattiva server e librerie, e scegli con quale utente guardare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå på eller av servrar och bibliotek och välj vilken användare som ska användas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uključite ili isključite poslužitelje i knjižnice te odaberite pod kojim korisnikom gledate."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hidupkan atau matikan pelayan dan pustaka, dan pilih sebagai siapa anda menonton."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapnite alebo vypnite servery a knižnice a vyberte, ako ktorý používateľ chcete pozerať."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Увімкніть або вимкніть сервери й медіатеки та виберіть, від імені кого переглядаєте контент."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktifkan atau nonaktifkan server dan pustaka, lalu pilih profil yang digunakan untuk menonton."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sunucuları ve kitaplıkları açın veya kapatın, ayrıca hangi kullanıcı olarak izlediğinizi seçin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activa o desactiva servidors i biblioteques, i tria amb quin usuari veus el contingut."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activează sau dezactivează serverele și bibliotecile și alege profilul cu care vizionezi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הפעל או כבה שרתים וספריות, ובחר בתור מי אתה צופה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vklopite ali izklopite strežnike in knjižnice ter izberite, kot kdo gledate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดหรือปิดเซิร์ฟเวอร์และไลบรารี แล้วเลือกว่าจะรับชมในฐานะใคร"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включвайте или изключвайте сървъри и медиатеки и избирайте като кой потребител гледате."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ota palvelimet ja kirjastot käyttöön tai pois käytöstä ja valitse, kenenä katsot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå servere og biblioteker på eller av, og velg hvem du ser som."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "开启或关闭服务器和媒体库，并选择您以谁的身份观看。"
          }
        }
      }
    },
