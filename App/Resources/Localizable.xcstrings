          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entre com um usuário do Plex Home ou do Jellyfin que tenha foto de perfil e depois volte para usá-la aqui. Enquanto isso, use um emoji ou símbolo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Log ind på en Plex Home-bruger eller Jellyfin-bruger med et profilbillede, og kom så tilbage for at bruge det her. Indtil da fungerer en emoji eller et symbol fint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez-vous à un utilisateur Plex Home ou Jellyfin ayant une photo de profil, puis revenez ici pour l’utiliser. En attendant, un emoji ou un symbole convient très bien."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Войдите как пользователь Plex Home или Jellyfin с фото профиля, затем вернитесь сюда, чтобы использовать его. А пока отлично подойдут эмодзи или символ."
          }
        }
      }
    },
