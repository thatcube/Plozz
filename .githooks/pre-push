#!/bin/bash
set -euo pipefail

pushes_main=0
while read -r _local_ref _local_oid remote_ref _remote_oid; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    pushes_main=1
  fi
done

if [[ "$pushes_main" != "1" ]]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
export GIT_CONFIG_PARAMETERS="'safe.bareRepository=all'"

delta_file="$(mktemp -t plozz-main-l10n-delta)"
trap 'rm -f "$delta_file"' EXIT

echo "▸ Pre-main localization gate"
tools/l10n-guard.sh
python3 tools/l10n-sync.py --check --quiet
python3 tools/l10n-sync.py --validate-only
python3 tools/l10n-export-source.py "$delta_file" \
  --missing-for nl \
  --check-snapshot
echo "✓ Pre-main localization gate passed."
