    "Requests as the admin; no per-user quota or approval.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vraagt aan als beheerder; geen quotum of goedkeuring per gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wysyła prośby jako administrator; bez limitów i zatwierdzania dla użytkownika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As solicitações serão feitas como administrador, sem cota por usuário nem aprovação."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anmoder som administrator; ingen kvote eller godkendelse pr. bruger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Effectue les demandes en tant qu’administrateur ; aucun quota ni approbation par utilisateur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запросы от имени администратора; без квот и подтверждения для пользователей."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Žádosti jako správce; bez kvót a schvalování pro jednotlivé uživatele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fragt als Admin an; kein Kontingent und keine Freigabe pro Benutzer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Effettua le richieste come amministratore; nessuna quota o approvazione per utente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Begär som admin; ingen kvot eller godkännande per användare."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zahtjevi se šalju kao administrator; nema kvote ni odobravanja po korisniku."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Meminta sebagai admin; tiada kuota atau kelulusan setiap pengguna."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Žiada ako správca; bez kvóty a schvaľovania pre jednotlivých používateľov."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запити надсилаються від імені адміністратора; без окремих квот чи схвалення для користувачів."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permintaan diajukan sebagai admin; tanpa kuota atau persetujuan per pengguna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İstekler yönetici adına gönderilir; kullanıcıya özel kota veya onay uygulanmaz."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sol·licita com a administrador; sense quota ni aprovació per usuari."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicitările se fac ca administrator; fără cotă sau aprobare per utilizator."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מבצע בקשות כמנהל; ללא מכסה או אישור לפי משתמש."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zahteve kot skrbnik; brez kvote ali odobritve na uporabnika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ส่งคำขอในฐานะผู้ดูแลระบบ ไม่มีโควตาหรือการอนุมัติรายผู้ใช้"
