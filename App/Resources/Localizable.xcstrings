    "Deletes the shared iCloud copy and re-uploads it from THIS Apple TV. Other devices keep their own logins. Use only if devices won't converge.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwijdert de gedeelde iCloud-kopie en uploadt deze opnieuw vanaf DEZE Apple TV. Andere apparaten behouden hun eigen aanmeldingen. Gebruik dit alleen als apparaten niet synchroon lopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usuwa współdzieloną kopię iCloud i wysyła ją ponownie z TEGO Apple TV. Inne urządzenia zachowują własne dane logowania. Używaj tylko wtedy, gdy urządzenia nie chcą się zsynchronizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exclui a cópia compartilhada do iCloud e a envia novamente DESTA Apple TV. Os outros dispositivos mantêm os próprios logins. Use somente se os dispositivos não entrarem em sincronia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sletter den delte iCloud-kopi og overfører den igen fra DETTE Apple TV. Andre enheder beholder deres egne logins. Brug kun dette, hvis enhederne ikke synkroniserer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprime la copie iCloud partagée et la téléverse à nouveau depuis CETTE Apple TV. Les autres appareils conservent leurs propres connexions. À utiliser seulement si les appareils ne se synchronisent pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удаляет общую копию в iCloud и заново загружает её с ЭТОГО Apple TV. На других устройствах их собственные входы останутся. Используйте только если устройства не могут синхронизироваться между собой."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Smaže sdílenou kopii v iCloudu a znovu ji nahraje z TÉTO Apple TV. Ostatní zařízení si ponechají vlastní přihlášení. Používejte jen tehdy, pokud se zařízení nesjednotí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Löscht die gemeinsame iCloud-Kopie und lädt sie von DIESEM Apple TV neu hoch. Andere Geräte behalten ihre eigenen Anmeldungen. Nur verwenden, wenn sich Geräte nicht angleichen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elimina la copia condivisa su iCloud e la ricarica da QUESTA Apple TV. Gli altri dispositivi mantengono i propri accessi. Da usare solo se i dispositivi non si sincronizzano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tar bort den delade iCloud-kopian och laddar upp den igen från DEN HÄR Apple TV:n. Andra enheter behåller sina egna inloggningar. Använd bara om enheterna inte synkroniseras."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Briše zajedničku kopiju u iCloudu i ponovno je prenosi s OVOG Apple TV-a. Ostali uređaji zadržavaju vlastite prijave. Koristite samo ako se uređaji ne sinkroniziraju."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memadam salinan iCloud yang dikongsi dan memuat naiknya semula dari Apple TV INI. Peranti lain mengekalkan log masuk masing-masing. Gunakan hanya jika peranti tidak dapat menyelaraskan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odstráni zdieľanú kópiu v iCloude a znova ju nahrá z TEJTO Apple TV. Ostatné zariadenia si ponechajú vlastné prihlásenia. Použite len vtedy, ak sa zariadenia nechcú zosúladiť."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Видаляє спільну копію з iCloud і повторно завантажує її з ЦЬОГО Apple TV. Інші пристрої зберігають власні дані входу. Використовуйте лише тоді, коли пристрої не синхронізуються."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menghapus salinan bersama di iCloud lalu mengunggah ulang dari Apple TV INI. Perangkat lain tetap menyimpan informasi masuk masing-masing. Gunakan hanya jika perangkat tidak kunjung sinkron."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paylaşılan iCloud kopyasını siler ve BU Apple TV’den yeniden yükler. Diğer aygıtlar kendi oturumlarını korur. Yalnızca aygıtlar aynı duruma gelmiyorsa kullanın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suprimeix la còpia compartida de l’iCloud i la torna a pujar des d’AQUEST Apple TV. La resta de dispositius conserven les seves pròpies sessions. Utilitza-ho només si els dispositius no convergeixen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Șterge copia iCloud partajată și o reîncarcă de pe ACEST Apple TV. Celelalte dispozitive își păstrează propriile autentificări. Folosește numai dacă dispozitivele nu se sincronizează."
          }
        }
      }
    },
