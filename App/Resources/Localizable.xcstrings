    "No servers are available on this %@.": {
      "comment": "Empty-state text on the iOS Settings > Servers page when this device has no signed-in servers. %@ is the current device name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er zijn geen servers beschikbaar op deze %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na urządzeniu „%@” nie ma dostępnych serwerów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não há servidores disponíveis em %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der er ingen servere tilgængelige på denne %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun serveur n’est disponible sur ce %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На устройстве %@ нет доступных серверов."
          }
        }
      }
    },
    "No servers found yet. Make sure the server is on and that Plozz is allowed Local Network access, then rescan — or enter an address below.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog geen servers gevonden. Zorg dat de server aanstaat en dat Plozz toegang heeft tot het lokale netwerk, scan dan opnieuw — of voer hieronder een adres in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie znaleziono jeszcze żadnych serwerów. Upewnij się, że serwer jest włączony i że Plozz ma dostęp do sieci lokalnej, a potem zeskanuj ponownie — albo wpisz adres poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum servidor encontrado ainda. Verifique se o servidor está ligado e se o Plozz tem acesso à Rede Local, depois faça uma nova busca — ou digite um endereço abaixo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der er endnu ikke fundet nogen servere. Sørg for, at serveren er tændt, og at Plozz har adgang til det lokale netværk, og genscan derefter — eller indtast en adresse nedenfor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun serveur trouvé pour le moment. Vérifiez que le serveur est allumé et que Plozz est autorisé à accéder au réseau local, puis relancez l’analyse — ou saisissez une adresse ci-dessous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Серверы пока не найдены. Убедитесь, что сервер включён и у Plozz есть доступ к локальной сети, затем выполните повторное сканирование — или введите адрес ниже."
          }
        }
      }
    },
    "No servers found yet. Make sure your server is on and that Plozz is allowed Local Network access (tvOS Settings ▸ General ▸ Privacy), then rescan — or enter an address below.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog geen servers gevonden. Zorg dat je server aanstaat en dat Plozz toegang heeft tot het lokale netwerk (tvOS-instellingen ▸ Algemeen ▸ Privacy), scan dan opnieuw — of voer hieronder een adres in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie znaleziono jeszcze żadnych serwerów. Upewnij się, że serwer jest włączony i że Plozz ma dostęp do sieci lokalnej (Ustawienia tvOS ▸ Ogólne ▸ Prywatność), a potem zeskanuj ponownie — albo wpisz adres poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum servidor encontrado ainda. Verifique se o servidor está ligado e se o Plozz tem acesso à Rede Local (Ajustes do tvOS ▸ Geral ▸ Privacidade), depois faça uma nova busca — ou digite um endereço abaixo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der er endnu ikke fundet nogen servere. Sørg for, at din server er tændt, og at Plozz har adgang til det lokale netværk (tvOS-indstillinger ▸ Generelt ▸ Privatliv), og genscan derefter — eller indtast en adresse nedenfor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun serveur trouvé pour le moment. Vérifiez que votre serveur est allumé et que Plozz est autorisé à accéder au réseau local (Réglages tvOS ▸ Général ▸ Confidentialité), puis relancez l’analyse — ou saisissez une adresse ci-dessous."
          }
        },
        "ru": {
          "stringUnit": {
