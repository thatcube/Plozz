    "Hide all profile UI for solo use. You can re-enable Profiles anytime." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إخفاء واجهة المستخدم الخاصة بالملف الشخصي للاستخدام الفردي. يمكنك إعادة تمكين الملفات الشخصية في أي وقت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скрива всички елементи за профили при самостоятелно използване. Можете да включите профилите отново по всяко време."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Amaga tota la interfície de perfils per a l'ús individual. Pots tornar a activar els perfils quan vulguis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skryjte celé rozhraní profilů pro samostatné používání. Profily můžete kdykoli znovu zapnout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skjul hele profilbrugerfladen til brug alene. Du kan altid slå Profiler til igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Blendet die gesamte Profil-Oberfläche für die alleinige Nutzung aus. Du kannst Profile jederzeit wieder aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Απόκρυψη όλων των στοιχείων προφίλ για ατομική χρήση. Μπορείτε να ενεργοποιήσετε ξανά τα Προφίλ οποτεδήποτε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ocultar toda la interfaz de perfiles para uso individual. Puedes volver a activar los perfiles en cualquier momento."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پنهان کردن تمام رابط کاربری نمایه برای استفاده تکی. شما هر زمان می‌توانید نمایه‌ها را دوباره فعال کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Piilota kaikki profiilitoiminnot yksinkäyttöä varten. Voit ottaa profiilit uudelleen käyttöön milloin tahansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masquez toute l’interface des profils pour un usage en solo. Vous pourrez réactiver Profils à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הסתר את כל ממשק הפרופילים לשימוש יחיד. תוכל להפעיל מחדש פרופילים בכל עת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अकेले इस्तेमाल के लिए पूरी प्रोफ़ाइल इंटरफ़ेस छिपाएं. आप कभी भी प्रोफ़ाइल फिर से चालू कर सकते हैं."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sakrij cijelo sučelje profila za samostalno korištenje. Profile možete ponovno omogućiti u bilo kojem trenutku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minden profil felhasználói felület elrejtése egyedül való használatra. Bármikor újra engedélyezheti a profilokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sembunyikan semua antarmuka profil untuk penggunaan sendiri. Anda dapat mengaktifkan kembali Profil kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nascondi tutta l’interfaccia dei profili per l’uso individuale. Puoi riattivare Profili in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
