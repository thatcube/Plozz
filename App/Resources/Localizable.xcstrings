    "Profiles keep Home, settings, watch history, and downloads personal.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Met profielen blijven Start, instellingen, kijkgeschiedenis en downloads persoonlijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dzięki profilom każda osoba ma osobną stronę główną, ustawienia, historię oglądania i pobrane materiały."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os perfis mantêm o Início, os ajustes, o histórico de exibição e os downloads pessoais."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler holder Hjem, indstillinger, seerhistorik og downloads adskilt for hver person."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les profils gardent l’accueil, les réglages, l’historique de lecture et les téléchargements personnels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У каждого профиля свои Главная, настройки, история просмотров и загрузки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profily uchovávají obrazovku Domů, nastavení, historii sledování a stažené položky odděleně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mit Profilen erhält jede Person eine eigene Startseite, eigene Einstellungen, einen eigenen Wiedergabeverlauf und eigene Downloads."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con i profili, Home, impostazioni, cronologia di visione e download restano personali."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler ger var och en ett eget Hem, egna inställningar, egen tittarhistorik och egna nedladdningar."
          }
        }
      }
    },
    "Profiles keep each person’s Home, watch history, settings, and downloads separate.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profielen houden Start, kijkgeschiedenis, instellingen en downloads voor elke persoon gescheiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dzięki profilom każda osoba ma osobną stronę główną, historię oglądania, ustawienia i pobrane materiały."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os perfis mantêm separados o Início, o histórico de exibição, os ajustes e os downloads de cada pessoa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler holder hver persons Hjem, seerhistorik, indstillinger og downloads adskilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les profils gardent séparés l’accueil, l’historique de lecture, les réglages et les téléchargements de chacun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У каждого человека будут отдельные Главная, история просмотров, настройки и загрузки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profily uchovávají obrazovku Domů, historii sledování, nastavení a stažené položky každého uživatele odděleně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profile trennen die Startseite, den Wiedergabeverlauf, die Einstellungen und die Downloads jeder Person."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I profili mantengono separati Home, cronologia di visione, impostazioni e download di ogni persona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Med profiler får varje person ett eget Hem samt egen tittarhistorik, egna inställningar och egna nedladdningar."
          }
        }
      }
    },
    "Profiles stay enabled while more than one household profile exists.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profielen blijven ingeschakeld zolang er meer dan één huishoudprofiel bestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profile pozostają włączone, gdy istnieje więcej niż jeden profil domowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os perfis permanecem ativados enquanto houver mais de um perfil no grupo familiar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler forbliver aktiveret, så længe der findes mere end én husstandsprofil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les profils restent activés tant qu’il existe plus d’un profil dans le foyer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Профили остаются включёнными, пока существует более одного домашнего профиля."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profily zůstanou zapnuté, dokud existuje více než jeden domácí profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profile bleiben aktiviert, solange mehr als ein Haushaltsprofil vorhanden ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I profili restano attivi finché esiste più di un profilo nel nucleo familiare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler förblir aktiverade så länge det finns fler än en hushållsprofil."
          }
        }
      }
    },
