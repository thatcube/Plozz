    "navigationLibraries.unavailable" : {
      "comment" : "Shown when library discovery failed while arranging the navigation.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذّر الوصول إلى خوادمك. ترتيبك محفوظ، أعد المحاولة بعد قليل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сървърите ви са недостъпни. Подредбата ви е запазена — опитайте отново след малко."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No s'ha pogut connectar amb els teus servidors. La disposició està desada; torna-ho a provar d'aquí a un moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nepodařilo se spojit s vašimi servery. Vaše uspořádání je v bezpečí – zkuste to za chvíli znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der kunne ikke oprettes forbindelse til dine servere. Din opsætning er gemt – prøv igen om et øjeblik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Server sind nicht erreichbar. Deine Anordnung bleibt erhalten – versuch es gleich noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δεν ήταν δυνατή η σύνδεση με τους διακομιστές σας. Η διάταξή σας είναι ασφαλής — δοκιμάστε ξανά σε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't reach your servers. Your arrangement is safe — try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo conectar con tus servidores. Tu orden se ha conservado; inténtalo de nuevo en un momento."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دسترسی به سرورهای شما ممکن نشد. چیدمان شما محفوظ است — کمی بعد دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Palvelimiin ei saatu yhteyttä. Järjestyksesi on tallessa — yritä hetken kuluttua uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossible de joindre vos serveurs. Votre organisation est conservée — réessayez dans un instant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לא הצלחנו להגיע לשרתים שלך. הסידור שלך נשמר — נסה שוב בעוד רגע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके सर्वर तक नहीं पहुँच सके। आपका क्रम सुरक्षित है — थोड़ी देर में फिर कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poslužitelji nisu dostupni. Vaš je raspored sačuvan — pokušajte ponovno za koji trenutak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nem sikerült elérni a kiszolgálókat. A sorrend megmaradt – próbálja újra kicsit később."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tidak dapat menghubungi server Anda. Susunan Anda aman — coba lagi sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossibile raggiungere i tuoi server. La tua disposizione è al sicuro: riprova tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サーバに接続できませんでした。並び順は保持されています。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "서버에 연결할 수 없습니다. 설정한 구성은 그대로 유지되니 잠시 후 다시 시도하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tidak dapat menghubungi pelayan anda. Susunan anda selamat — cuba lagi sebentar nanti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fikk ikke kontakt med serverne dine. Oppsettet ditt er trygt – prøv igjen om litt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kan je servers niet bereiken. Je indeling blijft bewaard — probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie można połączyć się z serwerami. Ustawiony układ został zachowany — spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não foi possível acessar seus servidores. Sua configuração está preservada — tente de novo em instantes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Serverele nu au putut fi contactate. Aranjarea ta e în siguranță — încearcă din nou peste puțin timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не удалось связаться с серверами. Ваш порядок сохранён — попробуйте ещё раз через минуту."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Servery sa nepodarilo kontaktovať. Vaše usporiadanie zostalo zachované — skúste to o chvíľu znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Strežnikov ni bilo mogoče doseči. Vaša razporeditev je shranjena — poskusite znova čez trenutek."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nije moguće dopreti do servera. Vaš raspored je sačuvan — pokušajte ponovo za trenutak."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kunde inte nå dina servrar. Din ordning är sparad – försök igen om en stund."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เชื่อมต่อเซิร์ฟเวอร์ของคุณไม่ได้ การจัดเรียงของคุณยังอยู่ครบ — ลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sunucularınıza ulaşılamadı. Düzeniniz güvende — birazdan yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не вдалося зв’язатися з вашими серверами. Ваше впорядкування збережено — спробуйте за мить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Không kết nối được với máy chủ của bạn. Cách sắp xếp của bạn vẫn được giữ nguyên — hãy thử lại sau giây lát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
