    "Authorize in your browser, then enter the short code shown there.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriseer in je browser en voer daarna de korte code in die daar wordt getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoryzuj w przeglądarce, a potem wpisz pokazany tam krótki kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorize no navegador e depois digite o código curto mostrado lá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkend i din browser, og indtast derefter den korte kode, der vises der."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez dans votre navigateur, puis saisissez le code court affiché."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Авторизуйтесь в браузере, затем введите показанный там короткий код."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Proveďte autorizaci v prohlížeči a potom zadejte krátký kód, který se tam zobrazí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisiere im Browser und gib dann den dort angezeigten Code ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorizza nel tuo browser, poi inserisci il codice breve mostrato lì."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auktorisera i din webbläsare och ange sedan den korta koden som visas där."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorizirajte u pregledniku, a zatim unesite tamo prikazani kratki kôd."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berikan kebenaran dalam pelayar anda, kemudian masukkan kod pendek yang dipaparkan di sana."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorizujte sa v prehliadači a potom zadajte krátky kód, ktorý sa tam zobrazí."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
