    "Check the other device shows the same number before continuing.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controleer of het andere apparaat hetzelfde nummer toont voordat je doorgaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przed kontynuowaniem sprawdź, czy na drugim urządzeniu widnieje ten sam numer."
