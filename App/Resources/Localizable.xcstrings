        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%#@arg1@\n\n%2$@ ruang kosong tersedia di perangkat ini."
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "Ini akan mengunduh semua %lld episode dalam kualitas asli dan dapat memakai banyak penyimpanan serta data. Anda dapat menghapusnya kapan saja dari Unduhan."
                    }
