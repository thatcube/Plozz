          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "گزارش‌های ناشناس از خرابی و توقف برنامه. هیچ سرور، ورود، اطلاعات احراز هویت یا فعالیت تماشا ثبت نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
