    "Coming from a device that’s already signed in? Show a code here and scan it from your other phone, tablet, or Apple TV to sign this one in.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kom je van een apparaat dat al is aangemeld? Toon hier een code en scan die vanaf je andere telefoon, tablet of Apple TV om dit apparaat aan te melden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masz już zalogowane inne urządzenie? Wyświetl tutaj kod i zeskanuj go z drugiego telefonu, tabletu albo Apple TV, aby zalogować to urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Já usa o Plozz em um dispositivo conectado? Exiba um código aqui e escaneie-o com outro celular, tablet ou Apple TV para entrar neste dispositivo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommer du fra en enhed, der allerede er logget ind? Vis en kode her, og scan den fra din anden telefon, tablet eller Apple TV for at logge denne ind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous venez d’un appareil déjà connecté ? Affichez un code ici et scannez-le depuis votre autre téléphone, tablette ou Apple TV pour connecter celui-ci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переходите с устройства, где вход уже выполнен? Покажите здесь код и отсканируйте его с другого телефона, планшета или Apple TV, чтобы войти на этом устройстве."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přecházíte ze zařízení, které už je přihlášené? Zobrazte zde kód a naskenujte ho z druhého telefonu, tabletu nebo Apple TV, aby se přihlásilo i toto zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ist bereits ein anderes Gerät angemeldet? Zeige hier einen Code an und scanne ihn mit deinem Smartphone, Tablet oder Apple TV, um dieses Gerät anzumelden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hai già effettuato l’accesso su un altro dispositivo? Mostra qui un codice e scansionalo con l’altro telefono, tablet o Apple TV per accedere su questo dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommer du från en enhet som redan är inloggad? Visa en kod här och skanna den från din andra telefon, surfplatta eller Apple TV för att logga in den här enheten."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dolazite s uređaja koji je već prijavljen? Ovdje prikažite kôd i skenirajte ga drugim telefonom, tabletom ili Apple TV-om kako biste prijavili ovaj uređaj."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Datang dari peranti yang sudah log masuk? Paparkan kod di sini dan imbaskannya dari telefon, tablet, atau Apple TV lain anda untuk melog masuk peranti ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prichádzate zo zariadenia, ktoré je už prihlásené? Zobrazte tu kód a naskenujte ho na druhom telefóne, tablete alebo Apple TV, aby ste prihlásili toto zariadenie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Використовуєте пристрій, на якому вже виконано вхід? Покажіть тут код і відскануйте його іншим телефоном, планшетом або Apple TV, щоб увійти на цьому пристрої."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menggunakan perangkat yang sudah masuk? Tampilkan kode di sini, lalu pindai dengan ponsel, tablet, atau Apple TV lain untuk masuk di perangkat ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oturumun zaten açık olduğu bir aygıt mı kullanıyorsunuz? Burada bir kod gösterin ve bu aygıtta oturum açmak için kodu diğer telefonunuz, tabletiniz veya Apple TV’nizle tarayın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Véns d’un dispositiu que ja ha iniciat sessió? Mostra un codi aquí i escaneja’l des del teu altre telèfon, tauleta o Apple TV per iniciar sessió en aquest."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vii de pe un dispozitiv deja conectat? Afișează aici un cod și scanează-l de pe celălalt telefon, tabletă sau Apple TV pentru a conecta și acest dispozitiv."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מגיע ממכשיר שכבר מחובר? הצג קוד כאן וסרוק אותו מהטלפון, הטאבלט או ה-Apple TV האחר שלך כדי לחבר את המכשיר הזה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prehajate iz naprave, ki je že prijavljena? Tukaj pokažite kodo in jo optično preberite z drugim telefonom, tablico ali Apple TV-jem, da prijavite to napravo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กำลังย้ายมาจากอุปกรณ์ที่ลงชื่อเข้าใช้แล้วใช่ไหม? แสดงรหัสที่นี่ แล้วสแกนจากโทรศัพท์ แท็บเล็ต หรือ Apple TV อีกเครื่องของคุณเพื่อลงชื่อเข้าใช้อุปกรณ์เครื่องนี้"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Идвате от устройство, което вече е влязло? Покажете код тук и го сканирайте от другия си телефон, таблет или Apple TV, за да влезете и тук."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onko toisella laitteella jo kirjauduttu sisään? Näytä koodi tässä ja lue se toisella puhelimella, tabletilla tai Apple TV:llä, niin tämä laite kirjautuu sisään."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommer du fra en enhet som allerede er logget på? Vis en kode her, og skann den fra den andre telefonen, nettbrettet eller Apple TV-en for å logge på denne enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "来自已登录设备？在此显示代码，并从您的其他手机、平板或 Apple TV 扫描该代码以登录此设备。"
          }
        }
      }
    },
