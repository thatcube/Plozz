    "System prompts and the player's own on-screen controls follow the Apple TV's language, not this setting.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Systeemmeldingen en de eigen schermbediening van de speler volgen de taal van de Apple TV, niet deze instelling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komunikaty systemowe i ekranowe elementy sterowania odtwarzacza używają języka Apple TV, a nie tego ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os avisos do sistema e os controles do reprodutor na tela seguem o idioma da Apple TV, não esta configuração."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Systembeskeder og afspillerens egne betjeningselementer følger Apple TV’ets sprog, ikke denne indstilling."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les invites système et les commandes à l’écran du lecteur suivent la langue de l’Apple TV, pas ce réglage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Системные сообщения и встроенные экранные элементы управления проигрывателя используют язык Apple TV, а не этот параметр."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Systémové výzvy a vlastní ovládací prvky přehrávače na obrazovce se řídí jazykem Apple TV, ne tímto nastavením."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Systemdialoge und die Bedienelemente des Players folgen der Sprache des Apple TV, nicht dieser Einstellung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I messaggi di sistema e i controlli del player sullo schermo seguono la lingua di Apple TV, non questa impostazione."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Systemdialogrutor och spelarens egna skärmreglage följer språket på Apple TV:n, inte den här inställningen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sustavni upiti i vlastite kontrole reproduktora na zaslonu prate jezik Apple TV-a, a ne ovu postavku."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gesaan sistem dan kawalan pada skrin pemain sendiri mengikut bahasa Apple TV, bukan tetapan ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Systémové výzvy a vlastné ovládacie prvky prehrávača na obrazovke sa riadia jazykom Apple TV, nie týmto nastavením."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Системні повідомлення та власні екранні елементи керування програвача відповідають мові Apple TV, а не цьому налаштуванню."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dialog sistem dan kontrol pemutar di layar mengikuti bahasa Apple TV, bukan pengaturan ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sistem iletileri ve oynatıcının kendi ekran denetimleri bu ayarı değil, Apple TV’nin dilini kullanır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els missatges del sistema i els controls en pantalla propis del reproductor segueixen l'idioma de l'Apple TV, no aquesta configuració."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mesajele de sistem și controalele de pe ecran ale playerului folosesc limba Apple TV, nu această setare."
          }
        }
      }
    },
    "TMDB rejected this key. Check the token and try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
