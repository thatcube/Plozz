    "Scan the QR code or visit the URL on your phone, sign in to AniList, then enter the code shown:": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scan de QR-code of ga naar de URL op je telefoon, meld je aan bij AniList en voer daarna de getoonde code in:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeskanuj kod QR lub odwiedź adres URL na telefonie, zaloguj się do AniList, a następnie wpisz wyświetlony kod:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escaneie o código QR ou acesse a URL no seu celular, entre no AniList e depois digite o código exibido:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scan QR-koden, eller besøg URL'en på din telefon, log ind på AniList, og indtast derefter den viste kode:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannez le code QR ou ouvrez l’URL sur votre téléphone, connectez-vous à AniList, puis saisissez le code affiché :"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отсканируйте QR-код или откройте URL на телефоне, войдите в AniList, затем введите показанный код:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskenujte QR kód nebo v telefonu otevřete URL, přihlaste se ke službě AniList a potom zadejte zobrazený kód:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scanne den QR-Code oder öffne die URL auf deinem Telefon, melde dich bei AniList an und gib dann den angezeigten Code ein:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scansiona il codice QR o visita l’URL sul telefono, accedi ad AniList, quindi inserisci il codice mostrato:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skanna QR-koden eller besök webbadressen på din telefon, logga in på AniList och ange sedan koden som visas:"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenirajte QR kod ili otvorite URL na telefonu, prijavite se na AniList, zatim unesite prikazani kod:"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imbas kod QR atau lawati URL pada telefon anda, log masuk ke AniList, kemudian masukkan kod yang dipaparkan:"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskenujte QR kód alebo otvorte URL v telefóne, prihláste sa do služby AniList a potom zadajte zobrazený kód:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відскануйте QR-код або відвідайте URL на телефоні, увійдіть в AniList, потім введіть показаний код:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pindai kode QR atau buka URL di ponsel Anda, masuk ke AniList, lalu masukkan kode yang ditampilkan:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "QR kodunu tarayın veya telefonunuzda URL’yi ziyaret edin, AniList’te oturum açın, sonra gösterilen kodu girin:"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escaneja el codi QR o visita l'URL des del telèfon, inicia sessió a AniList i després introdueix el codi que es mostra:"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scanează codul QR sau accesează URL-ul pe telefon, conectează-te la AniList, apoi introdu codul afișat:"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "סרוק את קוד ה-QR או בקר בכתובת האתר בטלפון שלך, התחבר ל-AniList, ואז הזן את הקוד המוצג:"
