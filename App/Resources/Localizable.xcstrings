    },
    "What to call this share on the Home screen. Defaults to the share name.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De naam van deze netwerkshare op Start. Standaard wordt de naam van de netwerkshare gebruikt."
          }
        },
        "pl": {
