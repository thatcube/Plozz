        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ativo agora (%1$@). Manual: liga às %2$@, desliga às %3$@ · transição de %4$@."
          }
        },
        "da": {
          "stringUnit": {
