    "Plex shares one sign-in across the household. Each profile picks its own Plex user and libraries under Profile › Your Libraries.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex deelt één aanmelding voor het hele huishouden. Elk profiel kiest zijn eigen Plex-gebruiker en bibliotheken onder Profiel › Jouw bibliotheken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex współdzieli jedno logowanie w całym gospodarstwie domowym. Każdy profil wybiera własnego użytkownika Plex i biblioteki w Profil › Twoje biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plex compartilha um único login com todo o grupo familiar. Cada perfil escolhe o próprio usuário do Plex e as próprias bibliotecas em Perfil › Suas bibliotecas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex deler ét login på tværs af husstanden. Hver profil vælger sin egen Plex-bruger og biblioteker under Profil › Dine biblioteker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex partage une seule connexion pour tout le foyer. Chaque profil choisit son propre utilisateur Plex et ses bibliothèques sous Profil › Vos bibliothèques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex использует один вход для всей семьи. Каждый профиль выбирает своего пользователя Plex и свои медиатеки в разделе «Профиль» › «Ваши медиатеки»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex sdílí jedno přihlášení napříč celou domácností. Každý profil si v části Profil › Vaše knihovny vybere vlastního uživatele Plex a knihovny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex nutzt eine gemeinsame Anmeldung für den ganzen Haushalt. Jedes Profil wählt unter „Profil › Deine Medienbibliotheken“ seinen eigenen Plex-Benutzer und seine Medienbibliotheken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex condivide un unico accesso per tutto il nucleo familiare. Ogni profilo sceglie il proprio utente Plex e le proprie librerie in Profilo › Le tue librerie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex delar en inloggning för hela hushållet. Varje profil väljer sin egen Plex-användare och sina bibliotek under Profil › Dina bibliotek."
          }
        }
      }
    },
    "Plex sign-in finds every server linked to your account.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aanmelden bij Plex vindt elke server die aan je account is gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logowanie do Plex znajduje wszystkie serwery powiązane z kontem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O login do Plex encontra todos os servidores vinculados à sua conta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Login med Plex finder alle servere, der er knyttet til din konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion à Plex détecte tous les serveurs liés à votre compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
