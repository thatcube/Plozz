    "Metadata providers, artwork, and caches are shared by every profile on this device.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metadataproviders, afbeeldingen en caches worden gedeeld door elk profiel op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dostawcy metadanych, grafiki i pamięci podręczne są współdzielone przez wszystkie profile na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os provedores de metadados, as artes e os caches são compartilhados por todos os perfis neste dispositivo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metadataudbydere, coverbilleder og caches deles af alle profiler på denne enhed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les fournisseurs de métadonnées, les illustrations et les caches sont partagés par tous les profils de cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Источники метаданных, иллюстрации и кэш общие для всех профилей на этом устройстве."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poskytovatelé metadat, grafika a mezipaměti jsou společné pro všechny profily na tomto zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metadatenanbieter, Bildmaterial und Caches werden von allen Profilen auf diesem Gerät gemeinsam genutzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I provider di metadati, le immagini e le cache sono condivisi da tutti i profili su questo dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metadatakällor, bilder och cacheminnen delas av alla profiler på enheten."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pružatelji metapodataka, ilustracije i predmemorije dijele se na svim profilima na ovom uređaju."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Penyedia metadata, karya seni, dan cache dikongsi oleh setiap profil pada peranti ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poskytovatelia metadát, grafika a vyrovnávacie pamäte sú spoločné pre všetky profily v tomto zariadení."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Постачальники метаданих, обкладинки й кеші спільні для всіх профілів на цьому пристрої."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Penyedia metadata, gambar, dan cache digunakan bersama oleh semua profil di perangkat ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Meta veri sağlayıcıları, kapak görselleri ve önbellekler bu aygıttaki tüm profiller tarafından paylaşılır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els proveïdors de metadades, les imatges i les memòries cau es comparteixen entre tots els perfils d'aquest dispositiu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Furnizorii de metadate, ilustrațiile și cache-urile sunt comune pentru toate profilurile de pe acest dispozitiv."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ספקי מטא-נתונים, תמונות ומטמון משותפים לכל פרופיל במכשיר הזה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ponudniki metapodatkov, ilustracije in predpomnilniki so v skupni rabi za vse profile v tej napravi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ผู้ให้บริการข้อมูลเมตา ภาพปก และแคชจะใช้ร่วมกันในทุกโปรไฟล์บนอุปกรณ์นี้"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Доставчиците на метаданни, обложките и кешовете се споделят от всички профили на това устройство."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metatietolähteet, kuvitukset ja välimuistit ovat yhteisiä kaikille tämän laitteen profiileille."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metadataleverandører, omslagsbilder og hurtigbuffere deles av alle profiler på denne enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此设备上的所有个人资料共享元数据提供商、图片和缓存。"
          }
        }
      }
    },
