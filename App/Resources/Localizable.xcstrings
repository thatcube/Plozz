    "FTP sends credentials and media without encryption.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP verstuurt inloggegevens en media zonder versleuteling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP przesyła dane logowania i multimedia bez szyfrowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O FTP envia credenciais e mídia sem criptografia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP sender loginoplysninger og medier uden kryptering."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP envoie les identifiants et les médias sans chiffrement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP передаёт учётные данные и медиа без шифрования."
