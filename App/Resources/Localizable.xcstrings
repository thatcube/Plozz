          }
        }
      }
    },
    "Sign-ins are shared by everyone on this Apple TV. Choose what each profile sees under Profile › Your Libraries.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aanmeldingen worden gedeeld door iedereen op deze Apple TV. Kies wat elk profiel ziet onder Profiel › Jouw bibliotheken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logowania są współdzielone przez wszystkich na tym Apple TV. Wybierz, co widzi każdy profil, w sekcji Profil › Twoje biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os logins são compartilhados por todos nesta Apple TV. Escolha o que cada perfil vê em Perfil › Suas bibliotecas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logins deles af alle på dette Apple TV. Vælg, hvad hver profil kan se, under Profil › Dine biblioteker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les connexions sont partagées entre tous les profils sur cette Apple TV. Choisissez ce que chaque profil voit dans Profil › Vos bibliothèques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Входы в учётные записи общие для всех на этом Apple TV. Выберите, что видит каждый профиль, в разделе «Профиль» › «Ваши медиатеки»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přihlášení jsou společná pro všechny uživatele této Apple TV. V části Profil › Vaše knihovny vyberte, co každý profil uvidí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anmeldungen werden von allen auf diesem Apple TV gemeinsam genutzt. Lege unter „Profil › Deine Medienbibliotheken“ fest, was jedes Profil sieht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli accessi sono condivisi da tutti su questa Apple TV. Scegli cosa vede ogni profilo in Profilo › Le tue librerie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inloggningar delas av alla på denna Apple TV. Välj vad varje profil ser under Profil › Dina bibliotek."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijave dijele svi na ovom Apple TV-u. Odaberite što svaki profil vidi pod Profil › Vaše knjižnice."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Log masuk dikongsi oleh semua orang pada Apple TV ini. Pilih apa yang dilihat oleh setiap profil di bawah Profil › Pustaka Anda."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prihlásenia sú zdieľané pre všetkých na tejto Apple TV. V časti Profil › Vaše knižnice vyberte, čo jednotlivé profily uvidia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дані входу спільні для всіх на цьому Apple TV. Виберіть у розділі «Профіль» › «Ваші медіатеки», що бачить кожен профіль."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akun masuk digunakan bersama oleh semua orang di Apple TV ini. Pilih yang dapat dilihat setiap profil melalui Profil › Pustaka Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Apple TV’de oturum açma bilgileri herkesle paylaşılır. Profil › Kitaplıklarınız altında her profilin ne göreceğini seçin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els inicis de sessió es comparteixen entre tothom en aquest Apple TV. Tria què veu cada perfil a Perfil › Les teves biblioteques."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectările sunt comune pentru toți cei de pe acest Apple TV. Alege ce vede fiecare profil în Profil › Bibliotecile tale."
          }
        }
      }
    },
