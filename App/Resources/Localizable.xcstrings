    "Always on. Tints the screen at full strength around the clock.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altijd aan. Kleurt het scherm de klok rond op volle sterkte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zawsze włączone. Barwi ekran z pełną intensywnością przez całą dobę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sempre ativado. Aplica a tonalidade da tela na força máxima 24 horas por dia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altid til. Farver skærmen med fuld styrke hele døgnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toujours actif. Teinte l’écran à pleine intensité en permanence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всегда включено. Экран постоянно тонируется с полной интенсивностью."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vždy zapnuto. Barví obrazovku plnou intenzitou nepřetržitě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Immer an. Färbt den Bildschirm rund um die Uhr mit voller Stärke ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sempre attivo. Applica allo schermo la tinta alla massima intensità 24 ore su 24."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alltid på. Tonar skärmen med full styrka dygnet runt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uvijek uključeno. Nijansira zaslon punim intenzitetom tijekom cijelog dana."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sentiasa hidup. Mewarnakan skrin pada kekuatan penuh sepanjang masa."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vždy zapnuté. Zafarbuje obrazovku na plnú intenzitu nepretržite."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завжди ввімкнено. Цілодобово забарвлює екран із повною інтенсивністю."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selalu aktif. Layar diwarnai dengan kekuatan penuh sepanjang waktu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her zaman açık. Ekranı günün her saati tam güçte renklendirir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sempre activat. Tenyeix la pantalla a màxima intensitat les 24 hores del dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mereu activat. Nuanțează ecranul la intensitate maximă permanent."
          }
        }
      }
    },
