    "Off. %@: sunset %@, sunrise %@.": {
      "comment": "Footer summary in iOS Settings > Circadian Mode when solar scheduling is configured but disabled. %@ is the region name, the second %@ is today's sunset time, and the third %@ is today's sunrise time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Off. %1$@: sunset %2$@, sunrise %3$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uit. %1$@: zonsondergang %2$@, zonsopgang %3$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wył. %1$@: zachód słońca %2$@, wschód słońca %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativado. %1$@: pôr do sol às %2$@, nascer do sol às %3$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fra. %1$@: solnedgang %2$@, solopgang %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé. %1$@ : coucher du soleil à %2$@, lever du soleil à %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выкл. %1$@: закат %2$@, восход %3$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vypnuto. %1$@: západ slunce v %2$@, východ slunce v %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aus. %1$@: Sonnenuntergang %2$@, Sonnenaufgang %3$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattivato. %1$@: tramonto alle %2$@, alba alle %3$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Av. %1$@: solnedgång %2$@, soluppgång %3$@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isključeno. %1$@: zalazak sunca u %2$@, izlazak sunca u %3$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mati. %1$@: matahari terbenam %2$@, matahari terbit %3$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vypnuté. %1$@: západ slnka o %2$@, východ slnka o %3$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вимкнено. %1$@: захід сонця %2$@, схід сонця %3$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mati. %1$@: matahari terbenam %2$@, matahari terbit %3$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapalı. %1$@: gün batımı %2$@, gün doğumu %3$@."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactivat. %1$@: posta de sol %2$@, sortida del sol %3$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dezactivat. %1$@: apus la %2$@, răsărit la %3$@."
          }
        }
      }
    },
    "Off. Manual: on %@, off %@.": {
      "comment": "Footer summary in iOS Settings > Circadian Mode when manual scheduling is configured but disabled. %@ is the on time, and the second %@ is the off time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Off. Manual: on %1$@, off %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uit. Handmatig: aan %1$@, uit %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wył. Ręcznie: włączenie %1$@, wyłączenie %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativado. Manual: ativar às %1$@, desativar às %2$@."
