    "On your other device, open Plozz ▸ Settings ▸ Sync & Setup ▸ “Set up another device.”": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Open op je andere apparaat Plozz ▸ Instellingen ▸ Synchronisatie en installatie ▸ ‘Ander apparaat instellen’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na drugim urządzeniu otwórz Plozz ▸ Ustawienia ▸ Synchronizacja i konfiguracja ▸ „Skonfiguruj inne urządzenie”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No outro dispositivo, abra Plozz ▸ Ajustes ▸ Sincronização e configuração ▸ “Configurar outro dispositivo.”"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn Plozz ▸ Indstillinger ▸ Synkronisering og opsætning ▸ »Konfigurer en anden enhed« på din anden enhed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sur votre autre appareil, ouvrez Plozz ▸ Réglages ▸ Synchronisation et configuration ▸ « Configurer un autre appareil »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На другом устройстве откройте Plozz ▸ Настройки ▸ Синхронизация и настройка ▸ «Настроить другое устройство»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na druhém zařízení otevřete Plozz ▸ Nastavení ▸ Synchronizace a nastavení ▸ „Nastavit jiné zařízení“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne auf deinem anderen Gerät Plozz ▸ Einstellungen ▸ Synchronisierung & Einrichtung ▸ „Anderes Gerät einrichten“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sul tuo altro dispositivo, apri Plozz ▸ Impostazioni ▸ Sincronizzazione e configurazione ▸ “Configura un altro dispositivo.”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öppna Plozz på den andra enheten och välj Inställningar ▸ Synkronisering och konfiguration ▸ ”Konfigurera en annan enhet”."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na drugom uređaju otvorite Plozz ▸ Postavke ▸ Sinkronizacija i postavljanje ▸ “Postavi drugi uređaj.”"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pada peranti lain anda, buka Plozz ▸ Tetapan ▸ Segerak & Persediaan ▸ “Sediakan peranti lain.”"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na vašom druhom zariadení otvorte Plozz ▸ Nastavenia ▸ Synchronizácia a nastavenie ▸ „Nastaviť iné zariadenie“."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На вашому іншому пристрої відкрийте Plozz ▸ Налаштування ▸ Синхронізація та налаштування ▸ «Налаштувати інший пристрій»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Di perangkat Anda yang lain, buka Plozz ▸ Pengaturan ▸ Sinkronisasi & Pengaturan ▸ “Atur perangkat lain.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer aygıtınızda Plozz ▸ Ayarlar ▸ Eşzamanlama ve ayarlama ▸ “Başka bir aygıt ayarla” bölümünü açın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al teu altre dispositiu, obre Plozz ▸ Configuració ▸ Sincronització i configuració ▸ «Configura un altre dispositiu»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pe celălalt dispozitiv, deschide Plozz ▸ Setări ▸ Sincronizare și configurare ▸ „Configurează alt dispozitiv”."
          }
