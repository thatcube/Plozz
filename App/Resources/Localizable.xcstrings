    "skipIntros.detail.autoDelay": {
      "comment": "One-line explanation shown under the skip-intro picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Show a Skip button, then skip automatically after a few seconds."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toon een knop Overslaan en sla na enkele seconden automatisch over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokaż przycisk Pomiń, a po kilku sekundach pomiń automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostrar um botão Pular e, depois de alguns segundos, pular automaticamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vis en Spring over-knap, og spring derefter automatisk over efter et par sekunder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afficher un bouton Passer, puis passer automatiquement après quelques secondes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показывать кнопку «Пропустить», а затем автоматически пропускать через несколько секунд."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zobrazí tlačítko Přeskočit a po několika sekundách přeskočí automaticky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt die Taste „Überspringen“ und überspringt nach wenigen Sekunden automatisch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra il pulsante Salta e, dopo qualche secondo, salta automaticamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visa en Hoppa över-knapp och hoppa sedan över automatiskt efter några sekunder."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikaži gumb Preskoči, a zatim automatski preskoči nakon nekoliko sekundi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tunjukkan butang Langkau, kemudian langkau secara automatik selepas beberapa saat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zobraziť tlačidlo Preskočiť a po niekoľkých sekundách preskočiť automaticky."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показати кнопку пропуску, а потім автоматично пропустити через кілька секунд."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tampilkan tombol Lewati, lalu lewati otomatis setelah beberapa detik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atla düğmesini göster, sonra birkaç saniye sonra otomatik olarak atla."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra un botó Omet i, al cap d’uns segons, ho omet automàticament."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afișează butonul Omite, apoi omite automat segmentul după câteva secunde."
          }
        }
      }
    },
    "skipIntros.detail.autoInstant": {
      "comment": "One-line explanation shown under the skip-intro picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Skip intros and credits automatically, the instant they start."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sla intro's en aftiteling automatisch over, zodra ze beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Automatycznie pomijaj intro i napisy końcowe w chwili ich rozpoczęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pular introduções e créditos automaticamente assim que começarem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spring introer og rulletekster over automatisk, i samme øjeblik de starter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ignorer automatiquement les intros et les génériques dès qu’ils commencent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Автоматически пропускать вступления и титры сразу после их начала."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Úvody a závěrečné titulky přeskočí automaticky hned, jak začnou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Überspringt Intros und Abspann automatisch, sobald sie beginnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salta automaticamente intro e titoli di coda non appena iniziano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoppa över intron och eftertexter automatiskt så fort de börjar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Automatski preskoči uvode i odjavnu špicu čim počnu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Langkau intro dan kredit secara automatik, sebaik sahaja ia bermula."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Úvody a záverečné titulky preskočiť automaticky hneď po ich začiatku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Автоматично пропускати вступи й титри, щойно вони починаються."
          }
        },
        "id": {
