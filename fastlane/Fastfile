# Fastfile — App Store Connect automation for Plozz (tvOS + iOS/iPadOS)
#
# Authentication uses an App Store Connect API key (no Apple ID / 2FA needed),
# which is required for unattended runs and CI. Provide these via env vars
# (see .env.fastlane.example) or your CI secrets:
#
#   ASC_KEY_ID       Key ID from App Store Connect > Integrations > App Store Connect API
#   ASC_ISSUER_ID    Issuer ID from the same page
#   ASC_KEY_PATH     Path to the downloaded AuthKey_XXXXXX.p8  (keep it OUT of git)
#
# Usage (Fastlane installed via Homebrew):
#   fastlane beta       # build + upload to TestFlight
#   fastlane build      # archive an .ipa locally, no upload
#   fastlane release    # build + upload to App Store
#
# Both platform binaries use the existing Plozz App Store Connect record and
# bundle ID. Distribution signing is handled automatically by `build` via
# -allowProvisioningUpdates + the API key.

require "shellwords"

APP_IDENTIFIER = "com.thatcube.Plozz"
APP_NAME       = "Plozz"
XCODEPROJ      = "Plozz.xcodeproj"
OUTPUT_DIR     = "build"
RELEASE_TARGETS = [
  {
    name: "tvOS",
    scheme: "Plozz",
    platform: "appletvos",
    # The App Store Connect API's own platform name, which differs from the
    # xcodebuild/altool one above.
    asc_platform: "TV_OS",
    output_name: "Plozz-tvOS.ipa",
    archive_path: File.join(OUTPUT_DIR, "Plozz-tvOS.xcarchive")
  },
  {
    name: "iOS/iPadOS",
    scheme: "PlozziOS",
    platform: "ios",
    asc_platform: "IOS",
    output_name: "Plozz-iOS.ipa",
    archive_path: File.join(OUTPUT_DIR, "Plozz-iOS.xcarchive")
  }
].freeze
# External TestFlight beta group builds are distributed to (created once in the
# App Store Connect web UI). The internal group already has access to all builds
# automatically, so `beta` only has to add + submit for this external one.
EXTERNAL_GROUP = "Plozz External"

# The host GitHub desktop/CLI app injects safe.bareRepository=explicit via
# GIT_CONFIG_* env vars, which breaks Swift Package Manager's bare dependency
# checkouts during xcodebuild. Relax just that one value back to git's default
# for everything fastlane spawns.
if ENV["GIT_CONFIG_KEY_0"] == "safe.bareRepository"
  ENV["GIT_CONFIG_VALUE_0"] = "all"
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

# App Store Connect rejects any build made with a BETA Xcode / SDK (altool error
# 90534 "Unsupported SDK or Xcode version"). This machine keeps the beta as the
# active `xcode-select` toolchain (/Applications/Xcode-beta.app), so an
# unqualified fastlane run would build with the beta SDK and the upload would be
# rejected. Point every fastlane build at a RELEASE Xcode automatically so
# uploads always succeed — no manual `DEVELOPER_DIR` / `xcode-select` dance.
#
# Resolution order:
#   1. An explicit non-beta DEVELOPER_DIR the caller already exported (respected).
#   2. The conventional release install at /Applications/Xcode.app.
#   3. The highest-versioned /Applications/Xcode*.app whose name isn't "beta".
def select_release_xcode
  beta = ->(path) { path.downcase.include?("beta") }

  # Respect an explicit, non-beta override.
  if (dd = ENV["DEVELOPER_DIR"]) && !dd.empty?
    if beta.call(dd)
      UI.important("DEVELOPER_DIR points at a beta Xcode (#{dd}); overriding with a release Xcode.")
    else
      UI.message("Using caller-provided DEVELOPER_DIR: #{dd}")
      return
    end
  end

  candidates = Dir.glob("/Applications/Xcode*.app").reject { |p| beta.call(p) }
  # Prefer the canonical release path, then fall back to the newest remaining.
  chosen = candidates.find { |p| p == "/Applications/Xcode.app" }
  chosen ||= candidates.sort.last

  unless chosen
    UI.user_error!("No release Xcode found in /Applications (only a beta is installed). " \
                   "Install a release Xcode — App Store Connect rejects beta-SDK builds.")
  end

  developer_dir = File.join(chosen, "Contents", "Developer")
  ENV["DEVELOPER_DIR"] = developer_dir
  version = `DEVELOPER_DIR=#{developer_dir.shellescape} xcodebuild -version 2>/dev/null`.strip.gsub("\n", " ")
  UI.success("Building with release Xcode: #{chosen} (#{version})")
end

# Use one build number across both platform archives. Taking the highest current
# TestFlight build across tvOS and iOS prevents collisions even if one platform
# has shipped more builds than the other.
def next_build_number
  latest = RELEASE_TARGETS.map do |target|
    latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      platform: target[:platform],
      initial_build_number: 0
    ).to_i
  end.max
  latest + 1
end

# Refuse to archive a distribution build with no crash-reporting endpoint.
#
# The DSN is read at runtime from Info.plist; when it is empty the app installs a
# NoopCrashReporter and every crash a tester hits is lost with no trace. That is
# invisible from the outside — the Settings toggle simply shows as unavailable —
# so a whole beta cycle can be shipped blind without anyone noticing. Consent
# already defaults ON for TestFlight, so the DSN is the only remaining gate.
#
# tools/generate-project.sh reads the DSN from the environment or .env.fastlane,
# so this checks both. Set PLOZZ_ALLOW_NO_CRASH_REPORTING=1 to ship anyway.
# tools/generate-project.sh reads the DSN from the environment, the per-worktree
# .env.fastlane, or the machine-wide ~/.config/plozz/env — so this checks the
# same places, in the same order. Set PLOZZ_ALLOW_NO_CRASH_REPORTING=1 to ship
# anyway.
def crash_reporting_dsn
  dsn = ENV["PLOZZ_SENTRY_DSN"].to_s.strip
  return dsn unless dsn.empty?

  candidates = [
    ENV["PLOZZ_ENV_FILE"],
    File.expand_path("../.env.fastlane", __dir__),
    File.join(ENV["XDG_CONFIG_HOME"] || File.join(Dir.home, ".config"), "plozz", "env")
  ].compact.reject(&:empty?)

  candidates.each do |path|
    next unless File.exist?(path)
    line = File.readlines(path).grep(/^\s*PLOZZ_SENTRY_DSN=/).last
    next unless line
    value = line.split("=", 2).last.to_s.strip.gsub(/\A["']|["']\z/, "")
    return value unless value.empty?
  end
  ""
end

def require_crash_reporting_dsn
  return unless crash_reporting_dsn.empty?

  if ENV["PLOZZ_ALLOW_NO_CRASH_REPORTING"].to_s == "1"
    UI.important("No PLOZZ_SENTRY_DSN — shipping WITHOUT crash reporting (override set).")
    return
  end

  config_path = File.join(
    ENV["XDG_CONFIG_HOME"] || File.join(Dir.home, ".config"), "plozz", "env"
  )
  UI.user_error!(
    "No crash-reporting endpoint (PLOZZ_SENTRY_DSN) for this distribution build.\n" \
    "Testers' crashes would be discarded on-device with no record.\n\n" \
    "Put the Sentry DSN in the machine-wide env file, which survives worktrees:\n" \
    "  #{config_path}\n" \
    "  PLOZZ_SENTRY_DSN=https://<key>@o<org>.ingest.<region>.sentry.io/<project>\n\n" \
    "To ship blind anyway: PLOZZ_ALLOW_NO_CRASH_REPORTING=1 fastlane beta --env fastlane"
  )
end

# The marketing version (CFBundleShortVersionString) this ship will carry.
#
# Mirrors tools/generate-project.sh's precedence — an explicit
# PLOZZ_MARKETING_VERSION override, else CalVer `YYYY.M.D` — and is computed ONCE
# per run, then exported so the script bakes the very same value. Letting both
# derive it independently would disagree across a midnight boundary, which is
# exactly the kind of mismatch App Store Review rejects.
def marketing_version
  @marketing_version ||= begin
    override = ENV["PLOZZ_MARKETING_VERSION"]
    if override && !override.strip.empty?
      override.strip
    else
      t = Time.now
      "#{t.year}.#{t.month}.#{t.day}"
    end
  end
end

# App Store version records whose version string can still be edited. Anything
# else (in review, live, pending release) is frozen, so a new record has to be
# created rather than the existing one renamed.
EDITABLE_VERSION_STATES = %w[
  PREPARE_FOR_SUBMISSION
  DEVELOPER_REJECTED
  REJECTED
  METADATA_REJECTED
  INVALID_BINARY
].freeze

# Points each platform's App Store version record at `version`, creating one when
# the platform has none yet.
#
# App Store Review rejects a submission whose version record disagrees with the
# binary's CFBundleShortVersionString. Because the marketing version is CalVer —
# it changes on its own whenever you ship on a new day — keeping the records in
# step by hand is a standing trap, so `release` does it as part of shipping.
#
# TestFlight ignores these records entirely, which is why `beta` doesn't call it.
def sync_app_store_versions(version)
  key = asc_api_key
  Spaceship::ConnectAPI.auth(
    key_id: key[:key_id],
    issuer_id: key[:issuer_id],
    key: OpenSSL::PKey::EC.new(key[:key])
  )
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("App #{APP_IDENTIFIER} not found in App Store Connect") if app.nil?

  existing = app.get_app_store_versions
  RELEASE_TARGETS.each do |target|
    platform = target[:asc_platform]
    record = existing.find { |v| v.platform == platform }

    if record.nil?
      create_app_store_version(app_id: app.id, platform: platform, version: version)
      UI.success("#{target[:name]}: created App Store version #{version}")
      next
    end

    if record.version_string == version
      UI.message("#{target[:name]}: App Store version already #{version}")
      next
    end

    unless EDITABLE_VERSION_STATES.include?(record.app_store_state)
      # The current record is frozen (in review / live), so renaming it would be
      # rejected. A fresh record is the correct next version.
      create_app_store_version(app_id: app.id, platform: platform, version: version)
      UI.success(
        "#{target[:name]}: #{record.version_string} is #{record.app_store_state}; " \
        "created a new App Store version #{version}"
      )
      next
    end

    Spaceship::ConnectAPI.tunes_request_client.patch(
      "v1/appStoreVersions/#{record.id}",
      data: {
        type: "appStoreVersions",
        id: record.id,
        attributes: { versionString: version }
      }
    )
    UI.success("#{target[:name]}: App Store version #{record.version_string} -> #{version}")
  end
end

# Creates an App Store version record for one platform.
#
# Uses the raw endpoint deliberately: Spaceship exposes no create helper for
# `appStoreVersions`, and this is also the only route that can add a platform the
# App Store Connect UI won't (its universal-purchase flow is iOS-anchored, so an
# app record created tvOS-only offers no way to add iOS).
def create_app_store_version(app_id:, platform:, version:)
  Spaceship::ConnectAPI.tunes_request_client.post(
    "v1/appStoreVersions",
    data: {
      type: "appStoreVersions",
      attributes: { platform: platform, versionString: version },
      relationships: { app: { data: { type: "apps", id: app_id } } }
    }
  )
end

# Release notes shown to testers as TestFlight's "What to Test". Sourced from the
# PLOZZ_WHATS_NEW env var first (so agent/scripted runs can pass it inline), else
# a repo-root WHAT_TO_TEST.txt file (gitignored scratch or committed notes). An
# external beta must have notes, so `beta` errors clearly if both are empty.
def whats_new
  txt = ENV["PLOZZ_WHATS_NEW"]
  if (txt.nil? || txt.strip.empty?)
    path = File.expand_path("../WHAT_TO_TEST.txt", __dir__)
    txt = File.read(path) if File.exist?(path)
  end
  (txt || "").strip
end

# Tags the shipped commit `release/<build>` and opens a GitHub Release with an
# auto changelog (commits since the previous release tag) plus the tester notes.
# Best-effort: a missing/failed `gh` or git push warns but never fails the ship —
# the upload already succeeded by the time this runs.
#
# `build_number` is the CFBundleVersion that was uploaded (sequential TestFlight
# number, set by the `build` lane). Tags are ZERO-PADDED (`release/016`) so the
# GitHub Releases web page — which orders releases by tag name, lexicographically —
# lists newest first (unpadded `release/16` would sort below `release/2` as text).
#
# `prerelease` follows the industry standard for iOS betas: TestFlight builds (the
# `beta` lane) are GitHub **pre-releases** (the orange badge — the canonical beta
# indicator; they intentionally do NOT take the "Latest" slot). A real App Store
# ship (the `release` lane) is a full release and earns the green "Latest" badge.
# The newest beta is still surfaced on the repo page via the README shields.io
# badge (`include_prereleases`).
# Tagging is not allowed to fail the lane — by the time it runs the build is
# already uploaded, and a non-zero exit would invite a re-run that uploads twice.
# But it is also not allowed to disappear, which is what happened to builds 25 and
# 26: a `UI.important` five minutes into a ten-minute log is not a report anyone
# reads. Failures are collected here and re-printed as the LAST thing the lane
# says, with the command to finish the job by hand.
def note_release_tagging_failure(message, manual_command)
  @release_tagging_failures ||= []
  @release_tagging_failures << [message, manual_command]
  UI.error(message)
  nil
end

def report_release_tagging_failures
  return if @release_tagging_failures.nil? || @release_tagging_failures.empty?

  UI.error("─" * 72)
  UI.error("ACTION REQUIRED — the build shipped, but its release tag did not.")
  @release_tagging_failures.each do |message, command|
    UI.error("  • #{message}")
    UI.error("    run: #{command}")
  end
  UI.error("─" * 72)
  @release_tagging_failures = []
end

def tag_github_release(build_number, notes, prerelease)
  return UI.important("No build number available; skipping release tag.") if build_number.nil? || build_number.to_s.strip.empty?

  # APPEND the override rather than `||=`-ing it. The host injects
  # `safe.bareRepository=explicit` (and credential helpers) into this variable, so
  # it is never nil and `||=` was silently a no-op — the override this line exists
  # to apply never applied. Later entries win, so appending both overrides the
  # restriction and preserves the credentials sharing the variable.
  #
  # This is a latent correctness fix, not a proven cause of the missing 025/026
  # tags: a *linked worktree* is not a bare repo, so `explicit` does not actually
  # block git here (verified). Why those two tags never appeared is unknown — the
  # likeliest explanation is that they were uploaded outside `fastlane beta`. The
  # reporting below is the part that makes the next occurrence visible.
  ENV["GIT_CONFIG_PARAMETERS"] =
    [ENV["GIT_CONFIG_PARAMETERS"], "'safe.bareRepository=all'"]
      .compact.reject(&:empty?).join(" ")
  ident = "-c user.name='Brandon Moore' -c user.email='16313090+thatcube@users.noreply.github.com'"
  n = build_number.to_i
  tag = format("release/%03d", n)
  prev_tag = format("release/%03d", n - 1)

  begin
    sh("cd .. && git #{ident} tag -a -f #{tag} -m 'TestFlight build #{build_number}'")
    sh("cd .. && git push origin -f #{tag}")
  rescue => e
    return note_release_tagging_failure(
      "Tagging #{tag} failed: #{e.message}",
      "cd #{Dir.pwd}/.. && git #{ident} tag -a -f #{tag} -m 'TestFlight build #{build_number}' && git push origin -f #{tag}"
    )
  end

  has_prev = (sh("cd .. && git rev-parse -q --verify refs/tags/#{prev_tag} >/dev/null 2>&1 && echo yes || echo no").strip == "yes")
  changelog =
    if has_prev
      (sh("cd .. && git log --no-merges --pretty='- %s' #{prev_tag}..#{tag}").strip)
    else
      "- Initial tagged release."
    end
  changelog = "- (no changes recorded)" if changelog.empty?

  # Release title = the app's CalVer marketing version (e.g. "2026.7.18"), read from
  # the generated project (generate-project.sh bakes MARKETING_VERSION = build date).
  # Falls back to today's CalVer if it can't be read. The build number still shows in
  # the release via its `release/<NNN>` tag, so same-day builds remain distinguishable.
  today_cal = "#{Time.now.year}.#{Time.now.month}.#{Time.now.day}"
  version =
    begin
      v = sh("cd .. && grep -m1 'MARKETING_VERSION' Plozz.xcodeproj/project.pbxproj 2>/dev/null | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' || true").strip
      v.empty? ? today_cal : v
    rescue
      today_cal
    end
  date = Time.now.strftime("%Y-%m-%d")
  body = +"TestFlight build #{build_number} — #{date}\n"
  body << "\nWhat to Test:\n#{notes.strip}\n" unless notes.strip.empty?
  body << "\nChanges:\n#{changelog}\n"

  require "tempfile"
  file = Tempfile.new(["release-#{build_number}", ".md"])
  file.write(body)
  file.close
  # Beta (TestFlight) → pre-release badge; App Store release → full "Latest".
  flag = prerelease ? "--prerelease" : "--latest"
  begin
    sh("cd .. && gh release create #{tag} --verify-tag --title #{version.shellescape} --notes-file #{file.path.shellescape} #{flag}")
    UI.success("Created GitHub #{prerelease ? 'pre-release' : 'release'} #{tag} (#{version})")
  rescue => e
    note_release_tagging_failure(
      "GitHub release for #{tag} failed: #{e.message} (the tag IS pushed)",
      "cd #{Dir.pwd}/.. && gh release create #{tag} --verify-tag --title #{version.shellescape} #{flag}"
    )
  ensure
    file.unlink
  end
end

desc "Regenerate the Xcode project from project.yml via XcodeGen"
lane :generate_project do
  # generate-project.sh runs xcodegen and bakes the build number (PLOZZ_BUILD_NUMBER
  # override, else git commit count) into CFBundleVersion so it's never missed.
  sh("cd .. && ./tools/generate-project.sh")
end

desc "Archive signed tvOS and universal iOS/iPadOS App Store .ipa files"
lane :build do |options|
  # App Store Connect rejects beta-SDK builds, and this machine's active toolchain
  # is the Xcode beta — force a release Xcode before anything compiles.
  select_release_xcode

  # Crash reporting is only *possible* when a DSN is baked in — without one the
  # app installs a NoopCrashReporter and every tester crash is lost silently.
  # Distribution builds are exactly the ones we can't debug over a cable, so
  # refuse to ship one blind.
  require_crash_reporting_dsn

  # Build number must strictly increase per upload for a given marketing version.
  # TestFlight is the source of truth, so derive the next build from (latest
  # TestFlight build + 1). Set it BEFORE generating the project so generate-project.sh
  # bakes it into CFBundleVersion for both the app and the Top Shelf extension.
  # Marketing version (CFBundleShortVersionString) is auto-derived — CalVer by
  # default, or PLOZZ_MARKETING_VERSION for a hand-chosen release name — and
  # `release` writes the same value to the App Store version records.
  build_number = next_build_number
  ENV["PLOZZ_BUILD_NUMBER"] = build_number.to_s
  UI.message("Using build number #{build_number} (CFBundleVersion)")

  # Pin the marketing version for this run so generate-project.sh bakes exactly
  # the value `release` will later write to the App Store version records —
  # rather than each deriving CalVer separately and disagreeing at midnight.
  ENV["PLOZZ_MARKETING_VERSION"] = marketing_version
  UI.message("Using marketing version #{marketing_version} (CFBundleShortVersionString)")

  # Let Xcode create/download the distribution certificate and provisioning
  # profile on first run, authenticating with the same App Store Connect API key.
  prov_args = "-allowProvisioningUpdates"
  if ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_PATH"]
    prov_args += " -authenticationKeyPath #{ENV['ASC_KEY_PATH'].shellescape}" \
                 " -authenticationKeyID #{ENV['ASC_KEY_ID'].shellescape}" \
                 " -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID'].shellescape}"
  end
  RELEASE_TARGETS.each_with_index do |target, index|
    UI.header("Archiving #{target[:name]}")
    generate_project
    build_app(
      project: XCODEPROJ,
      scheme: target[:scheme],
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUTPUT_DIR,
      output_name: target[:output_name],
      archive_path: target[:archive_path],
      clean: index.zero?,
      xcargs: prov_args
    )
  end
end

desc "Build and upload tvOS plus iOS/iPadOS to TestFlight"
lane :beta do
  api_key = asc_api_key
  # Bake the channel into the binary rather than leaving the app to infer it from
  # an App Store receipt — on tvOS that receipt can be absent, which would make a
  # TestFlight build read as production and default crash reporting OFF.
  ENV["PLOZZ_RELEASE_CHANNEL"] = "testflight"
  # An external beta must ship with "What to Test" notes and passes Apple's beta
  # review, so require the notes up front before spending minutes on the build.
  notes = whats_new
  if notes.empty?
    UI.user_error!(
      "No release notes for the external beta. Provide them before running `beta`:\n" \
      "  • export PLOZZ_WHATS_NEW=\"...\"   (inline), or\n" \
      "  • create WHAT_TO_TEST.txt at the repo root."
    )
  end
  build
  RELEASE_TARGETS.each do |target|
    UI.header("Uploading #{target[:name]} to TestFlight")
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: target[:platform],
      ipa: File.join(OUTPUT_DIR, target[:output_name]),
      distribute_external: true,
      groups: [EXTERNAL_GROUP],
      notify_external_testers: true,
      changelog: notes,
      submit_beta_review: true,
      skip_waiting_for_build_processing: false
    )
  end

  # Tag the shipped commit and open a GitHub PRE-release (TestFlight beta) with the
  # changelog + tester notes.
  tag_github_release(ENV["PLOZZ_BUILD_NUMBER"], notes, true)
  report_release_tagging_failures
end

desc "Build and upload tvOS plus iOS/iPadOS to the App Store"
lane :release do
  api_key = asc_api_key
  ENV["PLOZZ_RELEASE_CHANNEL"] = "production"
  build
  # Keep every platform's App Store version record in step with the binaries
  # being uploaded. Review rejects a mismatch, and CalVer moves on its own.
  sync_app_store_versions(marketing_version)
  RELEASE_TARGETS.each do |target|
    UI.header("Uploading #{target[:name]} to App Store Connect")
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      platform: target[:platform],
      ipa: File.join(OUTPUT_DIR, target[:output_name]),
      submit_for_review: false,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  # Tag the shipped commit and open a full GitHub release (marked "Latest") with the
  # changelog and any notes — this is a production App Store ship, not a beta.
  tag_github_release(ENV["PLOZZ_BUILD_NUMBER"], whats_new, false)
  report_release_tagging_failures
end
