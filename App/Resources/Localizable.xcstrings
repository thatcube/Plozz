          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz Plozz na Apple TV lub innym zalogowanym urządzeniu, a pojawi się propozycja automatycznego skonfigurowania tego urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra o Plozz na sua Apple TV ou em outro dispositivo conectado, e ele vai oferecer a opção de configurar este dispositivo automaticamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn Plozz på dit Apple TV eller en anden enhed, der er logget ind, så tilbyder Plozz automatisk at konfigurere denne enhed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez Plozz sur votre Apple TV ou un autre appareil connecté, et il vous proposera de configurer celui-ci automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте Plozz на Apple TV или другом устройстве, где выполнен вход, и приложение предложит настроить это устройство автоматически."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otevřete Plozz na Apple TV nebo jiném přihlášeném zařízení a nabídne, že toto zařízení nastaví automaticky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne Plozz auf deinem Apple TV oder einem anderen angemeldeten Gerät – dort wird dir angeboten, dieses Gerät automatisch einzurichten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri Plozz sulla tua Apple TV o su un altro dispositivo su cui hai già effettuato l’accesso. Plozz ti proporrà automaticamente di configurare questo dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öppna Plozz på din Apple TV eller en annan inloggad enhet, så erbjuder den att konfigurera den här automatiskt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite Plozz na svom Apple TV-u ili drugom prijavljenom uređaju i ponudit će da automatski postavi ovaj uređaj."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka Plozz pada Apple TV atau peranti lain yang telah log masuk, dan ia akan menawarkan untuk menyediakannya secara automatik."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorte Plozz na Apple TV alebo inom prihlásenom zariadení a ponúkne automatické nastavenie tohto zariadenia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте Plozz на своєму Apple TV або іншому авторизованому пристрої, і він пропонуватиме налаштувати цей пристрій автоматично."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka Plozz di Apple TV atau perangkat lain yang sudah masuk, lalu Plozz akan menawarkan untuk menyiapkan perangkat ini secara otomatis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple TV’nizde veya oturum açılmış başka bir aygıtta Plozz’u açın; bu aygıtı otomatik olarak ayarlama seçeneği sunulur."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obre Plozz al teu Apple TV o a un altre dispositiu amb la sessió iniciada i t'oferirà configurar-lo automàticament."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deschide Plozz pe Apple TV sau pe alt dispozitiv conectat și ți se va propune automat să configurezi acest dispozitiv."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פתח את Plozz ב-Apple TV או במכשיר מחובר אחר, והיא תציע להגדיר את המכשיר הזה אוטומטית."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odprite Plozz v Apple TV-ju ali drugi prijavljeni napravi, pa bo samodejno ponudil nastavitev te naprave."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด Plozz บน Apple TV ของคุณหรืออุปกรณ์อื่นที่ลงชื่อเข้าใช้อยู่ แล้วระบบจะเสนอให้ตั้งค่าอุปกรณ์นี้โดยอัตโนมัติ"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отворете Plozz на своя Apple TV или друго устройство, на което сте влезли, и приложението ще предложи автоматично да настрои това устройство."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avaa Plozz Apple TV:llä tai muulla laitteella, johon olet kirjautunut, niin se tarjoutuu ottamaan tämän laitteen käyttöön automaattisesti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne Plozz på Apple TV-en eller en annen pålogget enhet. Plozz tilbyr automatisk å konfigurere denne enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 Apple TV 或其他已登录设备上打开 Plozz，它会自动提示设置此设备。"
          }
        }
      }
    },
