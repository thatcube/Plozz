    "No servers are available on this %@.": {
      "comment": "Empty-state text on the iOS Settings > Servers page when this device has no signed-in servers. %@ is the current device name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er zijn geen servers beschikbaar op deze %@."
          }
        },
        "pl": {
