          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přihlášení a síťová sdílení jsou dostupná všem profilům v zařízení %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anmeldungen und Netzwerkfreigaben stehen allen Profilen auf diesem %@ zur Verfügung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accessi e condivisioni di rete sono disponibili per tutti i profili su questo %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inloggningar och nätverksdelningar är tillgängliga för alla profiler på denna %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijave i mrežna dijeljenja dostupni su svakom profilu na uređaju %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Log masuk dan perkongsian rangkaian tersedia untuk semua profil pada %@ ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
