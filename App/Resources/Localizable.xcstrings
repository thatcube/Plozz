    "Download a movie or episode from its detail page to watch offline.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Download een film of aflevering vanaf de detailpagina om offline te kijken."
          }
        },
        "pl": {
          "stringUnit": {
