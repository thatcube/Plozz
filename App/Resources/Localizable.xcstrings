    "Open Jellyfin on another device, choose **Quick Connect**, and enter this code.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Open Jellyfin op een ander apparaat, kies **Quick Connect** en voer deze code in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz Jellyfin na innym urządzeniu, wybierz **Quick Connect** i wpisz ten kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra o Jellyfin em outro dispositivo, escolha **Quick Connect** e digite este código."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn Jellyfin på en anden enhed, vælg **Quick Connect**, og indtast denne kode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez Jellyfin sur un autre appareil, choisissez **Quick Connect** et saisissez ce code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте Jellyfin на другом устройстве, выберите **Quick Connect** и введите этот код."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na jiném zařízení otevřete Jellyfin, zvolte **Quick Connect** a zadejte tento kód."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne Jellyfin auf einem anderen Gerät, wähle **Quick Connect** und gib diesen Code ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri Jellyfin su un altro dispositivo, scegli **Quick Connect** e inserisci questo codice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öppna Jellyfin på en annan enhet, välj **Quick Connect** och ange den här koden."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorite Jellyfin na drugom uređaju, odaberite **Quick Connect** i unesite ovaj kod."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka Jellyfin pada peranti lain, pilih **Quick Connect**, dan masukkan kod ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otvorte Jellyfin na inom zariadení, vyberte **Quick Connect** a zadajte tento kód."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте Jellyfin на іншому пристрої, виберіть **Quick Connect** і введіть цей код."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka Jellyfin di perangkat lain, pilih **Quick Connect**, lalu masukkan kode ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Başka bir aygıtta Jellyfin’i açın, **Quick Connect** seçeneğini belirleyip bu kodu girin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obre Jellyfin en un altre dispositiu, tria **Quick Connect** i introdueix aquest codi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deschide Jellyfin pe alt dispozitiv, alege **Quick Connect** și introdu acest cod."
          }
        }
      }
    },
