    "Your libraries are empty. Add media on your media server to see it here.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je bibliotheken zijn leeg. Voeg media toe aan je mediaserver om die hier te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biblioteki są puste. Dodaj multimedia na serwerze multimediów, aby zobaczyć je tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suas bibliotecas estão vazias. Adicione mídia ao seu servidor de mídia para vê-la aqui."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dine biblioteker er tomme. Tilføj medier på din medieserver for at se dem her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos bibliothèques multimédias sont vides. Ajoutez des médias à votre serveur multimédia pour les voir ici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваши медиатеки пусты. Добавьте медиа на ваш медиасервер, чтобы увидеть их здесь."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaše knihovny jsou prázdné. Přidejte média na svůj mediální server a zobrazí se tady."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Medienbibliotheken sind leer. Füge auf deinem Medienserver Medien hinzu, damit sie hier erscheinen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le tue librerie sono vuote. Aggiungi contenuti multimediali sul tuo server multimediale per vederli qui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dina bibliotek är tomma. Lägg till medier på medieservern så visas de här."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaše su knjižnice prazne. Dodajte medije na svoj poslužitelj medija da biste ih vidjeli ovdje."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pustaka anda kosong. Tambah media pada pelayan media anda untuk melihatnya di sini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaše knižnice sú prázdne. Pridajte médiá na svoj mediálny server, aby sa zobrazili aj tu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваші медіатеки порожні. Додайте медіа на медіасервер, щоб побачити їх тут."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pustaka Anda kosong. Tambahkan media di server media Anda untuk melihatnya di sini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kitaplıklarınız boş. Burada görmek için medya sunucunuza medya ekleyin."
          }
        },
        "ca": {
          "stringUnit": {
