    "Diagnostic tools are now shown at the bottom of Settings. Turn them off again from the Developer Mode row.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnostische tools worden nu onderaan Instellingen weergegeven. Zet ze weer uit via de rij Ontwikkelaarsmodus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Narzędzia diagnostyczne są teraz widoczne na dole Ustawień. Wyłącz je ponownie w wierszu Tryb deweloperski."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As ferramentas de diagnóstico agora aparecem no fim de Ajustes. Para ocultá-las novamente, use a opção Modo de desenvolvedor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnoseværktøjer vises nu nederst i Indstillinger. Slå dem fra igen fra rækken Udviklertilstand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les outils de diagnostic sont maintenant affichés en bas de Réglages. Désactivez-les à nouveau depuis la ligne Mode développeur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Средства диагностики теперь отображаются внизу Настроек. Выключить их можно снова в строке «Режим разработчика»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nástroje diagnostiky se nyní zobrazují v dolní části Nastavení. Znovu je vypnete v řádku Režim vývojáře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnosewerkzeuge werden jetzt unten in den Einstellungen angezeigt. Über die Zeile „Entwicklermodus“ kannst du sie wieder ausschalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli strumenti di diagnostica sono ora visibili in fondo alle Impostazioni. Disattivali di nuovo dalla riga Modalità sviluppatore."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnostikverktygen visas nu längst ner i Inställningar. Stäng av dem igen från raden Utvecklarläge."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dijagnostički alati sada se prikazuju pri dnu Postavki. Ponovno ih isključite u retku Razvojni način."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alat diagnostik kini dipaparkan di bahagian bawah Tetapan. Matikannya semula daripada baris Mod Pembangun."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnostické nástroje sa teraz zobrazujú v spodnej časti Nastavení. Znova ich vypnete v riadku Režim vývojára."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Засоби діагностики тепер показано внизу Налаштувань. Їх можна знову вимкнути в рядку «Режим розробника»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alat diagnostik kini ditampilkan di bagian bawah Pengaturan. Matikan lagi dari baris Mode Pengembang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tanılama araçları artık Ayarlar’ın en altında gösteriliyor. Bunları Geliştirici Modu satırından yeniden kapatabilirsiniz."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ara les eines de diagnòstic es mostren a la part inferior de Configuració. Torna-les a desactivar des de la fila Mode de desenvolupador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Instrumentele de diagnosticare sunt afișate acum în partea de jos a paginii Setări. Dezactivează-le din nou din rândul Mod dezvoltator."
          }
        }
      }
    },
    "Diagnostic tools are now shown in Settings under Developer. Turn them off again from that section.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnostische tools worden nu weergegeven in Instellingen onder Ontwikkelaar. Zet ze weer uit via dat gedeelte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Narzędzia diagnostyczne są teraz widoczne w Ustawieniach w sekcji Deweloper. Wyłącz je ponownie w tej sekcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As ferramentas de diagnóstico agora aparecem em Ajustes, na seção Desenvolvedor. Desative-as novamente nessa seção."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnoseværktøjer vises nu i Indstillinger under Udvikler. Slå dem fra igen fra det afsnit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les outils de diagnostic sont maintenant affichés dans Réglages, sous Développeur. Désactivez-les à nouveau depuis cette section."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Средства диагностики теперь отображаются в Настройках в разделе «Для разработчиков». Выключить их можно снова в этом разделе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nástroje diagnostiky se nyní zobrazují v Nastavení v části Vývojář. Znovu je vypnete v této části."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnosewerkzeuge werden jetzt in den Einstellungen unter „Entwickler“ angezeigt. In diesem Bereich kannst du sie wieder ausschalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli strumenti di diagnostica sono ora visibili nelle Impostazioni sotto Sviluppatore. Disattivali di nuovo da quella sezione."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnostikverktygen visas nu i Inställningar under Utvecklare. Stäng av dem igen i det avsnittet."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dijagnostički alati sada se prikazuju u Postavkama pod Razvoj. Ponovno ih isključite u tom odjeljku."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alat diagnostik kini dipaparkan dalam Tetapan di bawah Pembangun. Matikannya semula daripada bahagian itu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnostické nástroje sa teraz zobrazujú v Nastaveniach v časti Vývojár. Znova ich vypnete v tejto časti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Засоби діагностики тепер показано в розділі «Розробник» у Налаштуваннях. Їх можна знову вимкнути в цьому розділі."
          }
        },
        "id": {
