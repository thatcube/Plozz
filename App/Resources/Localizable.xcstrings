    "Thanks! Your recent activity was sent to the developer.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bedankt! Je recente activiteit is verzonden naar de ontwikkelaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dziękujemy! Ostatnia aktywność została wysłana do dewelopera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obrigado! Sua atividade recente foi enviada ao desenvolvedor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tak! Din seneste aktivitet blev sendt til udvikleren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merci ! Votre activité récente a été envoyée au développeur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спасибо! Ваша недавняя активность отправлена разработчику."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Díky! Poslední aktivita byla odeslána vývojáři."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Danke! Deine letzten Aktivitäten wurden an den Entwickler gesendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grazie! La tua attività recente è stata inviata allo sviluppatore."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tack! Din senaste aktivitet skickades till utvecklaren."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvala! Vaša nedavna aktivnost poslana je razvojnom programeru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terima kasih! Aktiviti terkini anda telah dihantar kepada pembangun."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ďakujeme! Vaša nedávna aktivita bola odoslaná vývojárovi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дякуємо! Вашу останню активність надіслано розробнику."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terima kasih! Aktivitas terbaru Anda telah dikirim ke pengembang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teşekkürler! Son etkinliğiniz geliştiriciye gönderildi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gràcies! S'ha enviat la teva activitat recent al desenvolupador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mulțumim! Activitatea recentă a fost trimisă dezvoltatorului."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "תודה! הפעילות האחרונה שלך נשלחה למפתח."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvala! Vaša nedavna dejavnost je bila poslana razvijalcu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ขอบคุณ! กิจกรรมล่าสุดของคุณถูกส่งให้ผู้พัฒนาแล้ว"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Благодарим! Скорошната ви активност беше изпратена на разработчика."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiitos! Viimeaikainen toiminta lähetettiin kehittäjälle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Takk! Den siste aktiviteten ble sendt til utvikleren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "感谢！您的近期活动已发送给开发者。"
          }
        }
      }
    },
