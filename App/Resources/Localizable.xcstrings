    "Applies to Plozz's own labels. Media titles keep the language your server provides, and system prompts follow the device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ينطبق على التسميات الخاصة بـ Plozz. تبقى عناوين الوسائط باللغة التي يوفرها الخادم، وتتبع الرسائل النظامية لغة الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отнася се към собствените етикети на Plozz. Заглавията на медийни файлове запазват езика, който предоставя вашия сървър, а системните подкани следват устройството."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S'aplica a les etiquetes pròpies del Plozz. Els títols multimèdia mantenen l'idioma que proporciona el servidor, i els missatges del sistema segueixen el dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Platí pro vlastní popisky Plozz. Názvy médií zůstávají v jazyce, který poskytuje server, a systémové výzvy se řídí zařízením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gælder for Plozz’ egne tekster. Medietitler beholder det sprog, din server leverer, og systembeskeder følger enhedens sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gilt für die Beschriftungen von Plozz. Medientitel behalten die Sprache, die dein Server liefert, und Systemdialoge richten sich nach dem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ισχύει για τις ίδιες τις ετικέτες του Plozz. Οι τίτλοι πολυμέσων διατηρούν τη γλώσσα που δίνει ο διακομιστής σας και τα μηνύματα συστήματος ακολουθούν τη συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se aplica a las etiquetas propias de Plozz. Los títulos de los medios conservan el idioma que proporciona tu servidor, y los mensajes del sistema siguen el del dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای برچسب‌های خود Plozz اعمال می‌شود. عناوین رسانه‌ها زبانی را که سرور شما ارائه می‌دهد حفظ می‌کنند، و پیام‌های سیستمی مطابق با دستگاه شما هستند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koskee Plozzin omia tekstejä. Medianimikkeet säilyttävät palvelimen tarjoaman kielen, ja järjestelmän kehotteet noudattavat laitteen kieltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S’applique aux libellés de Plozz. Les titres des médias conservent la langue fournie par votre serveur, et les invites système suivent la langue de l’appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "חל על התוויות של Plozz. כותרי המדיה נשארים בשפה שמספק השרת, והודעות המערכת מוצגות בשפת המכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह Plozz के अपने लेबल पर लागू होता है. मीडिया टाइटल वही भाषा रखते हैं जो आपका सर्वर देता है, और सिस्टम प्रॉम्प्ट डिवाइस के अनुसार होते हैं."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Primjenjuje se na vlastite tekstove aplikacije Plozz. Naslovi medija zadržavaju jezik koji pruža poslužitelj, a sustavni upiti slijede jezik uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Plozz saját címkéire vonatkozik. A média címek a szerver által biztosított nyelven maradnak, a rendszer üzenetei pedig a készülék nyelvét követik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Berlaku untuk label Plozz. Judul media tetap memakai bahasa dari server Anda, sedangkan dialog sistem mengikuti perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si applica alle etichette di Plozz. I titoli multimediali mantengono la lingua fornita dal server e i messaggi di sistema seguono il dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plozz独自のラベルに適用されます。メディアタイトルはサーバが提供する言語を保持し、システムプロンプトはデバイスの言語に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plozz 자체 라벨에 적용됩니다. 미디어 제목은 서버에서 제공하는 언어를 유지하며, 시스템 프롬프트는 기기 언어를 따릅니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Terpakai pada label Plozz sendiri. Tajuk media mengekalkan bahasa yang disediakan oleh pelayan anda, dan gesaan sistem mengikut peranti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gjelder Plozz sine egne tekster. Medietitler beholder språket fra serveren, og systemmeldinger følger enhetens språk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geldt voor Plozz’ eigen labels. Mediatitels behouden de taal die je server aanlevert, en systeemmeldingen volgen het apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dotyczy własnych etykiet Plozz. Tytuły multimediów zachowują język z serwera, a komunikaty systemowe są zgodne z urządzeniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Isso se aplica aos próprios rótulos do Plozz. Os títulos de mídia mantêm o idioma fornecido pelo servidor, e as mensagens do sistema seguem o dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se aplică etichetelor proprii ale Plozz. Titlurile media păstrează limba oferită de server, iar mesajele de sistem urmează dispozitivul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Относится только к интерфейсу Plozz. Названия медиа остаются на языке сервера, а системные сообщения — на языке устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vzťahuje sa na vlastné texty aplikácie Plozz. Názvy médií zostávajú v jazyku poskytovanom serverom a systémové výzvy sa riadia zariadením."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Velja za lastne oznake aplikacije Plozz. Naslovi medijev ostanejo v jeziku, ki ga ponuja vaš strežnik, sistemski pozivi pa sledijo napravi."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odnosi se na oznake u Plozz aplikaciji. Naslovi medija ostaju na jeziku koji pruža vaš server, a sistemske poruke prate uređaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gäller Plozz egna texter. Medietitlar behåller språket från servern och systemdialogrutor följer enhetens språk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "มีผลกับป้ายกำกับของ Plozz เองเท่านั้น ชื่อสื่อจะยังคงใช้ภาษาที่เซิร์ฟเวอร์ของคุณกำหนด และข้อความแจ้งเตือนของระบบจะเป็นไปตามอุปกรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plozz’un kendi etiketleri için geçerlidir. Yapım adları sunucunuzun sağladığı dilde kalır; sistem iletileri aygıtın dilini kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Застосовується до власних написів Plozz. Назви медіа залишаються мовою, яку надає сервер, а системні повідомлення відповідають мові пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Áp dụng cho nhãn của Plozz. Tiêu đề phương tiện giữ nguyên ngôn ngữ do máy chủ cung cấp, và lời nhắc hệ thống theo ngôn ngữ thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "适用于 Plozz 自有的标签。媒体标题保持服务器提供的语言，系统提示遵循设备设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
