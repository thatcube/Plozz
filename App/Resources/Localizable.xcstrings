    "Couldn’t reach that server. Check the address and network.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan die server niet bereiken. Controleer het adres en netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się połączyć z tym serwerem. Sprawdź adres i sieć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível acessar esse servidor. Verifique o endereço e a rede."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke få forbindelse til den server. Tjek adressen og netværket."
          }
