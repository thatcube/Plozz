            "state": "needs_review",
            "value": "Постоянно делает изображение теплее с максимальной интенсивностью."
          }
        }
      }
    },
    "circadianMode.detail.auto": {
      "comment": "One-line explanation shown under the Circadian mode picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Warms automatically from sunset to sunrise for your location."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geeft het beeld van zonsondergang tot zonsopgang automatisch een warmere tint op basis van je locatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Automatycznie ociepla obraz od zachodu do wschodu słońca w tej lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquece automaticamente do pôr do sol ao nascer do sol de acordo com sua localização."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varmer automatisk fra solnedgang til solopgang på din placering."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réchauffe automatiquement l’image du coucher au lever du soleil selon votre position."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Автоматически делает изображение теплее от заката до рассвета для вашего местоположения."
          }
        }
      }
    },
    "circadianMode.detail.manual": {
      "comment": "One-line explanation shown under the Circadian mode picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Warms between two times you set each day."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geeft het beeld elke dag tussen twee door jou ingestelde tijden een warmere tint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ociepla obraz między dwoma godzinami ustawionymi na każdy dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquece entre dois horários que você define todos os dias."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varmer mellem to tidspunkter, du selv angiver hver dag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réchauffe l’image entre deux heures que vous définissez chaque jour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Делает изображение теплее между двумя заданными вами моментами времени каждый день."
          }
        }
      }
    },
    "circadianMode.detail.off": {
