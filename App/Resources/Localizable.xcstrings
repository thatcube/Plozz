    "System prompts and the player's own on-screen controls follow the Apple TV's language, not this setting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الرسائل النظامية وعناصر التحكم على الشاشة في المشغل تتبع لغة Apple TV وليس هذا الإعداد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Системните подкани и екранните контроли на плейъра използват езика на Apple TV, а не тази настройка."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els missatges del sistema i els controls en pantalla propis del reproductor segueixen l'idioma de l'Apple TV, no aquesta configuració."
