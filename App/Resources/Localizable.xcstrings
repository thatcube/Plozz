          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selesaikan otorisasi di browser, lalu masukkan kode singkat yang ditampilkan di sana."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
