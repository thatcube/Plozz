    "themeMusic.detail.high": {
      "comment": "One-line explanation shown under the theme-music volume picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The loudest theme level, still capped below full volume."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het luidste themaniveau, nog altijd onder het maximale volume."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najgłośniejszy poziom muzyki motywu, nadal ograniczony poniżej pełnej głośności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O volume mais alto para o tema, ainda abaixo do volume máximo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den højeste lydstyrke for temamusik, stadig begrænset til under fuld lydstyrke."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le niveau le plus fort, tout en restant sous le volume maximal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Самый высокий уровень, но всё ещё ниже полной громкости."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nejhlasitější úroveň hudby motivu, stále omezená pod plnou hlasitost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die lauteste Stufe – bleibt dennoch unter der vollen Lautstärke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il volume più alto per la musica del tema, comunque inferiore al massimo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den högsta temanivån, men fortfarande under full volym."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najglasnija razina tematske glazbe, i dalje ograničena ispod pune glasnoće."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tahap tema paling lantang, masih dihadkan di bawah kelantangan penuh."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najhlasnejšia úroveň hudby motívu, stále nižšia než plná hlasitosť."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Найгучніший рівень тематичної музики, однак нижчий за повну гучність."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Level musik tema paling keras, tetap dibatasi di bawah volume penuh."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En yüksek tema düzeyi; yine de tam ses düzeyinin altında tutulur."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El nivell més alt de música temàtica, encara limitat per sota del volum màxim."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cel mai ridicat nivel, dar tot sub volumul maxim."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "רמת מוזיקת הנושא הרועשת ביותר, עדיין מוגבלת מתחת לעוצמה מלאה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najglasnejša raven tematske glasbe, še vedno omejena pod polno glasnostjo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ดังที่สุด แต่ยังไม่ถึงระดับเสียงเต็ม"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Най-силното ниво на тематичната музика, все пак ограничено под пълната сила на звука."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kovin tunnusmusiikin taso, silti täyttä äänenvoimakkuutta hiljaisempi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Høyeste nivå for temamusikk, fortsatt begrenset til under full lydstyrke."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最响亮的主题音量，但仍低于最大音量。"
          }
        }
      }
    },
