    "settings.parentalPIN.explanation" : {
      "comment" : "Subtitle of the Parental PIN page. Must stay honest that a Kids Profile alone restricts nothing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "رمز واحد للأسرة. بدونه، لا تكون الملفات الشخصية للأطفال مقيّدة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Един PIN за домакинството. Без него детските профили не са ограничени."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un PIN per a tota la llar. Sense aquest PIN, els perfils infantils no estan restringits."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeden PIN pro celou domácnost. Bez něj nejsou dětské profily omezené."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Én PIN for husstanden. Uden den er børneprofiler ikke begrænsede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine PIN für den Haushalt. Ohne sie sind Kinderprofile nicht eingeschränkt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ένα PIN για όλο το σπίτι. Χωρίς αυτό, τα Παιδικά προφίλ δεν είναι περιορισμένα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "One PIN for the household. Without it, Kids Profiles aren't restricted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un PIN para todo el hogar. Sin él, los Perfiles infantiles no están restringidos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "یک PIN برای کل خانوار. بدون آن، نمایه‌های کودک محدود نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yksi PIN koko kotitaloudelle. Ilman sitä lapsiprofiileja ei rajoiteta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un seul code PIN pour le foyer. Sans celui-ci, les profils enfants ne sont pas restreints."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PIN אחד למשק הבית. בלעדיו, פרופילי ילדים אינם מוגבלים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पूरे घर के लिए एक PIN. इसके बिना, किड्स प्रोफ़ाइल प्रतिबंधित नहीं होतीं."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jedan PIN za kućanstvo. Bez njega, Dječji profili nisu ograničeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
