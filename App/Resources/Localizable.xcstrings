    "Couldn't connect to the server. Check the address and that it's on the same network, then try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan geen verbinding maken met de server. Controleer het adres en of de server zich op hetzelfde netwerk bevindt en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się połączyć z serwerem. Sprawdź adres i czy jest w tej samej sieci, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível conectar ao servidor. Verifique o endereço e se ele está na mesma rede, depois tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke oprette forbindelse til serveren. Tjek adressen, og at den er på samme netværk, og prøv igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de se connecter au serveur. Vérifiez l’adresse, assurez-vous qu’il se trouve sur le même réseau, puis réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось подключиться к серверу. Проверьте адрес и убедитесь, что он в той же сети, затем повторите попытку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepodařilo se připojit k serveru. Zkontrolujte adresu a to, že je na stejné síti, a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbindung zum Server nicht möglich. Prüfe die Adresse und ob er sich im selben Netzwerk befindet, und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile connettersi al server. Verifica l’indirizzo e che sia sulla stessa rete, quindi riprova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det gick inte att ansluta till servern. Kontrollera adressen och att den är på samma nätverk, och försök sedan igen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povezivanje s poslužiteljem nije uspjelo. Provjerite adresu i je li na istoj mreži, a zatim pokušajte ponovno."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat menyambung ke pelayan. Semak alamat dan pastikan ia berada pada rangkaian yang sama, kemudian cuba lagi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepodarilo sa pripojiť k serveru. Skontrolujte adresu a či je v rovnakej sieti, potom to skúste znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося підключитися до сервера. Перевірте адресу й те, що він у тій же мережі, потім спробуйте знову."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat terhubung ke server. Periksa alamatnya dan pastikan berada di jaringan yang sama, lalu coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sunucuya bağlanılamadı. Adresi ve aynı ağda olup olmadığını kontrol edip tekrar deneyin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No s’ha pogut connectar amb el servidor. Comprova l’adreça i que estigui a la mateixa xarxa, i torna-ho a provar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nu s-a putut conecta la server. Verifică adresa și dacă este în aceeași rețea, apoi încearcă din nou."
          }
        }
      }
    },
