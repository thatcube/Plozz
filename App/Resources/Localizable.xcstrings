    "Connections are stored separately for each Plozz profile. Playback progress is sent to every connected tracker.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbindingen worden apart opgeslagen voor elk Plozz-profiel. Kijkvoortgang wordt naar elke verbonden tracker gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połączenia są przechowywane osobno dla każdego profilu Plozz. Postęp odtwarzania jest wysyłany do każdego połączonego serwisu śledzącego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As conexões são armazenadas separadamente para cada perfil do Plozz. O progresso da reprodução é enviado para todos os rastreadores conectados."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbindelser gemmes separat for hver Plozz-profil. Afspilningsfremgang sendes til alle forbundne trackere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les connexions sont stockées séparément pour chaque profil Plozz. La progression de lecture est envoyée à chaque service de suivi connecté."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключения хранятся отдельно для каждого профиля Plozz. Прогресс воспроизведения отправляется в каждый подключённый трекер."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojení se ukládají zvlášť pro každý profil Plozz. Postup přehrávání se odesílá do všech připojených služeb sledování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
