    "settings.profileLock.forgot.detail" : {
      "comment" : "Explains how to recover from a forgotten Profile Lock PIN. There is no email reset because Plozz has no account of its own.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُمسح القفل عند إزالته من جهاز آخر مسجّل الدخول، أو عند تسجيل الخروج وإعداد Plozz من جديد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Премахването на заключването от друго влязло устройство или излизането и повторното настройване на Plozz ще го изчисти."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El bloqueig s’esborrarà si l’elimines des d’un altre dispositiu amb sessió iniciada, o si tanques la sessió i tornes a configurar Plozz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zámek se zruší, když ho odstraníte z jiného přihlášeného zařízení nebo když se odhlásíte a nastavíte Plozz znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Låsen kan ryddes fra en anden enhed, hvor du er logget ind, eller ved at logge ud og konfigurere Plozz igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Sperre wird entfernt, wenn du sie auf einem anderen angemeldeten Gerät aufhebst oder dich abmeldest und Plozz neu einrichtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το κλείδωμα θα καταργηθεί αν το αφαιρέσετε από άλλη συσκευή όπου έχετε συνδεθεί ή αν αποσυνδεθείτε και ρυθμίσετε ξανά το Plozz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Removing the lock from another signed-in device, or signing out and setting Plozz up again, will clear it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El bloqueo se eliminará si lo quitas desde otro dispositivo con sesión iniciada o si cierras sesión y vuelves a configurar Plozz."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حذف قفل از دستگاه دیگری که در آن وارد شده‌اید، یا خروج و راه‌اندازی مجدد Plozz، آن را پاک می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lukituksen voi poistaa toiselta kirjautuneelta laitteelta tai kirjautumalla ulos ja määrittämällä Plozz uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprimer le verrouillage depuis un autre appareil connecté, ou se déconnecter et reconfigurer Plozz, le réinitialisera."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הסרת הנעילה ממכשיר אחר שבו אתם מחוברים, או יציאה והגדרה מחדש של Plozz, תאפס אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "किसी दूसरे साइन इन किए गए डिवाइस से लॉक हटाने या साइन आउट करके Plozz को दोबारा सेट अप करने से लॉक हट जाएगा."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zaključavanje možete ukloniti na drugom prijavljenom uređaju ili se odjaviti i ponovno postaviti Plozz."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A zárolás eltávolítható egy másik bejelentkezett eszközről, vagy a Plozzból való kijelentkezéssel és a Plozz újbóli beállításával."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kunci ini dapat dihapus dari perangkat lain yang sudah masuk, atau dengan keluar lalu mengatur ulang Plozz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rimuovendo il blocco da un altro dispositivo collegato, oppure uscendo e riconfigurando Plozz, il blocco verrà cancellato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "別のサインイン済みデバイスからロックを解除するか、サインアウトしてPlozzを再設定すると解除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "다른 로그인된 기기에서 잠금을 제거하거나, 로그아웃 후 Plozz를 다시 설정하면 해제됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mengalih keluar kunci pada peranti lain yang dilog masuk, atau log keluar dan menyediakan semula Plozz, akan memadamkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kan fjerne låsen fra en annen pålogget enhet, eller logge av og sette opp Plozz på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwijder de vergrendeling vanaf een ander aangemeld apparaat, of meld je af en stel Plozz opnieuw in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usuń blokadę z innego zalogowanego urządzenia lub wyloguj się i skonfiguruj Plozz od nowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remova o bloqueio de outro dispositivo conectado, ou saia e configure o Plozz novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poți elimina blocarea de pe un alt dispozitiv conectat sau deconectându-te și configurând din nou Plozz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Снять блокировку можно на другом устройстве, где выполнен вход, либо выйдя из системы и настроив Plozz заново."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odstránenie zámku z iného prihláseného zariadenia alebo odhlásenie a opätovné nastavenie aplikácie Plozz ho vymaže."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odstranitev zaklepanja z druge prijavljene naprave ali odjava in ponovna nastavitev aplikacije Plozz ga bosta izbrisali."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uklanjanje zaključavanja sa drugog prijavljenog uređaja ili odjavljivanje i ponovno podešavanje aplikacije Plozz obrisaće ga."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Om du tar bort låset från en annan inloggad enhet, eller loggar ut och konfigurerar Plozz igen, rensas det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การลบล็อกจากอุปกรณ์อื่นที่ลงชื่อเข้าใช้อยู่ หรือการออกจากระบบแล้วตั้งค่า Plozz ใหม่จะล้างล็อกนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kilidi oturum açık başka bir cihazdan kaldırmak veya oturumu kapatıp Plozz’u yeniden kurmak kilidi temizler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Блокування буде знято, якщо видалити його з іншого пристрою, на якому виконано вхід, або вийти й налаштувати Plozz заново."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Khóa này sẽ bị xóa khi bạn xóa nó trên một thiết bị khác đã đăng nhập, hoặc đăng xuất rồi thiết lập lại Plozz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在其他已登录的设备上移除此锁定，或退出登录并重新设置 Plozz，即可清除此锁定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
