            "state": "needs_review",
            "value": "Nie udało się zweryfikować certyfikatu tego serwera. Jeśli jest samopodpisany, zatwierdź jego odcisk, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível verificar o certificado deste servidor. Se ele for autoassinado, aprove a impressão digital para continuar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke bekræfte denne servers certifikat. Hvis det er selvsigneret, skal du godkende dets fingeraftryk for at fortsætte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de vérifier le certificat de ce serveur. S’il est auto-signé, approuvez son empreinte pour continuer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось проверить сертификат этого сервера. Если он самоподписанный, подтвердите его отпечаток, чтобы продолжить."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepodařilo se ověřit certifikát tohoto serveru. Pokud je samopodepsaný, schvalte jeho otisk a pokračujte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Zertifikat dieses Servers konnte nicht verifiziert werden. Wenn es selbst signiert ist, bestätige seinen Fingerabdruck, um fortzufahren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
