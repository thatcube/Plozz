    "You can also scan this from the other device’s iCloud Sync settings.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je kunt dit ook scannen in de instellingen voor iCloud-synchronisatie op het andere apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Można też zeskanować kod w ustawieniach synchronizacji z iCloud na drugim urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você também pode escanear isto nos ajustes de Sincronização do iCloud do outro dispositivo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan også scanne denne fra den anden enheds iCloud Sync-indstillinger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez aussi le scanner depuis les réglages de synchronisation iCloud de l’autre appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы также можете отсканировать этот код в настройках синхронизации iCloud на другом устройстве."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Můžete ho také naskenovat z nastavení Synchronizace s iCloudem na druhém zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kannst dies auch in den Einstellungen zur iCloud-Synchronisierung des anderen Geräts scannen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puoi scansionarlo anche dalle impostazioni di Sincronizzazione iCloud sull’altro dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan även skanna detta från inställningarna för iCloud-synkronisering på den andra enheten."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To možete skenirati i iz postavki Sinkronizacije s iCloudom na drugom uređaju."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda juga boleh mengimbas ini daripada tetapan Penyegerakan iCloud peranti lain."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toto môžete naskenovať aj z nastavení Synchronizácie s iCloudom na druhom zariadení."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ви також можете відсканувати це в налаштуваннях синхронізації iCloud на іншому пристрої."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda juga bisa memindainya dari pengaturan Sinkronisasi iCloud di perangkat lain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunu diğer aygıtın iCloud eşzamanlama ayarlarından da tarayabilirsiniz."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "També pots escanejar-ho des de la configuració de sincronització d'iCloud de l'altre dispositiu."
          }
        },
        "ro": {
          "stringUnit": {
