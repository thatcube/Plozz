    "This address is not a WebDAV endpoint.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit adres is geen WebDAV-eindpunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten adres nie jest punktem końcowym WebDAV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este endereço não é um endereço WebDAV válido."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne adresse er ikke et WebDAV-slutpunkt."
          }
        },
        "fr": {
