    "Hide all profile UI for solo use. You can re-enable Profiles anytime.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verberg de volledige profielinterface voor gebruik door één persoon. Je kunt Profielen op elk moment weer inschakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukryj cały interfejs profili do użytku jednoosobowego. Profile możesz włączyć ponownie w dowolnym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oculta toda a interface de perfis para uso individual. Você pode reativar Perfis quando quiser."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skjul hele profilbrugerfladen til brug alene. Du kan altid slå Profiler til igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masquez toute l’interface des profils pour un usage en solo. Vous pourrez réactiver Profils à tout moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скрывает весь интерфейс профилей, если приложением пользуетесь только вы. Профили можно снова включить в любой момент."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skryjte celé rozhraní profilů pro samostatné používání. Profily můžete kdykoli znovu zapnout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blendet die gesamte Profil-Oberfläche für die alleinige Nutzung aus. Du kannst Profile jederzeit wieder aktivieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nascondi tutta l’interfaccia dei profili per l’uso individuale. Puoi riattivare Profili in qualsiasi momento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dölj alla profilgränssnitt för användning av en enda person. Du kan aktivera Profiler igen när som helst."
          }
        }
      }
    },
