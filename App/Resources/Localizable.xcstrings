        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ne vidite ga u blizini? Skenirajte QR ili upišite kratki kod prikazan na drugom uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nem látja a közelben? Szkennelje be a QR-kódot, vagy írja be a másik eszközön megjelenő rövid kódot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
