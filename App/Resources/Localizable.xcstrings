        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모든 미디어 보관함을 선택한 상태로 유지하여 모든 활성화된 미디어 보관함을 포함합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
