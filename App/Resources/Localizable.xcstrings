    "This WebDAV server uses HTTP. Review the security warning, then Connect again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم هذا خادم WebDAV بروتوكول HTTP. راجع تحذير الأمان، ثم اتصل مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Този WebDAV сървър използва HTTP. Прегледайте предупреждението за сигурност, след това натиснете Свързване отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aquest servidor WebDAV utilitza HTTP. Revisa l'avís de seguretat i, després, torna a connectar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tento server WebDAV používá HTTP. Zkontrolujte bezpečnostní upozornění a potom znovu klepněte na Připojit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denne WebDAV-server bruger HTTP. Gennemgå sikkerhedsadvarslen, og tryk derefter på Opret forbindelse igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser WebDAV-Server verwendet HTTP. Sieh dir die Sicherheitswarnung an und verbinde dich dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αυτός ο διακομιστής WebDAV χρησιμοποιεί HTTP. Ελέγξτε την προειδοποίηση ασφαλείας και έπειτα επιλέξτε ξανά Σύνδεση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este servidor WebDAV usa HTTP. Revisa la advertencia de seguridad y luego Conectar de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "این سرور WebDAV از HTTP استفاده می‌کند. هشدار امنیتی را مرور کنید، سپس دوباره متصل شوید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä WebDAV-palvelin käyttää HTTP:tä. Lue turvallisuusvaroitus ja yhdistä sitten uudelleen."
          }
        },
