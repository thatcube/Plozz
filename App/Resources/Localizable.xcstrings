    "%@ doesn’t have permission to request this. Check the user’s permissions in Seerr.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ heeft geen toestemming om dit aan te vragen. Controleer de rechten van de gebruiker in Seerr."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nie ma uprawnień do złożenia tej prośby. Sprawdź uprawnienia użytkownika w Seerr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não tem permissão para fazer essa solicitação. Verifique as permissões do usuário no Seerr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har ikke tilladelse til at anmode om dette. Tjek brugerens tilladelser i Seerr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ n’a pas l’autorisation de faire cette demande. Vérifiez les autorisations de l’utilisateur dans Seerr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не может отправить этот запрос. Проверьте разрешения пользователя в Seerr."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nemá oprávnění o toto požádat. Zkontrolujte oprávnění uživatele ve službě Seerr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ hat keine Berechtigung, das anzufragen. Prüfe die Benutzerrechte in Seerr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ non ha il permesso di richiedere questo. Verifica i permessi dell’utente in Seerr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har inte behörighet att begära detta. Kontrollera användarens behörigheter i Seerr."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nema dopuštenje za podnošenje ovog zahtjeva. Provjerite dopuštenja korisnika u Seerru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ tiada kebenaran untuk memohon ini. Semak kebenaran pengguna dalam Seerr."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nemá oprávnenie o toto požiadať. Skontrolujte oprávnenia používateľa v službe Seerr."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не має дозволу подати цей запит. Перевірте права користувача в Seerr."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ tidak punya izin untuk meminta ini. Periksa izin pengguna di Seerr."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu kullanıcı adına istek gönderilemiyor: %@. Seerr’deki kullanıcı izinlerini kontrol edin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no té permís per sol·licitar-ho. Comprova els permisos de l'usuari a Seerr."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nu are permisiunea de a solicita asta. Verifică permisiunile utilizatorului în Seerr."
          }
        }
      }
    },
