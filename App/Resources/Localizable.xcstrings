    "Troubleshooting overlays stay on this device and are off by default.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Overlays voor probleemoplossing blijven op dit apparaat en staan standaard uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
