    "Active now (%@). %@ sunrise %@ · %@ fade.": {
      "comment": "Status summary for Circadian Mode when automatic solar scheduling is currently active. The first %@ is current tint intensity as a percentage, the second %@ is the selected region name, the third %@ is today's sunrise time, and the fourth %@ is the fade duration.",
      "localizations": {
        "en": {
          "stringUnit": {
