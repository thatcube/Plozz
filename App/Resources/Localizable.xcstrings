        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nogle servere kunne ikke kontaktes. Deres biblioteker kan konfigureres senere i Indstillinger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains serveurs sont injoignables. Leurs bibliothèques multimédias pourront être configurées plus tard dans Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Некоторые серверы недоступны. Их медиатеки можно настроить позже в Настройках."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Některé servery se nepodařilo kontaktovat. Jejich knihovny lze nastavit později v Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einige Server waren nicht erreichbar. Ihre Medienbibliotheken kannst du später in den Einstellungen konfigurieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è stato possibile raggiungere alcuni server. Le loro librerie possono essere configurate più tardi nelle Impostazioni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vissa servrar kunde inte nås. Deras bibliotek kan konfigureras senare i Inställningar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neki poslužitelji nisu dostupni. Njihove knjižnice možete podesiti kasnije u Postavkama."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesetengah pelayan tidak dapat dihubungi. Pustaka mereka boleh dikonfigurasikan kemudian dalam Tetapan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niektoré servery sa nepodarilo kontaktovať. Ich knižnice môžete nakonfigurovať neskôr v Nastaveniach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Деякі сервери недоступні. Їхні медіатеки можна налаштувати пізніше в Налаштуваннях."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beberapa server tidak dapat dijangkau. Pustakanya bisa diatur nanti di Pengaturan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bazı sunuculara ulaşılamadı. Kitaplıkları daha sonra Ayarlar’da yapılandırılabilir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No s'ha pogut connectar amb alguns servidors. Les seves biblioteques es poden configurar més endavant a Configuració."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unele servere nu au putut fi accesate. Bibliotecile lor pot fi configurate mai târziu în Setări."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא ניתן היה להגיע לחלק מהשרתים. ניתן להגדיר את הספריות שלהם מאוחר יותר בהגדרות."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Do nekaterih strežnikov ni bilo mogoče dostopati. Njihove knjižnice lahko pozneje nastavite v Nastavitvah."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่สามารถเข้าถึงบางเซิร์ฟเวอร์ได้ คุณตั้งค่าไลบรารีของเซิร์ฟเวอร์เหล่านั้นภายหลังได้ในการตั้งค่า"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Някои сървъри не можаха да бъдат достигнати. Техните медиатеки могат да бъдат конфигурирани по-късно в Настройки."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Joitakin palvelimia ei tavoitettu. Niiden kirjastot voi määrittää myöhemmin Asetuksissa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noen servere kunne ikke kontaktes. Bibliotekene deres kan konfigureres senere i Innstillinger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "部分服务器无法访问。可在稍后设置中配置其媒体库。"
          }
        }
      }
    },
    "Something not working? Send your recent activity straight to the developer — the quickest way to help track down a bug. Sent anonymously: no logins, tokens, servers, or titles.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Werkt er iets niet? Stuur je recente activiteit direct naar de ontwikkelaar — de snelste manier om een bug op te sporen. Anoniem verstuurd: geen inloggegevens, tokens, servers of titels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coś nie działa? Wyślij ostatnią aktywność bezpośrednio do dewelopera — to najszybszy sposób, aby pomóc namierzyć błąd. Dane są wysyłane anonimowo: bez danych logowania, tokenów, serwerów ani tytułów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algo não está funcionando? Envie sua atividade recente direto para o desenvolvedor — é a forma mais rápida de ajudar a encontrar um bug. Enviado anonimamente: sem logins, tokens, servidores ou títulos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Virker noget ikke? Send din seneste aktivitet direkte til udvikleren — den hurtigste måde at hjælpe med at finde en fejl på. Sendes anonymt: ingen logins, tokens, servere eller titler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un problème ? Envoyez votre activité récente directement au développeur — le moyen le plus rapide d’aider à trouver l’origine d’un problème. Envoi anonyme : aucun identifiant de connexion, jeton, serveur ni titre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Что-то не работает? Отправьте недавние действия прямо разработчику — это самый быстрый способ найти ошибку. Отправляется анонимно: без данных для входа, токенов, серверов и названий."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Něco nefunguje? Odešlete svou poslední aktivitu přímo vývojáři — je to nejrychlejší způsob, jak pomoci najít chybu. Odesílá se anonymně: bez přihlášení, tokenů, serverů a názvů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Etwas funktioniert nicht? Sende deine letzten Aktivitäten direkt an den Entwickler — der schnellste Weg, einen Fehler aufzuspüren. Anonym gesendet: keine Anmeldedaten, Tokens, Server oder Titel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qualcosa non funziona? Invia la tua attività recente direttamente allo sviluppatore: il modo più rapido per aiutare a individuare un bug. Inviata in modo anonimo: nessun accesso, token, server o titolo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fungerar något inte? Skicka din senaste aktivitet direkt till utvecklaren – det snabbaste sättet att hitta felet. Skickas anonymt utan inloggningar, åtkomsttoken, servrar eller titlar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nešto ne radi? Pošaljite svoju nedavnu aktivnost izravno razvojnom programeru — to je najbrži način da pomognete pronaći grešku. Šalje se anonimno: bez prijava, tokena, poslužitelja ili naslova."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ada yang tidak berfungsi? Hantar aktiviti terkini anda terus kepada pembangun — cara paling pantas untuk membantu mengesan pepijat. Dihantar secara tanpa nama: tiada log masuk, token, pelayan atau tajuk."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niečo nefunguje? Pošlite svoju nedávnu aktivitu priamo vývojárovi — je to najrýchlejší spôsob, ako pomôcť nájsť chybu. Odosiela sa anonymne: bez prihlásení, tokenov, serverov alebo názvov."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щось не працює? Надішліть останню активність безпосередньо розробнику — це найшвидший спосіб допомогти знайти помилку. Дані буде надіслано анонімно: без даних входу, токенів, серверів і назв контенту."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ada yang tidak berfungsi? Kirim aktivitas terbaru langsung kepada pengembang—cara tercepat untuk membantu melacak masalah. Dikirim secara anonim tanpa informasi masuk, token, server, atau judul."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir şey çalışmıyor mu? Son etkinliğinizi doğrudan geliştiriciye gönderin; bu, hatayı bulmaya yardımcı olmanın en hızlı yoludur. Anonim olarak gönderilir: oturum bilgileri, belirteçler, sunucular ve yapım adları gönderilmez."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alguna cosa no funciona? Envia la teva activitat recent directament al desenvolupador: la manera més ràpida d'ajudar a localitzar un error. S'envia de manera anònima: sense inicis de sessió, testimonis, servidors ni títols."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ceva nu funcționează? Trimite activitatea recentă direct dezvoltatorului — cea mai rapidă metodă de a ajuta la identificarea unui bug. Se trimite anonim: fără conectări, tokenuri, servere sau titluri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "משהו לא עובד? שלח את הפעילות האחרונה שלך ישירות למפתח — הדרך המהירה ביותר לעזור באיתור באג. נשלח באופן אנונימי: ללא פרטי כניסה, טוקנים, שרתים או כותרים."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nekaj ne deluje? Pošljite svojo nedavno dejavnost neposredno razvijalcu — to je najhitrejši način za pomoč pri iskanju napake. Poslano anonimno: brez prijav, žetonov, strežnikov ali naslovov."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มีบางอย่างทำงานผิดปกติใช่ไหม? ส่งกิจกรรมล่าสุดของคุณตรงถึงผู้พัฒนาได้เลย ซึ่งเป็นวิธีที่เร็วที่สุดในการช่วยตามหาข้อบกพร่อง ส่งแบบไม่ระบุตัวตน: ไม่มีข้อมูลการลงชื่อเข้าใช้ โทเค็น เซิร์ฟเวอร์ หรือชื่อเรื่อง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нещо не работи? Изпратете скорошната си активност директно на разработчика — това е най-бързият начин за откриване на грешка. Изпраща се анонимно: без данни за вход, токени, сървъри или заглавия."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eikö jokin toimi? Lähetä viimeaikainen toiminta suoraan kehittäjälle — se auttaa vian löytämisessä nopeimmin. Lähetys on nimetön: mukana ei ole kirjautumistietoja, pääsytunnisteita, palvelimia eikä nimikkeitä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fungerer noe ikke? Send den siste aktiviteten direkte til utvikleren — det er den raskeste måten å finne en feil på. Sendes anonymt: ingen pålogginger, tokens, servere eller titler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "遇到问题？将您的近期操作直接发送给开发者——最快定位问题的方式。发送内容匿名：不包含登录信息、令牌、服务器或标题。"
          }
        }
      }
    },
    "Something went wrong": {
      "localizations": {
        "nl": {
