    "%lld episodes • %@": {
      "comment": "Subtitle for a downloaded TV show entry when only one season is represented. %lld is the episode count, and %@ is the formatted total download size.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@arg1@ • %2$@"
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
