    "Only approve if this matches your server. Approving pins this exact certificate; a change requires re-approval." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وافق فقط إذا كان هذا يتطابق مع خادمك. عند الموافقة، يتم تثبيت هذه الشهادة بدقة؛ أي تغيير يتطلب إعادة الموافقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Одобрете само ако данните съвпадат с вашия сървър. Одобряването фиксира точно този сертификат; промяна изисква ново одобрение."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aprova-ho només si coincideix amb el teu servidor. En aprovar-ho, es fixa aquest certificat exacte; qualsevol canvi requerirà una nova aprovació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schvalte jen tehdy, pokud to odpovídá vašemu serveru. Schválením připnete právě tento certifikát; změna vyžaduje nové schválení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Godkend kun, hvis dette matcher din server. Godkendelse fastgør netop dette certifikat; en ændring kræver fornyet godkendelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bestätige nur, wenn dies zu deinem Server passt. Mit der Bestätigung wird genau dieses Zertifikat festgelegt; eine Änderung erfordert eine erneute Bestätigung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Εγκρίνετε το μόνο αν ταιριάζει με τον διακομιστή σας. Η έγκριση κλειδώνει σε αυτό ακριβώς το πιστοποιητικό· μια αλλαγή απαιτεί νέα έγκριση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aprueba solo si esto coincide con tu servidor. Al aprobar, se fija este certificado exacto; un cambio requiere volver a aprobarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فقط زمانی تأیید کنید که با سرور شما مطابقت داشته باشد. تأیید این گواهی دقیقاً مربوط می‌شود؛ تغییر نیازمند تأیید مجدد است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hyväksy vain, jos tämä vastaa palvelintasi. Hyväksyminen kiinnittää juuri tämän varmenteen; muutos vaatii uuden hyväksynnän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
