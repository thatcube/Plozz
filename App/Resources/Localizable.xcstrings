    "HTTP sends reusable credentials without encryption. Prefer HTTPS.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP verstuurt herbruikbare inloggegevens zonder versleuteling. Gebruik bij voorkeur HTTPS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP przesyła dane logowania wielokrotnego użytku bez szyfrowania. Zalecane jest HTTPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O HTTP envia credenciais reutilizáveis sem criptografia. Prefira HTTPS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP sender genanvendelige loginoplysninger uden kryptering. Foretræk HTTPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP envoie des identifiants réutilisables sans chiffrement. Préférez HTTPS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP передаёт данные для входа без шифрования, и их можно использовать повторно. Предпочтителен HTTPS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP přenáší znovu použitelné přihlašovací údaje bez šifrování. Upřednostněte HTTPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP überträgt wiederverwendbare Zugangsdaten unverschlüsselt. Verwende besser HTTPS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP invia le credenziali riutilizzabili senza crittografia. Preferisci HTTPS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP skickar återanvändbara inloggningsuppgifter okrypterat. Föredra HTTPS."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP šalje višekratne vjerodajnice bez šifriranja. Preferirajte HTTPS."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP menghantar bukti kelayakan boleh guna semula tanpa penyulitan. Utamakan HTTPS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP prenáša opakovane použiteľné prihlasovacie údaje bez šifrovania. Uprednostnite HTTPS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP передає без шифрування облікові дані, які можна повторно використати. Віддавайте перевагу HTTPS."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP mengirim kredensial yang dapat digunakan kembali tanpa enkripsi. Sebaiknya gunakan HTTPS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP yeniden kullanılabilir kimlik bilgilerini şifreleme olmadan gönderir. HTTPS tercih edin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP envia credencials reutilitzables sense xifrar. És preferible utilitzar HTTPS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP trimite date reutilizabile de autentificare fără criptare. Preferă HTTPS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP שולח פרטי כניסה הניתנים לשימוש חוזר ללא הצפנה. עדיף HTTPS."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP pošilja poverilnice za večkratno uporabo brez šifriranja. Raje uporabite HTTPS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP ส่งข้อมูลรับรองที่ใช้ซ้ำได้โดยไม่เข้ารหัส ควรใช้ HTTPS"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP изпраща данни за достъп за многократна употреба без шифроване. Предпочитайте HTTPS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP lähettää uudelleenkäytettävät kirjautumistiedot salaamattomana. Käytä mieluummin HTTPS:ää."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP sender gjenbrukbar påloggingsinformasjon ukryptert. HTTPS anbefales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HTTP 传输可复用凭据时未加密。建议使用 HTTPS。"
          }
        }
      }
