          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ üzerinde kullanılabilir sunucu yok."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hi ha cap servidor disponible en aquest %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nu există servere disponibile pe %@."
          }
        }
      }
    },
    "No servers found yet. Make sure the server is on and that Plozz is allowed Local Network access, then rescan — or enter an address below.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog geen servers gevonden. Zorg dat de server aanstaat en dat Plozz toegang heeft tot het lokale netwerk, scan dan opnieuw — of voer hieronder een adres in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie znaleziono jeszcze żadnych serwerów. Upewnij się, że serwer jest włączony i że Plozz ma dostęp do sieci lokalnej, a potem zeskanuj ponownie — albo wpisz adres poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum servidor encontrado ainda. Verifique se o servidor está ligado e se o Plozz tem acesso à Rede Local, depois faça uma nova busca — ou digite um endereço abaixo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der er endnu ikke fundet nogen servere. Sørg for, at serveren er tændt, og at Plozz har adgang til det lokale netværk, og genscan derefter — eller indtast en adresse nedenfor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun serveur trouvé pour le moment. Vérifiez que le serveur est allumé et que Plozz est autorisé à accéder au réseau local, puis relancez l’analyse — ou saisissez une adresse ci-dessous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Серверы пока не найдены. Убедитесь, что сервер включён и у Plozz есть доступ к локальной сети, затем выполните повторное сканирование — или введите адрес ниже."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatím nebyly nalezeny žádné servery. Ujistěte se, že je server zapnutý a že má Plozz povolený přístup k místní síti, pak spusťte nové hledání — nebo níže zadejte adresu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch keine Server gefunden. Stelle sicher, dass der Server eingeschaltet ist und Plozz auf das lokale Netzwerk zugreifen darf, und suche dann erneut — oder gib unten eine Adresse ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun server trovato. Assicurati che il server sia acceso e che Plozz abbia accesso a Rete locale, quindi esegui di nuovo la scansione oppure inserisci un indirizzo qui sotto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inga servrar hittades. Kontrollera att servern är påslagen och att Plozz har åtkomst till det lokala nätverket. Sök sedan igen eller ange en adress nedan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još nisu pronađeni poslužitelji. Provjerite je li poslužitelj uključen i ima li Plozz dopušten pristup lokalnoj mreži, zatim ponovno skenirajte — ili unesite adresu ispod."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada pelayan ditemui lagi. Pastikan pelayan dihidupkan dan Plozz dibenarkan akses Rangkaian Setempat, kemudian imbas semula — atau masukkan alamat di bawah."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatiaľ sa nenašli žiadne servery. Uistite sa, že je server zapnutý a že má Plozz povolený prístup k miestnej sieti, potom spustite nové vyhľadávanie — alebo nižšie zadajte adresu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Серверів ще не знайдено. Переконайтеся, що сервер увімкнено, а Plozz має доступ до локальної мережі, потім повторіть сканування або введіть адресу нижче."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum ada server yang ditemukan. Pastikan server menyala dan Plozz diizinkan mengakses Jaringan Lokal, lalu pindai ulang — atau masukkan alamat di bawah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henüz sunucu bulunamadı. Sunucunun açık olduğundan ve Plozz’a Yerel Ağ erişimi verildiğinden emin olun, ardından yeniden tarayın — veya aşağıya bir adres girin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encara no s'ha trobat cap servidor. Comprova que el servidor estigui engegat i que Plozz tingui accés a la xarxa local, i torna a escanejar — o introdueix una adreça a sota."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încă nu au fost găsite servere. Asigură-te că serverul este pornit și că Plozz are acces la Rețea locală, apoi scanează din nou — sau introdu mai jos o adresă."
          }
        }
      }
    },
    "No servers found yet. Make sure your server is on and that Plozz is allowed Local Network access (tvOS Settings ▸ General ▸ Privacy), then rescan — or enter an address below.": {
