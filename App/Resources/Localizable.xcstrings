    "%@ has no default quality profile or server set. Set one in the Seerr web app, then try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ heeft geen standaard kwaliteitsprofiel of server ingesteld. Stel er een in via de Seerr-webapp en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nie ma ustawionego domyślnego profilu jakości ani serwera. Ustaw je w aplikacji internetowej Seerr, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não tem perfil de qualidade nem servidor padrão definidos. Defina um no app web do Seerr e tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har ingen standardkvalitetsprofil eller server angivet. Angiv en i Seerr-webappen, og prøv igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ n’a aucun profil de qualité ni serveur par défaut définis. Définissez-en un dans l’app web Seerr, puis réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для пользователя %@ не заданы ни сервер, ни профиль качества по умолчанию. Задайте их в веб-приложении Seerr и повторите попытку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nemá nastavený výchozí profil kvality ani server. Nastavte je ve webové aplikaci Seerr a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für %@ ist kein Standard-Qualitätsprofil und kein Server festgelegt. Lege beides in der Seerr-Web-App fest und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ non ha un profilo di qualità o un server predefinito. Impostane uno nell’app web Seerr, poi riprova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har ingen standardkvalitetsprofil eller server inställd. Ställ in en i webbappen för Seerr och försök igen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nema postavljen zadani profil kvalitete ni poslužitelj. Postavite ga u web-aplikaciji Seerr, a zatim pokušajte ponovno."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ tiada profil kualiti atau pelayan lalai ditetapkan. Tetapkan satu dalam aplikasi web Seerr, kemudian cuba lagi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nemá nastavený predvolený profil kvality ani server. Nastavte ich vo webovej aplikácii Seerr a skúste to znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для %@ не задано типовий профіль якості або сервер. Налаштуйте його у вебзастосунку Seerr і спробуйте ще раз."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ belum memiliki profil kualitas bawaan atau server bawaan. Atur di aplikasi web Seerr, lalu coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ için varsayılan kalite profili veya sunucu ayarlanmamış. Seerr web uygulamasında bunlardan birini ayarlayıp yeniden deneyin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no té cap perfil de qualitat ni servidor predeterminat. Configura'n un a l'aplicació web de Seerr i torna-ho a provar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nu are setat niciun profil de calitate implicit și niciun server. Setează-le în aplicația web Seerr, apoi încearcă din nou."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ל-%@ אין פרופיל איכות או שרת ברירת מחדל. יש להגדיר אחד באתר Seerr ולנסות שוב."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nima nastavljenega privzetega profila kakovosti ali strežnika. Nastavite ga v spletni aplikaciji Seerr, nato poskusite znova."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ไม่มีโปรไฟล์คุณภาพเริ่มต้นหรือเซิร์ฟเวอร์ที่กำหนดไว้ กรุณาตั้งค่าในเว็บแอป Seerr แล้วลองอีกครั้ง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ няма зададен профил на качество или сървър по подразбиране. Задайте един в уеб приложението Seerr и опитайте отново."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Käyttäjälle %@ ei ole asetettu oletuslaatuprofiilia tai -palvelinta. Aseta se Seerr-verkkosovelluksessa ja yritä uudelleen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har ingen standardkvalitetsprofil eller server angitt. Angi en i Seerr-webappen, og prøv igjen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 没有设置默认质量配置文件或服务器。请在 Seerr 网页应用中设置一个，然后重试。"
          }
        }
      }
    },
    "%@ has reached the request limit. Try again later or adjust the quota in Seerr.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ heeft de aanvraaglimiet bereikt. Probeer het later opnieuw of pas de limiet aan in Seerr."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ma już wykorzystany limit próśb. Spróbuj ponownie później albo dostosuj limit w Seerr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ atingiu o limite de solicitações. Tente novamente mais tarde ou ajuste a cota no Seerr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har nået anmodningsgrænsen. Prøv igen senere, eller justér kvoten i Seerr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a atteint la limite de demandes. Réessayez plus tard ou ajustez le quota dans Seerr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для пользователя %@ исчерпан лимит запросов. Повторите попытку позже или измените квоту в Seerr."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uživatel %@ dosáhl limitu žádostí. Zkuste to znovu později nebo upravte kvótu ve službě Seerr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ hat das Anfragelimit erreicht. Versuche es später erneut oder passe das Kontingent in Seerr an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ha raggiunto il limite di richieste. Riprova più tardi o modifica la quota in Seerr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har nått gränsen för antal förfrågningar. Försök igen senare eller justera kvoten i Seerr."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ je dosegnuo ograničenje zahtjeva. Pokušajte ponovno kasnije ili prilagodite kvotu u Seerru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ telah mencapai had permohonan. Cuba lagi kemudian atau laraskan kuota dalam Seerr."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Používateľ %@ dosiahol limit žiadostí. Skúste to znova neskôr alebo upravte kvótu v službe Seerr."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для %@ вичерпано ліміт запитів. Спробуйте пізніше або змініть квоту в Seerr."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ telah mencapai batas permintaan. Coba lagi nanti atau sesuaikan kuotanya di Seerr."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ için istek sınırına ulaşıldı. Daha sonra yeniden deneyin veya Seerr’deki kotayı değiştirin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ha arribat al límit de sol·licituds. Torna-ho a provar més tard o ajusta la quota a Seerr."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a atins limita de solicitări. Încearcă din nou mai târziu sau ajustează cota în Seerr."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מכסת הבקשות של %@ נוצלה במלואה. יש לנסות שוב מאוחר יותר או לשנות את המכסה ב-Seerr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uporabnik %@ je dosegel omejitev zahtev. Poskusite znova pozneje ali prilagodite kvoto v storitvi Seerr."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ส่งคำขอถึงขีดจำกัดแล้ว ลองใหม่ภายหลังหรือปรับโควตาใน Seerr"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ е достигнал лимита на заявки. Опитайте по-късно или коригирайте квотата в Seerr."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Käyttäjä %@ on saavuttanut pyyntörajan. Yritä myöhemmin uudelleen tai muuta kiintiötä Seerr-palvelussa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har nådd forespørselsgrensen. Prøv igjen senere, eller juster kvoten i Seerr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 已达到请求上限。请稍后再试或在 Seerr 中调整配额。"
          }
        }
      }
    },
