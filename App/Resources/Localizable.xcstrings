    "FTP sends credentials and media without encryption." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُرسل FTP بيانات الاعتماد والوسائط بدون تشفير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP изпраща данни за достъп и медийно съдържание без шифроване."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP envia les credencials i els continguts multimèdia sense xifrar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP přenáší přihlašovací údaje i média bez šifrování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP sender loginoplysninger og medier uden kryptering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP überträgt Zugangsdaten und Medien unverschlüsselt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το FTP στέλνει διαπιστευτήρια και πολυμέσα χωρίς κρυπτογράφηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP envía credenciales y medios sin cifrado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP اطلاعات کاربری و رسانه را بدون رمزگذاری ارسال می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP lähettää kirjautumistiedot ja median salaamattomana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP envoie les identifiants et les médias sans chiffrement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
