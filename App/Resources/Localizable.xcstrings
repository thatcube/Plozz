    "Connect one Overseerr or Jellyseerr server for the household. Each Plozz profile can make requests as a different user.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbind één Overseerr- of Jellyseerr-server voor het huishouden. Elk Plozz-profiel kan aanvragen doen als een andere gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połącz jeden serwer Overseerr lub Jellyseerr dla całego domu. Każdy profil Plozz może składać prośby jako inny użytkownik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conecte um servidor Overseerr ou Jellyseerr para o grupo familiar. Cada perfil do Plozz pode fazer solicitações como um usuário diferente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbind én Overseerr- eller Jellyseerr-server for husstanden. Hver Plozz-profil kan sende anmodninger som en anden bruger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez un serveur Overseerr ou Jellyseerr pour tout le foyer. Chaque profil Plozz peut faire des demandes au nom d’un utilisateur différent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключите один сервер Overseerr или Jellyseerr для всего дома. Каждый профиль Plozz может отправлять запросы от имени другого пользователя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojte pro domácnost jeden server Overseerr nebo Jellyseerr. Každý profil Plozz může podávat žádosti jako jiný uživatel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbinde einen Overseerr- oder Jellyseerr-Server für den ganzen Haushalt. Jedes Plozz-Profil kann Anfragen über einen eigenen Benutzer stellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connetti un server Overseerr o Jellyseerr per la famiglia. Ogni profilo Plozz può effettuare richieste come utente diverso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anslut en Overseerr- eller Jellyseerr-server för hushållet. Varje Plozz-profil kan göra förfrågningar som en annan användare."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povežite jedan Overseerr ili Jellyseerr poslužitelj za kućanstvo. Svaki profil u Plozzu može slati zahtjeve kao drugi korisnik."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungkan satu pelayan Overseerr atau Jellyseerr untuk isi rumah. Setiap profil Plozz boleh membuat permintaan sebagai pengguna yang berbeza."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pripojte pre domácnosť jeden server Overseerr alebo Jellyseerr. Každý profil Plozz môže vytvárať žiadosti ako iný používateľ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підключіть один сервер Overseerr або Jellyseerr для домашньої групи. Кожен профіль Plozz може надсилати запити від імені іншого користувача."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungkan satu server Overseerr atau Jellyseerr untuk rumah tangga ini. Setiap profil Plozz dapat membuat permintaan sebagai pengguna yang berbeda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hane için bir Overseerr veya Jellyseerr sunucusu bağlayın. Her Plozz profili farklı bir kullanıcı olarak istek gönderebilir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connecta un servidor Overseerr o Jellyseerr per a la llar. Cada perfil de Plozz pot fer sol·licituds com a usuari diferent."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectează un server Overseerr sau Jellyseerr pentru toată casa. Fiecare profil Plozz poate face solicitări ca utilizator diferit."
          }
        }
      }
    },
