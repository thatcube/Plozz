          }
        }
      }
    },
    "Downloads use original quality. Network-share downloads continue while Plozz is open; Jellyfin, Emby, and Plex downloads can continue in the background.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Downloads gebruiken de originele kwaliteit. Downloads via een netwerkshare gaan door zolang Plozz open is; downloads van Jellyfin, Emby en Plex kunnen ook op de achtergrond doorgaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pobrane używają oryginalnej jakości. Pobieranie z udziałów sieciowych trwa, gdy Plozz jest otwarty; pobieranie z Jellyfin, Emby i Plex może trwać w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os downloads usam a qualidade original. Os downloads de compartilhamento de rede continuam enquanto o Plozz está aberto; os downloads de Jellyfin, Emby e Plex podem continuar em segundo plano."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Downloads bruger original kvalitet. Downloads fra netværksdeling fortsætter, mens Plozz er åben; downloads fra Jellyfin, Emby og Plex kan fortsætte i baggrunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les téléchargements utilisent la qualité d’origine. Les téléchargements depuis un partage réseau se poursuivent tant que Plozz est ouvert ; les téléchargements Jellyfin, Emby et Plex peuvent continuer en arrière-plan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При загрузке используется исходное качество. Загрузки из сетевых ресурсов продолжаются, пока открыт Plozz; загрузки из Jellyfin, Emby и Plex могут продолжаться в фоновом режиме."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stažené položky používají původní kvalitu. Stahování ze síťových sdílení pokračuje, když je Plozz otevřený; stahování z Jellyfinu, Emby a Plexu může pokračovat na pozadí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Downloads verwenden die Originalqualität. Downloads von Netzwerkfreigaben laufen weiter, solange Plozz geöffnet ist; Downloads von Jellyfin, Emby und Plex können im Hintergrund fortgesetzt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I download mantengono la qualità originale. Quelli dalle condivisioni di rete continuano mentre Plozz è aperto; i download da Jellyfin, Emby e Plex possono continuare in background."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nedladdningar använder originalkvalitet. Nedladdningar från nätverksdelningar fortsätter medan Plozz är öppen. Nedladdningar från Jellyfin, Emby och Plex kan fortsätta i bakgrunden."
          }
        }
      }
    },
    "Drag a provider here to turn it off": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep een provider hierheen om deze uit te schakelen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeciągnij tu dostawcę, aby go wyłączyć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arraste um provedor aqui para desativá-lo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Træk en udbyder herhen for at slå den fra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glissez un fournisseur ici pour le désactiver"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетащите сюда провайдера, чтобы отключить его"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přetáhněte sem poskytovatele a vypněte ho"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ziehe einen Anbieter hierher, um ihn auszuschalten"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trascina qui un provider per disattivarlo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dra en leverantör hit för att stänga av den"
          }
        }
      }
    },
    "Drag providers to set priority. Anything below the line is turned off.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep providers om de prioriteit in te stellen. Alles onder de lijn is uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeciągnij dostawców, aby ustawić priorytet. Wszystko poniżej linii jest wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arraste os provedores para definir a prioridade. Tudo abaixo da linha fica desativado."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Træk udbydere for at angive prioritet. Alt under linjen er slået fra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites glisser les fournisseurs pour définir la priorité. Tout ce qui se trouve sous la ligne est désactivé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетащите провайдеры, чтобы задать приоритет. Всё, что ниже линии, отключено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přetažením poskytovatelů nastavíte prioritu. Cokoli pod čarou je vypnuté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ziehe Anbieter, um die Priorität festzulegen. Alles unterhalb der Linie ist ausgeschaltet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trascina i provider per impostarne la priorità. Tutto ciò che si trova sotto la linea viene disattivato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dra leverantörer för att ställa in prioritet. Allt under linjen är avstängt."
          }
        }
      }
    },
    "Drag to reorder. Sources below the Disabled line are turned off.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep om de volgorde te wijzigen. Bronnen onder de lijn Uitgeschakeld zijn uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeciągnij, aby zmienić kolejność. Źródła poniżej linii Wyłączone są wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arraste para reordenar. As fontes abaixo da linha ficam desativadas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Træk for at ændre rækkefølge. Kilder under linjen Deaktiveret er slået fra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites glisser pour réorganiser. Les sources sous la ligne Désactivé sont désactivées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетащите, чтобы изменить порядок. Источники ниже линии «Отключено» отключены."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přetažením změníte pořadí. Zdroje pod čarou Vypnuto jsou vypnuté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ziehe zum Umsortieren. Quellen unterhalb der Linie „Deaktiviert“ sind ausgeschaltet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trascina per riordinare. Le fonti sotto la linea Disattivati vengono disattivate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dra för att ändra ordning. Källor under linjen Inaktiverad är avstängda."
          }
        }
      }
    },
