    "Budgets cap on-disk caches; lowering a budget evicts immediately.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Budgetten beperken caches op schijf; een lager budget wist meteen overtollige gegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Limity ograniczają pamięci podręczne na dysku; obniżenie limitu natychmiast usuwa dane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os limites controlam os caches em disco; ao reduzir um limite, o conteúdo é removido na hora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Budgetter begrænser cachen på disken; en lavere grænse rydder øjeblikkeligt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les budgets limitent les caches sur disque ; réduire un budget purge immédiatement l’excédent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лимиты ограничивают размер кэша на диске; при уменьшении лимита данные удаляются сразу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozpočty omezují velikost mezipamětí na disku; snížení limitu okamžitě provede vyřazení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Speicherlimits begrenzen die Caches auf dem Gerät. Wenn du ein Limit senkst, werden Daten sofort entfernt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I budget limitano le cache su disco; ridurne uno libera subito spazio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Budgetar sätter tak för cachar på disk; sänker du en budget rensas data omedelbart."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Proračuni ograničavaju predmemorije na disku; smanjenje proračuna odmah uklanja sadržaj."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bajet mengehadkan cache pada cakera; pengurangan bajet akan membuang kandungan cache serta-merta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozpočty obmedzujú vyrovnávacie pamäte na disku; zníženie rozpočtu okamžite vymaže nadbytočné položky."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Обмеження визначають розмір дискових кешів; зменшення обмеження негайно вилучає зайві дані."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anggaran membatasi cache di disk; menurunkannya langsung menghapus item."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sınırlar diskteki önbelleklerin boyutunu belirler; sınır düşürüldüğünde fazla veriler hemen silinir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els límits acoten les memòries cau al disc; si redueixes un límit, s'expulsa contingut immediatament."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bugetele limitează cache-urile de pe disc; dacă reduci un buget, conținutul este eliminat imediat."
          }
        }
      }
    },
