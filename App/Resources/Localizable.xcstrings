    "Cached images and resolved links are rebuilt automatically as you browse.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gecachte afbeeldingen en herleide links worden automatisch opnieuw opgebouwd terwijl je bladert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
