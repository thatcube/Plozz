    "Tailscale servers can't be found automatically. Manually type your Tailscale IP or MagicDNS name below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يمكن العثور على خوادم Tailscale تلقائيًا. أدخل عنوان IP أو اسم MagicDNS الخاص بـ Tailscale يدويًا أدناه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сървърите в Tailscale не могат да бъдат намерени автоматично. Въведете ръчно своя Tailscale IP адрес или MagicDNS име по-долу."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els servidors de Tailscale no es poden trobar automàticament. Escriu manualment la teva IP de Tailscale o el nom de MagicDNS a continuació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Servery Tailscale nelze najít automaticky. Níže ručně zadejte IP Tailscale nebo název MagicDNS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
