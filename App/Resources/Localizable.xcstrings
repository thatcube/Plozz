          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Об’єднайте всі свої медіа в одному цілісному просторі. Назавжди безплатно й із відкритим кодом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gộp tất cả phương tiện của bạn vào một trải nghiệm thống nhất. Miễn phí mãi mãi và mã nguồn mở."
