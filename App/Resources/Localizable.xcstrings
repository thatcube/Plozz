    },
    "Plex shares one sign-in across the household. Each profile picks its own Plex user and libraries under Profile › Your Libraries.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex deelt één aanmelding voor het hele huishouden. Elk profiel kiest zijn eigen Plex-gebruiker en bibliotheken onder Profiel › Jouw bibliotheken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex współdzieli jedno logowanie w całym gospodarstwie domowym. Każdy profil wybiera własnego użytkownika Plex i biblioteki w Profil › Twoje biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plex compartilha um único login com todo o grupo familiar. Cada perfil escolhe o próprio usuário do Plex e as próprias bibliotecas em Perfil › Suas bibliotecas."
          }
        }
      }
    },
    "Plex sign-in finds every server linked to your account.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aanmelden bij Plex vindt elke server die aan je account is gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logowanie do Plex znajduje wszystkie serwery powiązane z kontem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O login do Plex encontra todos os servidores vinculados à sua conta."
          }
        }
      }
    },
    "Plozz is only available in English for now. More languages are on the way.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz is momenteel alleen beschikbaar in het Engels. Meer talen komen eraan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz jest na razie dostępny tylko po angielsku. Wkrótce pojawią się kolejne języki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz está disponível apenas em inglês por enquanto. Mais idiomas estão a caminho."
          }
        }
      }
    },
    "Plozz picks the best source for each field automatically.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz kiest automatisch de beste bron voor elk veld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz automatycznie wybiera najlepsze źródło dla każdego pola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz escolhe automaticamente a melhor fonte para cada campo."
          }
        }
      }
    },
    "Plozz pins the server’s SSH host key after you approve its fingerprint.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz zet de SSH-hostsleutel van de server vast nadat je de vingerafdruk hebt goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz przypina klucz hosta SSH serwera po zatwierdzeniu jego odcisku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz fixa a chave SSH do host do servidor depois que você aprova a impressão digital dela."
          }
        }
      }
    },
    "Plozz scans the selected export for movies and TV episodes. NFS uses your server’s existing network permissions.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz scant de geselecteerde export op films en tv-afleveringen. NFS gebruikt de bestaande netwerkrechten van je server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz skanuje wybrany eksport w poszukiwaniu filmów i odcinków seriali. NFS korzysta z istniejących uprawnień sieciowych serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz examina a exportação selecionada em busca de filmes e episódios de TV. O NFS usa as permissões de rede que seu servidor já tem."
          }
        }
      }
    },
    "Point your camera at the code on your other device — pinch to zoom": {
      "localizations": {
        "nl": {
          "stringUnit": {
