    "Couldn't connect to the server. Check the address and that it's on the same network, then try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan geen verbinding maken met de server. Controleer het adres en of de server zich op hetzelfde netwerk bevindt en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się połączyć z serwerem. Sprawdź adres i czy jest w tej samej sieci, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível conectar ao servidor. Verifique o endereço e se ele está na mesma rede, depois tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke oprette forbindelse til serveren. Tjek adressen, og at den er på samme netværk, og prøv igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de se connecter au serveur. Vérifiez l’adresse, assurez-vous qu’il se trouve sur le même réseau, puis réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось подключиться к серверу. Проверьте адрес и убедитесь, что он в той же сети, затем повторите попытку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepodařilo se připojit k serveru. Zkontrolujte adresu a to, že je na stejné síti, a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
