          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nascondi tutta l’interfaccia dei profili per l’uso individuale. Puoi riattivare Profili in qualsiasi momento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dölj alla profilgränssnitt för användning av en enda person. Du kan aktivera Profiler igen när som helst."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sakrij cijelo sučelje profila za samostalno korištenje. Profile možete ponovno omogućiti u bilo kojem trenutku."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sembunyikan semua UI profil untuk penggunaan solo. Anda boleh mendayakan semula Profil pada bila-bila masa."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skryje celé rozhranie profilov pre používanie osamote. Profily môžete kedykoľvek znova zapnúť."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сховати весь інтерфейс профілю для одного користувача. Ви можете увімкнути профілі будь-коли."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
