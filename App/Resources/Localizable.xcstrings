    "Check the other device shows the same number before continuing.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controleer of het andere apparaat hetzelfde nummer toont voordat je doorgaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przed kontynuowaniem sprawdź, czy na drugim urządzeniu widnieje ten sam numer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifique se o outro dispositivo mostra o mesmo número antes de continuar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrollér, at den anden enhed viser det samme tal, før du fortsætter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiez que l’autre appareil affiche le même numéro avant de continuer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прежде чем продолжить, убедитесь, что на другом устройстве отображается тот же номер."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Před pokračováním zkontrolujte, že druhé zařízení zobrazuje stejné číslo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfe, ob auf dem anderen Gerät dieselbe Zahl steht, bevor du fortfährst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifica che l’altro dispositivo mostri lo stesso numero prima di continuare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrollera att den andra enheten visar samma nummer innan du fortsätter."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prije nastavka provjerite prikazuje li drugi uređaj isti broj."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pastikan peranti satu lagi memaparkan nombor yang sama sebelum meneruskan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pred pokračovaním skontrolujte, či druhé zariadenie zobrazuje rovnaké číslo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переконайтеся, що інший пристрій показує те саме число перед тим, як продовжити."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pastikan perangkat lain menampilkan angka yang sama sebelum melanjutkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Devam etmeden önce diğer aygıtta da aynı numaranın göründüğünü kontrol edin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprova que l'altre dispositiu mostri el mateix número abans de continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifică dacă pe celălalt dispozitiv apare același număr înainte de a continua."
          }
        }
      }
    },
    "Check the same number shows on the device you're setting up, then confirm.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controleer of op het apparaat dat je instelt hetzelfde nummer wordt getoond en bevestig vervolgens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprawdź, czy na konfigurowanym urządzeniu widnieje ten sam numer, a potem potwierdź."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifique se o mesmo número aparece no dispositivo que você está configurando e depois confirme."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrollér, at det samme tal vises på den enhed, du konfigurerer, og bekræft derefter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiez que le même numéro s’affiche sur l’appareil que vous configurez, puis confirmez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Убедитесь, что на настраиваемом устройстве отображается тот же номер, затем подтвердите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zkontrolujte, že se na nastavovaném zařízení zobrazuje stejné číslo, a potom potvrďte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfe, ob auf dem Gerät, das du einrichtest, dieselbe Zahl steht, und bestätige dann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifica che sul dispositivo che stai configurando appaia lo stesso numero, quindi conferma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrollera att samma nummer visas på enheten du konfigurerar och bekräfta sedan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Provjerite prikazuje li uređaj koji postavljate isti broj, a zatim potvrdite."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pastikan nombor yang sama dipaparkan pada peranti yang sedang anda sediakan, kemudian sahkan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skontrolujte, či sa na nastavovanom zariadení zobrazuje rovnaké číslo, a potom potvrďte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перевірте, що той самий номер відображається на пристрої, який ви налаштовуєте, а потім підтвердіть."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pastikan angka yang sama muncul di perangkat yang sedang Anda atur, lalu konfirmasikan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aynı numaranın kurduğunuz aygıtta göründüğünü kontrol edin, sonra onaylayın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprova que el mateix número es mostri al dispositiu que estàs configurant i, després, confirma-ho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifică dacă pe dispozitivul pe care îl configurezi apare același număr, apoi confirmă."
          }
        }
      }
    },
