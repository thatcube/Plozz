    "Sign in a phone or tablet from this Apple TV over your local network.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Meld een telefoon of tablet aan met behulp van deze Apple TV via je lokale netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaloguj telefon lub tablet z tego Apple TV przez sieć lokalną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faça login em um celular ou tablet a partir desta Apple TV pela sua rede local."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Log en telefon eller tablet ind fra dette Apple TV via dit lokale netværk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez un téléphone ou une tablette depuis cette Apple TV sur votre réseau local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выполните вход на телефоне или планшете с помощью этого Apple TV через локальную сеть."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přihlaste telefon nebo tablet z této Apple TV přes místní síť."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Melde ein Smartphone oder Tablet über dein lokales Netzwerk von diesem Apple TV aus an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Effettua l’accesso su un telefono o tablet da questa Apple TV tramite la rete locale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logga in en telefon eller surfplatta från denna Apple TV via ditt lokala nätverk."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijavite telefon ili tablet s ovog Apple TV-a preko svoje lokalne mreže."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
