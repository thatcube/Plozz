    "This build has no crash-reporting endpoint configured, so nothing can be sent. Crash reporting is available in TestFlight and release builds.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voor deze build is geen eindpunt voor crashrapportage geconfigureerd, dus er kan niets worden verzonden. Crashrapportage is beschikbaar in TestFlight- en release-builds."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "W tej kompilacji nie skonfigurowano punktu końcowego raportowania awarii, więc nie można niczego wysłać. Raportowanie awarii jest dostępne w kompilacjach TestFlight i wydaniach produkcyjnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta compilação não tem um serviço de relatório de falhas configurado, portanto nada pode ser enviado. O relatório de falhas está disponível nas compilações do TestFlight e de lançamento."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne build har intet slutpunkt til fejlrapportering, så der kan ikke sendes noget. Fejlrapportering er tilgængelig i TestFlight- og release-builds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette version ne comporte aucun point de terminaison pour le signalement des plantages ; aucun envoi n’est donc possible. Le signalement des plantages est disponible dans TestFlight et les versions publiques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В этой сборке не настроена конечная точка для отправки сбоев, поэтому отправить ничего нельзя. Отчёты о сбоях доступны в сборках TestFlight и релизных сборках."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toto sestavení nemá nakonfigurovaný koncový bod pro hlášení pádů, takže nelze nic odeslat. Hlášení pádů je k dispozici v TestFlightu a produkčních sestaveních."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für diesen Build ist kein Endpunkt für Absturzberichte konfiguriert, daher kann nichts gesendet werden. Absturzberichte sind in TestFlight- und Release-Builds verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In questa build non è configurato alcun endpoint per le segnalazioni di crash, quindi non è possibile inviare nulla. La segnalazione dei crash è disponibile nelle build di TestFlight e nelle versioni di rilascio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den här versionen saknar en konfigurerad slutpunkt för kraschrapportering, så inget kan skickas. Kraschrapportering är tillgänglig i TestFlight- och utgåveversioner."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ova međuverzija nema konfiguriranu krajnju točku za izvješća o rušenjima pa se ništa ne može poslati. Izvješća o rušenjima dostupna su u TestFlightu i produkcijskim međuverzijama."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Binaan ini tidak mempunyai titik akhir laporan ranap yang dikonfigurasi, jadi tiada apa-apa dapat dihantar. Laporan ranap tersedia dalam binaan TestFlight dan keluaran."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "V tomto zostavení nie je nakonfigurovaný žiadny koncový bod na hlásenie pádov, takže sa nedá nič odoslať. Hlásenie pádov je dostupné v zostaveniach TestFlight a produkčných zostaveniach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У цій збірці не налаштовано кінцеву точку звітування про збої, тому нічого надіслати неможливо. Звітування про збої доступне в TestFlight і релізних збірках."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Build ini belum memiliki endpoint pelaporan kerusakan, jadi tidak ada yang dapat dikirim. Pelaporan kerusakan tersedia dalam build TestFlight dan rilis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu derlemede yapılandırılmış bir çökme raporlama uç noktası yok, bu yüzden hiçbir şey gönderilemez. Çökme raporlama TestFlight ve sürüm derlemelerinde kullanılabilir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquesta compilació no té cap punt final configurat per als informes de fallades, així que no es pot enviar res. Els informes de fallades estan disponibles a TestFlight i a les compilacions de llançament."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Această versiune nu are configurată nicio adresă pentru raportarea blocărilor, așa că nu se poate trimite nimic. Raportarea blocărilor este disponibilă în versiunile TestFlight și de lansare."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בגרסה זו לא הוגדרה כתובת לדיווח על קריסות, ולכן לא ניתן לשלוח דבר. הדיווח זמין ב-TestFlight ובגרסאות הפצה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "V tej različici ni nastavljene končne točke za poročanje o zrušitvah, zato ni mogoče ničesar poslati. Poročanje o zrušitvah je na voljo v različicah TestFlight in izdajnih različicah."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บิลด์นี้ยังไม่ได้ตั้งค่าปลายทางสำหรับรายงานข้อขัดข้อง จึงไม่สามารถส่งข้อมูลใดได้ การรายงานข้อขัดข้องพร้อมใช้งานในบิลด์ TestFlight และบิลด์เผยแพร่"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тази компилация няма настроена крайна точка за докладване на сривове, затова нищо не може да бъде изпратено. Докладването на сривове е налично в TestFlight и официалните издания."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tähän koontiversioon ei ole määritetty kaatumisraporttien päätepistettä, joten mitään ei voi lähettää. Kaatumisraportointi on käytettävissä TestFlight- ja julkaisuversioissa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette bygget har ikke et konfigurert endepunkt for feilrapportering, så ingenting kan sendes. Feilrapportering er tilgjengelig i TestFlight- og produksjonsbygg."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此版本未配置崩溃报告端点，因此无法发送任何报告。崩溃报告功能仅在 TestFlight 和正式版本中可用。"
          }
        }
      }
    },
