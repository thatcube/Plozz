          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Server konnte nicht erreicht werden. Prüfe die Adresse und ob er sich im selben Netzwerk befindet, und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile raggiungere quel server. Verifica l’indirizzo e che sia sulla stessa rete, quindi riprova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
