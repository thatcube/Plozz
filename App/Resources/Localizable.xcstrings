    "This WebDAV server uses HTTP. Review the security warning, then Connect again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze WebDAV-server gebruikt HTTP. Bekijk de beveiligingswaarschuwing en tik daarna opnieuw op Verbinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten serwer WebDAV używa HTTP. Zapoznaj się z ostrzeżeniem dotyczącym bezpieczeństwa, a następnie ponownie stuknij Połącz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este servidor WebDAV usa HTTP. Revise o aviso de segurança e depois selecione Conectar novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne WebDAV-server bruger HTTP. Gennemgå sikkerhedsadvarslen, og tryk derefter på Opret forbindelse igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce serveur WebDAV utilise HTTP. Consultez l’avertissement de sécurité, puis connectez-vous de nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот сервер WebDAV использует HTTP. Ознакомьтесь с предупреждением о безопасности, затем снова нажмите «Подключить»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tento server WebDAV používá HTTP. Zkontrolujte bezpečnostní upozornění a potom znovu klepněte na Připojit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser WebDAV-Server verwendet HTTP. Sieh dir die Sicherheitswarnung an und verbinde dich dann erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo server WebDAV utilizza HTTP. Rivedi l’avviso di sicurezza, poi tocca di nuovo Connetti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den här WebDAV-servern använder HTTP. Granska säkerhetsvarningen och tryck sedan på Anslut igen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj WebDAV poslužitelj koristi HTTP. Pregledajte sigurnosno upozorenje, zatim ponovno dodirnite Poveži."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pelayan WebDAV ini menggunakan HTTP. Semak amaran keselamatan, kemudian Sambung semula."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tento server WebDAV používa HTTP. Skontrolujte bezpečnostné upozornenie a potom znova vyberte Pripojiť."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей сервер WebDAV використовує HTTP. Перегляньте попередження про безпеку, а потім знову натисніть «Підключити»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Server WebDAV ini memakai HTTP. Tinjau peringatan keamanan, lalu Sambungkan lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu WebDAV sunucusu HTTP kullanıyor. Güvenlik uyarısını gözden geçirin, sonra yeniden bağlanın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquest servidor WebDAV utilitza HTTP. Revisa l'avís de seguretat i, després, torna a connectar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acest server WebDAV folosește HTTP. Consultă avertismentul de securitate, apoi apasă din nou pe Conectează."
          }
        }
      }
    },
    "This account can’t browse that location.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit account kan niet door die locatie bladeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To konto nie może przeglądać tej lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta conta não pode navegar por esse local."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne konto kan ikke gennemse den placering."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce compte ne peut pas parcourir cet emplacement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эта учётная запись не может открыть это расположение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tento účet nemůže procházet toto umístění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Account kann diesen Speicherort nicht durchsuchen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo account non può sfogliare quel percorso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det här kontot kan inte öppna platsen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj račun ne može pregledavati tu lokaciju."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akaun ini tidak boleh menyemak imbas lokasi itu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tento účet nemôže prehliadať toto umiestnenie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей обліковий запис не може переглядати це розташування."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akun ini tidak dapat menelusuri lokasi itu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu hesap o konuma göz atamaz."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquest compte no pot navegar per aquesta ubicació."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acest cont nu poate răsfoi acea locație."
          }
        }
      }
    },
    "This account doesn’t have permission to browse that location.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit account heeft geen toestemming om door die locatie te bladeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To konto nie ma uprawnień do przeglądania tej lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta conta não tem permissão para navegar por esse local."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne konto har ikke tilladelse til at gennemse den placering."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce compte n’est pas autorisé à parcourir cet emplacement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У этой учётной записи нет доступа к этому расположению."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tento účet nemá oprávnění k procházení tohoto umístění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Account hat keine Berechtigung, diesen Speicherort zu durchsuchen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo account non dispone dell’autorizzazione per sfogliare quel percorso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det här kontot saknar behörighet att öppna platsen."
          }
        },
