    "Ask Who’s Watching on Startup": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vragen wie er kijkt bij opstarten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pytaj przy uruchamianiu, kto ogląda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perguntar quem está assistindo ao iniciar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spørg, hvem der ser med, ved opstart"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demander qui regarde au démarrage"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спрашивать при запуске, кто смотрит"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeptat se při spuštění, kdo se dívá"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Start fragen, wer zusieht"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiedi chi sta guardando all’avvio"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fråga vem som tittar vid start"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri pokretanju pitaj tko gleda"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tanya Siapa Menonton Semasa Permulaan"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri spustení sa opýtať, kto pozerá"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запитувати «Хто дивиться» під час запуску"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tanyakan siapa yang menonton saat aplikasi dibuka"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Açılışta kimin izlediğini sor"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pregunta qui mira en iniciar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Întreabă cine urmărește la pornire"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שאל מי צופה בהפעלה"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ob zagonu vprašaj, kdo gleda"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ถามว่าใครกำลังดูเมื่อเริ่มต้น"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Избор на профил при стартиране"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kysy käynnistyksessä, kuka katsoo"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spør hvem som ser på ved oppstart"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "启动时询问观看者"
          }
        }
      }
    },
