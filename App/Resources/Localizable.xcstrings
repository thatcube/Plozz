    "Only approve if this matches your server. Approving pins this exact certificate; a change requires re-approval.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keur alleen goed als dit overeenkomt met je server. Door goed te keuren, wordt dit exacte certificaat vastgezet; bij een wijziging is opnieuw goedkeuren vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatwierdź tylko wtedy, gdy dane pasują do Twojego serwera. Po zatwierdzeniu ten konkretny certyfikat zostanie zapamiętany; każda zmiana będzie wymagała ponownego zatwierdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprove somente se isto corresponder ao seu servidor. Ao aprovar, você fixa este certificado exato; qualquer mudança exige nova aprovação."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkend kun, hvis dette matcher din server. Godkendelse fastgør netop dette certifikat; en ændring kræver fornyet godkendelse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "N’approuvez que si cela correspond à votre serveur. L’approbation épingle exactement ce certificat ; tout changement nécessitera une nouvelle approbation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подтверждайте, только если это соответствует вашему серверу. После подтверждения будет закреплён именно этот сертификат; при изменении потребуется повторное подтверждение."
          }
        }
      }
    },
    "Only approve if this matches your server’s SSH host key. Approving pins this exact key; a change requires re-approval.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keur alleen goed als dit overeenkomt met de SSH-hostsleutel van je server. Door goed te keuren, wordt deze exacte sleutel vastgezet; bij een wijziging is opnieuw goedkeuren vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatwierdź tylko wtedy, gdy dane pasują do klucza hosta SSH Twojego serwera. Po zatwierdzeniu ten konkretny klucz zostanie zapamiętany; każda zmiana będzie wymagała ponownego zatwierdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprove somente se isto corresponder à chave de host SSH do seu servidor. Ao aprovar, você fixa esta chave exata; qualquer mudança exige nova aprovação."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkend kun, hvis dette matcher din servers SSH-værtsnøgle. Godkendelse fastgør netop denne nøgle; en ændring kræver fornyet godkendelse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "N’approuvez que si cela correspond à la clé d’hôte SSH de votre serveur. L’approbation épingle exactement cette clé ; tout changement nécessitera une nouvelle approbation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подтверждайте, только если это соответствует SSH-ключу хоста вашего сервера. После подтверждения будет закреплён именно этот ключ; при изменении потребуется повторное подтверждение."
          }
        }
      }
    },
    "Only approve this if the SHA-256 fingerprint matches your server. Approving pins this exact certificate; a future change will require re-approval.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keur dit alleen goed als de SHA-256-vingerafdruk overeenkomt met je server. Door goed te keuren, wordt dit exacte certificaat vastgezet; bij een toekomstige wijziging is opnieuw goedkeuren vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatwierdź tylko wtedy, gdy odcisk SHA-256 pasuje do Twojego serwera. Po zatwierdzeniu ten konkretny certyfikat zostanie zapamiętany; każda późniejsza zmiana będzie wymagała ponownego zatwierdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprove isto somente se a impressão digital SHA-256 corresponder ao seu servidor. Ao aprovar, você fixa este certificado exato; uma mudança futura exigirá nova aprovação."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkend kun dette, hvis SHA-256-fingeraftrykket matcher din server. Godkendelse fastgør netop dette certifikat; en fremtidig ændring vil kræve fornyet godkendelse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "N’approuvez ceci que si l’empreinte SHA-256 correspond à votre serveur. L’approbation épingle exactement ce certificat ; tout changement futur nécessitera une nouvelle approbation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подтверждайте это, только если отпечаток SHA-256 соответствует вашему серверу. После подтверждения будет закреплён именно этот сертификат; при будущих изменениях потребуется повторное подтверждение."
          }
        }
      }
    },
    "Only show forced subtitles for foreign-language passages.": {
      "comment": "Explanation that only forced (foreign-language-passage) subtitles are shown; used for both the subtitle display mode and the subtitle search preference.",
      "localizations": {
