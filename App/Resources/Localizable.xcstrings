    "A media share connects with the credentials you entered (or as a guest). Choose what shows on your Home under Profile › Your Libraries.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een mediashare maakt verbinding met de ingevoerde inloggegevens (of als gast). Kies via Profiel › Jouw bibliotheken wat er op Start verschijnt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Udział multimedialny łączy się przy użyciu podanych danych logowania (albo jako gość). Wybierz w sekcji Profil › Twoje biblioteki, co ma się pojawiać na stronie głównej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O acesso a um compartilhamento de mídia usa as credenciais informadas (ou o modo convidado). Escolha o que aparece na tela inicial em Perfil › Suas bibliotecas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En mediedeling opretter forbindelse med de loginoplysninger, du har angivet (eller som gæst). Vælg, hvad der vises på dit Hjem under Profil › Dine biblioteker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un partage multimédia se connecte avec les identifiants saisis (ou en invité). Choisissez ce qui s’affiche sur votre Accueil dans Profil › Vos bibliothèques multimédias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сетевой ресурс подключается с введёнными вами учётными данными (или как гость). Выберите, что показывать на «Главной» в разделе «Профиль» › «Ваши медиатеки»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Síťové sdílení se připojí pomocí zadaných přihlašovacích údajů (nebo jako host). Co se zobrazí na obrazovce Domů, vyberte v části Profil › Vaše knihovny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Medienfreigabe wird mit den eingegebenen Zugangsdaten (oder als Gast) verbunden. Lege unter „Profil › Deine Medienbibliotheken“ fest, was auf deiner Startseite erscheint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una condivisione multimediale si connette con le credenziali inserite (o come ospite). Scegli cosa mostrare nella tua Home in Profilo › Le tue librerie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En mediedelning ansluts med uppgifterna du angav eller som gäst. Välj vad som visas på Hem under Profil › Dina bibliotek."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dijeljenje medija povezuje se vjerodajnicama koje ste unijeli (ili kao gost). Odaberite što se prikazuje na Početnoj pod Profil › Vaše knjižnice."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perkongsian media disambungkan menggunakan bukti kelayakan yang anda masukkan (atau sebagai tetamu). Pilih apa yang dipaparkan pada Laman Utama anda di bawah Profil › Pustaka Anda."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zdieľanie médií sa pripája pomocou zadaných prihlasovacích údajov (alebo ako hosť). V časti Profil › Vaše knižnice vyberte, čo sa zobrazí na obrazovke Domov."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Медіаресурс підключається за допомогою введених облікових даних (або як гість). Виберіть у розділі «Профіль» › «Ваші медіатеки», що показувати на Головній."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Folder bersama media terhubung dengan informasi masuk yang Anda masukkan (atau sebagai tamu). Pilih yang tampil di Beranda melalui Profil › Pustaka Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Medya paylaşımı, girdiğiniz kimlik bilgileriyle veya konuk olarak bağlanır. Ana Sayfa’da gösterilecekleri Profil › Kitaplıklarınız bölümünden seçin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un recurs compartit multimèdia es connecta amb les credencials que has introduït (o com a convidat). Tria què es mostra a la teva pantalla d'Inici a Perfil › Les teves biblioteques."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O resursă media se conectează cu datele de autentificare introduse (sau ca invitat). Alege ce se afișează în Acasă din Profil › Bibliotecile tale."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "החיבור לשיתוף המדיה משתמש בפרטי ההתחברות שהזנת, או בגישת אורח. בחר מה יוצג במסך הבית תחת פרופיל › הספריות שלך."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Souporaba medijev se poveže s poverilnicami, ki ste jih vnesli (ali kot gost). Izberite, kaj se prikaže na zaslonu Domov v Profil › Vaše knjižnice."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแชร์สื่อจะเชื่อมต่อด้วยข้อมูลรับรองที่คุณป้อน (หรือในฐานะผู้เยี่ยมชม) เลือกสิ่งที่จะแสดงในหน้าแรกได้ที่โปรไฟล์ › ไลบรารีของคุณ"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Мрежовият ресурс се свързва с въведените от вас данни за достъп (или като гост). Изберете какво да се показва в Начало от Профил › Вашите медиатеки."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mediajako yhdistää annetuilla kirjautumistiedoilla (tai vieraana). Valitse Koti-näkymässä näkyvät kohteet kohdassa Profiili › Omat kirjastot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En mediedeling kobler til med påloggingsinformasjonen du oppga, eller som gjest. Velg hva som vises på Hjem under Profil › Dine biblioteker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "网络共享会使用您输入的凭据（或以访客身份）连接。请在“个人资料 › 我的媒体库”中选择首页显示的内容。"
          }
        }
      }
    },
