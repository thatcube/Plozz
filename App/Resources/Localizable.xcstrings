    "Only approve if this matches your server. Approving pins this exact certificate; a change requires re-approval.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keur alleen goed als dit overeenkomt met je server. Door goed te keuren, wordt dit exacte certificaat vastgezet; bij een wijziging is opnieuw goedkeuren vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatwierdź tylko wtedy, gdy dane pasują do Twojego serwera. Po zatwierdzeniu ten konkretny certyfikat zostanie zapamiętany; każda zmiana będzie wymagała ponownego zatwierdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprove somente se isto corresponder ao seu servidor. Ao aprovar, você fixa este certificado exato; qualquer mudança exige nova aprovação."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkend kun, hvis dette matcher din server. Godkendelse fastgør netop dette certifikat; en ændring kræver fornyet godkendelse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "N’approuvez que si cela correspond à votre serveur. L’approbation épingle exactement ce certificat ; tout changement nécessitera une nouvelle approbation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подтверждайте, только если это соответствует вашему серверу. После подтверждения будет закреплён именно этот сертификат; при изменении потребуется повторное подтверждение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schvalte jen tehdy, pokud to odpovídá vašemu serveru. Schválením připnete právě tento certifikát; změna vyžaduje nové schválení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bestätige nur, wenn dies zu deinem Server passt. Mit der Bestätigung wird genau dieses Zertifikat festgelegt; eine Änderung erfordert eine erneute Bestätigung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Approva solo se corrisponde al tuo server. L’approvazione vincola esattamente questo certificato; qualsiasi modifica richiederà una nuova approvazione."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkänn endast om det här stämmer med din server. Om du godkänner låses det här exakta certifikatet fast; en ändring kräver nytt godkännande."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odobrite samo ako se ovo podudara s vašim poslužiteljem. Odobrenjem se zapamti upravo ovaj certifikat; promjena zahtijeva ponovno odobrenje."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hanya luluskan jika ini sepadan dengan pelayan anda. Meluluskan akan menyematkan sijil ini dengan tepat; sebarang perubahan memerlukan kelulusan semula."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schváľte to len vtedy, ak sa to zhoduje s vaším serverom. Schválením pripnete presne tento certifikát; zmena bude vyžadovať opätovné schválenie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Схваліть тільки якщо це відповідає вашому серверу. Схвалення закріплює цей точний сертифікат; зміна потребує повторного схвалення."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setujui hanya jika ini cocok dengan server Anda. Menyetujui akan menyematkan sertifikat ini; perubahan memerlukan persetujuan ulang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca sunucunuzla eşleşiyorsa onaylayın. Onaylamak bu sertifikayı sabitler; değişiklik olursa yeniden onay gerekir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprova-ho només si coincideix amb el teu servidor. En aprovar-ho, es fixa aquest certificat exacte; qualsevol canvi requerirà una nova aprovació."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprobă doar dacă se potrivește cu serverul tău. Aprobarea fixează exact acest certificat; orice modificare necesită o nouă aprobare."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש לאשר רק אם התעודה תואמת לשרת. האישור יקבע את התעודה הזו; כל שינוי יחייב אישור מחדש."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odobrite le, če se to ujema z vašim strežnikom. Z odobritvijo pripnete točno to potrdilo; sprememba zahteva novo odobritev."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุมัติเฉพาะเมื่อข้อมูลนี้ตรงกับเซิร์ฟเวอร์ของคุณ การอนุมัติจะปักหมุดใบรับรองนี้โดยเฉพาะ หากมีการเปลี่ยนแปลงจะต้องอนุมัติใหม่"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Одобрете само ако данните съвпадат с вашия сървър. Одобряването фиксира точно този сертификат; промяна изисква ново одобрение."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hyväksy vain, jos tämä vastaa palvelintasi. Hyväksyminen kiinnittää juuri tämän varmenteen; muutos vaatii uuden hyväksynnän."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkjenn bare hvis dette samsvarer med serveren. Det nøyaktige sertifikatet festes, og endringer krever ny godkjenning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅在与您的服务器匹配时批准。批准后将锁定此证书；若发生更改则需重新批准。"
          }
        }
      }
    },
    "Only approve if this matches your server’s SSH host key. Approving pins this exact key; a change requires re-approval.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keur alleen goed als dit overeenkomt met de SSH-hostsleutel van je server. Door goed te keuren, wordt deze exacte sleutel vastgezet; bij een wijziging is opnieuw goedkeuren vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatwierdź tylko wtedy, gdy dane pasują do klucza hosta SSH Twojego serwera. Po zatwierdzeniu ten konkretny klucz zostanie zapamiętany; każda zmiana będzie wymagała ponownego zatwierdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprove somente se isto corresponder à chave de host SSH do seu servidor. Ao aprovar, você fixa esta chave exata; qualquer mudança exige nova aprovação."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkend kun, hvis dette matcher din servers SSH-værtsnøgle. Godkendelse fastgør netop denne nøgle; en ændring kræver fornyet godkendelse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "N’approuvez que si cela correspond à la clé d’hôte SSH de votre serveur. L’approbation épingle exactement cette clé ; tout changement nécessitera une nouvelle approbation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подтверждайте, только если это соответствует SSH-ключу хоста вашего сервера. После подтверждения будет закреплён именно этот ключ; при изменении потребуется повторное подтверждение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schvalte jen tehdy, pokud to odpovídá SSH hostitelskému klíči vašeho serveru. Schválením připnete právě tento klíč; změna vyžaduje nové schválení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bestätige nur, wenn dies zum SSH-Hostschlüssel deines Servers passt. Mit der Bestätigung wird genau dieser Schlüssel festgelegt; eine Änderung erfordert eine erneute Bestätigung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Approva solo se corrisponde alla chiave host SSH del tuo server. L’approvazione vincola esattamente questa chiave; qualsiasi modifica richiederà una nuova approvazione."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkänn endast om det här stämmer med din servers SSH-värdnyckel. Om du godkänner låses den här exakta nyckeln fast; en ändring kräver nytt godkännande."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odobrite samo ako se ovo podudara s ključem SSH glavnog računala vašeg poslužitelja. Odobrenjem se pamti upravo ovaj ključ; promjena zahtijeva ponovno odobrenje."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hanya luluskan jika ini sepadan dengan kunci hos SSH pelayan anda. Meluluskan akan menyematkan kunci ini dengan tepat; sebarang perubahan memerlukan kelulusan semula."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schváľte to len vtedy, ak sa to zhoduje s kľúčom hostiteľa SSH vášho servera. Schválením pripnete presne tento kľúč; zmena bude vyžadovať opätovné schválenie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Схваліть тільки якщо це відповідає ключу хоста SSH вашого сервера. Схвалення закріплює цей точний ключ; зміна потребує повторного схвалення."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setujui hanya jika ini cocok dengan kunci host SSH server Anda. Menyetujui akan menyematkan kunci ini; perubahan memerlukan persetujuan ulang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca sunucunuzun SSH ana bilgisayar anahtarıyla eşleşiyorsa onaylayın. Onaylamak bu anahtarı sabitler; değişiklik olursa yeniden onay gerekir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprova-ho només si coincideix amb la clau d'amfitrió SSH del teu servidor. En aprovar-ho, es fixa aquesta clau exacta; qualsevol canvi requerirà una nova aprovació."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprobă doar dacă se potrivește cu cheia SSH a gazdei serverului tău. Aprobarea fixează exact această cheie; orice modificare necesită o nouă aprobare."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש לאשר רק אם מפתח המארח של SSH תואם לשרת. האישור יקבע את המפתח הזה; כל שינוי יחייב אישור מחדש."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odobrite le, če se to ujema s ključem gostitelja SSH vašega strežnika. Z odobritvijo pripnete točno ta ključ; sprememba zahteva novo odobritev."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุมัติเฉพาะเมื่อคีย์โฮสต์ SSH นี้ตรงกับเซิร์ฟเวอร์ของคุณ การอนุมัติจะตรึงคีย์นี้ไว้ หากคีย์เปลี่ยนจะต้องอนุมัติใหม่"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Одобрете само ако данните съвпадат с SSH хост ключа на вашия сървър. Одобряването фиксира точно този ключ; промяна изисква ново одобрение."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hyväksy vain, jos tämä vastaa palvelimen SSH-isäntäavainta. Hyväksyminen kiinnittää juuri tämän avaimen; muutos vaatii uuden hyväksynnän."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkjenn bare hvis dette samsvarer med serverens SSH-vertsnøkkel. Den nøyaktige nøkkelen festes, og endringer krever ny godkjenning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅在与您的服务器 SSH 主机密钥匹配时批准。批准后将锁定此密钥；若发生更改则需重新批准。"
          }
        }
      }
    },
    "Only approve this if the SHA-256 fingerprint matches your server. Approving pins this exact certificate; a future change will require re-approval.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keur dit alleen goed als de SHA-256-vingerafdruk overeenkomt met je server. Door goed te keuren, wordt dit exacte certificaat vastgezet; bij een toekomstige wijziging is opnieuw goedkeuren vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatwierdź tylko wtedy, gdy odcisk SHA-256 pasuje do Twojego serwera. Po zatwierdzeniu ten konkretny certyfikat zostanie zapamiętany; każda późniejsza zmiana będzie wymagała ponownego zatwierdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprove isto somente se a impressão digital SHA-256 corresponder ao seu servidor. Ao aprovar, você fixa este certificado exato; uma mudança futura exigirá nova aprovação."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkend kun dette, hvis SHA-256-fingeraftrykket matcher din server. Godkendelse fastgør netop dette certifikat; en fremtidig ændring vil kræve fornyet godkendelse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "N’approuvez ceci que si l’empreinte SHA-256 correspond à votre serveur. L’approbation épingle exactement ce certificat ; tout changement futur nécessitera une nouvelle approbation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подтверждайте это, только если отпечаток SHA-256 соответствует вашему серверу. После подтверждения будет закреплён именно этот сертификат; при будущих изменениях потребуется повторное подтверждение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schvalte to jen tehdy, pokud otisk SHA-256 odpovídá vašemu serveru. Schválením připnete právě tento certifikát; budoucí změna bude vyžadovat nové schválení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bestätige nur, wenn der SHA-256-Fingerabdruck zu deinem Server passt. Mit der Bestätigung wird genau dieses Zertifikat festgelegt; eine spätere Änderung erfordert eine erneute Bestätigung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Approva solo se l’impronta SHA-256 corrisponde al tuo server. L’approvazione vincola esattamente questo certificato; qualsiasi modifica futura richiederà una nuova approvazione."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkänn endast om SHA-256-fingeravtrycket stämmer med din server. Om du godkänner låses det här exakta certifikatet fast; en framtida ändring kräver nytt godkännande."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odobrite ovo samo ako se SHA-256 otisak podudara s vašim poslužiteljem. Odobrenjem se zapamti upravo ovaj certifikat; buduća promjena zahtijevat će ponovno odobrenje."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hanya luluskan ini jika cap jari SHA-256 sepadan dengan pelayan anda. Meluluskan akan menyematkan sijil ini dengan tepat; perubahan pada masa hadapan akan memerlukan kelulusan semula."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schváľte to len vtedy, ak sa odtlačok SHA-256 zhoduje s vaším serverom. Schválením pripnete presne tento certifikát; budúca zmena bude vyžadovať opätovné schválenie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Схваліть це тільки якщо відбиток SHA-256 відповідає вашому серверу. Схвалення закріплює цей точний сертифікат; майбутня зміна потребуватиме повторного схвалення."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setujui ini hanya jika sidik jari SHA-256 cocok dengan server Anda. Menyetujui akan menyematkan sertifikat ini; perubahan di masa mendatang akan memerlukan persetujuan ulang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunu yalnızca SHA-256 parmak izi sunucunuzla eşleşiyorsa onaylayın. Onaylamak bu sertifikayı sabitler; ileride bir değişiklik olursa yeniden onay gerekir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprova-ho només si l'empremta SHA-256 coincideix amb el teu servidor. En aprovar-ho, es fixa aquest certificat exacte; qualsevol canvi futur requerirà una nova aprovació."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprobă doar dacă amprenta SHA-256 corespunde serverului tău. Aprobarea fixează exact acest certificat; orice modificare viitoare va necesita o nouă aprobare."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש לאשר רק אם טביעת האצבע SHA-256 תואמת לשרת. האישור יקבע את התעודה הזו; שינוי עתידי יחייב אישור מחדש."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To odobrite le, če se prstni odtis SHA-256 ujema z vašim strežnikom. Z odobritvijo pripnete točno to potrdilo; prihodnja sprememba bo zahtevala novo odobritev."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุมัติเฉพาะเมื่อลายนิ้วมือ SHA-256 ตรงกับเซิร์ฟเวอร์ของคุณ การอนุมัติจะตรึงใบรับรองนี้ไว้ หากใบรับรองเปลี่ยนจะต้องอนุมัติใหม่"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Одобрете само ако SHA-256 отпечатъкът съвпада с този на вашия сървър. Одобряването фиксира точно този сертификат; бъдеща промяна ще изисква ново одобрение."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hyväksy tämä vain, jos SHA-256-sormenjälki vastaa palvelintasi. Hyväksyminen kiinnittää juuri tämän varmenteen; myöhempi muutos vaatii uuden hyväksynnän."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkjenn bare hvis SHA-256-fingeravtrykket samsvarer med serveren. Det nøyaktige sertifikatet festes, og fremtidige endringer krever ny godkjenning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅在 SHA-256 指纹与您的服务器匹配时批准。批准后将锁定此证书；未来更改将需要重新批准。"
          }
        }
      }
    },
    "Only show forced subtitles for foreign-language passages.": {
