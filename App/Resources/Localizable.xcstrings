          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napríklad https://nas.local/dav. Ak ho vynecháte, predvolene sa použije https://."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Наприклад: https://nas.local/dav. Якщо протокол не вказано, використовується https://."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
