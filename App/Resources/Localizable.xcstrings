    "Sunrise/sunset unavailable at this location today.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zonsopgang/zonsondergang niet beschikbaar voor deze locatie vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dane o wschodzie i zachodzie słońca są dziś niedostępne w tej lokalizacji."
          }
        },
        "pt-BR": {
