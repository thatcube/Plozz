    "Scales card size, columns and spacing across the app.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Past de kaartgrootte, het aantal kolommen en de tussenruimte in de hele app aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skaluje rozmiar kart, kolumn i odstępy w całej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajusta o tamanho dos cartões, das colunas e do espaçamento em todo o app."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Justerer kortstørrelse, kolonner og mellemrum i hele appen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajuste la taille des cartes, les colonnes et l’espacement dans toute l’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изменяет размер карточек, число столбцов и интервалы по всему приложению."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upravuje velikost karet, sloupců a rozestupů v celé aplikaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skaliert Kartengröße, Spalten und Abstände in der ganzen App."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Regola le dimensioni delle schede, il numero di colonne e la spaziatura in tutta l’app."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Justerar kortstorlek, kolumner och avstånd i hela appen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prilagođava veličinu kartica, stupce i razmake u cijeloj aplikaciji."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menskalakan saiz kad, lajur dan jarak di seluruh aplikasi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prispôsobí veľkosť kariet, počet stĺpcov a rozostupy v celej aplikácii."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Змінює розмір карток, кількість стовпців і інтервали в додатку."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menyesuaikan ukuran kartu, kolom, dan jarak di seluruh aplikasi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uygulama genelinde kart boyutunu, sütun sayısını ve aralığı ölçeklendirir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escala la mida de les targetes, les columnes i l'espaiat a tota l'aplicació."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajustează dimensiunea cardurilor, coloanele și spațierea în întreaga aplicație."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "משנה את גודל הכרטיסים, העמודות והמרווחים בכל האפליקציה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prilagodi velikost kartic, stolpcev in razmike po vsej aplikaciji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปรับขนาดการ์ด จำนวนคอลัมน์ และระยะห่างทั่วทั้งแอป"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Променя размера на картите, броя колони и разстоянията в цялото приложение."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Säätää korttien kokoa, sarakkeita ja välistystä koko sovelluksessa."
          }
        },
        "nb": {
