{
  "sourceLanguage": "en",
  "strings": {
    " ahead": {
      "comment": "Suffix in the playback diagnostics buffer-status row after the buffered time figure, for example '72.6s ahead'.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " vooruit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " do przodu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": " à frente"
          }
        }
      }
    },
    " free": {
      "comment": "Suffix in the playback diagnostics disk-space row after the free-space figure, for example '90.26 GB free'.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " vrij"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " wolnego miejsca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": " disponíveis"
          }
        }
      }
    },
    " of ": {
      "comment": "Infix in the playback diagnostics seek-window row between the current seekable duration and the total duration, for example '15:00 of 42:00'.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " van "
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " z "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": " de "
          }
        }
      }
    },
    "%@ (detected)": {
      "comment": "Label for a protocol option in the add-network-share transport picker on tvOS and iOS when that protocol was auto-detected on the selected device. %@ is the transport name, such as SMB or NFS.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (gedetecteerd)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (wykryto)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (detectado)"
          }
        }
      }
    },
    "%@ coming soon": {
      "comment": "Title of the tvOS placeholder screen shown after choosing a detected share protocol that Plozz has not implemented yet. %@ is the transport name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ binnenkort beschikbaar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ już wkrótce"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ em breve"
          }
        }
      }
    },
    "%@ doesn’t have permission to request this. Check the user’s permissions in Seerr.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ heeft geen toestemming om dit aan te vragen. Controleer de rechten van de gebruiker in Seerr."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nie ma uprawnień do złożenia tej prośby. Sprawdź uprawnienia użytkownika w Seerr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não tem permissão para fazer essa solicitação. Verifique as permissões do usuário no Seerr."
          }
        }
      }
    },
    "%@ free": {
      "comment": "Free-space amount shown in storage summaries, including the iOS Downloads capacity bar and the player's Disk diagnostics row. %@ is the formatted free-space size.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ vrij"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ wolnego miejsca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ disponíveis"
          }
        }
      }
    },
    "%@ has no default quality profile or server set. Set one in the Seerr web app, then try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ heeft geen standaard kwaliteitsprofiel of server ingesteld. Stel er een in via de Seerr-webapp en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nie ma ustawionego domyślnego profilu jakości ani serwera. Ustaw je w aplikacji internetowej Seerr, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não tem perfil de qualidade nem servidor padrão definidos. Defina um no app web do Seerr e tente novamente."
          }
        }
      }
    },
    "%@ has reached the request limit. Try again later or adjust the quota in Seerr.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ heeft de aanvraaglimiet bereikt. Probeer het later opnieuw of pas de limiet aan in Seerr."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ma już wykorzystany limit próśb. Spróbuj ponownie później albo dostosuj limit w Seerr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ atingiu o limite de solicitações. Tente novamente mais tarde ou ajuste a cota no Seerr."
          }
        }
      }
    },
    "%@ left": {
      "comment": "Remaining runtime label shown on episode and poster cards and on the in-progress episode watch-state pill. %@ is the formatted remaining time.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozostało %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ restantes"
          }
        }
      }
    },
    "%@ of %@": {
      "comment": "Share enrichment progress: items enriched so far out of the pass's total. `done` arrives pre-padded to a fixed width; `total` must stay ungrouped to match.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ of %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ van %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ z %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ de %2$@"
          }
        }
      }
    },
    "%@ rating %@": {
      "comment": "Accessibility label for one rating badge in a ratings row. %@ is the rating source name, and the second %@ is the displayed score.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ rating %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-beoordeling: %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ocena %1$@: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nota %2$@ no %1$@"
          }
        }
      }
    },
    "%@ share": {
      "comment": "Subtitle in server details for a direct network share connection. %@ is the share transport name, such as SMB or WebDAV.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-share"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "udział %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "compartilhamento via %@"
          }
        }
      }
    },
    "%@ subtitles are rendered as images and can’t be restyled.": {
      "comment": "Secondary text in the iOS player subtitle Appearance section when the selected subtitle track is bitmap-based. %@ is the subtitle format name, such as PGS or VobSub.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-ondertitels worden weergegeven als afbeeldingen en kunnen niet worden aangepast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napisy %@ są renderowane jako obrazy i nie można zmienić ich stylu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As legendas %@ são renderizadas como imagens e não podem ter o estilo alterado."
          }
        }
      }
    },
    "%@ subtitles can't be restyled": {
      "comment": "Headline on the tvOS subtitle style screen when the current subtitle track is bitmap-based and styling controls are unavailable. %@ is the subtitle format name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-ondertitels kunnen niet worden aangepast"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można zmienić stylu napisów %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não é possível alterar o estilo das legendas %@"
          }
        }
      }
    },
    "%@ support is coming soon": {
      "comment": "Headline on the iOS placeholder screen for a detected share protocol that Plozz does not support yet. %@ is the transport name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ondersteuning voor %@ komt binnenkort"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obsługa %@ już wkrótce"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suporte a %@ em breve"
          }
        }
      }
    },
    "%@ support is on the way. This device was detected, but Plozz can’t connect over %@ just yet.": {
      "comment": "Body text on the tvOS coming-soon screen for a detected network share protocol. The first %@ is the transport name in the sentence subject, and the second %@ is the same transport name after 'over'.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ support is on the way. This device was detected, but Plozz can’t connect over %2$@ just yet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ondersteuning voor %1$@ komt eraan. Dit apparaat is gedetecteerd, maar Plozz kan nog geen verbinding maken via %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obsługa %1$@ jest już w drodze. To urządzenie zostało wykryte, ale Plozz nie może się jeszcze połączyć przez %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Em breve, haverá suporte a %1$@. Este dispositivo foi detectado, mas o Plozz ainda não consegue se conectar por %2$@."
          }
        }
      }
    },
    "%@ used by downloads": {
      "comment": "iOS Downloads storage summary showing how much device space downloaded media currently uses. %@ is the formatted size.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ in gebruik door downloads"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pobrane pliki zajmują %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ usados pelos downloads"
          }
        }
      }
    },
    "%@ · %@ detected": {
      "comment": "Subtitle under an auto-detected device in the add-share flow on tvOS and iOS. The first %@ is the device host name or address, and the second %@ is the list of detected share protocols.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@ detected"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · %2$@ gedetecteerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · wykryto %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · detectado: %2$@"
          }
        }
      }
    },
    "%@ — Failed": {
      "comment": "Disabled season row in request menus when requesting that season failed. %@ is the season title, such as Season 2.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — Mislukt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — nie udało się"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — Falhou"
          }
        }
      }
    },
    "%@, offline": {
      "comment": "Accessibility label for an unavailable source row in the playback source picker. %@ is the source name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@, offline"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@, niedostępne"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@, indisponível"
          }
        }
      }
    },
    "%lld": {
      "comment": "Standalone numeric value used in the player subtitle style editor for whole-number controls such as shadow thickness, outline width, padding, and gap. %lld is the selected integer value.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld"
          }
        }
      }
    },
