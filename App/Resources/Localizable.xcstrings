    "settings.profileLock.usePlexPIN.detail" : {
      "comment" : "Explains what saying yes does — including that the PIN is sent to Plex, which the person should know before agreeing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إذا اخترت نعم، يمكن لـ Plozz استخدام إدخال واحد لرمز PIN لكليهما."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ако да, Plozz може да използва еднократно въвеждане на PIN и за двете."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si respons que sí, Plozz pot utilitzar una sola entrada de PIN per a tots dos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pokud ano, Plozz může použít jediné zadání PINu pro obojí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvis ja, kan Plozz bruge én PIN-indtastning til begge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Falls ja, kann Plozz mit einer PIN-Eingabe beide entsperren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αν ναι, το Plozz μπορεί να χρησιμοποιήσει μία εισαγωγή PIN και για τα δύο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If yes, Plozz can use one PIN entry for both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si es así, Plozz puede usar una sola entrada de PIN para ambos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اگر بله، Plozz می‌تواند با یک بار وارد کردن PIN هر دو را باز کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jos kyllä, Plozzille riittää yksi PIN-koodin syöttö molempia varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si oui, Plozz peut utiliser une seule saisie du code PIN pour les deux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אם כן, Plozz יכול להשתמש בהזנת PIN אחת לשניהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अगर हाँ, तो Plozz में दोनों के लिए केवल एक बार PIN डालना होगा."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ako da, Plozz može koristiti jedan unos PIN-a za oba zaključavanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ha igen, a Plozz egy PIN-beírással mindkettőt megnyitja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jika ya, satu kali memasukkan PIN di Plozz berlaku untuk keduanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se sì, in Plozz basterà inserire il PIN una volta per entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "はいの場合、Plozzは1つのPIN入力で両方をロック解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "같은 PIN이라면 Plozz가 한 번의 PIN 입력으로 둘 다 잠금 해제할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jika ya, anda hanya perlu memasukkan PIN sekali untuk kedua-duanya di Plozz."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvis ja, kan Plozz bruke én PIN-inntasting for begge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
