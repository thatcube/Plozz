          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile inviare — la segnalazione dei crash non è attiva. Attiva Condividi segnalazioni crash qui sotto e riprova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det gick inte att skicka — kraschrapportering är inte aktiverad. Slå på Dela kraschrapporter nedan och försök igen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slanje nije uspjelo — prijavljivanje rušenja nije aktivno. Uključite dolje Dijeli izvješća o rušenjima i pokušajte ponovno."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat menghantar — laporan ranap tidak aktif. Hidupkan Kongsi Laporan Ranap di bawah dan cuba lagi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepodarilo sa odoslať — hlásenie pádov nie je aktívne. Nižšie zapnite možnosť Zdieľať hlásenia pádov a skúste to znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося надіслати — звіти про збої не активні. Увімкніть «Надіслати звіти про збої» нижче й спробуйте знову."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat mengirim — pelaporan kerusakan tidak aktif. Nyalakan Bagikan Laporan Kerusakan di bawah, lalu coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gönderilemedi; çökme raporlaması etkin değil. Aşağıdaki “Çökme raporlarını paylaş” seçeneğini açıp yeniden deneyin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No s’ha pogut enviar: els informes de fallades no estan actius. Activa Comparteix informes de fallades a sota i torna-ho a provar."
