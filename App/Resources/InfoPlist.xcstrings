{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "comment": "Shown when tvOS asks permission to use the local network, which is how servers and shares are discovered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plozz uses your local network to discover Jellyfin and Emby servers and media shares automatically."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz gebruikt je lokale netwerk om Jellyfin- en Emby-servers en gedeelde mediamappen automatisch te vinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz potrzebuje dostępu do sieci lokalnej, aby wykrywać serwery Jellyfin i Emby oraz udziały multimedialne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz usa sua rede local para encontrar automaticamente servidores Jellyfin e Emby e compartilhamentos de mídia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz bruger dit lokale netværk til automatisk at finde Jellyfin- og Emby-servere samt mediedelinger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz utilise votre réseau local pour détecter automatiquement les serveurs Jellyfin et Emby, ainsi que les partages multimédias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz использует локальную сеть для автоматического поиска серверов Jellyfin и Emby, а также сетевых ресурсов с медиафайлами."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz používá místní síť k automatickému vyhledání serverů Jellyfin a Emby a sdílení médií."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz verwendet dein lokales Netzwerk, um Jellyfin- und Emby-Server sowie Medienfreigaben automatisch zu finden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz usa la rete locale per trovare automaticamente i server Jellyfin ed Emby e le condivisioni multimediali."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz använder ditt lokala nätverk för att automatiskt hitta Jellyfin- och Emby-servrar samt mediedelningar."
          }
        }
      }
    }
  },
  "version": "1.0"
}
