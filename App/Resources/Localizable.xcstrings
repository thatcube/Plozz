          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บนอุปกรณ์อีกเครื่องของคุณ ให้เปิด Plozz ▸ การตั้งค่า ▸ ซิงค์และตั้งค่า ▸ “ตั้งค่าอุปกรณ์อีกเครื่อง”"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На другото си устройство отворете Plozz ▸ Настройки ▸ Синхронизиране и настройване ▸ „Настройване на друго устройство“."
          }
        },
        "fi": {
          "stringUnit": {
