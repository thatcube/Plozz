    "Episode titles, summaries, and artwork can be hidden until you watch them." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يمكن إخفاء عناوين الحلقات والملخصات والرسوم التوضيحية حتى تشاهدها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Заглавията, описанията и обложките на епизодите могат да бъдат скрити, докато не ги гледате."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els títols, resums i cartells dels episodis es poden amagar fins que els vegis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Názvy dílů, shrnutí a grafika mohou zůstat skryté, dokud je nezhlédnete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Episodetitler, resuméer og coverbilleder kan skjules, indtil du har set episoderne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Titel, Zusammenfassungen und Bilder von Folgen können ausgeblendet werden, bis du sie gesehen hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι τίτλοι, οι περιλήψεις και τα γραφικά των επεισοδίων μπορούν να κρύβονται μέχρι να τα παρακολουθήσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los títulos, resúmenes e imágenes de los episodios se pueden ocultar hasta que los veas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عناوین قسمت‌ها، خلاصه‌ها و هنرهای گرافیکی تا زمانی که آن‌ها را تماشا نکرده باشید پنهان خواهند ماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jaksojen nimet, kuvaukset ja kuvitus voidaan piilottaa, kunnes olet katsonut ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les titres, résumés et illustrations des épisodes peuvent être masqués jusqu’à ce que vous les regardiez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ניתן להסתיר כותרות פרקים, תקצירים ותמונות עד שתצפה בהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एपिसोड के शीर्षक, सारांश और आर्टवर्क को आपके देखने तक छिपाया जा सकता है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naslovi epizoda, sažeci i grafika mogu se sakriti dok ih ne pogledate."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az epizódcímek, összefoglalók és borítóképek elrejthetők, amíg meg nem nézi őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Judul, ringkasan, dan gambar episode dapat disembunyikan sampai Anda menontonnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Titoli, riepiloghi e immagini degli episodi possono essere nascosti fino a quando non li guardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "エピソードのタイトル、あらすじ、アートワークは視聴するまで非表示にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "에피소드 제목, 요약 및 아트워크는 시청할 때까지 숨겨질 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tajuk episod, ringkasan, dan karya seni boleh disembunyikan sehingga anda menontonnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Episodetitler, sammendrag og omslagsbilder kan skjules til du har sett episodene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Titels, samenvattingen en afbeeldingen van afleveringen kunnen verborgen blijven totdat je ze kijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tytuły odcinków, opisy i grafiki mogą być ukryte do czasu obejrzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Títulos, resumos e imagens dos episódios podem ficar ocultos até você assisti-los."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Titlurile, rezumatele și ilustrațiile episoadelor pot fi ascunse până când le vizionezi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Названия эпизодов, описания и изображения можно скрывать, пока вы их не посмотрите."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Názvy dielov, zhrnutia a grafika môžu zostať skryté, kým si ich nepozriete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naslovi epizod, povzetki in grafika so lahko skriti, dokler jih ne pogledate."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naslovi epizoda, sažeci i slike mogu da budu skriveni dok ih ne odgledate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avsnittstitlar, sammanfattningar och bilder kan döljas tills du har sett dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "สามารถซ่อนชื่อตอน เรื่องย่อ และภาพประกอบได้จนกว่าคุณจะรับชม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bölüm başlıkları, özetleri ve görselleri siz izleyene kadar gizlenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Назви епізодів, описи й обкладинки можна приховати, доки ви їх не переглянете."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiêu đề tập phim, tóm tắt, và tác phẩm nghệ thuật có thể được che giấu cho đến khi bạn xem chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "剧集标题、简介和图片可在观看前隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "集數標題、簡介與圖像可在觀看前先隱藏。"
          }
        }
      }
    },
