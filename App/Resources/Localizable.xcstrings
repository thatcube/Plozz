          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prihláste telefón alebo tablet z tejto Apple TV cez miestnu sieť."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Увійдіть на телефоні або планшеті за допомогою цього Apple TV через локальну мережу."
          }
        },
        "id": {
