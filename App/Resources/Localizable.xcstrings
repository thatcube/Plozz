            "value": "%@ occupés par les téléchargements"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ занято загрузками"
          }
        }
      }
    },
    "%@ · %@ detected": {
      "comment": "Subtitle under an auto-detected device in the add-share flow on tvOS and iOS. The first %@ is the device host name or address, and the second %@ is the list of detected share protocols.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@ detected"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · %2$@ gedetecteerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · wykryto %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · detectado: %2$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · %2$@ fundet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · Détection : %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ · обнаружено: %2$@"
          }
        }
      }
    },
    "%@ — Failed": {
      "comment": "Disabled season row in request menus when requesting that season failed. %@ is the season title, such as Season 2.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — Mislukt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — nie udało się"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — Falhou"
          }
        },
        "da": {
