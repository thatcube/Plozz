        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请在下方开启“分享崩溃报告”以启用此功能。您的近期活动将被匿名发送——无需登录信息、令牌、服务器或标题。"
