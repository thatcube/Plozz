    "This downloads all %lld episodes at original quality and can use significant storage and data. You can remove them anytime from Downloads.": {
      "comment": "Confirmation message when downloading an entire season on iPhone or iPad. %lld is the number of episodes that will be downloaded.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This downloads the %lld episode at original quality and can use significant storage and data. You can remove it anytime from Downloads."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This downloads all %lld episodes at original quality and can use significant storage and data. You can remove them anytime from Downloads."
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Dit downloadt de %lld aflevering in de oorspronkelijke kwaliteit en kan aanzienlijke opslagruimte en data gebruiken. Je kunt hem op elk moment verwijderen via Downloads."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Dit downloadt alle %lld afleveringen in de oorspronkelijke kwaliteit en kan aanzienlijke opslagruimte en data gebruiken. Je kunt ze op elk moment verwijderen via Downloads."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Ta czynność pobierze %lld odcinek w oryginalnej jakości i może zużyć dużo miejsca oraz danych. Możesz go w każdej chwili usunąć w sekcji Pobrane."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Ta czynność pobierze %lld odcinki w oryginalnej jakości i może zużyć dużo miejsca oraz danych. Możesz je w każdej chwili usunąć w sekcji Pobrane."
                }
