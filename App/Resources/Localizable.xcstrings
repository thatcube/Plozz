    "settings.kidsProfile.explanation" : {
      "comment" : "Explains what marking a profile as a Kids Profile does. The last sentence matters: there is no content filtering yet and the copy must not imply otherwise.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يخفي الإعدادات المشتركة، فلا يمكن تغيير الخوادم والملفات الشخصية منه. ولا يُصفّي المحتوى الذي يمكن مشاهدته."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скрива споделените настройки, така че сървърите и профилите не могат да бъдат променяни от него. Не филтрира какво може да се гледа."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Amaga la configuració compartida perquè no es puguin canviar servidors ni perfils. No filtra què es pot mirar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skryje sdílená nastavení, takže z něj nelze měnit servery a profily. Nefiltruje, co lze sledovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skjuler delte indstillinger, så servere og profiler ikke kan ændres herfra. Filtrerer ikke, hvad der kan ses."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Blendet gemeinsame Einstellungen aus, sodass Server und Profile nicht geändert werden können. Filtert nicht, was angesehen werden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αποκρύπτει τις κοινόχρηστες ρυθμίσεις, ώστε οι διακομιστές και τα προφίλ να μην μπορούν να αλλάξουν. Δεν φιλτράρει τι μπορεί να παρακολουθηθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hides shared settings, so servers and profiles can't be changed from it. Doesn't filter what can be watched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oculta los ajustes compartidos para que no se puedan cambiar servidores ni perfiles. No filtra lo que se puede ver."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تنظیمات مشترک را پنهان می‌کند تا سرورها و نمایه‌ها از آن قابل تغییر نباشند. محتوای قابل تماشا را فیلتر نمی‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Piilottaa jaetut asetukset, joten palvelimia ja profiileja ei voi muuttaa sen kautta. Ei suodata katsottavaa sisältöä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masque les réglages partagés pour empêcher toute modification des serveurs et profils. Ne filtre pas ce qui peut être regardé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מסתיר הגדרות משותפות, כך שלא ניתן לשנות דרכו שרתים ופרופילים. לא מסנן את התכנים שניתן לצפות בהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "साझा सेटिंग्स छुपाता है, ताकि इससे सर्वर और प्रोफ़ाइल बदले नहीं जा सकें. क्या देखा जा सकता है, इसे फ़िल्टर नहीं करता."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skriva dijeljene postavke tako da se poslužitelji i profili ne mogu mijenjati iz njega. Ne filtrira što se može gledati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elrejti a megosztott beállításokat, így a szerverek és profilok nem módosíthatók belőle. Nem szűri a megtekinthető tartalmakat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menyembunyikan pengaturan bersama sehingga server dan profil tidak dapat diubah dari sini. Tidak memfilter apa yang dapat ditonton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nasconde le impostazioni condivise, impedendo la modifica di server e profili. Non filtra ciò che si può guardare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "共有設定を非表示にし、サーバやプロファイルを変更できなくします。視聴コンテンツのフィルタリングは行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "공유 설정을 숨겨 서버나 프로필을 변경할 수 없게 합니다. 시청 콘텐츠를 필터링하지는 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menyembunyikan tetapan kongsi supaya pelayan dan profil tidak boleh diubah daripadanya. Tidak menapis apa yang boleh ditonton."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skjuler delte innstillinger slik at servere og profiler ikke kan endres fra den. Filtrerer ikke hva som kan sees."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verbergt gedeelde instellingen, zodat je vanuit dit profiel geen servers of profielen kunt wijzigen. Filtert niet wat er gekeken kan worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ukrywa ustawienia współdzielone, aby serwery i profile nie mogły być zmieniane z tego profilu. Nie filtruje treści."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oculta ajustes compartilhados para que servidores e perfis não possam ser alterados a partir dele. Não filtra o que pode ser assistido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ascunde setările partajate, astfel încât serverele și profilurile nu pot fi modificate din acest profil. Nu filtrează ce poate fi vizionat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скрывает общие настройки, чтобы серверы и профили нельзя было изменить. Не фильтрует контент для просмотра."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skryje zdieľané nastavenia, takže servery a profily nie je možné z neho meniť. Nefiltruje obsah na pozeranie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skrije skupne nastavitve, zato iz tega profila ni mogoče spreminjati strežnikov in profilov. Ne filtrira vsebine za gledanje."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sakriva deljena podešavanja, tako da se serveri i profili ne mogu menjati iz njega. Ne filtrira sadržaj koji se može gledati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Döljer delade inställningar så att servrar och profiler inte kan ändras därifrån. Filtrerar inte vad som kan tittas på."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ซ่อนการตั้งค่าที่แชร์ ทำให้ไม่สามารถเปลี่ยนเซิร์ฟเวอร์และโปรไฟล์จากที่นี่ ไม่ได้กรองเนื้อหาที่รับชมได้"
