    "Home, Search, profile switching and Settings always stay available." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تظل الصفحة الرئيسية والبحث وتبديل الملفات الشخصية والإعدادات متاحة دائمًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Начало, Търсене, превключването на профили и Настройки са винаги достъпни."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inici, Cerca, el canvi de perfil i Configuració sempre continuen disponibles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Domovská obrazovka, hledání, přepínání profilů a nastavení jsou vždy dostupné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hjem, Søgning, profilskift og Indstillinger er altid tilgængelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Start, Suchen, Profilwechsel und Einstellungen bleiben immer verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η Αρχική, η Αναζήτηση, η εναλλαγή προφίλ και οι Ρυθμίσεις παραμένουν πάντα διαθέσιμες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicio, Buscar, el cambio de perfil y Ajustes siempre están disponibles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "خانه، جستجو، تعویض نمایه و تنظیمات همیشه در دسترس می‌مانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koti, Haku, profiilin vaihto ja Asetukset ovat aina käytettävissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Accueil, Recherche, le changement de profil et Réglages restent toujours disponibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מסך הבית, החיפוש, החלפת הפרופילים וההגדרות נשארים זמינים תמיד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "होम, खोज, प्रोफ़ाइल बदलना और सेटिंग्स हमेशा उपलब्ध रहते हैं।"
