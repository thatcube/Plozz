    "Choose what plays behind the hero on a movie or show's detail page. Trailer and theme music never play together.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies wat er achter de uitgelichte banner wordt afgespeeld op de detailpagina van een film of serie. De trailer en themamuziek worden nooit tegelijk afgespeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz, co ma się odtwarzać za banerem głównym na stronie szczegółów filmu lub serialu. Zwiastun i muzyka motywu nigdy nie są odtwarzane jednocześnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha o que toca no fundo do destaque na página de detalhes de um filme ou série. Trailer e música tema nunca tocam juntos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg, hvad der afspilles bag banneret på detaljesiden for en film eller serie. Trailer og temamusik afspilles aldrig samtidig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez ce qui se lance derrière la bannière sur la fiche d’un film ou d’une série. La bande-annonce et le thème musical ne sont jamais lus ensemble."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите, что будет воспроизводиться в фоновом баннере на странице фильма или сериала. Трейлер и музыкальная тема никогда не воспроизводятся одновременно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vyberte, co se přehrává za hlavním panelem na stránce detailu filmu nebo seriálu. Trailer a hudební motiv se nikdy nepřehrávají současně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lege fest, was auf der Detailseite eines Films oder einer Serie hinter der Titelbühne läuft. Trailer und Titelmusik laufen nie gleichzeitig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli cosa riprodurre dietro la sezione in evidenza nella pagina dei dettagli di un film o una serie TV. Trailer e musica del tema non vengono mai riprodotti insieme."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Välj vad som spelas bakom huvudbilden på detaljsidan för en film eller serie. Trailer och temamusik spelas aldrig samtidigt."
          }
        }
      }
    },
    "Choose what plays behind the hero on a title's detail page. Trailer and theme music never play together.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies wat er achter de uitgelichte banner wordt afgespeeld op de detailpagina van een titel. De trailer en themamuziek worden nooit tegelijk afgespeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz, co ma się odtwarzać za banerem głównym na stronie szczegółów tytułu. Zwiastun i muzyka motywu nigdy nie są odtwarzane jednocześnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha o que toca no fundo do destaque na página de detalhes do título. Trailer e música tema nunca tocam juntos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg, hvad der afspilles bag banneret på en titels detaljeside. Trailer og temamusik afspilles aldrig samtidig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez ce qui se lance derrière la bannière sur la fiche d’un titre. La bande-annonce et le thème musical ne sont jamais lus ensemble."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите, что будет воспроизводиться в фоновом баннере на странице материала. Трейлер и музыкальная тема никогда не воспроизводятся одновременно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vyberte, co se přehrává za hlavním panelem na stránce detailu titulu. Trailer a hudební motiv se nikdy nepřehrávají současně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lege fest, was auf der Detailseite eines Titels hinter der Titelbühne läuft. Trailer und Titelmusik laufen nie gleichzeitig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli cosa riprodurre dietro la sezione in evidenza nella pagina dei dettagli di un titolo. Trailer e musica del tema non vengono mai riprodotti insieme."
          }
        },
        "sv": {
          "stringUnit": {
