    "Scan the code with your phone and approve access on Last.fm. There's no code to type — this screen updates automatically once you approve.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scan de code met je telefoon en keur de toegang goed op Last.fm. Er is geen code om in te typen — dit scherm wordt automatisch bijgewerkt zodra je goedkeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeskanuj kod telefonem i zatwierdź dostęp w Last.fm. Nie trzeba wpisywać kodu — ten ekran zaktualizuje się automatycznie po zatwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escaneie o código com seu celular e aprove o acesso no Last.fm. Não há código para digitar — esta tela é atualizada automaticamente assim que você aprovar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scan koden med din telefon, og godkend adgang på Last.fm. Der er ingen kode at indtaste — denne skærm opdateres automatisk, når du har godkendt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannez le code avec votre téléphone et approuvez l’accès sur Last.fm. Il n’y a aucun code à saisir — cet écran se met à jour automatiquement une fois l’accès approuvé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отсканируйте код телефоном и подтвердите доступ в Last.fm. Вводить код не нужно — этот экран обновится автоматически после подтверждения."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskenujte kód telefonem a schvalte přístup na Last.fm. Není třeba nic zadávat — tato obrazovka se po schválení aktualizuje automaticky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scanne den Code mit deinem Telefon und bestätige den Zugriff bei Last.fm. Du musst keinen Code eingeben — dieser Bildschirm aktualisiert sich automatisch, sobald du bestätigst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scansiona il codice con il telefono e approva l’accesso su Last.fm. Non c’è nessun codice da digitare — questa schermata si aggiorna automaticamente una volta approvato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skanna koden med din telefon och godkänn åtkomst på Last.fm. Det finns ingen kod att skriva in — den här skärmen uppdateras automatiskt när du har godkänt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenirajte kod telefonom i odobrite pristup na Last.fm-u. Nema koda za upisivanje — ovaj se zaslon automatski ažurira nakon odobrenja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imbas kod dengan telefon anda dan luluskan akses pada Last.fm. Tiada kod untuk ditaip — skrin ini dikemas kini secara automatik sebaik sahaja anda meluluskan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskenujte kód telefónom a schváľte prístup v Last.fm. Nie je potrebné zadávať žiadny kód — táto obrazovka sa po schválení aktualizuje automaticky."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відскануйте код телефоном і схваліть доступ на Last.fm. Вводити код не потрібно — цей екран оновиться автоматично після схвалення."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pindai kode dengan ponsel Anda dan setujui akses di Last.fm. Tidak ada kode yang perlu dimasukkan — layar ini akan diperbarui otomatis setelah Anda menyetujuinya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefonunuzla kodu tarayın ve Last.fm’de erişimi onaylayın. Yazmanız gereken bir kod yok — onay verdiğinizde bu ekran otomatik olarak güncellenir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escaneja el codi amb el telèfon i aprova l'accés a Last.fm. No cal escriure cap codi — aquesta pantalla s'actualitza automàticament quan ho aprovis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scanează codul cu telefonul și aprobă accesul în Last.fm. Nu trebuie să introduci niciun cod — acest ecran se actualizează automat după ce aprobi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "סרוק את הקוד עם הטלפון שלך ואשר גישה ב-Last.fm. אין קוד להקליד — המסך הזה מתעדכן אוטומטית לאחר שתאשר."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S telefonom preberite kodo in odobrite dostop v Last.fm. Ni kode za vnos — ta zaslon se po odobritvi samodejno posodobi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สแกนคิวอาร์โค้ดด้วยโทรศัพท์แล้วอนุมัติการเข้าถึงบน Last.fm ไม่ต้องป้อนรหัส — หน้าจอนี้จะอัปเดตอัตโนมัติเมื่ออนุมัติ"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сканирай кода с телефона си и одобри достъпа на Last.fm. Няма код за въвеждане — този екран се актуализира автоматично, когато одобриш."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skannaa koodi puhelimella ja hyväksy käyttöoikeus Last.fm-palvelussa. Koodia ei tarvitse kirjoittaa — tämä näkymä päivittyy automaattisesti hyväksynnän jälkeen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skann koden med telefonen og godkjenn tilgang på Last.fm. Du trenger ikke skrive inn en kode — skjermen oppdateres automatisk når du godkjenner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请使用手机扫描二维码并在 Last.fm 上授权访问。无需手动输入代码——授权后此界面将自动更新。"
          }
        }
      }
    },
