    "This profile isn’t linked to a Seerr user, so the request is made as the unrestricted admin. Link a user in Settings to track requests per person.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit profiel is niet gekoppeld aan een Seerr-gebruiker, dus de aanvraag wordt ingediend als de beheerder zonder beperkingen. Koppel in Instellingen een gebruiker om aanvragen per persoon bij te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten profil nie jest powiązany z użytkownikiem Seerr, więc prośbę wysyła administrator bez ograniczeń. Powiąż użytkownika w Ustawieniach, aby śledzić prośby poszczególnych osób."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este perfil não está vinculado a um usuário do Seerr, então a solicitação é feita como administrador sem restrições. Vincule um usuário em Ajustes para acompanhar as solicitações por pessoa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne profil er ikke knyttet til en Seerr-bruger, så anmodningen sendes som administrator uden begrænsninger. Tilknyt en bruger i Indstillinger for at spore anmodninger pr. person."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce profil n’est lié à aucun utilisateur Seerr ; la demande est donc effectuée en tant qu’administrateur sans restriction. Liez un utilisateur dans Réglages pour suivre les demandes par personne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот профиль не связан с пользователем Seerr, поэтому запрос отправляется от имени администратора без ограничений. Привяжите пользователя в Настройках, чтобы отслеживать запросы по каждому человеку."
          }
        }
      }
    },
    "This profile isn’t linked to a Seerr user. The request will use the unrestricted administrator account.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit profiel is niet gekoppeld aan een Seerr-gebruiker. De aanvraag wordt ingediend via het onbeperkte beheerdersaccount."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten profil nie jest powiązany z użytkownikiem Seerr. Prośba zostanie wysłana z konta administratora bez ograniczeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este perfil não está vinculado a um usuário do Seerr. A solicitação usará a conta de administrador sem restrições."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne profil er ikke knyttet til en Seerr-bruger. Anmodningen bruger administratorkontoen uden begrænsninger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce profil n’est lié à aucun utilisateur Seerr. La demande utilisera le compte administrateur sans restriction."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот профиль не связан с пользователем Seerr. Для запроса будет использована учётная запись администратора без ограничений."
          }
        }
      }
    },
    "This removes %@'s sign-in to %@ on this Apple TV.": {
      "comment": "tvOS sign-out confirmation message for a non-Plex account on a server. %1$@ is the user name, %2$@ is the server name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This removes %1$@'s sign-in to %2$@ on this Apple TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit verwijdert de aanmelding van %1$@ bij %2$@ op deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usuwa logowanie użytkownika „%1$@” na serwerze „%2$@” z tego Apple TV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isso remove o login de %1$@ em %2$@ nesta Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette fjerner loginet for %1$@ på %2$@ fra dette Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela supprime la connexion de %1$@ à %2$@ sur cette Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это удалит вход пользователя «%1$@» на сервере %2$@ на этом Apple TV."
          }
        }
      }
    },
    "This removes %@'s sign-in to %@ on this Apple TV. No one else in your household is signed in, so %@ will be removed from your servers until someone signs in again.": {
      "comment": "tvOS sign-out confirmation message when removing the last non-Plex account from a server. %1$@ is the user name, %2$@ is the server name, %3$@ is the same server name in the follow-up sentence.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This removes %1$@'s sign-in to %2$@ on this Apple TV. No one else in your household is signed in, so %3$@ will be removed from your servers until someone signs in again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit verwijdert de aanmelding van %1$@ bij %2$@ op deze Apple TV. Niemand anders in je huishouden is aangemeld, dus %3$@ wordt uit je servers verwijderd totdat iemand zich weer aanmeldt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usuwa logowanie użytkownika „%1$@” na serwerze „%2$@” z tego Apple TV. Nikt inny w domu nie jest zalogowany, więc serwer „%3$@” zniknie z listy serwerów do czasu ponownego zalogowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isso remove o login de %1$@ em %2$@ nesta Apple TV. Ninguém mais da sua casa está conectado, então %3$@ será removido da sua lista de servidores até alguém entrar de novo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette fjerner loginet for %1$@ på %2$@ fra dette Apple TV. Ingen andre i din husstand er logget ind, så %3$@ fjernes fra dine servere, indtil nogen logger ind igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela supprime la connexion de %1$@ à %2$@ sur cette Apple TV. Personne d’autre dans votre foyer n’est connecté, donc %3$@ sera retiré de vos serveurs jusqu’à ce que quelqu’un se reconnecte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это удалит вход пользователя «%1$@» на сервере %2$@ на этом Apple TV. Больше никто из вашей семьи не вошёл в систему, поэтому сервер %3$@ будет удалён из списка ваших серверов, пока кто-нибудь снова не войдёт."
          }
        }
      }
    },
    "This removes every Plex and Jellyfin sign-in on this Apple TV. You'll need to sign in again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
