    "Tap the window to bring playback back here.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik op het venster om het afspelen hierheen terug te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stuknij okno, aby przenieść odtwarzanie z powrotem tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque na janela para retomar a reprodução aqui."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryk på vinduet for at hente afspilningen tilbage hertil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez la fenêtre pour ramener la lecture ici."
          }
        },
        "ru": {
