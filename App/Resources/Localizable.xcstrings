    "Download a movie or episode from its detail page to watch offline." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قم بتنزيل فيلم أو حلقة من صفحة التفاصيل لمشاهدتها دون اتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изтеглете филм или епизод от страницата с детайли, за да го гледате офлайн."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baixa una pel·lícula o un episodi des de la seva pàgina de detalls per veure’l sense connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stáhněte si film nebo díl z jeho stránky detailu a sledujte ho offline."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Download en film eller episode fra dens detaljeside for at se den offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lade einen Film oder eine Folge über die Detailseite herunter, um offline zu schauen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Κατεβάστε μια ταινία ή ένα επεισόδιο από τη σελίδα λεπτομερειών του για προβολή εκτός σύνδεσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Descarga una película o episodio desde su página de detalles para verla sin conexión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای تماشای آفلاین یک فیلم یا قسمت را از صفحه جزئیات دانلود کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lataa elokuva tai jakso sen tietosivulta, niin voit katsoa sen offline-tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Télécharger un film ou un épisode depuis sa page de détails pour le regarder hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הורד סרט או פרק מעמוד הפרטים שלו כדי לצפות בו במצב לא מקוון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऑफ़लाइन देखने के लिए किसी मूवी या एपिसोड को उसके विवरण पेज से डाउनलोड करें."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Preuzmite film ili epizodu sa stranice pojedinosti za gledanje izvan mreže."
