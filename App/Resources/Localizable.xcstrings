                      "value": "Bu, %lld bölümün tamamını orijinal kalitede indirir ve önemli miktarda depolama alanı ile veri kullanabilir. İstediğiniz zaman İndirilenler’den kaldırabilirsiniz."
                    }
                  }
                }
              }
            }
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%#@arg1@\n\n%2$@ lliures en aquest dispositiu."
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "Això baixarà %lld episodi amb la qualitat original i pot fer servir molt espai d'emmagatzematge i dades. El pots eliminar en qualsevol moment des de Baixades."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "Això baixarà tots els %lld episodis amb la qualitat original i pot fer servir molt espai d'emmagatzematge i dades. Els pots eliminar en qualsevol moment des de Baixades."
                    }
                  }
                }
              }
            }
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%#@arg1@\n\nSpațiu disponibil pe acest dispozitiv: %2$@."
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "Se descarcă %lld episod la calitate originală. Descărcarea poate ocupa mult spațiu de stocare și poate consuma multe date. Îl poți elimina oricând din Descărcări."
                    }
                  },
                  "few": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "Se descarcă toate cele %lld episoade la calitate originală. Descărcarea poate ocupa mult spațiu de stocare și poate consuma multe date. Le poți elimina oricând din Descărcări."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "Se descarcă toate cele %lld de episoade la calitate originală. Descărcarea poate ocupa mult spațiu de stocare și poate consuma multe date. Le poți elimina oricând din Descărcări."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
