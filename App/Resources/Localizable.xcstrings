          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synkronisera din tittarhistorik och håll koll på vad du ska titta på härnäst med Simkl."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinkronizirajte svoju povijest gledanja i pratite što sljedeće gledati uz Simkl."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Segerakkan sejarah tontonan anda dan jejaki apa yang perlu ditonton seterusnya dengan Simkl."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
