    "Move a provider here to stop using it.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verplaats een provider hierheen om deze niet meer te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przenieś tu dostawcę, aby przestać go używać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mova um provedor para cá para deixar de usá-lo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flyt en udbyder herhen for at stoppe med at bruge den."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplacez un fournisseur ici pour ne plus l’utiliser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переместите источник сюда, чтобы больше его не использовать."
