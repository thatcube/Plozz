    "%@ has reached the request limit. Try again later or adjust the quota in Seerr.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ heeft de aanvraaglimiet bereikt. Probeer het later opnieuw of pas de limiet aan in Seerr."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ma już wykorzystany limit próśb. Spróbuj ponownie później albo dostosuj limit w Seerr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ atingiu o limite de solicitações. Tente novamente mais tarde ou ajuste a cota no Seerr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har nået anmodningsgrænsen. Prøv igen senere, eller justér kvoten i Seerr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a atteint la limite de demandes. Réessayez plus tard ou ajustez le quota dans Seerr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для пользователя %@ исчерпан лимит запросов. Повторите попытку позже или измените квоту в Seerr."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uživatel %@ dosáhl limitu žádostí. Zkuste to znovu později nebo upravte kvótu ve službě Seerr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ hat das Anfragelimit erreicht. Versuche es später erneut oder passe das Kontingent in Seerr an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ha raggiunto il limite di richieste. Riprova più tardi o modifica la quota in Seerr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har nått gränsen för antal förfrågningar. Försök igen senare eller justera kvoten i Seerr."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ je dosegnuo ograničenje zahtjeva. Pokušajte ponovno kasnije ili prilagodite kvotu u Seerru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ telah mencapai had permohonan. Cuba lagi kemudian atau laraskan kuota dalam Seerr."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Používateľ %@ dosiahol limit žiadostí. Skúste to znova neskôr alebo upravte kvótu v službe Seerr."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для %@ вичерпано ліміт запитів. Спробуйте пізніше або змініть квоту в Seerr."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ telah mencapai batas permintaan. Coba lagi nanti atau sesuaikan kuotanya di Seerr."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ için istek sınırına ulaşıldı. Daha sonra yeniden deneyin veya Seerr’deki kotayı değiştirin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ha arribat al límit de sol·licituds. Torna-ho a provar més tard o ajusta la quota a Seerr."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a atins limita de solicitări. Încearcă din nou mai târziu sau ajustează cota în Seerr."
          }
        }
      }
    },
