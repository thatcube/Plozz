    "Plex shares one sign-in across the household. Each profile picks its own Plex user and libraries under Profile › Your Libraries.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex deelt één aanmelding voor het hele huishouden. Elk profiel kiest zijn eigen Plex-gebruiker en bibliotheken onder Profiel › Jouw bibliotheken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex współdzieli jedno logowanie w całym gospodarstwie domowym. Każdy profil wybiera własnego użytkownika Plex i biblioteki w Profil › Twoje biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plex compartilha um único login com todo o grupo familiar. Cada perfil escolhe o próprio usuário do Plex e as próprias bibliotecas em Perfil › Suas bibliotecas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex deler ét login på tværs af husstanden. Hver profil vælger sin egen Plex-bruger og biblioteker under Profil › Dine biblioteker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex partage une seule connexion pour tout le foyer. Chaque profil choisit son propre utilisateur Plex et ses bibliothèques sous Profil › Vos bibliothèques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex использует один вход для всей семьи. Каждый профиль выбирает своего пользователя Plex и свои медиатеки в разделе «Профиль» › «Ваши медиатеки»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex sdílí jedno přihlášení napříč celou domácností. Každý profil si v části Profil › Vaše knihovny vybere vlastního uživatele Plex a knihovny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex nutzt eine gemeinsame Anmeldung für den ganzen Haushalt. Jedes Profil wählt unter „Profil › Deine Medienbibliotheken“ seinen eigenen Plex-Benutzer und seine Medienbibliotheken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex condivide un unico accesso per tutto il nucleo familiare. Ogni profilo sceglie il proprio utente Plex e le proprie librerie in Profilo › Le tue librerie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex delar en inloggning för hela hushållet. Varje profil väljer sin egen Plex-användare och sina bibliotek under Profil › Dina bibliotek."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex dijeli jednu prijavu unutar kućanstva. Svaki profil bira svojeg Plex korisnika i knjižnice pod Profil › Vaše knjižnice."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex berkongsi satu log masuk merentasi isi rumah. Setiap profil memilih pengguna Plex dan pustaka sendiri di bawah Profil › Pustaka Anda."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex zdieľa jedno prihlásenie v celej domácnosti. Každý profil si v časti Profil › Vaše knižnice vyberá vlastného používateľa Plex a knižnice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex використовує один спільний вхід для всієї домашньої групи. Кожен профіль вибирає свого користувача Plex і медіатеки в розділі «Профіль» › «Ваші медіатеки»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex menggunakan satu akun masuk bersama untuk seluruh rumah tangga. Setiap profil memilih pengguna Plex dan pustakanya sendiri melalui Profil › Pustaka Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex, hane genelinde tek bir oturum açma bilgisini paylaşır. Her profil kendi Plex kullanıcısını ve kitaplıklarını Profil › Kitaplıklarınız bölümünden seçer."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex comparteix un únic inici de sessió per a tota la llar. Cada perfil tria el seu propi usuari de Plex i les seves biblioteques a Perfil › Les teves biblioteques."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex folosește o singură autentificare pentru toată familia. Fiecare profil își alege propriul utilizator Plex și propriile biblioteci în Profil › Bibliotecile tale."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex משתף התחברות אחת בין כל משק הבית. כל פרופיל בוחר את משתמש ה-Plex והספריות שלו תחת פרופיל › הספריות שלך."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex uporablja eno prijavo za celotno gospodinjstvo. Vsak profil pod Profil › Vaše knjižnice izbere svojega uporabnika Plex in svoje knjižnice."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex ใช้การลงชื่อเข้าใช้ร่วมกันทั้งครัวเรือน แต่ละโปรไฟล์เลือกผู้ใช้ Plex และไลบรารีของตัวเองได้ที่ โปรไฟล์ › ไลบรารีของคุณ"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex споделя едно влизане за цялото домакинство. Всеки профил избира собствен потребител на Plex и медиатеки от Профил › Вашите медиатеки."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex käyttää yhtä ja samaa kirjautumista koko taloudessa. Kukin profiili valitsee oman Plex-käyttäjänsä ja kirjastonsa kohdassa Profiili › Omat kirjastot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex deler én pålogging i husholdningen. Hver profil velger sin egen Plex-bruker og biblioteker under Profil › Dine biblioteker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex 在整个家庭中共享一个登录账户。每个个人资料可独立选择自己的 Plex 用户和媒体库，路径为：个人资料 › 我的媒体库。"
          }
        }
      }
    },
    "Plex sign-in finds every server linked to your account.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aanmelden bij Plex vindt elke server die aan je account is gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logowanie do Plex znajduje wszystkie serwery powiązane z kontem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O login do Plex encontra todos os servidores vinculados à sua conta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Login med Plex finder alle servere, der er knyttet til din konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion à Plex détecte tous les serveurs liés à votre compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вход через Plex находит все серверы, связанные с вашей учётной записью."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přihlášením k účtu Plex najdete všechny servery propojené s vaším účtem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Plex-Anmeldung findet alle mit deinem Konto verknüpften Server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accesso a Plex trova ogni server collegato al tuo account."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "När du loggar in på Plex hittas alla servrar som är kopplade till kontot."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijavom na račun Plex pronaći ćete sve poslužitelje povezane s vašim računom."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Log masuk Plex mencari setiap pelayan yang dipautkan ke akaun anda."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prihlásením do účtu Plex nájdete všetky servery prepojené s vaším účtom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вхід до Plex знаходить кожен сервер, пов’язаний з вашим обліковим записом."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dengan masuk ke Plex, semua server yang tertaut ke akun Anda akan ditemukan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex’te oturum açmak, hesabınıza bağlı tüm sunucuları bulur."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'inici de sessió amb Plex troba tots els servidors vinculats al teu compte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectarea la Plex găsește toate serverele asociate contului tău."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ההתחברות ל-Plex מוצאת כל שרת המקושר לחשבון שלך."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijava v Plex najde vse strežnike, povezane z vašim računom."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การลงชื่อเข้าใช้ Plex จะค้นหาเซิร์ฟเวอร์ทั้งหมดที่เชื่อมกับบัญชีของคุณ"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Влизането в Plex намира всички сървъри, свързани с акаунта ви."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex-kirjautuminen löytää kaikki tiliisi linkitetyt palvelimet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex-pålogging finner alle servere som er knyttet til kontoen din."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex 登录会查找与您的账户关联的所有服务器。"
          }
        }
      }
    },
    "Plozz is only available in English for now. More languages are on the way.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz is momenteel alleen beschikbaar in het Engels. Meer talen komen eraan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz jest na razie dostępny tylko po angielsku. Wkrótce pojawią się kolejne języki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz está disponível apenas em inglês por enquanto. Mais idiomas estão a caminho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz er indtil videre kun tilgængelig på engelsk. Flere sprog er på vej."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz n’est disponible qu’en anglais pour le moment. D’autres langues arrivent bientôt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пока Plozz доступен только на английском. Другие языки скоро появятся."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz je zatím dostupný jen v angličtině. Další jazyky jsou na cestě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz ist derzeit nur auf Englisch verfügbar. Weitere Sprachen folgen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz è disponibile solo in inglese per ora. Altre lingue sono in arrivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz finns bara på engelska än så länge. Fler språk är på väg."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz je za sada dostupan samo na engleskom. Uskoro stiže još jezika."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz kini hanya tersedia dalam bahasa Inggeris. Lebih banyak bahasa akan datang."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz je zatiaľ k dispozícii iba v angličtine. Ďalšie jazyky sú na ceste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz наразі доступна лише англійською мовою. Більше мов у розробці."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz baru tersedia dalam bahasa Inggris untuk saat ini. Bahasa lain segera hadir."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz şimdilik yalnızca İngilizce kullanılabiliyor. Yakında daha fazla dil gelecek."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De moment, Plozz només està disponible en anglès. Properament s'hi afegiran més idiomes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz este disponibil momentan doar în engleză. Urmează și alte limbi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz זמינה כרגע רק באנגלית. שפות נוספות בדרך."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz je za zdaj na voljo samo v angleščini. Več jezikov prihaja kmalu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตอนนี้ Plozz ใช้ได้เฉพาะภาษาอังกฤษเท่านั้น ภาษาอื่นกำลังจะตามมา"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz е достъпен само на английски засега. Повече езици идват."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz on toistaiseksi saatavilla vain englanniksi. Lisää kieliä on tulossa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz er inntil videre kun tilgjengelig på engelsk. Flere språk er på vei."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz 目前仅支持英文界面。更多语言即将上线。"
          }
        }
      }
    },
    "Plozz picks the best source for each field automatically.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz kiest automatisch de beste bron voor elk veld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz automatycznie wybiera najlepsze źródło dla każdego pola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz escolhe automaticamente a melhor fonte para cada campo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz vælger automatisk den bedste kilde til hvert felt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz choisit automatiquement la meilleure source pour chaque champ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz автоматически выбирает лучший источник для каждого поля."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz automaticky vybere pro každé pole nejlepší zdroj."
          }
