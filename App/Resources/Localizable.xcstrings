    "Sign-ins and network shares are available to every profile on this %@.": {
      "comment": "Footer on the iOS Servers settings page explaining that server sign-ins and network shares are shared household-wide. %@ is the device name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aanmeldingen en netwerkshares zijn beschikbaar voor elk profiel op deze %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logowania i udziały sieciowe są dostępne dla wszystkich profili na urządzeniu „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os logins e compartilhamentos de rede estão disponíveis para todos os perfis neste %@."
