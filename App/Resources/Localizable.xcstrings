    "circadianMode.detail.alwaysOn": {
      "comment": "One-line explanation shown under the Circadian mode picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Always warm, at full strength, around the clock."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altijd warm, op volle sterkte, de klok rond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zawsze ociepla obraz z pełną siłą, przez całą dobę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sempre aquecida, na intensidade máxima, o tempo todo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altid varm, med fuld styrke, hele døgnet."
