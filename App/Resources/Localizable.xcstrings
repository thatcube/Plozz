{
  "sourceLanguage" : "en",
  "strings" : {
    " ahead" : {
      "comment" : "Suffix in the playback diagnostics buffer-status row after the buffered time figure, for example '72.6s ahead'."
    },
    " free" : {
      "comment" : "Suffix in the playback diagnostics disk-space row after the free-space figure, for example '90.26 GB free'."
    },
    " of " : {
      "comment" : "Infix in the playback diagnostics seek-window row between the current seekable duration and the total duration, for example '15:00 of 42:00'."
    },
    "%@ (detected)" : {
      "comment" : "Label for a protocol option in the add-network-share transport picker on tvOS and iOS when that protocol was auto-detected on the selected device. %@ is the transport name, such as SMB or NFS."
    },
    "%@ coming soon" : {
      "comment" : "Title of the tvOS placeholder screen shown after choosing a detected share protocol that Plozz has not implemented yet. %@ is the transport name."
    },
    "%@ doesn’t have permission to request this. Check the user’s permissions in Seerr." : {

    },
    "%@ free" : {
      "comment" : "Free-space amount shown in storage summaries, including the iOS Downloads capacity bar and the player's Disk diagnostics row. %@ is the formatted free-space size."
    },
    "%@ has no default quality profile or server set. Set one in the Seerr web app, then try again." : {

    },
    "%@ has reached the request limit. Try again later or adjust the quota in Seerr." : {

    },
    "%@ left" : {
      "comment" : "Remaining runtime label shown on episode and poster cards and on the in-progress episode watch-state pill. %@ is the formatted remaining time."
    },
    "%@ of %@" : {
      "comment" : "Share enrichment progress: items enriched so far out of the pass's total. `done` arrives pre-padded to a fixed width; `total` must stay ungrouped to match.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        }
      }
    },
    "%@ rating %@" : {
      "comment" : "Accessibility label for one rating badge in a ratings row. %@ is the rating source name, and the second %@ is the displayed score.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ rating %2$@"
          }
        }
      }
    },
    "%@ share" : {
      "comment" : "Subtitle in server details for a direct network share connection. %@ is the share transport name, such as SMB or WebDAV."
    },
    "%@ subtitles are rendered as images and can’t be restyled." : {
      "comment" : "Secondary text in the iOS player subtitle Appearance section when the selected subtitle track is bitmap-based. %@ is the subtitle format name, such as PGS or VobSub."
    },
    "%@ subtitles can't be restyled" : {
      "comment" : "Headline on the tvOS subtitle style screen when the current subtitle track is bitmap-based and styling controls are unavailable. %@ is the subtitle format name."
    },
    "%@ support is coming soon" : {
      "comment" : "Headline on the iOS placeholder screen for a detected share protocol that Plozz does not support yet. %@ is the transport name."
    },
    "%@ support is on the way. This device was detected, but Plozz can’t connect over %@ just yet." : {
      "comment" : "Body text on the tvOS coming-soon screen for a detected network share protocol. The first %@ is the transport name in the sentence subject, and the second %@ is the same transport name after 'over'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ support is on the way. This device was detected, but Plozz can’t connect over %2$@ just yet."
          }
        }
      }
    },
    "%@ used by downloads" : {
      "comment" : "iOS Downloads storage summary showing how much device space downloaded media currently uses. %@ is the formatted size."
    },
    "%@ · %@ detected" : {
      "comment" : "Subtitle under an auto-detected device in the add-share flow on tvOS and iOS. The first %@ is the device host name or address, and the second %@ is the list of detected share protocols.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@ detected"
          }
        }
      }
    },
    "%@ — Failed" : {
      "comment" : "Disabled season row in request menus when requesting that season failed. %@ is the season title, such as Season 2."
    },
    "%@, offline" : {
      "comment" : "Accessibility label for an unavailable source row in the playback source picker. %@ is the source name."
    },
    "%lld" : {
      "comment" : "Standalone numeric value used in the player subtitle style editor for whole-number controls such as shadow thickness, outline width, padding, and gap. %lld is the selected integer value."
    },
    "%lld channels" : {
      "comment" : "Fallback wording for an audio track's channel count when it doesn't match a named layout convention (e.g. Stereo, 5.1, 7.1).",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld channel"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld channels"
                }
              }
            }
          }
        }
      }
    },
    "%lld cues" : {
      "comment" : "Live status suffix showing how many subtitle lines (cues) were loaded for the selected second subtitle track.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
