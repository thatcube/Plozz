    "Optional. Use your own TMDB read token so lookups run under your account's rate limit.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Optioneel. Gebruik je eigen TMDB-leestoken, zodat opzoekacties binnen de API-limiet van je account vallen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opcjonalne. Użyj własnego tokenu odczytu TMDB, aby wyszukiwania działały w ramach limitu konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opcional. Use seu próprio token de leitura do TMDB para que as buscas usem o limite da sua conta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valgfrit. Brug dit eget TMDB-læsetoken, så opslag bruger din kontos anmodningsgrænse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Facultatif. Utilisez votre propre jeton de lecture TMDB afin que les recherches utilisent le quota de votre compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Необязательно. Используйте собственный токен чтения TMDB, чтобы запросы выполнялись в пределах лимита вашей учётной записи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volitelné. Použijte vlastní token TMDB pro čtení, aby vyhledávání využívala limit vašeho účtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Optional: Verwende dein eigenes TMDB-Lesetoken, damit Abfragen über das Limit deines Accounts laufen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Facoltativo. Usa il tuo token di lettura TMDB per eseguire le ricerche rispettando i limiti di frequenza del tuo account."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valfritt. Använd din egen TMDB-lästoken så att uppslagningarna räknas mot kontots anropsgräns."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neobavezno. Upotrijebite vlastiti TMDB token za čitanje kako bi se upiti izvršavali unutar ograničenja broja zahtjeva vašeg računa."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilihan. Gunakan token baca TMDB anda sendiri supaya carian berjalan di bawah had kadar akaun anda."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voliteľné. Použite vlastný token na čítanie TMDB, aby vyhľadávania prebiehali v rámci limitu vášho účtu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Необов’язково. Використовуйте власний токен читання TMDB, щоб пошуки виконувалися в межах ліміту запитів вашого облікового запису."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opsional. Gunakan token baca TMDB Anda sendiri agar pencarian memakai batas laju akun Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İsteğe bağlı. Aramaların hesabınızın hız sınırı altında çalışması için kendi TMDB okuma belirtecinizi kullanın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opcional. Utilitza el teu propi testimoni de lectura de TMDB perquè les cerques s'executin dins del límit de peticions del teu compte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opțional. Folosește propriul token de citire TMDB, astfel încât căutările să respecte limita de solicitări a contului tău."
          }
        }
