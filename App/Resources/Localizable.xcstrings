    "Cached images and resolved links are rebuilt automatically as you browse.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gecachte afbeeldingen en herleide links worden automatisch opnieuw opgebouwd terwijl je bladert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buforowane obrazy i rozpoznane linki są odbudowywane automatycznie podczas przeglądania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As imagens em cache e os links resolvidos são recriados automaticamente enquanto você navega."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cachelagrede billeder og løste links genopbygges automatisk, mens du gennemser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les images en cache et les liens résolus sont reconstruits automatiquement pendant la navigation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кэшированные изображения и обработанные ссылки автоматически обновляются во время просмотра."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obrázky v mezipaměti a vyřešené odkazy se při procházení automaticky znovu vytvoří."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwischengespeicherte Bilder und aufgelöste Links werden beim Stöbern automatisch neu erstellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le immagini nella cache e i collegamenti risolti vengono ricostruiti automaticamente durante la navigazione."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cachade bilder och upplösta länkar återskapas automatiskt när du bläddrar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Predmemorirane slike i razriješene veze ponovno se automatski stvaraju dok pregledavate."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imej dalam cache dan pautan yang telah diselesaikan dibina semula secara automatik semasa anda menyemak imbas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obrázky vo vyrovnávacej pamäti a vyriešené odkazy sa pri prehliadaní automaticky obnovujú."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кешовані зображення й визначені посилання автоматично оновлюються під час перегляду."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
