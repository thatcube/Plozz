    "Sync your watch history and track what to watch next with Simkl.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synchroniseer je kijkgeschiedenis en houd bij wat je hierna wilt kijken met Simkl."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synchronizuj historię oglądania i śledź, co oglądać dalej, w Simkl."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sincronize seu histórico de exibição e acompanhe o que assistir depois com Simkl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synkroniser din seerhistorik, og hold styr på, hvad du skal se næste gang, med Simkl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synchronisez votre historique de visionnage et suivez ce qu’il faut regarder ensuite avec Simkl."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Синхронизируйте историю просмотров и отслеживайте, что смотреть дальше, с Simkl."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synchronizujte historii sledování a sledujte, co zhlédnout příště, pomocí Simkl."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synchronisiere deinen Wiedergabeverlauf und behalte mit Simkl im Blick, was du als Nächstes ansehen willst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sincronizza la cronologia di visione e tieni traccia di cosa guardare dopo con Simkl."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synkronisera din tittarhistorik och håll koll på vad du ska titta på härnäst med Simkl."
          }
        },
        "hr": {
