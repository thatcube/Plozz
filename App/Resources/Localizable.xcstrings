    "transparency.detail.system": {
      "comment": "One-line explanation shown under the transparency picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Follow the tvOS “Reduce Transparency” accessibility setting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volg de tvOS-toegankelijkheidsinstelling “Transparantie verminderen”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dopasuj do ustawienia dostępności „Ogranicz przezroczystość” w tvOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
