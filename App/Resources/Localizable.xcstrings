      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هذا سيزيل اتصال الضيف بـ %1$@ على هذا Apple TV. لا يوجد أحد آخر في عائلتك مسجل دخوله، لذلك سيتم إزالة %2$@ من الخوادم الخاصة بك حتى يقوم شخص ما بتسجيل الدخول مرة أخرى."
          }
