    "If this share needs a different account, enter a username and password and try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als voor deze netwerkshare een ander account nodig is, voer je een gebruikersnaam en wachtwoord in en probeer je het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeśli ten udział wymaga innego konta, wpisz nazwę użytkownika i hasło, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se este compartilhamento precisar de outra conta, informe um nome de usuário e uma senha e tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvis denne deling kræver en anden konto, skal du indtaste et brugernavn og en adgangskode og prøve igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si ce partage nécessite un autre compte, saisissez un nom d’utilisateur et un mot de passe, puis réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Если для этого ресурса нужна другая учётная запись, введите имя пользователя и пароль и повторите попытку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokud toto sdílení vyžaduje jiný účet, zadejte uživatelské jméno a heslo a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn diese Freigabe ein anderes Konto benötigt, gib Benutzernamen und Passwort ein und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se questa condivisione richiede un account diverso, inserisci un nome utente e una password e riprova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om den här delningen kräver ett annat konto anger du användarnamn och lösenord och försöker igen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ako ovo dijeljenje treba drugi račun, unesite korisničko ime i lozinku pa pokušajte ponovno."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jika perkongsian ini memerlukan akaun berbeza, masukkan nama pengguna dan kata laluan, kemudian cuba lagi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ak toto zdieľanie vyžaduje iný účet, zadajte používateľské meno a heslo a skúste to znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Якщо цьому ресурсу потрібен інший обліковий запис, введіть ім’я користувача та пароль і спробуйте ще раз."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jika folder bersama ini memerlukan akun lain, masukkan nama pengguna dan kata sandi lalu coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu paylaşım farklı bir hesap gerektiriyorsa kullanıcı adı ve parola girip yeniden deneyin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si aquest recurs compartit necessita un compte diferent, introdueix un nom d'usuari i una contrasenya i torna-ho a provar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dacă această resursă de rețea necesită alt cont, introdu un nume de utilizator și o parolă, apoi încearcă din nou."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אם השיתוף הזה דורש חשבון אחר, הזן שם משתמש וסיסמה ונסה שוב."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Če ta souporaba potrebuje drug račun, vnesite uporabniško ime in geslo ter poskusite znova."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หากการแชร์นี้ต้องใช้บัญชีอื่น ให้ป้อนชื่อผู้ใช้และรหัสผ่านแล้วลองอีกครั้ง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ако този ресурс изисква друг акаунт, въведете потребителско име и парола и опитайте отново."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jos tämä jako vaatii toisen tilin, syötä käyttäjätunnus ja salasana ja yritä uudelleen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvis denne delingen krever en annen konto, skriver du inn brukernavn og passord og prøver igjen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果此共享需要不同账户，请输入用户名和密码后重试。"
          }
        }
      }
    },
