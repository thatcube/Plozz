    "· +%lld more" : {
      "comment" : "Overflow indicator in the secondary line of the tvOS Libraries row in Settings when more watched servers exist than are shown. %lld is the number of additional servers not listed."
    },
    "“%@” is set up on another device. Sign in to watch it here — your login stays private to each device. You can also find it later under Settings ▸ iCloud Sync." : {
      "comment" : "Alert message on tvOS when a server synced from another device is available to add locally. %@ is the server name."
    },
    "“%@” will also be removed from your other devices signed in to iCloud." : {
      "comment" : "Warning text in the Remove Everywhere alert on tvOS and iOS server settings. %@ is the server name that will also be removed from other iCloud-signed devices."
    },
    "− shows subtitles earlier\n+ shows them later" : {

    },
    "−50 ms" : {
      "comment" : "Adjustment button in the subtitle delay controls on tvOS. Decreases subtitle timing by 50 milliseconds."
    },
    "−500 ms" : {
      "comment" : "Adjustment button in the subtitle delay controls on tvOS. Decreases subtitle timing by 500 milliseconds."
    }
  },
