    "Requests from %@ will use this Seerr user’s quota, approvals, and default quality profile.": {
      "comment": "Footer in that Seerr user picker explaining the mapping. %@ is the household profile name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aanvragen van %@ gebruiken het quotum, de goedkeuringen en het standaardkwaliteitsprofiel van deze Seerr-gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prośby z profilu „%@” będą korzystać z limitu, zatwierdzeń i domyślnego profilu jakości tego użytkownika Seerr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As solicitações de %@ usarão a cota, as aprovações e o perfil de qualidade padrão deste usuário do Seerr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anmodninger fra %@ vil bruge denne Seerr-brugers kvote, godkendelser og standardkvalitetsprofil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les demandes de %@ utiliseront le quota, les approbations et le profil de qualité par défaut de cet utilisateur Seerr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для запросов профиля «%@» будут использоваться квота, подтверждения и профиль качества по умолчанию этого пользователя Seerr."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Žádosti profilu %@ budou používat kvótu, schvalování a výchozí profil kvality tohoto uživatele Seerr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anfragen von %@ nutzen das Kontingent, die Freigaben und das Standard-Qualitätsprofil dieses Seerr-Benutzers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le richieste di %@ useranno la quota, le approvazioni e il profilo di qualità predefinito di questo utente Seerr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Förfrågningar från %@ använder den här Seerr-användarens kvot, godkännanden och standardkvalitetsprofil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zahtjevi profila %@ koristit će kvotu, odobrenja i zadani profil kvalitete ovog korisnika usluge Seerr."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permintaan daripada %@ akan menggunakan kuota, kelulusan dan profil kualiti lalai pengguna Seerr ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Žiadosti profilu %@ budú používať kvótu, schvaľovanie a predvolený profil kvality tohto používateľa Seerr."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запити від %@ використовуватимуть квоту, схвалення й типовий профіль якості цього користувача Seerr."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permintaan dari %@ akan memakai kuota, persetujuan, dan profil kualitas bawaan pengguna Seerr ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ tarafından yapılan istekler bu Seerr kullanıcısının kotasını, onaylarını ve varsayılan kalite profilini kullanır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sol·licituds de %@ utilitzaran la quota, les aprovacions i el perfil de qualitat predeterminat d'aquest usuari de Seerr."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicitările de la %@ vor folosi cota, aprobările și profilul de calitate implicit ale acestui utilizator Seerr."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בקשות של %@ ישתמשו במכסה, באישורים ובפרופיל האיכות המוגדר כברירת מחדל של משתמש Seerr זה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zahteve profila %@ bodo uporabile kvoto, odobritve in privzeti profil kakovosti tega uporabnika storitve Seerr."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คำขอจาก %@ จะใช้โควตา การอนุมัติ และโปรไฟล์คุณภาพเริ่มต้นของผู้ใช้ Seerr นี้"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заявките от %@ ще използват квотата, одобренията и профила на качеството по подразбиране на този потребител на Seerr."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiilin %@ pyynnöt käyttävät tämän Seerr-käyttäjän kiintiötä, hyväksyntöjä ja oletuslaatuprofiilia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forespørsler fra %@ bruker denne Seerr-brukerens kvote, godkjenninger og standardkvalitetsprofil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "来自 %@ 的请求将使用该 Seerr 用户的配额、审批和默认质量配置文件。"
          }
        }
      }
    },
