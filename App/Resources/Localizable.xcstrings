    "home.notice.serversOff" : {
      "comment" : "Shown on Home when the profile has disabled every server it could watch from.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "جميع الخوادم معطّلة لهذا الملف الشخصي، لذا لا تظهر مكتباتها. فعّل أحدها مجددًا في الإعدادات › المكتبات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Този профил е изключил всички сървъри, затова медиатеките не се показват. Включете отново някой в Настройки › Медиатеки."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aquest perfil té tots els servidors desactivats, així que les biblioteques no es mostren. Torna'n a activar un a Configuració › Biblioteques."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tento profil má vypnuté všechny servery, takže se knihovny nezobrazují. Některý znovu zapněte v Nastavení › Knihovny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denne profil har slået alle servere fra, så bibliotekerne vises ikke. Slå en til igen i Indstillinger › Biblioteker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Profil hat alle Server deaktiviert, daher werden keine Medienbibliotheken angezeigt. Aktivieren Sie einen erneut unter Einstellungen › Medienbibliotheken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αυτό το προφίλ έχει απενεργοποιήσει όλους τους διακομιστές, επομένως οι βιβλιοθήκες δεν εμφανίζονται. Ενεργοποιήστε ξανά κάποιον στις Ρυθμίσεις › Βιβλιοθήκες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This profile has every server switched off, so its libraries aren't shown. Turn one back on in Settings › Libraries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este perfil tiene todos los servidores desactivados, así que sus bibliotecas multimedia no se muestran. Vuelve a activar uno en Ajustes › Bibliotecas multimedia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "این نمایه همه سرورها را خاموش کرده است، بنابراین کتابخانه‌ها نمایش داده نمی‌شوند. یکی از سرورها را دوباره در تنظیمات › کتابخانه‌ها روشن کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tässä profiilissa kaikki palvelimet on poistettu käytöstä, joten kirjastoja ei näytetä. Ota jokin palvelin takaisin käyttöön kohdassa Asetukset › Kirjastot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce profil a désactivé tous les serveurs, les bibliothèques ne sont donc pas affichées. Réactivez-en un dans Réglages › Bibliothèques."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בפרופיל הזה כל השרתים כבויים, ולכן הספריות שלהם אינן מוצגות. הפעילו מחדש אחד מהם בהגדרות › ספריות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस प्रोफ़ाइल के सभी सर्वर बंद हैं, इसलिए लाइब्रेरी नहीं दिख रहीं। सेटिंग्स › लाइब्रेरी में जाकर कोई एक सर्वर वापस चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ovaj profil ima isključene sve poslužitelje pa se knjižnice ne prikazuju. Ponovno uključite jedan u izborniku Postavke › Knjižnice."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ez a profil minden szervert kikapcsolt, ezért a könyvtárak nem jelennek meg. Kapcsoljon be újra egy szervert a Beállítások › Könyvtárak menüben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Profil ini menonaktifkan semua server, sehingga pustaka tidak ditampilkan. Aktifkan kembali salah satu server di Pengaturan › Pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questo profilo ha tutti i server disattivati, quindi le librerie non vengono mostrate. Riattivane uno in Impostazioni › Librerie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このプロフィールではすべてのサーバーがオフになっているため、ライブラリが表示されていません。設定 › ライブラリでいずれかのサーバーを再度オンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 프로필의 모든 서버가 꺼져 있어 미디어 보관함이 표시되지 않습니다. 설정 › 미디어 보관함에서 서버 하나를 다시 켜세요."
