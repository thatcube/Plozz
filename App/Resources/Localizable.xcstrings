    "Pick a server found on your network, or enter its address." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر خادمًا موجودًا في شبكتك، أو أدخل عنوانه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изберете сървър, намерен във вашата мрежа, или въведете адреса му."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tria un servidor trobat a la teva xarxa, o introdueix-ne l'adreça."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte server nalezený ve vaší síti nebo zadejte jeho adresu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vælg en server, der er fundet på dit netværk, eller indtast dens adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle einen im Netzwerk gefundenen Server oder gib seine Adresse ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Επιλέξτε έναν διακομιστή που βρέθηκε στο δίκτυό σας ή εισαγάγετε τη διεύθυνσή του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige un servidor encontrado en tu red o introduce su dirección."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سروری را که در شبکه شما پیدا شده است انتخاب کنید یا آدرس آن را وارد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse verkosta löytynyt palvelin tai syötä sen osoite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez un serveur trouvé sur votre réseau ou saisissez son adresse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בחר שרת שנמצא ברשת שלך, או הזן את הכתובת שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अपने नेटवर्क पर मिला कोई सर्वर चुनें या उसका पता दर्ज करें."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odaberite poslužitelj pronađen na vašoj mreži ili unesite njegovu adresu."
