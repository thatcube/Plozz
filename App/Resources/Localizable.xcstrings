    "error.serverUnreachable": {
      "comment": "Shown when the app cannot connect to the user's media server.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reach the server. Check that it’s online and on the same network."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan de server niet bereiken. Controleer of deze online is en zich op hetzelfde netwerk bevindt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można połączyć się z serwerem. Sprawdź, czy jest dostępny w sieci i połączony z tą samą siecią."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível acessar o servidor. Verifique se ele está online e na mesma rede."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan ikke få forbindelse til serveren. Tjek, at den er online og på samme netværk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de joindre le serveur. Vérifiez qu’il est en ligne et sur le même réseau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удаётся связаться с сервером. Проверьте, что он доступен и находится в той же сети."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "K serveru se nelze připojit. Zkontrolujte, že je online a ve stejné síti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Server nicht erreichbar. Prüfe, ob er online und im selben Netzwerk ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile raggiungere il server. Verifica che sia online e sulla stessa rete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det går inte att nå servern. Kontrollera att den är ansluten till samma nätverk."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije se moguće povezati s poslužiteljem. Provjerite je li dostupan i na istoj mreži."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat menghubungi pelayan. Pastikan ia dalam talian dan berada pada rangkaian yang sama."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nedarí sa pripojiť k serveru. Skontrolujte, či je online a v rovnakej sieti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдається зв’язатися із сервером. Переконайтеся, що він онлайн і в тій самій мережі."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat menjangkau server. Pastikan server aktif dan berada di jaringan yang sama."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sunucuya ulaşılamıyor. Çevrimiçi olduğundan ve aynı ağda bulunduğundan emin olun."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No es pot connectar amb el servidor. Comprova que estigui en línia i a la mateixa xarxa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Serverul nu poate fi contactat. Verifică dacă este online și în aceeași rețea."
          }
        }
      }
    },
