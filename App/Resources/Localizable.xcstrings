    "Player controls, system prompts, and the Top Shelf row follow the Apple TV's own language.": {
      "extractionState": "stale",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spelerbedieningen, systeemmeldingen en de Top Shelf-rij volgen de eigen taal van de Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elementy sterujące odtwarzacza, komunikaty systemowe i wiersz Top Shelf używają języka Apple TV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os controles do reprodutor, os avisos do sistema e a linha Top Shelf seguem o idioma da própria Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afspillerens kontroller, systembeskeder og Top Shelf-rækken følger Apple TV'ets eget sprog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les commandes du lecteur, les invites système et la ligne Top Shelf suivent la langue de l’Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Элементы управления проигрывателем, системные подсказки и строка Top Shelf используют язык Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovládací prvky přehrávače, systémové výzvy a řádek Top Shelf se řídí jazykem samotné Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiedergabesteuerung, Systemdialoge und die Top-Shelf-Zeile richten sich nach der Sprache des Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I controlli del player, i messaggi di sistema e la riga Top Shelf seguono la lingua impostata su Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spelarkontroller, systemdialogrutor och Top Shelf-raden följer språket på Apple TV:n."
          }
        }
      }
    },
