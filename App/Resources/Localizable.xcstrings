    "Batch notifications summarize a season or show instead of notifying for every episode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تلخّص إشعارات الدفعة موسمًا أو مسلسلًا بدلًا من إرسال إشعار لكل حلقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Груповите известия обобщават сезон или сериал, вместо да известяват за всеки епизод."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les notificacions per lots resumeixen una temporada o sèrie en lloc de notificar cada episodi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dávková oznámení shrnují sezónu nebo seriál místo upozornění na každou epizodu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Batchnotifikationer opsummerer en sæson eller serie i stedet for at give besked om hvert afsnit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sammelbenachrichtigungen fassen eine Staffel oder Serie zusammen, statt über jede Folge einzeln zu informieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι ομαδικές ειδοποιήσεις συνοψίζουν μια σεζόν ή σειρά αντί να ειδοποιούν για κάθε επεισόδιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las notificaciones por lotes resumen una temporada o serie en lugar de avisar por cada episodio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اعلان‌های دسته‌ای یک فصل یا سریال را خلاصه می‌کنند و برای هر قسمت اعلان جداگانه نمی‌فرستند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eräilmoitukset tekevät yhteenvedon kaudesta tai sarjasta sen sijaan, että jokaisesta jaksosta ilmoitettaisiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les notifications groupées résument une saison ou une série au lieu de vous avertir pour chaque épisode."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "התראות אצווה מסכמות עונה או סדרה במקום להתריע על כל פרק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बैच नोटिफ़िकेशन हर एपिसोड के लिए सूचना देने के बजाय किसी सीज़न या शो का सार बताते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skupne obavijesti sažimaju sezonu ili seriju umjesto obavještavanja za svaku epizodu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A kötegelt értesítések egy évadot vagy sorozatot foglalnak össze, ahelyett hogy minden epizódról értesítenének."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Notifikasi batch merangkum satu musim atau acara, bukan memberi tahu untuk setiap episode."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le notifiche raggruppate riepilogano una stagione o una serie invece di inviare una notifica per ogni episodio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一括通知では、エピソードごとではなくシーズンや番組単位でまとめて通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "일괄 알림은 에피소드마다 알리는 대신 시즌이나 프로그램 단위로 요약합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
