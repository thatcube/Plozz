    "How Plozz picks the audio language when a title offers more than one — with optional per-content-type rules and per-series memory.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe Plozz de audiotaal kiest wanneer een titel er meerdere aanbiedt — met optionele regels per inhoudstype en geheugen per serie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jak Plozz wybiera język ścieżki dźwiękowej, gdy tytuł ma ich kilka — z opcjonalnymi regułami dla typów treści i zapamiętywaniem wyboru dla seriali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Como o Plozz escolhe o idioma do áudio quando um título oferece mais de um — com regras opcionais por tipo de conteúdo e memória por série."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sådan vælger Plozz lydsprog, når en titel tilbyder mere end ét — med valgfrie regler pr. indholdstype og hukommelse pr. serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
