    "Player controls, system prompts, and the Top Shelf row follow the Apple TV's own language." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عناصر التحكم في المشغل، والرسائل النظامية، وصفحة المحتوى العلوي تتبع لغة Apple TV الخاصة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Управлението на плейъра, системните подкани и редът Top Shelf следват собствения език на Apple TV."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els controls del reproductor, els missatges del sistema i la fila Top Shelf segueixen l'idioma del propi Apple TV."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ovládací prvky přehrávače, systémové výzvy a řádek Top Shelf se řídí jazykem samotné Apple TV."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Afspillerens kontroller, systembeskeder og Top Shelf-rækken følger Apple TV'ets eget sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wiedergabesteuerung, Systemdialoge und die Top-Shelf-Zeile richten sich nach der Sprache des Apple TV."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα χειριστήρια αναπαραγωγής, τα μηνύματα συστήματος και η σειρά Top Shelf ακολουθούν τη γλώσσα του ίδιου του Apple TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los controles del reproductor, los avisos del sistema y la fila del estante superior siguen el idioma propio del Apple TV."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کنترل‌های پخش، پیام‌های سیستم و ردیف بالایی از زبان Apple TV خود پیروی می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toistimen säätimet, järjestelmän kehotteet ja Top Shelf -rivi noudattavat Apple TV:n omaa kieltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les commandes du lecteur, les invites système et la ligne Top Shelf suivent la langue de l’Apple TV."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "פקדי הנגן, הודעות המערכת ושורת Top Shelf פועלים לפי השפה של ה-Apple TV עצמו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
