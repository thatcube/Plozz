            "state": "needs_review",
            "value": "Serwer zwrócił nieoczekiwaną odpowiedź."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O servidor enviou uma resposta inesperada."
          }
        }
      }
    },
    "error.notFound": {
      "comment": "Shown when a requested item no longer exists on the server.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t find what you were looking for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos encontrado lo que buscabas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "We konden niet vinden waar je naar op zoek was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się znaleźć szukanego elementu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível encontrar o que você estava procurando."
          }
        }
      }
    },
    "error.plex.rateLimited": {
      "comment": "Shown when plex.tv throttles repeated sign-in attempts.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Plex is temporarily limiting sign-in attempts. Wait a minute and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex beperkt tijdelijk het aantal aanmeldpogingen. Wacht een minuutje en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plex tymczasowo ogranicza próby logowania. Odczekaj chwilę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plex está limitando temporariamente as tentativas de login. Aguarde um minuto e tente novamente."
          }
        }
      }
    },
    "error.quickConnectExpired": {
      "comment": "Shown when the Quick Connect sign-in code timed out.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The code expired. Request a new one to continue."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
