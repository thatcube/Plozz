    "For example https://nas.local/dav. Defaults to https:// if you omit it.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bijvoorbeeld https://nas.local/dav. Als je dit weglaat, wordt standaard https:// gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na przykład https://nas.local/dav. Jeśli pominiesz protokół, domyślnie zostanie użyte https://."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Por exemplo, https://nas.local/dav. O padrão é https:// se você não informar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For eksempel https://nas.local/dav. Bruger https:// som standard, hvis du udelader det."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Par exemple https://nas.local/dav. https:// est utilisé par défaut s’il est omis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Например, https://nas.local/dav. Если не указать схему, по умолчанию используется https://."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Například https://nas.local/dav. Když ho vynecháte, použije se https://."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum Beispiel https://nas.local/dav. Ohne Angabe wird https:// verwendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ad esempio, https://nas.local/dav. Se ometti il protocollo, viene usato https://."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Till exempel https://nas.local/dav. Använder https:// som standard om du utelämnar det."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na primjer https://nas.local/dav. Ako ga izostavite, zadano je https://."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Contohnya https://nas.local/dav. Menggunakan https:// secara lalai jika anda tidak menyatakannya."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napríklad https://nas.local/dav. Ak ho vynecháte, predvolene sa použije https://."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Наприклад: https://nas.local/dav. Якщо протокол не вказано, використовується https://."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Contohnya https://nas.local/dav. Jika tidak dicantumkan, https:// akan digunakan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Örneğin https://nas.local/dav. Belirtmezseniz varsayılan olarak https:// kullanılır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Per exemple, https://nas.local/dav. Si l'omets, s'utilitza https:// per defecte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De exemplu https://nas.local/dav. Dacă îl omiți, se folosește implicit https://."
