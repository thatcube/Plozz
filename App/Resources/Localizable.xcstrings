          "stringUnit": {
            "state": "needs_review",
            "value": "Изтриването премахва настройките на този профил (тема, субтитри, спойлери, Trakt) и избраните сървъри. Вписаните сървърни акаунти остават в общия списък на домакинството."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poistaminen poistaa tämän profiilin asetukset (teema, tekstitykset, juonipaljastukset, Trakt) ja tiedon siihen kuuluvista palvelimista. Kirjautuneet palvelintilit säilyvät kotitalouden yhteisessä joukossa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når profilen slettes, fjernes innstillingene (tema, undertekster, spoilere og Trakt) og valgte servere. Påloggede serverkontoer forblir i husholdningen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "删除操作将移除此个人资料的偏好设置（主题、字幕、剧透、Trakt）及其包含的服务器。已登录的服务器账户仍保留在家庭池中。"
          }
        }
      }
    },
