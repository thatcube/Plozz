    "Send your servers and sign-in so it’s ready to watch.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stuur je servers en aanmeldgegevens, zodat het apparaat klaar is om te kijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prześlij serwery i logowanie, aby wszystko było gotowe do oglądania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envie seus servidores e seu login para deixar tudo pronto para assistir."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Send dine servere og login, så den er klar til at se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envoyer vos serveurs et votre connexion pour que tout soit prêt à regarder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Передайте свои серверы и вход, чтобы всё было готово к просмотру."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odešlete své servery a přihlášení, aby bylo zařízení připravené ke sledování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Übertrage deine Server und deine Anmeldung, damit alles startklar ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Invia i server e i dati di accesso, così il dispositivo sarà pronto per la visione."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skicka dina servrar och din inloggning så att allt är klart för att titta."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pošaljite svoje poslužitelje i prijavu da bude spremno za gledanje."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hantar pelayan dan log masuk anda supaya sedia untuk ditonton."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preneste svoje servery a prihlásenie, aby bolo všetko pripravené na pozeranie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Надішліть свої сервери й дані входу, щоб пристрій був готовий до перегляду."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kirim server dan data login Anda agar siap ditonton."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İzlemeye hazır olması için sunucularınızı ve oturum açma bilgilerinizi gönderin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envia els servidors i les dades d'inici de sessió perquè estigui a punt per reproduir contingut."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trimite serverele și datele de conectare, ca să fie gata de vizionare."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שלח את השרתים ואת פרטי ההתחברות כדי שהמכשיר יהיה מוכן לצפייה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pošljite svoje strežnike in prijavo, da bo vse pripravljeno za ogled."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ส่งเซิร์ฟเวอร์และข้อมูลการลงชื่อเข้าใช้ของคุณเพื่อให้พร้อมรับชม"
