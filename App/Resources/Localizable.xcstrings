    "themeMusic.detail.high": {
      "comment": "One-line explanation shown under the theme-music volume picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The loudest theme level, still capped below full volume."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het luidste themaniveau, nog altijd onder het maximale volume."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najgłośniejszy poziom muzyki motywu, nadal ograniczony poniżej pełnej głośności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O volume mais alto para o tema, ainda abaixo do volume máximo."
          }
        }
      }
    },
    "themeMusic.detail.low": {
      "comment": "One-line explanation shown under the theme-music volume picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A quiet background bed behind the detail page."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een rustige achtergrondlaag achter de detailpagina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ciche tło za stroną szczegółów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma trilha de fundo discreta na página de detalhes."
          }
        }
      }
    },
    "themeMusic.detail.medium": {
      "comment": "One-line explanation shown under the theme-music volume picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "More present, while staying below normal playback volume."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Meer aanwezig, maar nog onder het normale afspeelvolume."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bardziej słyszalne, ale wciąż ciszej niż zwykłe odtwarzanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mais presente, sem chegar ao volume normal de reprodução."
          }
        }
      }
    },
    "themeMusic.detail.off": {
      "comment": "One-line explanation shown under the theme-music volume picker.",
      "extractionState": "extracted_with_value",
