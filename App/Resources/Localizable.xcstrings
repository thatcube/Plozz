    "Make sure the same number shows on your other device, then confirm there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تأكد من أن نفس الرقم يظهر على جهازك الآخر، ثم أكد هناك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Уверете се, че същият номер се показва на другото устройство, след което потвърдете там."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comprova que el mateix número es mostra a l'altre dispositiu i confirma-ho allà."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ujistěte se, že se stejné číslo zobrazuje i na druhém zařízení, a pak ho tam potvrďte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sørg for, at det samme tal vises på din anden enhed, og bekræft det der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vergewissere dich, dass auf deinem anderen Gerät dieselbe Zahl angezeigt wird, und bestätige dort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Βεβαιωθείτε ότι εμφανίζεται ο ίδιος αριθμός στην άλλη συσκευή σας και μετά επιβεβαιώστε εκεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Asegúrate de que el mismo número aparezca en tu otro dispositivo y confirma allí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اطمینان حاصل کنید که همان عدد روی دستگاه دیگر شما نمایش داده شود، سپس تأیید کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Varmista, että toisessa laitteessa näkyy sama numero, ja vahvista siellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vérifiez que le même numéro s’affiche sur votre autre appareil, puis confirmez-y."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ודא שאותו מספר מוצג במכשיר האחר שלך, ולאחר מכן אשר שם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पक्का करें कि आपके दूसरे डिवाइस पर वही नंबर दिख रहा है, फिर वहीं पुष्टि करें."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Provjerite prikazuje li se isti broj na drugom uređaju, a zatim ga potvrdite tamo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Győződjön meg róla, hogy ugyanaz a szám jelenik meg a másik eszközén, majd erősítse meg ott."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pastikan nomor yang sama muncul di perangkat lain Anda, lalu konfirmasikan di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Assicurati che sull’altro dispositivo appaia lo stesso numero, quindi conferma su quel dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "別のデバイスに同じ番号が表示されていることを確認し、そのデバイスで承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "다른 기기에 같은 번호가 표시되는지 확인한 다음 확인하세요."
          }
