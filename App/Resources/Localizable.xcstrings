        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サインイン情報はこのApple TVの全プロファイルで共有されます。各プロファイルに表示する内容は「プロファイル › ライブラリ」で選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
