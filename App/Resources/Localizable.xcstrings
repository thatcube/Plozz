    "Move a provider here to stop using it.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verplaats een provider hierheen om deze niet meer te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przenieś tu dostawcę, aby przestać go używać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mova um provedor para cá para deixar de usá-lo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flyt en udbyder herhen for at stoppe med at bruge den."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplacez un fournisseur ici pour ne plus l’utiliser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переместите источник сюда, чтобы больше его не использовать."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přesuňte sem poskytovatele, pokud ho už nechcete používat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ziehe einen Anbieter hierher, um ihn nicht mehr zu verwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sposta qui un provider per smettere di usarlo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flytta en leverantör hit för att sluta använda den."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Premjestite pružatelja ovamo da ga prestanete koristiti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alihkan penyedia ke sini untuk berhenti menggunakannya."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Presuňte sem poskytovateľa, ak ho chcete prestať používať."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенесіть постачальника сюди, щоб припинити його використання."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pindahkan penyedia ke sini untuk berhenti menggunakannya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kullanmayı bırakmak için bir sağlayıcıyı buraya taşıyın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mou aquí un proveïdor per deixar d'utilitzar-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mută aici un furnizor pentru a nu-l mai folosi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "העבר ספק לכאן כדי להפסיק להשתמש בו."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Premaknite ponudnika sem, če ga ne želite več uporabljati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ย้ายผู้ให้บริการมาที่นี่เพื่อหยุดใช้งาน"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Преместете доставчик тук, за да спрете да го използвате."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siirrä lähde tähän, niin se poistuu käytöstä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flytt en leverandør hit for å slutte å bruke den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将提供商移至此处以停止使用它。"
          }
        }
      }
    },
