    "Always on. Tints the screen at full strength around the clock." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مفعّل دائماً. يُلوّن الشاشة بقوة كاملة طوال الوقت."
