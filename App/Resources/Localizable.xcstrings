    "%@ subtitles are rendered as images and can’t be restyled.": {
      "comment": "Secondary text in the iOS player subtitle Appearance section when the selected subtitle track is bitmap-based. %@ is the subtitle format name, such as PGS or VobSub.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-ondertitels worden weergegeven als afbeeldingen en kunnen niet worden aangepast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napisy %@ są renderowane jako obrazy i nie można zmienić ich stylu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As legendas %@ são renderizadas como imagens e não podem ter o estilo alterado."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-undertekster gengives som billeder, og deres udseende kan ikke ændres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sous-titres %@ sont rendus sous forme d’images et ne peuvent pas être personnalisés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Субтитры %@ отображаются как изображения, и их оформление нельзя изменить."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Titulky %@ se vykreslují jako obrázky a nelze změnit jejich styl."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-Untertitel werden als Bilder dargestellt und lassen sich nicht anpassen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I sottotitoli %@ sono visualizzati come immagini e non possono essere personalizzati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-undertexter visas som bilder och kan inte anpassas."
