    "Nothing matched in your language. If this is a Plex or Jellyfin server, make sure a subtitle source (e.g. OpenSubtitles) is set up on the server.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er is niets gevonden in je taal. Als dit een Plex- of Jellyfin-server is, zorg er dan voor dat er een ondertitelbron (bijv. OpenSubtitles) is ingesteld op de server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nic nie pasowało w Twoim języku. Jeśli to serwer Plex lub Jellyfin, upewnij się, że na serwerze skonfigurowano źródło napisów (np. OpenSubtitles)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada foi encontrado no seu idioma. Se este for um servidor Plex ou Jellyfin, verifique se uma fonte de legendas (por exemplo, OpenSubtitles) está configurada no servidor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der blev ikke fundet noget på dit sprog. Hvis dette er en Plex- eller Jellyfin-server, skal du sørge for, at en undertekstkilde (f.eks. OpenSubtitles) er konfigureret på serveren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun résultat dans votre langue. S’il s’agit d’un serveur Plex ou Jellyfin, vérifiez qu’une source de sous-titres (par ex. OpenSubtitles) est configurée sur le serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На вашем языке ничего не найдено. Если это сервер Plex или Jellyfin, убедитесь, что на сервере настроен источник субтитров (например, OpenSubtitles)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ve vašem jazyce nebyla nalezena žádná shoda. Pokud jde o server Plex nebo Jellyfin, ujistěte se, že je na serveru nastavený zdroj titulků (např. OpenSubtitles)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In deiner Sprache gab es keine Treffer. Wenn dies ein Plex- oder Jellyfin-Server ist, stelle sicher, dass auf dem Server eine Untertitelquelle (z. B. OpenSubtitles) eingerichtet ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna corrispondenza nella tua lingua. Se si tratta di un server Plex o Jellyfin, assicurati che sul server sia configurato un provider di sottotitoli, ad esempio OpenSubtitles."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inga undertexter hittades på ditt språk. Om det är en Plex- eller Jellyfin-server kontrollerar du att en undertextkälla, till exempel OpenSubtitles, har konfigurerats på servern."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ništa nije pronađeno na vašem jeziku. Ako je ovo Plex ili Jellyfin poslužitelj, provjerite je li na poslužitelju postavljen izvor titlova (npr. OpenSubtitles)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada padanan dalam bahasa anda. Jika ini pelayan Plex atau Jellyfin, pastikan sumber sari kata (cth. OpenSubtitles) disediakan pada pelayan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nič sa nenašlo vo vašom jazyku. Ak ide o server Plex alebo Jellyfin, uistite sa, že je na serveri nastavený zdroj titulkov (napr. OpenSubtitles)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нічого не знайдено вибраною мовою. Якщо це сервер Plex або Jellyfin, переконайтеся, що на ньому налаштовано джерело субтитрів, наприклад OpenSubtitles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak ada yang cocok dalam bahasa Anda. Jika ini server Plex atau Jellyfin, pastikan sumber subtitle (misalnya OpenSubtitles) sudah disiapkan di server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dilinizde hiçbir eşleşme bulunamadı. Bu bir Plex veya Jellyfin sunucusuysa, sunucuda bir altyazı kaynağının (ör. OpenSubtitles) ayarlandığından emin olun."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hi ha cap coincidència en el teu idioma. Si es tracta d'un servidor Plex o Jellyfin, comprova que hi hagi configurada una font de subtítols (p. ex. OpenSubtitles) al servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nu s-a găsit nimic în limba ta. Dacă acesta este un server Plex sau Jellyfin, asigură-te că pe server este configurată o sursă de subtitrări (de exemplu, OpenSubtitles)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא נמצאו תוצאות בשפה שלך. בשרת Plex או Jellyfin יש לוודא שמוגדר מקור כתוביות, למשל OpenSubtitles."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nič se ni ujemalo v vašem jeziku. Če je to strežnik Plex ali Jellyfin, se prepričajte, da je na strežniku nastavljen vir podnapisov (npr. OpenSubtitles)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่พบรายการที่ตรงกับภาษาของคุณ หากนี่คือเซิร์ฟเวอร์ Plex หรือ Jellyfin โปรดตรวจสอบว่าได้ตั้งค่าแหล่งคำบรรยาย (เช่น OpenSubtitles) ไว้บนเซิร์ฟเวอร์แล้ว"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Няма съвпадения на вашия език. Ако това е Plex или Jellyfin сървър, уверете се, че източник на субтитри (напр. OpenSubtitles) е настроен на сървъра."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kielelläsi ei löytynyt osumia. Jos kyseessä on Plex- tai Jellyfin-palvelin, varmista, että palvelimelle on määritetty tekstityslähde (esim. OpenSubtitles)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingenting ble funnet på språket ditt. Hvis dette er en Plex- eller Jellyfin-server, må du kontrollere at en undertekstkilde (f.eks. OpenSubtitles) er konfigurert på serveren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您的语言未匹配到字幕。如果是 Plex 或 Jellyfin 服务器，请确保已在服务器上设置字幕源（例如 OpenSubtitles）。"
          }
        }
      }
    },
