    "Connect a Seerr server (Overseerr / Jellyseerr) to discover and request movies, shows & anime for everyone on this Apple TV.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koppel een Seerr-server (Overseerr/Jellyseerr) om films, series en anime te ontdekken en aan te vragen voor iedereen op deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połącz serwer Seerr (Overseerr / Jellyseerr), aby odkrywać filmy, seriale i anime oraz prosić o nie dla wszystkich na tym Apple TV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conecte um servidor Seerr (Overseerr / Jellyseerr) para descobrir e solicitar filmes, séries e animes para todo mundo nesta Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbind en Seerr-server (Overseerr / Jellyseerr) for at opdage og anmode om film, serier og anime for alle på dette Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez un serveur Seerr (Overseerr / Jellyseerr) pour découvrir et demander des films, des séries et des anime pour tout le monde sur cette Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключите сервер Seerr (Overseerr / Jellyseerr), чтобы находить и запрашивать фильмы, сериалы и аниме для всех пользователей этого Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojte server Seerr (Overseerr / Jellyseerr) a umožněte všem na této Apple TV vyhledávat filmy, seriály a anime a žádat o ně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbinde einen Seerr-Server (Overseerr / Jellyseerr), um Filme, Serien und Anime für alle auf diesem Apple TV zu entdecken und anzufragen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connetti un server Seerr (Overseerr / Jellyseerr) per scoprire e richiedere film, serie TV e anime per tutti su questa Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anslut en Seerr-server (Overseerr/Jellyseerr) för att upptäcka och begära filmer, serier och anime åt alla på den här Apple TV:n."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povežite poslužitelj Seerr (Overseerr / Jellyseerr) kako bi svi na ovom Apple TV-u mogli pronalaziti i tražiti filmove, serije i anime."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungkan pelayan Seerr (Overseerr / Jellyseerr) untuk menemui dan meminta filem, siri & anime untuk semua orang pada Apple TV ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pripojte server Seerr (Overseerr / Jellyseerr) a umožnite všetkým na tejto Apple TV vyhľadávať filmy, seriály a anime a žiadať o ne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підключіть сервер Seerr (Overseerr / Jellyseerr), щоб усі на цьому Apple TV могли знаходити фільми, серіали й аніме та надсилати запити на них."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungkan server Seerr (Overseerr / Jellyseerr) untuk menemukan dan meminta film, acara, dan anime bagi semua orang di Apple TV ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Apple TV’deki herkes için film, dizi ve anime keşfetmek ve istek göndermek üzere bir Seerr sunucusu (Overseerr / Jellyseerr) bağlayın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connecta un servidor Seerr (Overseerr / Jellyseerr) per descobrir i sol·licitar pel·lícules, sèries i anime per a tothom en aquest Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectează un server Seerr (Overseerr / Jellyseerr) pentru a descoperi și solicita filme, seriale și anime pentru toată lumea de pe acest Apple TV."
          }
        }
      }
    },
    "Connect a media server or an NFS network share to start watching.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak verbinding met een mediaserver of NFS-netwerkshare om te beginnen met kijken."
