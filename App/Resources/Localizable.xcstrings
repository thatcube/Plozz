    "Player controls, system prompts, and the Top Shelf row follow the Apple TV's own language.": {
      "extractionState": "stale",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spelerbedieningen, systeemmeldingen en de Top Shelf-rij volgen de eigen taal van de Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elementy sterujące odtwarzacza, komunikaty systemowe i wiersz Top Shelf używają języka Apple TV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os controles do reprodutor, os avisos do sistema e a linha Top Shelf seguem o idioma da própria Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afspillerens kontroller, systembeskeder og Top Shelf-rækken følger Apple TV'ets eget sprog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les commandes du lecteur, les invites système et la ligne Top Shelf suivent la langue de l’Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Элементы управления проигрывателем, системные подсказки и строка Top Shelf используют язык Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovládací prvky přehrávače, systémové výzvy a řádek Top Shelf se řídí jazykem samotné Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiedergabesteuerung, Systemdialoge und die Top-Shelf-Zeile richten sich nach der Sprache des Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I controlli del player, i messaggi di sistema e la riga Top Shelf seguono la lingua impostata su Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spelarkontroller, systemdialogrutor och Top Shelf-raden följer språket på Apple TV:n."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrole reproduktora, sistemski upiti i redak Top Shelf prate jezik samog Apple TV-a."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kawalan pemain, gesaan sistem dan baris Top Shelf mengikut bahasa Apple TV itu sendiri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovládacie prvky prehrávača, systémové výzvy a riadok Top Shelf sa riadia jazykom samotnej Apple TV."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Елементи керування програвачем, системні запити та рядок Top Shelf відповідають мові самого Apple TV."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrol pemutar, dialog sistem, dan baris Top Shelf mengikuti bahasa Apple TV."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oynatıcı denetimleri, sistem iletileri ve Top Shelf satırı Apple TV’nin kendi dilini kullanır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els controls del reproductor, els missatges del sistema i la fila Top Shelf segueixen l'idioma del propi Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controalele de redare, solicitările sistemului și rândul Top Shelf folosesc limba Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פקדי הנגן, הודעות המערכת ושורת Top Shelf פועלים לפי השפה של ה-Apple TV עצמו."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upravljalniki predvajalnika, sistemski pozivi in vrstica Top Shelf sledijo jeziku samega Apple TV-ja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปุ่มควบคุมการเล่น ข้อความแจ้งของระบบ และแถว Top Shelf จะใช้ภาษาของ Apple TV เอง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Управлението на плейъра, системните подкани и редът Top Shelf следват собствения език на Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toistimen säätimet, järjestelmän kehotteet ja Top Shelf -rivi noudattavat Apple TV:n omaa kieltä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spillerens kontroller, systemmeldinger og Top Shelf-raden følger Apple TV-ens eget språk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "播放器控件、系统提示和 Top Shelf 内容栏使用 Apple TV 的系统语言。"
          }
        }
      }
    },
