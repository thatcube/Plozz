    "Unlinked profiles request as the administrator. Linked profiles use that user’s permissions, quotas, and defaults.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niet-gekoppelde profielen dienen aanvragen in als beheerder. Gekoppelde profielen gebruiken de rechten, quota en standaardinstellingen van die gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niepowiązane profile wysyłają prośby jako administrator. Powiązane profile używają uprawnień, limitów i ustawień domyślnych tego użytkownika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perfis não vinculados fazem solicitações como administrador. Perfis vinculados usam as permissões, cotas e configurações padrão desse usuário."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler uden tilknytning sender anmodninger som administrator. Tilknyttede profiler bruger den pågældende brugers tilladelser, kvoter og standardindstillinger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les profils non liés font leurs demandes au nom de l’administrateur. Les profils liés utilisent les autorisations, quotas et réglages par défaut de l’utilisateur associé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Непривязанные профили отправляют запросы от имени администратора. Привязанные профили используют права, квоты и настройки по умолчанию этого пользователя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepropojené profily odesílají žádosti jako administrátor. Propojené profily používají oprávnění, kvóty a výchozí nastavení daného uživatele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht verknüpfte Profile stellen Anfragen als Administrator. Verknüpfte Profile nutzen die Rechte, Kontingente und Standardwerte des jeweiligen Benutzers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I profili non collegati effettuano le richieste come amministratore. I profili collegati utilizzano le autorizzazioni, le quote e le impostazioni predefinite di quell’utente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler utan koppling skickar förfrågningar via administratörskontot. Kopplade profiler använder användarens behörigheter, kvoter och standardinställningar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepovezani profili šalju zahtjeve kao administrator. Povezani profili koriste dopuštenja, kvote i zadane postavke tog korisnika."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profil yang tidak dipautkan membuat permintaan sebagai pentadbir. Profil yang dipautkan menggunakan kebenaran, kuota, dan lalai pengguna itu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neprepojené profily odosielajú žiadosti ako správca. Prepojené profily používajú povolenia, kvóty a predvolené nastavenia daného používateľa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Непов’язані профілі надсилають запити від імені адміністратора. Пов’язані профілі використовують дозволи, квоти й типові налаштування відповідного користувача."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profil yang tidak ditautkan membuat permintaan sebagai administrator. Profil yang ditautkan menggunakan izin, kuota, dan bawaan pengguna tersebut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bağlanmamış profiller isteği yönetici olarak yapar. Bağlı profiller, o kullanıcının izinlerini, kotalarını ve varsayılanlarını kullanır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els perfils no vinculats sol·liciten com a administrador. Els perfils vinculats utilitzen els permisos, les quotes i els valors predeterminats d'aquell usuari."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profilurile neasociate fac solicitări ca administrator. Profilurile asociate folosesc permisiunile, cotele și valorile implicite ale acelui utilizator."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פרופילים לא מקושרים מבצעים בקשות כמנהל. פרופילים מקושרים משתמשים בהרשאות, במכסות ובברירות המחדל של אותו משתמש."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepovezani profili pošiljajo zahteve kot skrbnik. Povezani profili uporabljajo dovoljenja, kvote in privzete nastavitve tega uporabnika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โปรไฟล์ที่ไม่ได้ลิงก์จะส่งคำขอในฐานะผู้ดูแลระบบ โปรไฟล์ที่ลิงก์แล้วจะใช้สิทธิ์ โควตา และค่าเริ่มต้นของผู้ใช้นั้น"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Несвързаните профили правят заявки от името на администратора. Свързаните профили използват правата, квотите и настройките по подразбиране на съответния потребител."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linkittämättömät profiilit tekevät pyynnöt ylläpitäjänä. Linkitetyt profiilit käyttävät kyseisen käyttäjän oikeuksia, kiintiöitä ja oletusasetuksia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler uten tilknytning sender forespørsler som administrator. Tilknyttede profiler bruker den aktuelle brukerens tillatelser, kvoter og standardinnstillinger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未链接的个人资料以管理员身份请求。链接的个人资料将使用该用户的权限、配额和默认设置。"
          }
        }
      }
    },
