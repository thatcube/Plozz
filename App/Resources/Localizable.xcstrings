    "Pick a server found on your network, or enter its address.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies een server die op je netwerk is gevonden, of voer het adres ervan in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz serwer znaleziony w Twojej sieci albo wpisz jego adres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha um servidor encontrado na sua rede ou digite o endereço dele."
          }
        },
        "da": {
          "stringUnit": {
