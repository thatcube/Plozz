    "A cinematic, rotating spotlight at the top of Home, with a Continue Watching row tucked under its lower edge.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een filmische, wisselende blikvanger bovenaan Start, met de rij Verder kijken deels onder de onderrand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kinowy, zmieniający się baner u góry strony głównej, z rzędem „Kontynuuj oglądanie” wsuniętym pod jego dolną krawędź."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um destaque cinematográfico e rotativo no topo da tela Início, com uma linha de Continuar Assistindo logo abaixo da borda inferior."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et filmisk, roterende fokusområde øverst på Hjem med rækken Fortsæt med at se placeret under den nederste kant."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un carrousel cinématographique en haut de l’accueil, avec la rangée Continuer à regarder glissée sous son bord inférieur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кинематографичная вращающаяся витрина вверху «Главной», а под её нижним краем — ряд «Продолжить просмотр»."
          }
        }
      }
    },
    "A credential requires a secure (https://) address.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Referenties vereisen een beveiligd (https://) adres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poświadczenie wymaga bezpiecznego adresu (https://)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma credencial exige um endereço seguro (https://)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Loginoplysninger kræver en sikker adresse (https://)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un identifiant nécessite une adresse sécurisée (https://)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для учётных данных требуется защищённый адрес (https://)."
          }
        }
      }
    },
    "A media share connects with the credentials you entered (or as a guest). Choose what shows on your Home under Profile › Your Libraries.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een mediashare maakt verbinding met de ingevoerde inloggegevens (of als gast). Kies via Profiel › Jouw bibliotheken wat er op Start verschijnt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Udział multimedialny łączy się przy użyciu podanych danych logowania (albo jako gość). Wybierz w sekcji Profil › Twoje biblioteki, co ma się pojawiać na stronie głównej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O acesso a um compartilhamento de mídia usa as credenciais informadas (ou o modo convidado). Escolha o que aparece na tela inicial em Perfil › Suas bibliotecas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En mediedeling opretter forbindelse med de loginoplysninger, du har angivet (eller som gæst). Vælg, hvad der vises på dit Hjem under Profil › Dine biblioteker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un partage multimédia se connecte avec les identifiants saisis (ou en invité). Choisissez ce qui s’affiche sur votre Accueil dans Profil › Vos bibliothèques multimédias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сетевой ресурс подключается с введёнными вами учётными данными (или как гость). Выберите, что показывать на «Главной» в разделе «Профиль» › «Ваши медиатеки»."
          }
        }
      }
    },
    "A rotating spotlight on titles from your libraries.": {
