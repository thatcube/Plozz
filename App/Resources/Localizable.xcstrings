    "You’re already set up on %@ %@. Bring it here?": {
      "comment": "Subtitle on the iOS detected-setup screen when another device already has this server. %1$@ is the source device icon, %2$@ is the source device name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You’re already set up on %1$@ %2$@. Bring it here?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je bent al ingesteld op %1$@ %2$@. Hierheen halen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konfiguracja jest już gotowa na urządzeniu %1$@ %2$@. Przenieść ją tutaj?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você já está configurado em %1$@ %2$@. Trazer para cá?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du er allerede konfigureret på %1$@ %2$@. Hent opsætningen hertil?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous êtes déjà configuré sur %1$@ %2$@. L’importer ici ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Настройка уже выполнена на устройстве %1$@ %2$@. Перенести сюда?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na zařízení %1$@ %2$@ už máte vše nastavené. Přenést to sem?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bist bereits auf %1$@ %2$@ eingerichtet. Hierher übernehmen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La configurazione è già presente su %1$@ %2$@. Vuoi importarla qui?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du är redan konfigurerad på %1$@ %2$@. Vill du hämta konfigurationen hit?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na uređaju %1$@ %2$@ već je sve postavljeno. Želite li to prenijeti ovamo?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda sudah disediakan pada %1$@ %2$@. Bawa ke sini?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na zariadení %1$@ %2$@ už máte všetko nastavené. Preniesť to sem?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Уже налаштовано на %1$@ %2$@. Перенести сюди?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda sudah menyiapkannya di %1$@ %2$@. Bawa ke sini?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaten %1$@ %2$@ üzerinde ayarlı. Buraya getirilsin mi?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja tens la configuració feta a %1$@ %2$@. La vols portar aquí?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ai deja configurarea pe %1$@ %2$@. O aduci și aici?"
