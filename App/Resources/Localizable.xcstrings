    "Keep the essentials fixed and choose which media shortcuts appear." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أبقِ العناصر الأساسية ثابتة واختر اختصارات الوسائط التي تظهر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Запазете основните елементи фиксирани и изберете кои преки пътища към медии да се показват."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Manteniu fixos els elements essencials i trieu quines dreceres multimèdia es mostren."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Základní položky zůstávají pevné; zvolte, které zástupce médií zobrazit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hold de vigtigste elementer faste, og vælg, hvilke mediegenveje der vises."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Behalte die wichtigsten Elemente bei und wähle die angezeigten Medienkurzbefehle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Διατηρήστε σταθερά τα βασικά και επιλέξτε ποιες συντομεύσεις πολυμέσων θα εμφανίζονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén fijos los elementos esenciales y elige qué accesos multimedia aparecen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "موارد اصلی را ثابت نگه دارید و میان‌برهای رسانه‌ای را که نمایش داده می‌شوند انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pidä olennaiset kohteet kiinteinä ja valitse näytettävät mediapikavalinnat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conservez les éléments essentiels et choisissez les raccourcis multimédias à afficher."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "השארת הפריטים החיוניים קבועים ובחירת קיצורי המדיה שיופיעו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ज़रूरी चीज़ों को स्थिर रखें और चुनें कि कौन-से मीडिया शॉर्टकट दिखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zadržite osnovne stavke pričvršćenima i odaberite koje će se medijske prečice prikazivati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az alapvető elemek maradjanak rögzítve, és válassza ki a megjelenő médiaparancsikonokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pertahankan item penting dan pilih pintasan media yang akan ditampilkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantieni fissi gli elementi essenziali e scegli quali scorciatoie multimediali mostrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "必須項目を固定し、表示するメディアショートカットを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "필수 항목은 고정하고 표시할 미디어 바로가기를 선택하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kekalkan perkara penting dan pilih pintasan media yang akan dipaparkan."
          }
        },
        "nb" : {
