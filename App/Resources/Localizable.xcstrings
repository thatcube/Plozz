          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Plex-Anmeldung findet alle mit deinem Konto verknüpften Server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accesso a Plex trova ogni server collegato al tuo account."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "När du loggar in på Plex hittas alla servrar som är kopplade till kontot."
          }
        }
      }
    },
    "Plozz is only available in English for now. More languages are on the way.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz is momenteel alleen beschikbaar in het Engels. Meer talen komen eraan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz jest na razie dostępny tylko po angielsku. Wkrótce pojawią się kolejne języki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz está disponível apenas em inglês por enquanto. Mais idiomas estão a caminho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz er indtil videre kun tilgængelig på engelsk. Flere sprog er på vej."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz n’est disponible qu’en anglais pour le moment. D’autres langues arrivent bientôt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пока Plozz доступен только на английском. Другие языки скоро появятся."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz je zatím dostupný jen v angličtině. Další jazyky jsou na cestě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz ist derzeit nur auf Englisch verfügbar. Weitere Sprachen folgen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz è disponibile solo in inglese per ora. Altre lingue sono in arrivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz finns bara på engelska än så länge. Fler språk är på väg."
          }
        }
      }
    },
    "Plozz picks the best source for each field automatically.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz kiest automatisch de beste bron voor elk veld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz automatycznie wybiera najlepsze źródło dla każdego pola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz escolhe automaticamente a melhor fonte para cada campo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz vælger automatisk den bedste kilde til hvert felt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz choisit automatiquement la meilleure source pour chaque champ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz автоматически выбирает лучший источник для каждого поля."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz automaticky vybere pro každé pole nejlepší zdroj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz wählt für jedes Feld automatisch die beste Quelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz sceglie automaticamente la fonte migliore per ogni campo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz väljer automatiskt den bästa källan för varje fält."
          }
        }
      }
    },
    "Plozz pins the server’s SSH host key after you approve its fingerprint.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz zet de SSH-hostsleutel van de server vast nadat je de vingerafdruk hebt goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz przypina klucz hosta SSH serwera po zatwierdzeniu jego odcisku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz fixa a chave SSH do host do servidor depois que você aprova a impressão digital dela."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz fastgør serverens SSH-værtsnøgle, når du har godkendt dens fingeraftryk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz épingle la clé d’hôte SSH du serveur après que vous avez approuvé son empreinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "После подтверждения отпечатка Plozz закрепляет SSH-ключ хоста сервера."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz připne SSH hostitelský klíč serveru poté, co schválíte jeho otisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz legt den SSH-Hostschlüssel des Servers fest, sobald du seinen Fingerabdruck bestätigst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz vincola la chiave host SSH del server dopo che ne hai approvato l’impronta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz låser fast serverns SSH-värdnyckel efter att du godkänt dess fingeravtryck."
          }
        }
      }
    },
    "Plozz scans the selected export for movies and TV episodes. NFS uses your server’s existing network permissions.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz scant de geselecteerde export op films en tv-afleveringen. NFS gebruikt de bestaande netwerkrechten van je server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz skanuje wybrany eksport w poszukiwaniu filmów i odcinków seriali. NFS korzysta z istniejących uprawnień sieciowych serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Plozz examina a exportação selecionada em busca de filmes e episódios de TV. O NFS usa as permissões de rede que seu servidor já tem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz scanner den valgte eksport for film og serieepisoder. NFS bruger din servers eksisterende netværkstilladelser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz analyse l’export sélectionné à la recherche de films et d’épisodes TV. NFS utilise les autorisations réseau existantes de votre serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz сканирует выбранный экспорт на наличие фильмов и эпизодов сериалов. NFS использует существующие сетевые разрешения вашего сервера."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz prohledá vybraný export a hledá v něm filmy a TV díly. NFS používá stávající síťová oprávnění vašeho serveru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz durchsucht den ausgewählten Export nach Filmen und Serienfolgen. NFS verwendet die bestehenden Netzwerkberechtigungen deines Servers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz esegue la scansione dell’esportazione selezionata per trovare film ed episodi TV. NFS usa le autorizzazioni di rete già configurate sul server."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz skannar den valda exporten efter filmer och TV-avsnitt. NFS använder serverns befintliga nätverksbehörigheter."
          }
        }
      }
    },
    "Point your camera at the code on your other device — pinch to zoom": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Richt je camera op de code op je andere apparaat — knijp om in te zoomen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skieruj aparat na kod na drugim urządzeniu — zsuń lub rozsuń palce, aby zmienić powiększenie"
          }
        },
        "pt-BR": {
          "stringUnit": {
