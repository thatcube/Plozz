    "You'll go back to the start and no server will be added.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je gaat terug naar het begin en er wordt geen server toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nastąpi powrót do początku i żaden serwer nie zostanie dodany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você voltará ao início e nenhum servidor será adicionado."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du går tilbage til starten, og ingen server vil blive tilføjet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous reviendrez au début et aucun serveur ne sera ajouté."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы вернётесь в начало, и сервер не будет добавлен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vrátíte se na začátek a žádný server se nepřidá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kehrst zum Anfang zurück und es wird kein Server hinzugefügt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tornerai all’inizio e nessun server verrà aggiunto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du återgår till början och ingen server läggs till."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vratit ćete se na početak i nijedan poslužitelj neće biti dodan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda akan kembali ke permulaan dan tiada pelayan akan ditambah."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vrátite sa na začiatok a nepridá sa žiadny server."
