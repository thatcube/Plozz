        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lämmittää kuvaa päivittäin kahden itse asetetun kellonajan välillä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varmer mellom to tidspunkter du velger hver dag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在您设定的两个时间段之间调节色温。"
          }
        }
      }
    },
    "circadianMode.detail.off": {
      "comment": "One-line explanation shown under the Circadian mode picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The picture is never dimmed or warmed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het beeld wordt nooit gedimd of van een warmere tint voorzien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obraz nigdy nie jest przyciemniany ani ocieplany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A imagem nunca é escurecida nem aquecida."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Billedet dæmpes eller varmes aldrig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’image n’est jamais assombrie ni réchauffée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изображение никогда не затемняется и не становится теплее."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obraz se nikdy neztmaví ani neoteplí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Bild wird nie abgedunkelt oder wärmer dargestellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’immagine non viene mai attenuata né resa più calda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bilden dimmas eller värms aldrig."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slika se nikad ne prigušuje niti zagrijava."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gambar tidak pernah diredupkan atau dihangatkan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obraz sa nikdy nestlmí ani nezafarbí do teplých tónov."
          }
        },
        "uk": {
          "stringUnit": {
