    "PIN-protected users must unlock when their Plozz profile becomes active." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يجب على المستخدمين المحميين بالرمز فك القفل عند تفعيل ملفهم الشخصي في Plozz."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Потребители, защитени с PIN, трябва да отключат, когато техният профил на Plozz стане активен."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els usuaris protegits amb PIN han de desbloquejar-se quan el seu perfil de Plozz s'activa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uživatelé chránění PINem se musí odemknout, když se jejich profil Plozz aktivuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PIN-beskyttede brugere skal låses op, når deres Plozz-profil bliver aktiv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PIN-geschützte Benutzer müssen entsperren, sobald ihr Plozz-Profil aktiv wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι χρήστες που προστατεύονται με PIN πρέπει να ξεκλειδώνουν όταν το προφίλ τους στο Plozz γίνεται ενεργό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
