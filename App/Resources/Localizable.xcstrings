        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zobrazovat jen vynucené titulky pro cizojazyčné pasáže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur erzwungene Untertitel für fremdsprachige Passagen anzeigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra solo sottotitoli forzati per passaggi in lingua straniera."
