    "Downloads use original quality. Network-share downloads continue while Plozz is open; Jellyfin, Emby, and Plex downloads can continue in the background.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Downloads gebruiken de originele kwaliteit. Downloads via een netwerkshare gaan door zolang Plozz open is; downloads van Jellyfin, Emby en Plex kunnen ook op de achtergrond doorgaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pobrane używają oryginalnej jakości. Pobieranie z udziałów sieciowych trwa, gdy Plozz jest otwarty; pobieranie z Jellyfin, Emby i Plex może trwać w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os downloads usam a qualidade original. Os downloads de compartilhamento de rede continuam enquanto o Plozz está aberto; os downloads de Jellyfin, Emby e Plex podem continuar em segundo plano."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Downloads bruger original kvalitet. Downloads fra netværksdeling fortsætter, mens Plozz er åben; downloads fra Jellyfin, Emby og Plex kan fortsætte i baggrunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les téléchargements utilisent la qualité d’origine. Les téléchargements depuis un partage réseau se poursuivent tant que Plozz est ouvert ; les téléchargements Jellyfin, Emby et Plex peuvent continuer en arrière-plan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При загрузке используется исходное качество. Загрузки из сетевых ресурсов продолжаются, пока открыт Plozz; загрузки из Jellyfin, Emby и Plex могут продолжаться в фоновом режиме."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stažené položky používají původní kvalitu. Stahování ze síťových sdílení pokračuje, když je Plozz otevřený; stahování z Jellyfinu, Emby a Plexu může pokračovat na pozadí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Downloads verwenden die Originalqualität. Downloads von Netzwerkfreigaben laufen weiter, solange Plozz geöffnet ist; Downloads von Jellyfin, Emby und Plex können im Hintergrund fortgesetzt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I download mantengono la qualità originale. Quelli dalle condivisioni di rete continuano mentre Plozz è aperto; i download da Jellyfin, Emby e Plex possono continuare in background."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nedladdningar använder originalkvalitet. Nedladdningar från nätverksdelningar fortsätter medan Plozz är öppen. Nedladdningar från Jellyfin, Emby och Plex kan fortsätta i bakgrunden."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preuzimanja koriste izvornu kvalitetu. Preuzimanja s mrežnih dijeljenja nastavljaju se dok je Plozz otvoren; preuzimanja iz Jellyfina, Embyja i Plexa mogu se nastaviti u pozadini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muat turun menggunakan kualiti asal. Muat turun perkongsian rangkaian diteruskan semasa Plozz dibuka; muat turun Jellyfin, Emby, dan Plex boleh diteruskan di latar belakang."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stiahnuté položky sa ukladajú v pôvodnej kvalite. Sťahovanie zo sieťových zdieľaní pokračuje, kým je Plozz otvorený; sťahovanie zo služieb Jellyfin, Emby a Plex môže pokračovať na pozadí."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завантаження використовують оригінальну якість. Завантаження з мережевих ресурсів тривають, поки Plozz відкрито; завантаження з Jellyfin, Emby та Plex можуть тривати у фоновому режимі."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unduhan menggunakan kualitas asli. Unduhan folder bersama jaringan berlanjut saat Plozz terbuka; unduhan Jellyfin, Emby, dan Plex dapat berlanjut di latar belakang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İndirmeler özgün kaliteyi kullanır. Ağ paylaşımı indirmeleri Plozz açıkken sürer; Jellyfin, Emby ve Plex indirmeleri arka planda devam edebilir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les baixades utilitzen la qualitat original. Les baixades de recursos compartits de xarxa continuen mentre Plozz estigui obert; les baixades de Jellyfin, Emby i Plex poden continuar en segon pla."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Descărcările folosesc calitatea originală. Descărcările din resurse de rețea continuă cât timp Plozz este deschis; descărcările din Jellyfin, Emby și Plex pot continua în fundal."
          }
        }
      }
    },
    "Drag a provider here to turn it off": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep een provider hierheen om deze uit te schakelen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeciągnij tu dostawcę, aby go wyłączyć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arraste um provedor aqui para desativá-lo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Træk en udbyder herhen for at slå den fra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glissez un fournisseur ici pour le désactiver"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетащите сюда провайдера, чтобы отключить его"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přetáhněte sem poskytovatele a vypněte ho"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ziehe einen Anbieter hierher, um ihn auszuschalten"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trascina qui un provider per disattivarlo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dra en leverantör hit för att stänga av den"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povucite davatelja ovamo da biste ga isključili"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seret penyedia ke sini untuk mematikannya"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Potiahnutím sem poskytovateľa ho vypnete"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетягніть постачальника сюди, щоб вимкнути його"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seret penyedia ke sini untuk menonaktifkannya"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapatmak için bir sağlayıcıyı buraya sürükleyin"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arrossega un proveïdor aquí per desactivar-lo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trage aici un furnizor pentru a-l dezactiva"
          }
        }
      }
    },
    "Drag providers to set priority. Anything below the line is turned off.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep providers om de prioriteit in te stellen. Alles onder de lijn is uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeciągnij dostawców, aby ustawić priorytet. Wszystko poniżej linii jest wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arraste os provedores para definir a prioridade. Tudo abaixo da linha fica desativado."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Træk udbydere for at angive prioritet. Alt under linjen er slået fra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites glisser les fournisseurs pour définir la priorité. Tout ce qui se trouve sous la ligne est désactivé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетащите провайдеры, чтобы задать приоритет. Всё, что ниже линии, отключено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přetažením poskytovatelů nastavíte prioritu. Cokoli pod čarou je vypnuté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ziehe Anbieter, um die Priorität festzulegen. Alles unterhalb der Linie ist ausgeschaltet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trascina i provider per impostarne la priorità. Tutto ciò che si trova sotto la linea viene disattivato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dra leverantörer för att ställa in prioritet. Allt under linjen är avstängt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povucite davatelje da biste postavili prioritet. Sve ispod crte je isključeno."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seret penyedia untuk menetapkan keutamaan. Apa-apa di bawah garisan dimatikan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Potiahnutím poskytovateľov nastavte prioritu. Všetko pod čiarou je vypnuté."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетягніть постачальників, щоб встановити пріоритет. Все нижче рядка вимкнено."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seret penyedia untuk mengatur prioritas. Apa pun di bawah garis dinonaktifkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Önceliği ayarlamak için sağlayıcıları sürükleyin. Çizginin altındaki her şey kapalıdır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arrossega els proveïdors per definir-ne la prioritat. Tot el que quedi per sota de la línia es desactiva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trage furnizorii pentru a stabili prioritatea. Tot ce este sub linie este dezactivat."
          }
        }
      }
    },
    "Drag to reorder. Sources below the Disabled line are turned off.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sleep om de volgorde te wijzigen. Bronnen onder de lijn Uitgeschakeld zijn uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeciągnij, aby zmienić kolejność. Źródła poniżej linii Wyłączone są wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arraste para reordenar. As fontes abaixo da linha ficam desativadas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Træk for at ændre rækkefølge. Kilder under linjen Deaktiveret er slået fra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites glisser pour réorganiser. Les sources sous la ligne Désactivé sont désactivées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетащите, чтобы изменить порядок. Источники ниже линии «Отключено» отключены."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přetažením změníte pořadí. Zdroje pod čarou Vypnuto jsou vypnuté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ziehe zum Umsortieren. Quellen unterhalb der Linie „Deaktiviert“ sind ausgeschaltet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trascina per riordinare. Le fonti sotto la linea Disattivati vengono disattivate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dra för att ändra ordning. Källor under linjen Inaktiverad är avstängda."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povucite za promjenu redoslijeda. Izvori ispod crte Onemogućeno su isključeni."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seret untuk menyusun semula. Sumber di bawah garisan Dilumpuhkan dimatikan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Potiahnutím zmeňte poradie. Zdroje pod čiarou Vypnuté sú vypnuté."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перетягніть для переупорядкування. Джерела нижче рядка «Вимкнено» вимкнені."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seret untuk menyusun ulang. Sumber di bawah garis Dinonaktifkan akan dimatikan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeniden sıralamak için sürükleyin. Devre dışı çizgisinin altındaki kaynaklar kapalıdır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arrossega per reordenar. Les fonts per sota de la línia Desactivat es desactiven."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trage pentru a reordona. Sursele de sub linia „Dezactivate” sunt dezactivate."
          }
        }
      }
    },
    "Dual Subtitles": {
      "comment": "Title for the player subtitle-style screen that configures a second subtitle track, used in both tvOS and iOS.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dubbele ondertitels"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podwójne napisy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Legendas duplas"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dobbelte undertekster"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sous-titres doubles"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Двойные субтитры"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dvojité titulky"
