<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.thatcube.Plozz</string>
    </array>
    <!-- Push Notifications. tvOS does NOT rely on background push to sync: the
         system aggressively suspends/terminates apps there, so CKSyncEngine can't
         depend on it, and tvOS syncs on foreground instead (AppState
         syncCloudOnForeground → fetchNow on scenePhase .active). iPhone/iPad get
         real background push (see PlozziOS.entitlements).

         The entitlement is still REQUIRED. App Store Connect rejects any tvOS
         build that declares `com.apple.developer.icloud-services` without
         `aps-environment` (error 90575, "Missing Entitlement"), so omitting it
         made the upload fail rather than the app behave differently. Declaring
         it does not make the app use push. `development` is rewritten to
         `production` on App Store export. -->
    <key>aps-environment</key>
    <string>development</string>
    <key>com.apple.developer.aps-environment</key>
    <string>development</string>
    <!-- iCloud key-value storage: powers the non-secret Sync & Setup "presence
         beacon" (a configured device advertises that a setup exists so a fresh
         same-Apple-ID device can offer to bring it over). No secrets stored. -->
    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
    <!-- CloudKit: powers the non-secret Sync & Setup auto-sync layer (CKSyncEngine
         on the private DB) that keeps the household setup — server descriptors,
         profiles, per-profile settings + membership — in sync across one Apple
         ID's devices. NEVER stores tokens/passwords. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.thatcube.Plozz</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <!-- tvOS system multi-user support. "runs-as-current-user" opts the app into
         per-Apple-TV-user data partitioning (separate UserDefaults + Keychain per
         system user) on tvOS 16+, while "…with-user-independent-keychain" lets the
         app keep the shared sign-in + profile set in the user-independent Keychain
         (via kSecUseUserIndependentKeychain) so the household signs in once. See
         FeatureAuth.KeychainStore and AppShell.SystemProfileBridge. -->
    <key>com.apple.developer.user-management</key>
    <array>
        <string>runs-as-current-user-with-user-independent-keychain</string>
    </array>
</dict>
</plist>
