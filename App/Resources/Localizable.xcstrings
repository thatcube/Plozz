          "stringUnit": {
            "state": "needs_review",
            "value": "Tailscale-servers kunnen niet automatisch worden gevonden. Voer hieronder handmatig je Tailscale IP-adres of MagicDNS-naam in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Serwerów Tailscale nie można znaleźć automatycznie. Wpisz poniżej ręcznie adres IP Tailscale lub nazwę MagicDNS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os servidores Tailscale não podem ser encontrados automaticamente. Digite abaixo o IP do Tailscale ou nome do MagicDNS manualmente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tailscale-servere kan ikke findes automatisk. Indtast din Tailscale-IP eller dit MagicDNS-navn manuelt nedenfor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les serveurs Tailscale ne peuvent pas être trouvés automatiquement. Saisissez manuellement votre adresse IP Tailscale ou votre nom MagicDNS ci-dessous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Серверы Tailscale не удаётся найти автоматически. Введите ниже IP Tailscale или имя MagicDNS вручную."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Servery Tailscale nelze najít automaticky. Níže ručně zadejte IP Tailscale nebo název MagicDNS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tailscale-Server können nicht automatisch gefunden werden. Gib unten deine Tailscale-IP oder deinen MagicDNS-Namen manuell ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I server Tailscale non possono essere rilevati automaticamente. Inserisci qui sotto l’indirizzo IP Tailscale o il nome MagicDNS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tailscale-servrar kan inte hittas automatiskt. Skriv in din Tailscale-IP eller ditt MagicDNS-namn manuellt nedan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tailscale poslužitelji ne mogu se pronaći automatski. Ručno unesite svoj Tailscale IP ili MagicDNS naziv u nastavku."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pelayan Tailscale tidak dapat dicari secara automatik. Taip secara manual IP Tailscale atau nama MagicDNS anda di bawah."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Servery Tailscale sa nedajú nájsť automaticky. Nižšie ručne zadajte svoju IP adresu Tailscale alebo názov MagicDNS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сервери Tailscale не можна знайти автоматично. Введіть вручну вашу IP-адресу Tailscale або ім’я MagicDNS нижче."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Server Tailscale tidak dapat ditemukan secara otomatis. Ketik IP Tailscale atau nama MagicDNS Anda secara manual di bawah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tailscale sunucuları otomatik bulunamaz. Tailscale IP adresinizi veya MagicDNS adınızı aşağıya elle girin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els servidors de Tailscale no es poden trobar automàticament. Escriu manualment la teva IP de Tailscale o el nom de MagicDNS a continuació."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Serverele Tailscale nu pot fi găsite automat. Introdu manual mai jos adresa IP Tailscale sau numele MagicDNS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא ניתן למצוא שרתי Tailscale אוטומטית. הקלד ידנית את כתובת ה-IP או שם ה-MagicDNS של Tailscale למטה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strežnikov Tailscale ni mogoče najti samodejno. Spodaj ročno vnesite svoj IP Tailscale ali ime MagicDNS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่สามารถค้นหาเซิร์ฟเวอร์ Tailscale ได้โดยอัตโนมัติ พิมพ์ Tailscale IP หรือชื่อ MagicDNS ของคุณด้านล่างด้วยตนเอง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сървърите в Tailscale не могат да бъдат намерени автоматично. Въведете ръчно своя Tailscale IP адрес или MagicDNS име по-долу."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tailscale-palvelimia ei löydy automaattisesti. Kirjoita Tailscale-IP-osoite tai MagicDNS-nimi alle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tailscale-servere kan ikke finnes automatisk. Skriv inn Tailscale-IP-en eller MagicDNS-navnet ditt manuelt nedenfor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法自动找到 Tailscale 服务器，请手动输入 Tailscale IP 或 MagicDNS 名称。"
          }
        }
      }
