    "Connect a Seerr server (Overseerr / Jellyseerr) to discover and request movies, shows & anime for everyone on this Apple TV.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koppel een Seerr-server (Overseerr/Jellyseerr) om films, series en anime te ontdekken en aan te vragen voor iedereen op deze Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połącz serwer Seerr (Overseerr / Jellyseerr), aby odkrywać filmy, seriale i anime oraz prosić o nie dla wszystkich na tym Apple TV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conecte um servidor Seerr (Overseerr / Jellyseerr) para descobrir e solicitar filmes, séries e animes para todo mundo nesta Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbind en Seerr-server (Overseerr / Jellyseerr) for at opdage og anmode om film, serier og anime for alle på dette Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez un serveur Seerr (Overseerr / Jellyseerr) pour découvrir et demander des films, des séries et des anime pour tout le monde sur cette Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключите сервер Seerr (Overseerr / Jellyseerr), чтобы находить и запрашивать фильмы, сериалы и аниме для всех пользователей этого Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojte server Seerr (Overseerr / Jellyseerr) a umožněte všem na této Apple TV vyhledávat filmy, seriály a anime a žádat o ně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbinde einen Seerr-Server (Overseerr / Jellyseerr), um Filme, Serien und Anime für alle auf diesem Apple TV zu entdecken und anzufragen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connetti un server Seerr (Overseerr / Jellyseerr) per scoprire e richiedere film, serie TV e anime per tutti su questa Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anslut en Seerr-server (Overseerr/Jellyseerr) för att upptäcka och begära filmer, serier och anime åt alla på den här Apple TV:n."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povežite poslužitelj Seerr (Overseerr / Jellyseerr) kako bi svi na ovom Apple TV-u mogli pronalaziti i tražiti filmove, serije i anime."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungkan pelayan Seerr (Overseerr / Jellyseerr) untuk menemui dan meminta filem, siri & anime untuk semua orang pada Apple TV ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pripojte server Seerr (Overseerr / Jellyseerr) a umožnite všetkým na tejto Apple TV vyhľadávať filmy, seriály a anime a žiadať o ne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підключіть сервер Seerr (Overseerr / Jellyseerr), щоб усі на цьому Apple TV могли знаходити фільми, серіали й аніме та надсилати запити на них."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungkan server Seerr (Overseerr / Jellyseerr) untuk menemukan dan meminta film, acara, dan anime bagi semua orang di Apple TV ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Apple TV’deki herkes için film, dizi ve anime keşfetmek ve istek göndermek üzere bir Seerr sunucusu (Overseerr / Jellyseerr) bağlayın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connecta un servidor Seerr (Overseerr / Jellyseerr) per descobrir i sol·licitar pel·lícules, sèries i anime per a tothom en aquest Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectează un server Seerr (Overseerr / Jellyseerr) pentru a descoperi și solicita filme, seriale și anime pentru toată lumea de pe acest Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "חבר שרת Seerr ‏(Overseerr / Jellyseerr) כדי לגלות ולבקש סרטים, תוכניות ואנימה עבור כולם ב-Apple TV הזה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povežite strežnik Seerr (Overseerr/Jellyseerr), da boste lahko odkrivali in zahtevali filme, serije in anime za vse na tem Apple TV-ju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ Seerr (Overseerr / Jellyseerr) เพื่อค้นหาและส่งคำขอภาพยนตร์ รายการ และอนิเมะสำหรับทุกคนบน Apple TV เครื่องนี้"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Свържете Seerr сървър (Overseerr / Jellyseerr), за да откривате и заявявате филми, сериали и аниме за всички на този Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhdistä Seerr-palvelin (Overseerr / Jellyseerr), niin voit löytää ja pyytää elokuvia, sarjoja ja animea kaikille tällä Apple TV:llä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koble til en Seerr-server (Overseerr/Jellyseerr) for å finne og be om filmer, serier og anime for alle på denne Apple TV-en."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "连接 Seerr 服务器（Overseerr / Jellyseerr）以发现并请求所有 Apple TV 用户的电影、剧集和动漫。"
          }
        }
      }
    },
    "Connect a media server or an NFS network share to start watching.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak verbinding met een mediaserver of NFS-netwerkshare om te beginnen met kijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połącz serwer multimediów albo udział sieciowy NFS, aby zacząć oglądać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conecte um servidor de mídia ou um compartilhamento de rede NFS para começar a assistir."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbind en medieserver eller en NFS-netværksdeling for at begynde at se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez un serveur multimédia ou un partage réseau NFS pour commencer à regarder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключите медиасервер или сетевой ресурс NFS, чтобы начать просмотр."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojte server médií nebo síťové sdílení NFS a začněte sledovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbinde einen Medienserver oder eine NFS-Netzwerkfreigabe, um loszulegen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connetti un server multimediale o una condivisione di rete NFS per iniziare a guardare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anslut en medieserver eller en NFS-nätverksdelning för att börja titta."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povežite poslužitelj medija ili NFS mrežno dijeljenje za početak gledanja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungkan pelayan media atau perkongsian rangkaian NFS untuk mula menonton."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pripojte mediálny server alebo sieťové zdieľanie NFS a začnite sledovať."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підключіть медіа-сервер або мережевий ресурс NFS, щоб почати перегляд."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungkan server media atau folder bersama jaringan NFS untuk mulai menonton."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İzlemeye başlamak için bir medya sunucusu veya NFS ağ paylaşımı bağlayın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connecta un servidor multimèdia o un recurs compartit de xarxa NFS per començar a veure continguts."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectează un server media sau o resursă de rețea NFS pentru a începe să vizionezi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "חבר שרת מדיה או שיתוף רשת NFS כדי להתחיל לצפות."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povežite medijski strežnik ali omrežno souporabo NFS za začetek gledanja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เชื่อมต่อเซิร์ฟเวอร์สื่อหรือการแชร์เครือข่าย NFS เพื่อเริ่มรับชม"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Свържете медиен сървър или NFS мрежов ресурс, за да започнете да гледате."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhdistä mediapalvelin tai NFS-verkkojako, niin pääset katsomaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koble til en medieserver eller en NFS-nettverksdeling for å begynne å se."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "连接媒体服务器或 NFS 网络共享以开始观看。"
          }
        }
      }
    },
    "Connect one Overseerr or Jellyseerr server for the household. Each Plozz profile can make requests as a different user.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbind één Overseerr- of Jellyseerr-server voor het huishouden. Elk Plozz-profiel kan aanvragen doen als een andere gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połącz jeden serwer Overseerr lub Jellyseerr dla całego domu. Każdy profil Plozz może składać prośby jako inny użytkownik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conecte um servidor Overseerr ou Jellyseerr para o grupo familiar. Cada perfil do Plozz pode fazer solicitações como um usuário diferente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbind én Overseerr- eller Jellyseerr-server for husstanden. Hver Plozz-profil kan sende anmodninger som en anden bruger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez un serveur Overseerr ou Jellyseerr pour tout le foyer. Chaque profil Plozz peut faire des demandes au nom d’un utilisateur différent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключите один сервер Overseerr или Jellyseerr для всего дома. Каждый профиль Plozz может отправлять запросы от имени другого пользователя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojte pro domácnost jeden server Overseerr nebo Jellyseerr. Každý profil Plozz může podávat žádosti jako jiný uživatel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbinde einen Overseerr- oder Jellyseerr-Server für den ganzen Haushalt. Jedes Plozz-Profil kann Anfragen über einen eigenen Benutzer stellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connetti un server Overseerr o Jellyseerr per la famiglia. Ogni profilo Plozz può effettuare richieste come utente diverso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anslut en Overseerr- eller Jellyseerr-server för hushållet. Varje Plozz-profil kan göra förfrågningar som en annan användare."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povežite jedan Overseerr ili Jellyseerr poslužitelj za kućanstvo. Svaki profil u Plozzu može slati zahtjeve kao drugi korisnik."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungkan satu pelayan Overseerr atau Jellyseerr untuk isi rumah. Setiap profil Plozz boleh membuat permintaan sebagai pengguna yang berbeza."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pripojte pre domácnosť jeden server Overseerr alebo Jellyseerr. Každý profil Plozz môže vytvárať žiadosti ako iný používateľ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підключіть один сервер Overseerr або Jellyseerr для домашньої групи. Кожен профіль Plozz може надсилати запити від імені іншого користувача."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungkan satu server Overseerr atau Jellyseerr untuk rumah tangga ini. Setiap profil Plozz dapat membuat permintaan sebagai pengguna yang berbeda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hane için bir Overseerr veya Jellyseerr sunucusu bağlayın. Her Plozz profili farklı bir kullanıcı olarak istek gönderebilir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connecta un servidor Overseerr o Jellyseerr per a la llar. Cada perfil de Plozz pot fer sol·licituds com a usuari diferent."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectează un server Overseerr sau Jellyseerr pentru toată casa. Fiecare profil Plozz poate face solicitări ca utilizator diferit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "חבר שרת Overseerr או Jellyseerr אחד עבור משק הבית. כל פרופיל Plozz יכול לבצע בקשות כמשתמש אחר."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Za gospodinjstvo povežite en strežnik Overseerr ali Jellyseerr. Vsak profil Plozz lahko pošilja zahteve kot drug uporabnik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ Overseerr หรือ Jellyseerr หนึ่งเครื่องสำหรับทั้งบ้าน แต่ละโปรไฟล์ใน Plozz สามารถส่งคำขอในฐานะผู้ใช้ที่แตกต่างกันได้"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Свържете един сервър Overseerr или Jellyseerr за домакинството. Всеки профил в Plozz може да прави заявки като различен потребител."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhdistä yksi Overseerr- tai Jellyseerr-palvelin koko taloudelle. Jokainen Plozz-profiili voi tehdä pyyntöjä eri käyttäjänä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koble én Overseerr- eller Jellyseerr-server til husholdningen. Hver Plozz-profil kan sende forespørsler som en egen bruker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "连接一个 Overseerr 或 Jellyseerr 服务器供全家使用。每个 Plozz 账户可作为不同用户发起请求。"
          }
        }
      }
    },
