    "This signs everyone out of %@ on this Apple TV. Any profile will need to sign in again to use it.": {
      "comment": "Body text in the tvOS Remove Server confirmation alert for a multi-account server. %@ is the server name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit meldt iedereen af bij %@ op deze Apple TV. Elk profiel moet zich opnieuw aanmelden om het te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wylogowuje wszystkich z serwera „%@” na tym Apple TV. Każdy profil będzie musiał zalogować się ponownie, aby z niego korzystać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isso desconecta todo mundo de %@ nesta Apple TV. Qualquer perfil precisará fazer login novamente para usá-lo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette logger alle ud af %@ på dette Apple TV. Enhver profil skal logge ind igen for at bruge den."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela déconnecte tout le monde de %@ sur cette Apple TV. Tout profil devra se reconnecter pour l’utiliser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все пользователи выйдут из учётных записей на сервере %@ на этом Apple TV. Чтобы снова пользоваться сервером, потребуется войти."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tím se na této Apple TV odhlásí všichni ze serveru %@. Každý profil se bude muset před jeho použitím znovu přihlásit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dadurch werden alle von %@ auf diesem Apple TV abgemeldet. Jedes Profil muss sich erneut anmelden, um ihn zu nutzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa operazione disconnette tutti gli account da %@ su questa Apple TV. Ogni profilo dovrà effettuare di nuovo l’accesso per usarlo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alla loggas ut från %@ på denna Apple TV. Profilerna måste logga in igen för att använda servern."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Time se svi odjavljuju s poslužitelja %@ na ovom Apple TV-u. Svaki će se profil morati ponovno prijaviti prije upotrebe."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ini melog keluar semua orang daripada %@ pada Apple TV ini. Mana-mana profil perlu log masuk semula untuk menggunakannya."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Týmto sa na tejto Apple TV odhlásia všetci zo servera %@. Každý profil sa bude musieť pred jeho použitím znova prihlásiť."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Це завершує сеанси всіх користувачів %@ на цьому Apple TV. Щоб скористатися сервером, у будь-якому профілі потрібно буде знову ввійти."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ini akan mengeluarkan semua orang dari %@ di Apple TV ini. Profil mana pun harus masuk lagi untuk menggunakannya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu işlem, bu Apple TV’de herkesin %@ oturumunu kapatır. Yeniden kullanmak için her profilin oturum açması gerekir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Això tanca la sessió de tothom a %@ en aquest Apple TV. Qualsevol perfil haurà de tornar a iniciar sessió per utilitzar-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aceasta deconectează pe toată lumea de la %@ pe acest Apple TV. Orice profil va trebui să se conecteze din nou pentru a-l folosi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פעולה זו מנתקת את כולם מ-%@ ב-Apple TV הזה. כל פרופיל יצטרך להתחבר שוב כדי להשתמש בו."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To na tem Apple TV-ju odjavi vse iz strežnika %@. Vsak profil se bo moral pred uporabo znova prijaviti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การดำเนินการนี้จะลงชื่อออกทุกคนจาก %@ บน Apple TV เครื่องนี้ ทุกโปรไฟล์จะต้องลงชื่อเข้าใช้อีกครั้งจึงจะใช้งานได้"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Това отписва всички от %@ на този Apple TV. Всеки профил ще трябва да влезе отново, за да го използва."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tämä kirjaa kaikki ulos palvelimelta %@ tällä Apple TV:llä. Jokaisen profiilin on kirjauduttava uudelleen sisään käyttääkseen sitä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette logger alle av %@ på denne Apple TV-en. Alle profiler må logge på igjen for å bruke den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这将使 %@ 上的所有用户退出登录。任何个人资料均需重新登录才能使用。"
          }
        }
      }
    },
    "This stops and removes %lld in-progress downloads. Completed downloads are kept.": {
      "comment": "Confirmation message in iOS Downloads settings when cancelling active downloads. %lld is the number of in-progress downloads that will be stopped and removed.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This stops and removes %lld in-progress download. Completed downloads are kept."
                }
              },
              "other": {
