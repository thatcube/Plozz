    "Profiles keep Home, settings, watch history, and downloads personal.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Met profielen blijven Start, instellingen, kijkgeschiedenis en downloads persoonlijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dzięki profilom każda osoba ma osobną stronę główną, ustawienia, historię oglądania i pobrane materiały."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os perfis mantêm o Início, os ajustes, o histórico de exibição e os downloads pessoais."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler holder Hjem, indstillinger, seerhistorik og downloads adskilt for hver person."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les profils gardent l’accueil, les réglages, l’historique de lecture et les téléchargements personnels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У каждого профиля свои Главная, настройки, история просмотров и загрузки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profily uchovávají obrazovku Domů, nastavení, historii sledování a stažené položky odděleně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mit Profilen erhält jede Person eine eigene Startseite, eigene Einstellungen, einen eigenen Wiedergabeverlauf und eigene Downloads."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con i profili, Home, impostazioni, cronologia di visione e download restano personali."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler ger var och en ett eget Hem, egna inställningar, egen tittarhistorik och egna nedladdningar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profili odvajaju Početnu, postavke, povijest gledanja i preuzimanja za svakoga."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profil memastikan Laman Utama, tetapan, sejarah tontonan dan muat turun kekal peribadi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profily uchovávajú obrazovku Domov, nastavenia, históriu pozerania a stiahnuté položky oddelene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Профілі зберігають Головну, налаштування, історію перегляду й завантаження окремо для кожної людини."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profil membuat Beranda, pengaturan, riwayat tontonan, dan unduhan tetap pribadi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiller Ana Sayfa’yı, ayarları, izleme geçmişini ve indirmeleri kişiye özel tutar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els perfils mantenen Inici, la configuració, l'historial de visualització i les baixades de cada persona en privat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profilurile păstrează separat Acasă, setările, istoricul de vizionare și descărcările."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פרופילים שומרים את מסך הבית, ההגדרות, היסטוריית הצפייה וההורדות בנפרד."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profili ločujejo zaslon Domov, nastavitve, zgodovino ogledov in prenose posameznih uporabnikov."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โปรไฟล์ช่วยแยกหน้าแรก การตั้งค่า ประวัติการรับชม และการดาวน์โหลดให้เป็นส่วนตัว"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Профилите запазват лични Начало, настройките, историята на гледане и изтеглянията."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiilit pitävät Kodin, asetukset, katseluhistorian ja lataukset henkilökohtaisina."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profiler holder Hjem, innstillinger, seerhistorikk og nedlastinger atskilt for hver person."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "个人资料使首页、设置、观看历史和下载内容保持个性化。"
          }
        }
      }
    },
