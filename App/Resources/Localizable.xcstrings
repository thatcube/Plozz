    "These are signed in on your iPad or Apple TV. To use them here without retyping anything, tap “Set up this device from another” below and confirm on that device.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze zijn aangemeld op je iPad of Apple TV. Tik hieronder op “Dit apparaat instellen vanaf een ander apparaat” om ze hier te gebruiken zonder iets opnieuw te typen, en bevestig op dat apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Te konta są zalogowane na iPadzie lub Apple TV. Aby użyć ich tutaj bez ponownego wpisywania danych, stuknij poniżej „Skonfiguruj to urządzenie z innego urządzenia” i potwierdź na tamtym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eles já estão conectados no seu iPad ou Apple TV. Para usá-los aqui sem digitar tudo de novo, toque em “Configurar este dispositivo a partir de outro” abaixo e confirme nesse dispositivo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disse er logget ind på din iPad eller Apple TV. For at bruge dem her uden at skrive noget igen skal du trykke på “Opsæt denne enhed fra en anden” nedenfor og bekræfte på den enhed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces comptes sont connectés sur votre iPad ou Apple TV. Pour les utiliser ici sans rien ressaisir, touchez « Configurer cet appareil à partir d’un autre » ci-dessous, puis confirmez sur cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для них уже выполнен вход на вашем iPad или Apple TV. Чтобы использовать их здесь без повторного ввода, нажмите ниже «Настроить это устройство с другого» и подтвердите на том устройстве."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na iPadu nebo Apple TV už jste k nim přihlášeni. Pokud je chcete používat i tady bez znovuzadávání údajů, klepněte níže na „Nastavit toto zařízení z jiného“ a potvrďte to na daném zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Server sind auf deinem iPad oder Apple TV angemeldet. Um sie hier ohne erneute Eingabe zu nutzen, tippe unten auf „Dieses Gerät über ein anderes einrichten“ und bestätige auf dem anderen Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accesso a questi server è già stato effettuato su iPad o Apple TV. Per usarli qui senza reinserire i dati, tocca “Configura questo dispositivo da un altro dispositivo” qui sotto e conferma sull’altro dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du är inloggad på de här servrarna på din iPad eller Apple TV. Om du vill använda dem här utan att skriva in uppgifterna igen trycker du på ”Konfigurera den här enheten från en annan” nedan och bekräftar på den enheten."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na vašem iPadu ili Apple TV-u za ovo već postoji prijava. Da biste to ovdje koristili bez ponovnog upisivanja, dodirnite „Postavi ovaj uređaj s drugog” u nastavku i potvrdite na tom uređaju."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ini telah log masuk pada iPad atau Apple TV anda. Untuk menggunakannya di sini tanpa menaip semula apa-apa, ketik “Sediakan peranti ini daripada peranti lain” di bawah dan sahkan pada peranti itu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na vašom iPade alebo Apple TV ste už prihlásení. Ak ich chcete používať aj tu bez opätovného zadávania čohokoľvek, nižšie klepnite na „Nastaviť toto zariadenie z iného“ a potvrďte to na danom zariadení."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для цих облікових записів виконано вхід на iPad або Apple TV. Щоб скористатися ними тут без повторного введення даних, натисніть нижче «Налаштувати цей пристрій з іншого» й підтвердьте дію на тому пристрої."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akun-akun ini sudah masuk di iPad atau Apple TV Anda. Untuk memakainya di sini tanpa mengetik ulang apa pun, ketuk “Siapkan perangkat ini dari perangkat lain” di bawah lalu konfirmasikan di perangkat itu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunların oturumu iPad’inizde veya Apple TV’nizde açık. Bunları burada yeniden bir şey yazmadan kullanmak için aşağıdan “Bu aygıtı başka bir aygıttan ayarla”ya dokunun ve o aygıtta onaylayın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquests comptes tenen la sessió iniciada al teu iPad o Apple TV. Per utilitzar-los aquí sense tornar-ho a escriure, toca “Configura aquest dispositiu des d'un altre” a continuació i confirma-ho en aquell dispositiu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acestea sunt conectate pe iPad-ul sau Apple TV-ul tău. Pentru a le folosi aici fără să reintroduci nimic, atinge mai jos „Configurează acest dispozitiv de pe altul” și confirmă pe acel dispozitiv."
          }
        }
      }
    },
    "These servers are set up on another device on your iCloud account. Sign in to watch them here — your login stays private to each device.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze servers zijn ingesteld op een ander apparaat met jouw iCloud-account. Meld je aan om hier te kijken — je aanmelding blijft privé per apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Te serwery są skonfigurowane na innym urządzeniu na koncie iCloud. Zaloguj się, aby oglądać je tutaj — dane logowania pozostają prywatne na każdym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estes servidores estão configurados em outro dispositivo da sua conta do iCloud. Faça login para assistir aqui — seu acesso fica privado em cada dispositivo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disse servere er konfigureret på en anden enhed på din iCloud-konto. Log ind for at se dem her — dit login forbliver privat på hver enhed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces serveurs sont configurés sur un autre appareil de votre compte iCloud. Connectez-vous pour les regarder ici — vos identifiants restent privés sur chaque appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эти серверы настроены на другом устройстве в вашей учётной записи iCloud. Войдите, чтобы смотреть их здесь — данные входа остаются отдельными на каждом устройстве."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tyto servery jsou nastavené na jiném zařízení v rámci vašeho účtu iCloud. Přihlaste se k nim i tady — vaše přihlašovací údaje zůstávají soukromé pro každé zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Server sind auf einem anderen Gerät mit deinem iCloud-Account eingerichtet. Melde dich an, um sie hier anzusehen — deine Anmeldung bleibt für jedes Gerät privat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questi server sono configurati su un altro dispositivo nel tuo account iCloud. Accedi per guardarli qui — il tuo accesso resta privato per ogni dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De här servrarna är konfigurerade på en annan enhet i ditt iCloud-konto. Logga in för att titta här – inloggningsuppgifterna lagras bara på respektive enhet."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovi su poslužitelji postavljeni na drugom uređaju prijavljenom na vaš iCloud račun. Prijavite se da biste ih gledali ovdje — vaša prijava ostaje privatna na svakom uređaju."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pelayan ini disediakan pada peranti lain dalam akaun iCloud anda. Log masuk untuk menontonnya di sini — log masuk anda kekal peribadi kepada setiap peranti."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tieto servery sú nastavené na inom zariadení vo vašom účte iCloud. Prihláste sa, ak ich chcete sledovať aj tu — vaše prihlásenie zostane súkromné pre každé zariadenie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ці сервери налаштовані на іншому пристрої вашого облікового запису iCloud. Увійдіть, щоб переглядати їх тут — ваш вхід залишається приватним для кожного пристрою."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Server ini telah diatur di perangkat lain dalam akun iCloud Anda. Masuk untuk menontonnya di sini—informasi masuk tetap tersimpan secara pribadi di setiap perangkat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sunucular iCloud hesabınızdaki başka bir aygıtta ayarlı. Bunları burada izlemek için oturum açın — oturum açma bilgileriniz her aygıtta gizli kalır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquests servidors estan configurats en un altre dispositiu del teu compte d'iCloud. Inicia sessió per veure'ls aquí — les credencials es mantenen privades a cada dispositiu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aceste servere sunt configurate pe alt dispozitiv din contul tău iCloud. Conectează-te pentru a le viziona aici — autentificarea rămâne privată pe fiecare dispozitiv."
          }
        }
      }
    },
    "They're rendered as images by the source, so font, colour, size and position controls don't apply.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ze worden door de bron als afbeeldingen weergegeven, dus lettertype-, kleur-, grootte- en positie-instellingen zijn niet van toepassing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Są renderowane przez źródło jako obrazy, więc ustawienia czcionki, koloru, rozmiaru i położenia nie mają zastosowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elas são renderizadas como imagens pela origem, então os controles de fonte, cor, tamanho e posição não se aplicam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De vises som billeder fra kilden, så indstillinger for skrifttype, farve, størrelse og placering gælder ikke."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ils sont rendus sous forme d’images par la source ; les réglages de police, couleur, taille et position ne s’appliquent donc pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Источник отрисовывает их как изображения, поэтому настройки шрифта, цвета, размера и положения не применяются."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zdroj je vykresluje jako obrázky, takže nastavení písma, barvy, velikosti a polohy se nepoužije."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie werden von der Quelle als Bilder gerendert, daher haben Schrift, Farbe, Größe und Position keine Wirkung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La sorgente li renderizza come immagini, quindi i controlli di font, colore, dimensione e posizione non sono applicabili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Källan skickar dem som bilder, så inställningar för typsnitt, färg, storlek och placering gäller inte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izvor ih prikazuje kao slike, pa se kontrole fonta, boje, veličine i položaja ne primjenjuju."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ia dipaparkan sebagai imej oleh sumber, jadi kawalan fon, warna, saiz dan kedudukan tidak terpakai."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zdroj ich vykresľuje ako obrázky, takže nastavenia písma, farby, veľkosti a polohy sa neuplatnia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Джерело відтворює їх як зображення, тому налаштування шрифту, кольору, розміру й розташування не застосовуються."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Subtitle ini dirender sebagai gambar oleh sumbernya, jadi kontrol font, warna, ukuran, dan posisi tidak berlaku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaynak tarafından görüntü olarak oluşturuldukları için yazı tipi, renk, boyut ve konum denetimleri uygulanmaz."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'origen els renderitza com a imatges, per la qual cosa els controls de tipus de lletra, color, mida i posició no s'apliquen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sunt redate ca imagini de către sursă, așa că setările pentru font, culoare, dimensiune și poziție nu se aplică."
          }
        }
      }
    },
