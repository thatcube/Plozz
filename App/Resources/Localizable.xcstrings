    "Pick a theme for this profile. You can change it any time.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies een thema voor dit profiel. Je kunt dit op elk moment wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz motyw dla tego profilu. Możesz go zmienić w dowolnym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha um tema para este perfil. Você pode mudar isso quando quiser."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg et tema til denne profil. Du kan altid ændre det senere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
