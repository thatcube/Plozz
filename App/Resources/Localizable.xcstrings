          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palvelimeen ei saada yhteyttä. Tarkista, että se on päällä ja samassa verkossa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
