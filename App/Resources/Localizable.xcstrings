    "Some servers could not be reached. Their libraries can be configured later in Settings.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sommige servers waren niet bereikbaar. Je kunt hun bibliotheken later instellen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się połączyć z niektórymi serwerami. Ich biblioteki można skonfigurować później w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível acessar alguns servidores. As bibliotecas deles podem ser configuradas depois em Ajustes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nogle servere kunne ikke kontaktes. Deres biblioteker kan konfigureres senere i Indstillinger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains serveurs sont injoignables. Leurs bibliothèques multimédias pourront être configurées plus tard dans Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Некоторые серверы недоступны. Их медиатеки можно настроить позже в Настройках."
          }
        }
      }
    },
    "Something not working? Send your recent activity straight to the developer — the quickest way to help track down a bug. Sent anonymously: no logins, tokens, servers, or titles.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Werkt er iets niet? Stuur je recente activiteit direct naar de ontwikkelaar — de snelste manier om een bug op te sporen. Anoniem verstuurd: geen inloggegevens, tokens, servers of titels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coś nie działa? Wyślij ostatnią aktywność bezpośrednio do dewelopera — to najszybszy sposób, aby pomóc namierzyć błąd. Dane są wysyłane anonimowo: bez danych logowania, tokenów, serwerów ani tytułów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algo não está funcionando? Envie sua atividade recente direto para o desenvolvedor — é a forma mais rápida de ajudar a encontrar um bug. Enviado anonimamente: sem logins, tokens, servidores ou títulos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Virker noget ikke? Send din seneste aktivitet direkte til udvikleren — den hurtigste måde at hjælpe med at finde en fejl på. Sendes anonymt: ingen logins, tokens, servere eller titler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un problème ? Envoyez votre activité récente directement au développeur — le moyen le plus rapide d’aider à trouver l’origine d’un problème. Envoi anonyme : aucun identifiant de connexion, jeton, serveur ni titre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Что-то не работает? Отправьте недавние действия прямо разработчику — это самый быстрый способ найти ошибку. Отправляется анонимно: без данных для входа, токенов, серверов и названий."
          }
        }
      }
    },
    "Something went wrong": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er is iets misgegaan"
