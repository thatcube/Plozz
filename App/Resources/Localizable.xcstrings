    "themeMusic.detail.high": {
      "comment": "One-line explanation shown under the theme-music volume picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The loudest theme level, still capped below full volume."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het luidste themaniveau, nog altijd onder het maximale volume."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najgłośniejszy poziom muzyki motywu, nadal ograniczony poniżej pełnej głośności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O volume mais alto para o tema, ainda abaixo do volume máximo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den højeste lydstyrke for temamusik, stadig begrænset til under fuld lydstyrke."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le niveau le plus fort, tout en restant sous le volume maximal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Самый высокий уровень, но всё ещё ниже полной громкости."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nejhlasitější úroveň hudby motivu, stále omezená pod plnou hlasitost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die lauteste Stufe – bleibt dennoch unter der vollen Lautstärke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il volume più alto per la musica del tema, comunque inferiore al massimo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den högsta temanivån, men fortfarande under full volym."
          }
        }
      }
    },
    "themeMusic.detail.low": {
      "comment": "One-line explanation shown under the theme-music volume picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
