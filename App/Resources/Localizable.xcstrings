    "Open Plozz on your Apple TV or another signed-in device and it’ll offer to add “%@” here automatically.": {
      "comment": "Body text on the iOS Set Up This Device screen while waiting for another signed-in device to transfer one specific server. %@ is the server name this device asked to add.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Open Plozz op je Apple TV of een ander aangemeld apparaat; het biedt aan om ‘%@’ hier automatisch toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz Plozz na Apple TV lub innym zalogowanym urządzeniu, a pojawi się propozycja automatycznego dodania tutaj „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra o Plozz na sua Apple TV ou em outro dispositivo conectado, e ele vai oferecer a opção de adicionar “%@” aqui automaticamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn Plozz på dit Apple TV eller en anden enhed, der er logget ind, så tilbyder Plozz automatisk at tilføje »%@« her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez Plozz sur votre Apple TV ou un autre appareil connecté, et il vous proposera d’ajouter « %@ » ici automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте Plozz на Apple TV или другом устройстве, где выполнен вход, и приложение предложит автоматически добавить здесь «%@»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otevřete Plozz na Apple TV nebo jiném přihlášeném zařízení a nabídne, že sem automaticky přidá „%@“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne Plozz auf deinem Apple TV oder einem anderen angemeldeten Gerät – dort wird dir angeboten, „%@“ hier automatisch hinzuzufügen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri Plozz sulla tua Apple TV o su un altro dispositivo su cui hai già effettuato l’accesso. Plozz ti proporrà automaticamente di aggiungere “%@” qui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öppna Plozz på din Apple TV eller en annan inloggad enhet, så erbjuder den att lägga till ”%@” här automatiskt."
          }
        }
      }
    },
