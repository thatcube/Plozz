    "FTPS uses TLS from connection start. Explicit TLS (AUTH TLS) is not supported.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS gebruikt TLS vanaf het begin van de verbinding. Expliciete TLS (AUTH TLS) wordt niet ondersteund."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS używa TLS od początku połączenia. Jawny TLS (AUTH TLS) nie jest obsługiwany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O FTPS usa TLS desde o início da conexão. TLS explícito (AUTH TLS) não é compatível."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS bruger TLS fra forbindelsens start. Eksplicit TLS (AUTH TLS) understøttes ikke."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS utilise TLS dès le début de la connexion. TLS explicite (AUTH TLS) n’est pas pris en charge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS использует TLS с момента подключения. Явный TLS (AUTH TLS) не поддерживается."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS používá TLS od začátku spojení. Explicit TLS (AUTH TLS) není podporováno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS verwendet TLS ab dem Verbindungsaufbau. Explizites TLS (AUTH TLS) wird nicht unterstützt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS usa TLS dall’inizio della connessione. TLS esplicito (AUTH TLS) non è supportato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS använder TLS från anslutningens start. Explicit TLS (AUTH TLS) stöds inte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS koristi TLS od početka veze. Eksplicitni TLS (AUTH TLS) nije podržan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS menggunakan TLS sejak permulaan sambungan. TLS Eksplisit (AUTH TLS) tidak disokong."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS používa TLS od začiatku pripojenia. Explicitné TLS (AUTH TLS) nie je podporované."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS використовує TLS від початку з’єднання. Явний TLS (AUTH TLS) не підтримується."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS menggunakan TLS sejak awal koneksi. TLS eksplisit (AUTH TLS) tidak didukung."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS bağlantının başlangıcından itibaren TLS kullanır. Açık TLS (AUTH TLS) desteklenmez."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS utilitza TLS des de l'inici de la connexió. El TLS explícit (AUTH TLS) no és compatible."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTPS folosește TLS de la începutul conexiunii. TLS explicit (AUTH TLS) nu este acceptat."
          }
        }
      }
    },
