    "Ratings are hidden until you've watched this. Reveals them anyway." : {
      "comment" : "Accessibility hint on the control that lifts the spoiler blur over a title's ratings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التقييمات مخفية حتى تشاهده. يكشفها على أي حال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Оценките са скрити, докато не изгледате това. Показва ги въпреки това."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les valoracions estan amagades fins que ho vegis. Les mostra igualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hodnocení je skryté, dokud to nezhlédnete. Přesto je odhalí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bedømmelser er skjult, indtil du har set denne. Viser dem alligevel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bewertungen sind ausgeblendet, bis du das gesehen hast. Zeigt sie trotzdem an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι βαθμολογίες είναι κρυμμένες μέχρι να το παρακολουθήσετε. Τις εμφανίζει έτσι κι αλλιώς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las puntuaciones están ocultas hasta que lo hayas visto. Las muestra de todos modos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "امتیازها تا زمانی که این را تماشا نکرده باشید پنهان می‌مانند. با این حال آنها را نمایش می‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arviot on piilotettu, kunnes olet katsonut tämän. Näyttää ne silti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les notes sont masquées jusqu’à ce que vous ayez regardé ce titre. Les affiche quand même."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הדירוגים מוסתרים עד שתצפה בו. מציג אותם בכל זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इसे देखने तक रेटिंग छिपी रहती हैं. फिर भी उन्हें दिखाता है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ocjene su skrivene dok ovo ne pogledate. Svejedno ih otkriva."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az értékelések rejtve vannak, amíg ezt meg nem nézi. Ennek ellenére megjeleníti őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Penilaian disembunyikan hingga Anda menontonnya. Tetap menampilkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le valutazioni sono nascoste finché non lo guardi. Le mostra comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "視聴するまで評価は非表示になっています。それでも表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 항목을 시청할 때까지 평점이 숨겨집니다. 그래도 평점을 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Penilaian disembunyikan sehingga anda menonton tajuk ini. Tetap mendedahkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vurderinger er skjult til du har sett dette. Viser dem likevel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beoordelingen zijn verborgen totdat je dit hebt bekeken. Onthult ze toch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oceny są ukryte, dopóki tego nie obejrzysz. Odsłania je mimo to."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As avaliações ficam ocultas até você assistir a este título. Revela-as mesmo assim."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Evaluările sunt ascunse până când vizionezi acest titlu. Le dezvăluie oricum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Рейтинги скрыты, пока вы это не посмотрите. Всё равно раскрывает их."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hodnotenia sú skryté, kým si toto nepozriete. Aj tak ich odkryje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ocene so skrite, dokler tega ne pogledate. Vseeno jih razkrije."
