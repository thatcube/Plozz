    "Troubleshooting overlays stay on this device and are off by default.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Overlays voor probleemoplossing blijven op dit apparaat en staan standaard uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nakładki rozwiązywania problemów pozostają na tym urządzeniu i są domyślnie wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As sobreposições de solução de problemas ficam neste dispositivo e vêm desativadas por padrão."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fejlfindingspaneler forbliver på denne enhed og er slået fra som standard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les superpositions de dépannage restent sur cet appareil et sont désactivées par défaut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Диагностические оверлеи хранятся только на этом устройстве и по умолчанию выключены."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnostické překryvy zůstávají jen na tomto zařízení a ve výchozím stavu jsou vypnuté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnose-Overlays bleiben auf diesem Gerät und sind standardmäßig deaktiviert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli overlay per la risoluzione dei problemi restano su questo dispositivo e sono disattivati per impostazione predefinita."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Felsökningsöverlägg lagras bara på den här enheten och är avstängda som standard."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dijagnostički preklopi ostaju na ovom uređaju i prema zadanim su postavkama isključeni."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lapisan penyelesaian masalah kekal pada peranti ini dan dimatikan secara lalai."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prekrytia na riešenie problémov zostávajú len v tomto zariadení a predvolene sú vypnuté."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Діагностичні накладки зберігаються на цьому пристрої та за замовчуванням вимкнені."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hamparan pemecahan masalah hanya tersimpan di perangkat ini dan secara bawaan dinonaktifkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorun giderme kaplamaları bu aygıtta kalır ve varsayılan olarak kapalıdır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les superposicions de resolució de problemes es queden en aquest dispositiu i estan desactivades per defecte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suprapunerile de depanare rămân pe acest dispozitiv și sunt dezactivate implicit."
          }
        }
