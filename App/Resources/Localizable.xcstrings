    "Disabled libraries are hidden from Home and library browsing.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uitgeschakelde bibliotheken zijn verborgen op Start en bij het bladeren door bibliotheken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyłączone biblioteki są ukryte na stronie głównej i podczas przeglądania bibliotek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As bibliotecas desativadas ficam ocultas no Início e na navegação pelas bibliotecas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deaktiverede biblioteker skjules fra Hjem og biblioteksgennemsyn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les bibliothèques multimédias désactivées sont masquées de l’accueil et de la navigation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отключённые медиатеки скрыты на Главной и при просмотре медиатек."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vypnuté knihovny jsou skryté na obrazovce Domů i při procházení knihoven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deaktivierte Medienbibliotheken werden auf „Start“ und beim Durchsuchen ausgeblendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le librerie disattivate sono nascoste da Home e dalla navigazione delle librerie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inaktiverade bibliotek döljs på Hem och när du bläddrar bland bibliotek."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onemogućene knjižnice skrivene su s Početne i iz pregledavanja knjižnica."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pustaka yang dilumpuhkan disembunyikan daripada Laman Utama dan penyemakan imbas Pustaka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vypnuté knižnice sú skryté na obrazovke Domov a pri prehliadaní knižníc."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вимкнені медіатеки приховано з Головної та перегляду медіатек."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pustaka yang dinonaktifkan disembunyikan dari Beranda dan penelusuran pustaka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Devre dışı bırakılan medya kitaplıkları Ana Sayfa’da ve kitaplıklarda gezinirken gizlenir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les biblioteques desactivades s’amaguen d’Inici i de la navegació per biblioteques."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bibliotecile dezactivate sunt ascunse din Acasă și din navigarea prin biblioteci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ספריות מושבתות מוסתרות ממסך הבית ומעיון בספריות."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onemogočene knjižnice so skrite na zaslonu Domov in pri brskanju po knjižnici."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไลบรารีที่ปิดใช้งานจะถูกซ่อนจากหน้าแรกและการเรียกดูไลบรารี"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Деактивираните медиатеки са скрити от началния екран и преглеждането на медиатеките."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Käytöstä poistetut kirjastot piilotetaan Kodista ja kirjastojen selauksesta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deaktiverte biblioteker skjules på Hjem og i bibliotekvisningen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已禁用的媒体库在首页和浏览中将被隐藏。"
          }
        }
      }
    },
