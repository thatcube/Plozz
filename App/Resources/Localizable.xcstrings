          "stringUnit": {
            "state": "needs_review",
            "value": "На устройстве %@ вход уже выполнен. Добавить здесь?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na zařízení %@ už jste přihlášeni. Přidat ho i sem?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bist auf %@ bereits angemeldet. Hier hinzufügen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accesso è già stato effettuato su %@. Vuoi importarlo qui?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du är redan inloggad på %@. Vill du lägga till servern här?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Već ste prijavljeni na uređaju %@. Želite li ga dodati i ovdje?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda sudah log masuk pada %@. Tambah di sini?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na zariadení %@ už ste prihlásení. Pridať ho aj sem?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Уже виконано вхід на %@. Додати сюди?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda sudah masuk di %@. Tambahkan di sini?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şurada zaten oturum açık: %@. Buraya eklensin mi?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja tens la sessió iniciada a %@. La vols afegir aquí?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ești deja conectat pe %@. Îl adaugi și aici?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כבר התחברת ב-%@. להוסיף אותו כאן?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "V %@ ste že prijavljeni. Dodam ga sem?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณลงชื่อเข้าใช้ไว้บน %@ แล้ว เพิ่มที่นี่ไหม?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вече сте влезли на %@. Да го добавим тук?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Olet jo kirjautunut laitteella %@. Lisätäänkö se tänne?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du er allerede logget på %@. Legg til den her?"
          }
        },
