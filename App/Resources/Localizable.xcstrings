        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ви повернетесь на початок, і жоден сервер не буде додано."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda akan kembali ke awal dan tidak ada server yang ditambahkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Baştan başlayacaksınız ve hiçbir sunucu eklenmeyecek."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tornaràs a l'inici i no s'afegirà cap servidor."
