    "Move a provider here to stop using it.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verplaats een provider hierheen om deze niet meer te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przenieś tu dostawcę, aby przestać go używać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mova um provedor para cá para deixar de usá-lo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flyt en udbyder herhen for at stoppe med at bruge den."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplacez un fournisseur ici pour ne plus l’utiliser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переместите источник сюда, чтобы больше его не использовать."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přesuňte sem poskytovatele, pokud ho už nechcete používat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ziehe einen Anbieter hierher, um ihn nicht mehr zu verwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sposta qui un provider per smettere di usarlo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Flytta en leverantör hit för att sluta använda den."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Premjestite pružatelja ovamo da ga prestanete koristiti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alihkan penyedia ke sini untuk berhenti menggunakannya."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Presuňte sem poskytovateľa, ak ho chcete prestať používať."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перенесіть постачальника сюди, щоб припинити його використання."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pindahkan penyedia ke sini untuk berhenti menggunakannya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kullanmayı bırakmak için bir sağlayıcıyı buraya taşıyın."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mou aquí un proveïdor per deixar d'utilitzar-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mută aici un furnizor pentru a nu-l mai folosi."
          }
        }
      }
    },
