    "Diagnostic tools are now shown at the bottom of Settings. Turn them off again from the Developer Mode row.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnostische tools worden nu onderaan Instellingen weergegeven. Zet ze weer uit via de rij Ontwikkelaarsmodus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Narzędzia diagnostyczne są teraz widoczne na dole Ustawień. Wyłącz je ponownie w wierszu Tryb deweloperski."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As ferramentas de diagnóstico agora aparecem no fim de Ajustes. Para ocultá-las novamente, use a opção Modo de desenvolvedor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnoseværktøjer vises nu nederst i Indstillinger. Slå dem fra igen fra rækken Udviklertilstand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les outils de diagnostic sont maintenant affichés en bas de Réglages. Désactivez-les à nouveau depuis la ligne Mode développeur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Средства диагностики теперь отображаются внизу Настроек. Выключить их можно снова в строке «Режим разработчика»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nástroje diagnostiky se nyní zobrazují v dolní části Nastavení. Znovu je vypnete v řádku Režim vývojáře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnosewerkzeuge werden jetzt unten in den Einstellungen angezeigt. Über die Zeile „Entwicklermodus“ kannst du sie wieder ausschalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli strumenti di diagnostica sono ora visibili in fondo alle Impostazioni. Disattivali di nuovo dalla riga Modalità sviluppatore."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnostikverktygen visas nu längst ner i Inställningar. Stäng av dem igen från raden Utvecklarläge."
          }
        }
      }
    },
    "Diagnostic tools are now shown in Settings under Developer. Turn them off again from that section.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diagnostische tools worden nu weergegeven in Instellingen onder Ontwikkelaar. Zet ze weer uit via dat gedeelte."
          }
        },
        "pl": {
          "stringUnit": {
