    "Budgets cap on-disk caches; lowering a budget evicts immediately." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تحدّ الميزانيات من حجم الذاكرة المؤقتة على القرص؛ وخفض الميزانية يؤدي إلى إخلائها فورًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Лимитите ограничават кешовете на диска; намаляването на лимит освобождава място незабавно."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els límits acoten les memòries cau al disc; si redueixes un límit, s'expulsa contingut immediatament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rozpočty omezují velikost mezipamětí na disku; snížení limitu okamžitě provede vyřazení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Budgetter begrænser cachen på disken; en lavere grænse rydder øjeblikkeligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Speicherlimits begrenzen die Caches auf dem Gerät. Wenn du ein Limit senkst, werden Daten sofort entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα όρια περιορίζουν τις προσωρινές μνήμες στον δίσκο· αν μειώσετε ένα όριο, γίνεται άμεση εκκαθάριση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los presupuestos limitan las cachés en disco; reducir un presupuesto las elimina inmediatamente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بودجه‌های حافظه پنهان حداکثر فضای دیسک را محدود می‌کنند؛ کاهش بودجه فوراً حذف می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rajat määrittävät levyvälimuistien enimmäiskoon. Rajan pienentäminen tyhjentää välimuistia heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les budgets limitent les caches sur disque ; réduire un budget purge immédiatement l’excédent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "תקציבים מגבילים את המטמון בדיסק; הורדת תקציב מפנה נתונים מיד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बजट ऑन-डिस्क कैश की सीमा तय करते हैं; बजट घटाते ही डेटा तुरंत हटा दिया जाता है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proračuni ograničavaju predmemorije na disku; smanjenje proračuna odmah uklanja sadržaj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A gyorsítótár-korlátok az adatok lemezre történő mentését szabályozzák; a korlát csökkentése azonnal eltávolítja a gyorsítótárból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anggaran membatasi cache di disk; menurunkannya langsung menghapus item."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I budget limitano le cache su disco; ridurne uno libera subito spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "上限でディスク上のキャッシュ量を制限します。上限を下げると、キャッシュはすぐに削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "예산은 디스크 캐시 용량을 제한합니다. 예산을 낮추면 캐시가 즉시 제거됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bajet mengehadkan cache pada cakera; pengurangan bajet akan membuang kandungan cache serta-merta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Grenser begrenser hurtigbuffere på disken. Når en grense senkes, slettes overskytende data umiddelbart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Budgetten beperken caches op schijf; een lager budget wist meteen overtollige gegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Limity ograniczają pamięci podręczne na dysku; obniżenie limitu natychmiast usuwa dane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os limites controlam os caches em disco; ao reduzir um limite, o conteúdo é removido na hora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bugetele limitează cache-urile de pe disc; dacă reduci un buget, conținutul este eliminat imediat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Лимиты ограничивают размер кэша на диске; при уменьшении лимита данные удаляются сразу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rozpočty obmedzujú vyrovnávacie pamäte na disku; zníženie rozpočtu okamžite vymaže nadbytočné položky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Proračuni omejujejo predpomnilnike na disku; znižanje proračuna takoj odstrani podatke."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ograničenja određuju veličinu keša na disku; smanjenjem ograničenja sadržaj se odmah uklanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Budgetar sätter tak för cachar på disk; sänker du en budget rensas data omedelbart."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "งบประมาณกำหนดเพดานแคชบนดิสก์; เมื่อลดงบประมาณ ระบบจะลบทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sınırlar diskteki önbelleklerin boyutunu belirler; sınır düşürüldüğünde fazla veriler hemen silinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обмеження визначають розмір дискових кешів; зменшення обмеження негайно вилучає зайві дані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ngân sách bộ nhớ đệm giới hạn bộ nhớ đệm trên đĩa; giảm ngân sách sẽ loại bỏ ngay lập tức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "缓存预算限制磁盘缓存；降低预算会立即清除缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "額度上限會限制磁碟快取容量；調低額度會立即清除超出的內容。"
          }
        }
      }
