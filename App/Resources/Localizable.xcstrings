    },
    "error.quickConnectUnavailable": {
      "comment": "Shown when Jellyfin's Quick Connect sign-in feature is disabled server-side.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Quick Connect is turned off on this server. Enable it in the Jellyfin dashboard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quick Connect staat uit op deze server. Schakel het in via het Jellyfin-dashboard."
