    "Each profile gets its own settings, watch history, and libraries.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elk profiel krijgt zijn eigen instellingen, kijkgeschiedenis en bibliotheken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy profil ma własne ustawienia, historię oglądania i biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada perfil tem suas próprias configurações, histórico de exibição e bibliotecas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver profil får sine egne indstillinger, sehistorik og biblioteker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque profil a ses propres réglages, son historique de visionnage et ses bibliothèques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У каждого профиля свои настройки, история просмотра и медиатеки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každý profil má vlastní nastavení, historii sledování a knihovny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jedes Profil erhält eigene Einstellungen, einen eigenen Wiedergabeverlauf und eigene Medienbibliotheken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni profilo ha le proprie impostazioni, cronologia di visione e librerie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varje profil har egna inställningar, egen tittarhistorik och egna bibliotek."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaki profil dobiva vlastite postavke, povijest gledanja i knjižnice."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setiap profil mendapat tetapan, sejarah tontonan, dan Pustaka sendiri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každý profil má vlastné nastavenia, históriu sledovania a knižnice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожен профіль має власні налаштування, історію перегляду й медіатеки."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setiap profil memiliki pengaturan, riwayat tonton, dan pustakanya sendiri."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her profilin kendi ayarları, izleme geçmişi ve kitaplıkları olur."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada perfil té la seva pròpia configuració, historial de visualització i biblioteques."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fiecare profil are propriile setări, propriul istoric de vizionare și propriile biblioteci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לכל פרופיל יש הגדרות, היסטוריית צפייה וספריות משלו."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vsak profil dobi svoje nastavitve, zgodovino ogledov in knjižnice."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แต่ละโปรไฟล์มีการตั้งค่า ประวัติการดู และไลบรารีของตัวเอง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всеки профил има свои собствени настройки, история на гледане и медиатеки."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jokaisella profiililla on omat asetukset, katseluhistoria ja kirjastot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver profil får sine egne innstillinger, seerhistorikk og biblioteker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个个人资料拥有独立的设置、观看历史和媒体库。"
          }
        }
      }
    },
    "Each profile keeps its own settings — theme, playback, subtitles, spoilers, trackers, and Home layout. Only your servers are shared.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elk profiel behoudt zijn eigen instellingen — thema, afspelen, ondertitels, spoilers, trackers en indeling van Start. Alleen je servers worden gedeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy profil zachowuje własne ustawienia — motyw, odtwarzanie, napisy, spoilery, serwisy śledzące i układ strony głównej. Współdzielone są tylko serwery."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada perfil mantém suas próprias configurações — tema, reprodução, legendas, spoilers, rastreadores e layout da tela Início. Só seus servidores são compartilhados."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver profil beholder sine egne indstillinger — tema, afspilning, undertekster, spoilere, trackere og Hjem-layout. Kun dine servere deles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque profil conserve ses propres réglages — thème, lecture, sous-titres, spoilers, services de suivi et disposition de l’accueil. Seuls vos serveurs sont partagés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У каждого профиля свои настройки — тема, воспроизведение, субтитры, защита от спойлеров, трекеры и макет экрана «Главная». Общими являются только ваши серверы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každý profil má vlastní nastavení — motiv, přehrávání, titulky, spoilery, služby sledování i rozložení obrazovky Domů. Sdílené jsou jen servery."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jedes Profil behält seine eigenen Einstellungen – Design, Wiedergabe, Untertitel, Spoiler, Tracker und Layout der Startseite. Nur deine Server werden gemeinsam genutzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni profilo mantiene le proprie impostazioni — tema, riproduzione, sottotitoli, spoiler, tracker e layout di Home. Solo i tuoi server sono condivisi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varje profil har egna inställningar för tema, uppspelning, undertexter, avslöjanden, spårningstjänster och utformningen av Hem. Endast servrarna delas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaki profil zadržava vlastite postavke — temu, reprodukciju, titlove, spojlere, servise za praćenje i raspored Početne. Dijele se samo vaši poslužitelji."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setiap profil mengekalkan tetapan sendiri — tema, main balik, sari kata, spoiler, penjejak, dan susun atur Laman Utama. Hanya pelayan anda dikongsi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každý profil má vlastné nastavenia — tému, prehrávanie, titulky, spoilery, služby sledovania aj rozloženie obrazovky Domov. Zdieľajú sa len servery."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожен профіль зберігає власні налаштування: тему, відтворення, субтитри, спойлери, трекери й макет Головної. Спільними залишаються лише сервери."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setiap profil menyimpan pengaturannya sendiri — tema, pemutaran, subtitle, spoiler, pelacak, dan tata letak Beranda. Hanya server Anda yang dibagikan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her profil kendi ayarlarını — tema, oynatma, altyazılar, sürprizbozanlar, takip hizmetleri ve Ana Sayfa düzeni — ayrı tutar. Yalnızca sunucular paylaşılır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada perfil manté la seva pròpia configuració (tema, reproducció, subtítols, espòilers, serveis de seguiment i disposició d’Inici). Només els servidors es comparteixen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fiecare profil își păstrează propriile setări — temă, redare, subtitrări, spoilere, servicii de monitorizare și aspectul Acasă. Doar serverele tale sunt partajate."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כל פרופיל שומר על ההגדרות שלו — ערכת נושא, השמעה, כתוביות, ספוילרים, שירותי מעקב ופריסת מסך הבית. רק השרתים שלך משותפים."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vsak profil ohrani svoje nastavitve — temo, predvajanje, podnapise, spojlerje, storitve sledenja in postavitev zaslona Domov. Skupni so samo strežniki."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แต่ละโปรไฟล์จะเก็บการตั้งค่าของตัวเองไว้ ได้แก่ ธีม การเล่น คำบรรยาย การซ่อนสปอยเลอร์ ตัวติดตาม และเค้าโครงหน้าแรก มีเพียงเซิร์ฟเวอร์ของคุณที่ใช้ร่วมกัน"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всеки профил пази свои настройки — тема, възпроизвеждане, субтитри, спойлери, услуги за проследяване и оформление на Начало. Споделят се само сървърите."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jokainen profiili säilyttää omat asetuksensa — teeman, toiston, tekstitykset, juonipaljastukset, seurantapalvelut ja Kodin asettelun. Vain palvelimet ovat yhteisiä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver profil beholder sine egne innstillinger — tema, avspilling, undertekster, spoilere, trackere og Hjem-oppsett. Kun serverne dine deles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个个人资料拥有独立的设置——主题、播放、字幕、剧透、追踪器和首页布局。仅共享您的服务器。"
          }
        }
      }
    },
