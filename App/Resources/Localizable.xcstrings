          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le richieste di %@ useranno la quota, le approvazioni e il profilo di qualità predefinito di questo utente Seerr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Förfrågningar från %@ använder den här Seerr-användarens kvot, godkännanden och standardkvalitetsprofil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zahtjevi profila %@ koristit će kvotu, odobrenja i zadani profil kvalitete ovog korisnika usluge Seerr."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permintaan daripada %@ akan menggunakan kuota, kelulusan dan profil kualiti lalai pengguna Seerr ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
