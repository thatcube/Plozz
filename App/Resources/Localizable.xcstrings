    "You’re already signed in on %@. Add it here?": {
      "comment": "Subtitle in the iOS new-server prompt when another device is already signed in. %@ is the other device's name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je bent al aangemeld op %@. Hier toevoegen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To konto jest już zalogowane na urządzeniu „%@”. Dodać je tutaj?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você já está conectado em %@. Adicionar aqui?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du er allerede logget ind på %@. Tilføj den her?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous êtes déjà connecté sur %@. L’ajouter ici ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На устройстве %@ вход уже выполнен. Добавить здесь?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na zařízení %@ už jste přihlášeni. Přidat ho i sem?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bist auf %@ bereits angemeldet. Hier hinzufügen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accesso è già stato effettuato su %@. Vuoi importarlo qui?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du är redan inloggad på %@. Vill du lägga till servern här?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Već ste prijavljeni na uređaju %@. Želite li ga dodati i ovdje?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda sudah log masuk pada %@. Tambah di sini?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na zariadení %@ už ste prihlásení. Pridať ho aj sem?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Уже виконано вхід на %@. Додати сюди?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda sudah masuk di %@. Tambahkan di sini?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şurada zaten oturum açık: %@. Buraya eklensin mi?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja tens la sessió iniciada a %@. La vols afegir aquí?"
