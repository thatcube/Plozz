    "Unavailable sources are temporarily skipped and retried automatically.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niet-beschikbare bronnen worden tijdelijk overgeslagen en automatisch opnieuw geprobeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niedostępne źródła są tymczasowo pomijane, a próby dostępu do nich są automatycznie ponawiane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fontes indisponíveis são ignoradas temporariamente e tentadas novamente automaticamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilgængelige kilder springes midlertidigt over og forsøges automatisk igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sources indisponibles sont temporairement ignorées et réessayées automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Недоступные источники временно пропускаются, и для них автоматически выполняется повторная попытка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nedostupné zdroje se dočasně přeskočí a automaticky se zkusí znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht verfügbare Quellen werden vorübergehend übersprungen und automatisch erneut geprüft."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le fonti non disponibili vengono saltate temporaneamente e riprovate in automatico."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Källor som inte är tillgängliga hoppas över tillfälligt och testas igen automatiskt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nedostupni izvori privremeno se preskaču i automatski ponovno pokušavaju."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sumber yang tidak tersedia dilangkau buat sementara waktu dan dicuba semula secara automatik."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nedostupné zdroje sa dočasne preskočia a automaticky sa skúsia znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Недоступні джерела тимчасово пропускаються й автоматично перевіряються знову."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sumber yang tidak tersedia dilewati sementara dan akan dicoba lagi secara otomatis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kullanılamayan kaynaklar geçici olarak atlanır ve otomatik olarak yeniden denenir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les fonts no disponibles s'ometen temporalment i es tornen a provar automàticament."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sursele indisponibile sunt omise temporar și reîncercate automat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מקורות שאינם זמינים מדולגים זמנית ונבדקים שוב אוטומטית."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viri, ki niso na voljo, so začasno preskočeni in se samodejno znova poskusijo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แหล่งข้อมูลที่ไม่พร้อมใช้งานจะถูกข้ามชั่วคราวและลองใหม่อัตโนมัติ"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Недостъпните източници се прескачат временно и се опитват отново автоматично."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lähteet, jotka eivät ole saatavilla, ohitetaan väliaikaisesti ja niitä yritetään automaattisesti uudelleen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilgjengelige kilder hoppes midlertidig over og prøves automatisk på nytt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暂时跳过不可用的数据源并自动重试。"
          }
        }
      }
    },
