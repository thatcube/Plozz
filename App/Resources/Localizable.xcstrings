    "navigationStyle.detail.sidebar": {
      "comment": "One-line explanation shown under the navigation-style picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A collapsible left sidebar that expands on focus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een inklapbare zijbalk links die uitklapt bij focus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwijany lewy pasek boczny, który rozwija się po zaznaczeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma barra lateral à esquerda que pode ser recolhida e se expande ao ganhar foco."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En sammenklappelig venstre sidebjælke, der udvides ved fokus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une barre latérale gauche repliable qui se déploie lorsqu’elle est sélectionnée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сворачиваемая левая боковая панель, которая раскрывается при фокусе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sbalitelný levý postranní panel, který se při zaměření rozbalí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine einklappbare Seitenleiste links, die beim Fokussieren ausgeklappt wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una barra laterale richiudibile a sinistra che si espande quando riceve il focus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ett hopfällbart sidofält till vänster som expanderar vid fokus."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sklopiva lijeva bočna traka koja se proširuje pri fokusu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bar sisi kiri yang boleh dikuncupkan dan berkembang apabila difokuskan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zbaliteľný ľavý bočný panel, ktorý sa pri zameraní rozbalí."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Згортана ліва бічна панель, яка розгортається, коли на неї переходить фокус."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bar samping kiri yang dapat diciutkan dan meluas saat difokuskan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaklanınca genişleyen, daraltılabilir bir sol kenar çubuğu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una barra lateral esquerra plegable que s’expandeix en rebre el focus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O bară laterală din stânga, pliabilă, care se extinde la focalizare."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "סרגל צד שניתן לכווץ ומתרחב עם המיקוד."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zložljiva leva stranska vrstica, ki se ob fokusu razširi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถบด้านข้างซ้ายที่ยุบได้และจะขยายเมื่อโฟกัส"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Свиваема лява странична лента, която се разгъва при фокусиране."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kokoon painuva vasen sivupalkki, joka laajenee kohdistettaessa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et sammenleggbart venstre sidepanel som utvides når det får fokus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可折叠左侧边栏，聚焦时展开。"
          }
        }
      }
    },
