        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изберете тема за този профил. Можете да я промените по всяко време."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valitse tälle profiilille teema. Voit vaihtaa sen milloin tahansa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velg et tema til denne profilen. Du kan alltid endre det senere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为该个人资料选择一个主题。您可以随时更改。"
          }
        }
      }
    },
    "Pick up where you left off, front and centre.": {
      "comment": "Explanation shown under the Continue Watching hero source option in Settings.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ga direct verder waar je was gebleven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wznów od miejsca, w którym przerwano — od razu na pierwszym planie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continue de onde parou, bem em destaque."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortsæt, hvor du slap, helt centralt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retrouvez ce que vous regardiez, bien en évidence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Продолжайте с того места, где остановились, — на самом видном месте."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokračujte tam, kde jste skončili, hned na očích."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Direkt dort weiterschauen, wo du aufgehört hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riprendi da dove avevi interrotto, in primo piano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortsätt där du slutade, i blickfånget."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nastavite tamo gdje ste stali, u prvom planu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambung semula di tempat anda berhenti, di tengah-tengah tumpuan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokračujte tam, kde ste skončili, priamo na očiach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Продовжуйте з місця, де зупинилися, — на найпомітнішому місці."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lanjutkan dari terakhir Anda berhenti, tampil paling depan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“İzlemeye Devam Et” satırını en öne çıkarır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continua on ho vas deixar, en primer pla."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reia de unde ai rămas, chiar în prim-plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "המשך מהמקום שבו הפסקת, במרכז הבמה."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadaljujte tam, kjer ste končali, v ospredju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ดูต่อจากที่ค้างไว้ โดยแสดงไว้เด่นที่สุด"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Продължете откъдето сте спрели, централно на екрана."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jatka siitä, mihin jäit – heti näkyvimmällä paikalla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortsett der du slapp, helt sentralt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从您上次观看的位置开始，置于前台。"
          }
        }
      }
    },
