    "transparency.detail.off": {
      "comment": "One-line explanation shown under the transparency picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Always use solid backgrounds — no translucency."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gebruik altijd effen achtergronden — geen doorschijnendheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zawsze używaj nieprzezroczystych teł — bez przezroczystości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sempre usar fundos sólidos — sem transparência."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brug altid ensfarvede baggrunde — ingen gennemsigtighed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toujours utiliser des arrière-plans opaques — sans translucidité."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всегда использовать сплошной фон без полупрозрачности."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vždy používat plná pozadí — bez průhlednosti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Immer deckende Hintergründe — keine Transparenz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa sempre sfondi opachi, senza traslucenza."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Använd alltid solida bakgrunder — ingen genomskinlighet."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uvijek koristi neprozirne pozadine — bez prozirnosti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sentiasa gunakan latar belakang pejal — tiada lut sinar."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vždy používať plné pozadia — bez priehľadnosti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завжди використовувати суцільні фони — без прозорості."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selalu gunakan latar belakang penuh tanpa transparansi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her zaman opak arka planlar kullan — saydamlık yok."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilitza sempre fons sòlids — sense translucidesa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Folosește întotdeauna fundaluri opace — fără transparență."
          }
        }
      }
    },
    "transparency.detail.on": {
      "comment": "One-line explanation shown under the transparency picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Always use translucent liquid-glass panels and cards."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gebruik altijd doorschijnende Liquid Glass-panelen en -kaarten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zawsze używaj półprzezroczystych paneli i kart Liquid Glass."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sempre usar painéis e cartões translúcidos com efeito de vidro líquido."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brug altid gennemskinnelige Liquid Glass-paneler og -kort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toujours utiliser des panneaux et cartes translucides Liquid Glass."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всегда использовать полупрозрачные стеклянные панели и карточки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vždy používat průsvitné panely a karty Liquid Glass."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Immer durchscheinende Liquid-Glass-Flächen und -Karten verwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa sempre pannelli e schede traslucidi in Liquid Glass."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Använd alltid genomskinliga Liquid Glass-paneler och kort."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uvijek koristi prozirne panele i kartice Liquid Glass."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sentiasa gunakan panel dan kad Liquid Glass lut sinar."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vždy používať priesvitné panely a karty Liquid Glass."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завжди використовувати напівпрозорі панелі й картки Liquid Glass."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selalu gunakan panel dan kartu Liquid Glass yang transparan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her zaman yarı saydam Liquid Glass panelleri ve kartları kullan."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilitza sempre plafons i targetes translúcids de Liquid Glass."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Folosește întotdeauna panouri și carduri translucide, cu efect de sticlă lichidă."
          }
        }
      }
    },
    "transparency.detail.system": {
      "comment": "One-line explanation shown under the transparency picker.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Follow the tvOS “Reduce Transparency” accessibility setting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volg de tvOS-toegankelijkheidsinstelling “Transparantie verminderen”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dopasuj do ustawienia dostępności „Ogranicz przezroczystość” w tvOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seguir o ajuste de acessibilidade “Reduzir Transparência” do tvOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Følg tvOS' tilgængelighedsindstilling “Reducér gennemsigtighed”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suivre le réglage d’accessibilité « Réduire la transparence » de tvOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Следовать настройке универсального доступа tvOS «Уменьшение прозрачности»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Řídit se nastavením zpřístupnění „Omezit průhlednost“ v tvOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Folgt der tvOS-Bedienungshilfe „Transparenz reduzieren“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Segui l’impostazione di accessibilità “Riduci trasparenza” di tvOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Följ tvOS-inställningen ”Minska genomskinlighet”."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slijedi postavku pristupačnosti „Smanji prozirnost” u tvOS-u."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikut tetapan kebolehcapaian “Kurangkan Ketelusan” tvOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riadiť sa nastavením sprístupnenia tvOS „Obmedziť priehľadnosť“."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дотримуватися параметра доступності tvOS «Зменшення прозорості»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikuti pengaturan aksesibilitas tvOS “Kurangi Transparansi”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tvOS “Saydamlığı Azalt” erişilebilirlik ayarını kullan."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Segueix l’opció d’accessibilitat “Redueix la transparència” de tvOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Urmează configurarea de accesibilitate „Reducere transparență” din tvOS."
          }
        }
      }
    },
