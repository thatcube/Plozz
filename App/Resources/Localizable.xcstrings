    "We created this profile from your %@ account. You can rename it or change the photo here, or any time in Settings.": {
      "comment": "Explanatory text on the tvOS first-run profile screen. %@ is the provider name the profile was created from, such as Plex or Jellyfin.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "We hebben dit profiel aangemaakt op basis van je %@-account. Je kunt het hier hernoemen of de foto wijzigen, of op elk moment in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utworzono ten profil na podstawie konta w serwisie %@. Możesz tutaj lub później w Ustawieniach zmienić jego nazwę albo zdjęcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Criamos este perfil a partir da sua conta %@. Você pode renomeá-lo ou trocar a foto aqui ou a qualquer momento em Ajustes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vi oprettede denne profil ud fra din %@-konto. Du kan omdøbe den eller ændre billedet her eller når som helst i Indstillinger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nous avons créé ce profil à partir de votre compte %@. Vous pouvez le renommer ou changer sa photo ici, ou à tout moment dans Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Мы создали этот профиль на основе вашей учётной записи в %@. Вы можете переименовать его или изменить фото здесь либо позже в Настройках."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tento profil jsme vytvořili z vašeho účtu služby %@. Tady nebo kdykoli později v Nastavení ho můžete přejmenovat nebo změnit fotku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wir haben dieses Profil aus deinem %@-Account erstellt. Du kannst es hier oder jederzeit in den Einstellungen umbenennen oder das Foto ändern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abbiamo creato questo profilo dal tuo account %@. Puoi rinominarlo o cambiare la foto qui oppure in qualsiasi momento in Impostazioni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vi skapade den här profilen från ditt %@-konto. Du kan byta namn på den eller ändra bilden här, eller när som helst i Inställningar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj smo profil stvorili iz vašeg računa usluge %@. Ovdje ga možete preimenovati ili promijeniti fotografiju, a to možete učiniti i bilo kada u Postavkama."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kami mencipta profil ini daripada akaun %@ anda. Anda boleh menamakannya semula atau menukar foto di sini, atau bila-bila masa dalam Tetapan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tento profil sme vytvorili z vášho účtu služby %@. Môžete ho tu premenovať alebo zmeniť fotku, prípadne kedykoľvek v Nastaveniach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей профіль створено з вашого облікового запису %@. Тут або будь-коли в Налаштуваннях можна змінити його ім’я чи фото."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kami membuat profil ini dari akun %@ Anda. Anda bisa mengganti namanya atau mengubah fotonya di sini, atau kapan saja di Pengaturan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu profili %@ hesabınızdan oluşturduk. Adını veya fotoğrafını burada ya da istediğiniz zaman Ayarlar’da değiştirebilirsiniz."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hem creat aquest perfil a partir del teu compte de %@. Pots canviar-ne el nom o la foto aquí, o en qualsevol moment a Configuració."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Am creat acest profil din contul tău %@. Îi poți schimba numele sau fotografia aici ori oricând în Setări."
          }
        }
      }
    },
