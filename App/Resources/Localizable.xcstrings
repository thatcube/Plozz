          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Powiadomienia zbiorcze podsumowują sezon lub serial zamiast powiadamiać o każdym odcinku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
