          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lämna alla bibliotek markerade för att inkludera alla aktiverade bibliotek."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
