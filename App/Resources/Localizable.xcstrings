    "Not seeing changes from your other devices? Pull a fresh copy from iCloud.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zie je geen wijzigingen van je andere apparaten? Haal een nieuwe kopie op uit iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie widać zmian z innych urządzeń? Pobierz świeżą kopię z iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não está vendo as mudanças dos seus outros dispositivos? Baixe uma cópia atualizada do iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan du ikke se ændringer fra dine andre enheder? Hent en ny kopi fra iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous ne voyez pas les changements de vos autres appareils ? Récupérez une nouvelle copie depuis iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не видите изменения с других устройств? Загрузите свежую копию из iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nevidíte změny z ostatních zařízení? Stáhněte novou kopii z iCloudu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siehst du keine Änderungen von deinen anderen Geräten? Lade eine frische Kopie aus iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non vedi le modifiche dagli altri dispositivi? Scarica una copia aggiornata da iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ser du inte ändringar från dina andra enheter? Hämta en ny kopia från iCloud."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne vidite promjene s drugih uređaja? Preuzmite svježu kopiju iz iClouda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak nampak perubahan daripada peranti lain anda? Tarik salinan terkini daripada iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nevidíte zmeny z vašich ostatných zariadení? Stiahnite si novú kópiu z iCloudu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не бачите змін з інших своїх пристроїв? Завантажте свіжу копію з iCloud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak melihat perubahan dari perangkat lain Anda? Ambil salinan terbaru dari iCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer aygıtlarınızdaki değişiklikleri görmüyor musunuz? iCloud’dan yeni bir kopya çekin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No veus els canvis dels teus altres dispositius? Baixa'n una còpia nova des de l'iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nu vezi modificările de pe celelalte dispozitive? Preia o copie nouă din iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "השינויים מהמכשירים האחרים לא מופיעים? הורד עותק חדש מ-iCloud."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne vidite sprememb iz drugih naprav? Prenesite novo kopijo iz iClouda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่เห็นการเปลี่ยนแปลงจากอุปกรณ์เครื่องอื่นของคุณใช่ไหม ดึงสำเนาใหม่จาก iCloud"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не виждате промени от другите си устройства? Изтеглете ново копие от iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eivätkö muiden laitteidesi muutokset näy? Nouda tuore kopio iCloudista."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan du ikke se endringer fra de andre enhetene dine? Hent en ny kopi fra iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未看到其他设备的更改？从 iCloud 拉取最新副本。"
          }
        }
      }
    },
    "Not seeing it nearby? Scan the QR or type the short code shown on the other device.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zie je het niet in de buurt? Scan de QR-code of voer de korte code in die op het andere apparaat wordt getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie widać go w pobliżu? Zeskanuj kod QR lub wpisz krótki kod wyświetlany na drugim urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não está aparecendo por perto? Escaneie o QR ou digite o código curto mostrado no outro dispositivo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan du ikke se den i nærheden? Scan QR-koden, eller indtast den korte kode, der vises på den anden enhed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous ne le voyez pas à proximité ? Scannez le code QR ou saisissez le code court affiché sur l’autre appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не видите устройство поблизости? Отсканируйте QR-код или введите короткий код, показанный на другом устройстве."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nevidíte ho poblíž? Naskenujte QR nebo zadejte krátký kód zobrazený na druhém zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird es in der Nähe nicht angezeigt? Scanne den QR-Code oder gib den Kurzcode ein, der auf dem anderen Gerät angezeigt wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non lo vedi nelle vicinanze? Scansiona il QR o digita il codice breve mostrato sull’altro dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ser du den inte i närheten? Skanna QR-koden eller skriv in den korta koden som visas på den andra enheten."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne vidite ga u blizini? Skenirajte QR ili upišite kratki kod prikazan na drugom uređaju."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak nampak berhampiran? Imbas kod QR atau taip kod pendek yang dipaparkan pada peranti lain."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nevidíte ho v blízkosti? Naskenujte QR alebo zadajte krátky kód zobrazený na druhom zariadení."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не бачите його поруч? Відскануйте QR-код або введіть короткий код, показаний на іншому пристрої."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak terlihat di sekitar? Pindai QR atau ketik kode singkat yang ditampilkan di perangkat lain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yakında görünmüyor mu? QR kodunu tarayın veya diğer aygıtta gösterilen kısa kodu girin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No el veus a prop? Escaneja el QR o introdueix el codi curt que es mostra a l'altre dispositiu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nu apare în apropiere? Scanează codul QR sau introdu codul scurt afișat pe celălalt dispozitiv."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא רואה אותו בקרבת מקום? סרוק את קוד ה-QR או הקלד את הקוד הקצר המוצג במכשיר האחר."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je ne vidite v bližini? Optično preberite QR ali vnesite kratko kodo, prikazano na drugi napravi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่เห็นอุปกรณ์ใกล้ ๆ ใช่ไหม สแกน QR หรือพิมพ์รหัสสั้นที่แสดงบนอุปกรณ์อีกเครื่อง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не го виждате наблизо? Сканирайте QR кода или въведете кода, показан на другото устройство."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eikö laite näy lähistöllä? Skannaa QR-koodi tai kirjoita toisessa laitteessa näkyvä lyhyt koodi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan du ikke se den i nærheten? Skann QR-koden eller skriv inn den korte koden som vises på den andre enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未在附近看到？扫描二维码或输入另一台设备上显示的短代码。"
          }
        }
      }
    },
