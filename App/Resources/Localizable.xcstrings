        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP přenáší přihlašovací údaje i média bez šifrování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP überträgt Zugangsdaten und Medien unverschlüsselt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP invia credenziali e contenuti senza crittografia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP skickar inloggningsuppgifter och mediefiler utan kryptering."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP šalje vjerodajnice i medije bez šifriranja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP menghantar bukti kelayakan dan media tanpa penyulitan."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP prenáša prihlasovacie údaje a médiá bez šifrovania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP передає облікові дані та медіа без шифрування."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP mengirim kredensial dan media tanpa enkripsi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP kimlik bilgilerini ve medyayı şifreleme olmadan gönderir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "FTP envia les credencials i els continguts multimèdia sense xifrar."
          }
        },
        "ro": {
