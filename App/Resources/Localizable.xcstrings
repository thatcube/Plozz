    "Off. %@: sunset %@, sunrise %@.": {
      "comment": "Footer summary in iOS Settings > Circadian Mode when solar scheduling is configured but disabled. %@ is the region name, the second %@ is today's sunset time, and the third %@ is today's sunrise time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Off. %1$@: sunset %2$@, sunrise %3$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uit. %1$@: zonsondergang %2$@, zonsopgang %3$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wył. %1$@: zachód słońca %2$@, wschód słońca %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativado. %1$@: pôr do sol às %2$@, nascer do sol às %3$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fra. %1$@: solnedgang %2$@, solopgang %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé. %1$@ : coucher du soleil à %2$@, lever du soleil à %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выкл. %1$@: закат %2$@, восход %3$@."
          }
        }
      }
    },
    "Off. Manual: on %@, off %@.": {
      "comment": "Footer summary in iOS Settings > Circadian Mode when manual scheduling is configured but disabled. %@ is the on time, and the second %@ is the off time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Off. Manual: on %1$@, off %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uit. Handmatig: aan %1$@, uit %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wył. Ręcznie: włączenie %1$@, wyłączenie %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativado. Manual: ativar às %1$@, desativar às %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fra. Manuel: til %1$@, fra %2$@."
          }
        },
        "fr": {
