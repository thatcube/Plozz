    "Uploads the full log below so it can be read on a computer instead of scrolling here. Sent anonymously — no logins, tokens, servers, or titles are included." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يرفع السجل الكامل أدناه بحيث يمكن قراءته على جهاز كمبيوتر بدلاً من التمرير هنا. يُرسل بشكل مجهول — لا تتضمن تسجيلات الدخول أو الرموز أو الخوادم أو العناوين."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Качва пълния регистрационен файл по-долу, за да може да се прочете на компютър, вместо да го преглеждате тук. Изпраща се анонимно — без данни за вход, токени, сървъри или заглавия."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puja el registre complet a continuació perquè es pugui llegir en un ordinador en lloc de desplaçar-te aquí. S'envia de manera anònima — no s'inclouen inicis de sessió, testimonis, servidors ni títols."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nahraje celý níže uvedený protokol, aby se dal číst na počítači místo posouvání tady. Odesílá se anonymně — bez přihlášení, tokenů, serverů a titulů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sender hele loggen nedenfor, så den kan læses på en computer i stedet for at skulle rulle her. Sendes anonymt — ingen logins, tokens, servere eller titler medtages."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lädt das vollständige Protokoll unten hoch, damit du es am Computer lesen kannst, statt hier zu scrollen. Wird anonym gesendet — Logins, Tokens, Server oder Titel sind nicht enthalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ανεβάζει ολόκληρο το παρακάτω αρχείο καταγραφής ώστε να μπορεί να διαβαστεί σε υπολογιστή αντί να κάνετε κύλιση εδώ. Στέλνεται ανώνυμα — δεν περιλαμβάνονται στοιχεία σύνδεσης, διακριτικά, διακομιστές ή τίτλοι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sube el registro completo más abajo para que puedas leerlo en un equipo en lugar de tener que desplazarte aquí. Se envía de forma anónima: no se incluyen inicios de sesión, tokens, servidores ni títulos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "گزارش کامل زیر را آپلود می‌کند تا به‌جای پیمایش در اینجا، بتوانید آن را روی رایانه بخوانید. به صورت ناشناس ارسال می‌شود — بدون ورود، توکن، سرور یا عنوان."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lähettää koko alla olevan lokin, jotta sen voi lukea tietokoneella selaamatta sitä tässä. Lähetys on nimetön — mukana ei ole kirjautumistietoja, pääsytunnisteita, palvelimia eikä nimikkeitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envoie le journal complet ci-dessous afin de pouvoir le lire sur un ordinateur plutôt que de le faire défiler ici. Envoi anonyme — aucun identifiant, jeton, serveur ni titre n’est inclus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מעלה את היומן המלא שלהלן כדי שיהיה אפשר לקרוא אותו במחשב במקום לגלול כאן. הוא נשלח בעילום שם ואינו כולל פרטי התחברות, טוקנים, שרתים או כותרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नीचे पूरा लॉग अपलोड करता है, ताकि यहां स्क्रोल करने के बजाय उसे कंप्यूटर पर पढ़ा जा सके. यह गुमनाम रूप से भेजा जाता है — इसमें लॉगिन, टोकन, सर्वर या टाइटल शामिल नहीं होते."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prenosi cijeli zapisnik u nastavku kako bi se mogao pročitati na računalu umjesto da ga pomičete ovdje. Šalje se anonimno — prijave, tokeni, poslužitelji i naslovi nisu uključeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A teljes napló feltöltése egy számítógépen való olvasáshoz, nem görgetés itt. Az anonim módon kerül elküldésre – nem tartalmaz bejelentkezést, tokent, szerver vagy címet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mengunggah log lengkap di bawah agar bisa dibaca di komputer alih-alih menggulir di sini. Dikirim anonim — login, token, server, atau judul tidak disertakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Carica il log completo qui sotto per consentirne la lettura su un computer anziché scorrerlo qui. Viene inviato anonimamente, senza dati di accesso, token, server o titoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "下のログ全体をアップロードして、ここでスクロールしなくてもコンピュータで読めるようにします。匿名で送信されるため、ログイン情報、トークン、サーバ、タイトルは含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "아래 전체 로그를 업로드하여 여기에서 스크롤하는 대신 컴퓨터에서 읽을 수 있도록 합니다. 익명으로 전송됩니다 — 로그인, 토큰, 서버 또는 제목이 포함되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Memuat naik log penuh di bawah supaya boleh dibaca pada komputer dan bukan menatal di sini. Dihantar secara tanpa nama — tiada log masuk, token, pelayan, atau tajuk disertakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sender hele loggen nedenfor, slik at den kan leses på en datamaskin i stedet for å rulle her. Sendes anonymt — ingen pålogginger, tokens, servere eller titler inkluderes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uploadt het volledige logboek hieronder, zodat het op een computer gelezen kan worden in plaats van hier te scrollen. Anoniem verzonden — er worden geen aanmeldgegevens, tokens, servers of titels meegestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przesyła pełny dziennik widoczny poniżej, aby można go było odczytać na komputerze zamiast przewijać tutaj. Dane są wysyłane anonimowo — bez danych logowania, tokenów, serwerów ani tytułów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envia o log completo abaixo para que ele possa ser lido no computador em vez de rolar por aqui. Enviado anonimamente — nenhum login, token, servidor ou título é incluído."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Încarcă jurnalul complet de mai jos, pentru a putea fi citit pe un computer în loc să derulezi aici. Este trimis anonim — nu sunt incluse autentificări, tokenuri, servere sau titluri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Загружает полный журнал ниже, чтобы его можно было прочитать на компьютере вместо прокрутки здесь. Отправляется анонимно — без данных для входа, токенов, серверов и названий материалов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odošle celý protokol uvedený nižšie, aby sa dal pohodlne čítať na počítači. Odošle sa anonymne — bez prihlásení, tokenov, serverov a titulov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naloži celoten spodnji dnevnik, da ga lahko v računalniku preberete namesto pomikanja tukaj. Poslano anonimno — brez prijav, žetonov, strežnikov ali naslovov."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otprema ceo dnevnik u nastavku kako bi mogao da se pročita na računaru umesto da se ovde lista. Šalje se anonimno — ne uključuje prijave, tokene, servere ni naslove."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laddar upp hela loggen nedan så att den kan läsas på en dator i stället för att bläddras igenom här. Skickas anonymt utan inloggningar, åtkomsttoken, servrar eller titlar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "อัปโหลดบันทึกทั้งหมดด้านล่างเพื่อให้อ่านบนคอมพิวเตอร์ได้แทนการเลื่อนดูที่นี่ ส่งแบบไม่ระบุตัวตน — ไม่มีข้อมูลการลงชื่อเข้าใช้ โทเค็น เซิร์ฟเวอร์ หรือชื่อเรื่องรวมอยู่ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aşağıdaki tam günlük yüklenir; böylece burada kaydırmak yerine bir bilgisayarda okunabilir. Anonim olarak gönderilir; oturum bilgileri, belirteçler, sunucular ve yapım adları eklenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Завантажує повний журнал нижче, щоб його можна було прочитати на комп’ютері, а не прокручувати тут. Надсилається анонімно — без даних входу, токенів, серверів і назв контенту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tải lên toàn bộ nhật ký dưới đây để nó có thể được đọc trên máy tính thay vì cuộn ở đây. Được gửi ẩn danh không bao gồm đăng nhập, mã thông báo, máy chủ hoặc tiêu đề."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "上传完整日志以便在电脑上查看，无需在此滚动。匿名发送 — 不包含登录信息、令牌、服务器或标题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "上傳下方的完整記錄，以便在電腦上閱讀，不必在此捲動查看。以匿名方式送出——不包含登入資訊、權杖、伺服器或觀看片名。"
          }
        }
      }
    },
