{
  "sourceLanguage": "en",
  "strings": {
    " ahead": {
      "comment": "Suffix in the playback diagnostics buffer-status row after the buffered time figure, for example '72.6s ahead'.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " vooruit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " do przodu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": " à frente"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": " forud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " d’avance"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": " впереди"
          }
        }
      }
    },
    " free": {
      "comment": "Suffix in the playback diagnostics disk-space row after the free-space figure, for example '90.26 GB free'.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " vrij"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " wolnego miejsca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": " disponíveis"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": " ledig"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " libres"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": " свободно"
          }
        }
      }
    },
    " of ": {
      "comment": "Infix in the playback diagnostics seek-window row between the current seekable duration and the total duration, for example '15:00 of 42:00'.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " van "
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " z "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": " de "
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": " af "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " sur "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": " из "
          }
        }
      }
    },
    "%@ (detected)": {
      "comment": "Label for a protocol option in the add-network-share transport picker on tvOS and iOS when that protocol was auto-detected on the selected device. %@ is the transport name, such as SMB or NFS.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (gedetecteerd)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (wykryto)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (detectado)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (fundet)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (détecté)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (обнаружен)"
          }
        }
      }
    },
    "%@ coming soon": {
      "comment": "Title of the tvOS placeholder screen shown after choosing a detected share protocol that Plozz has not implemented yet. %@ is the transport name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ binnenkort beschikbaar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ już wkrótce"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ em breve"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ kommer snart"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bientôt disponible"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поддержка %@ скоро появится"
          }
        }
      }
    },
    "%@ doesn’t have permission to request this. Check the user’s permissions in Seerr.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ heeft geen toestemming om dit aan te vragen. Controleer de rechten van de gebruiker in Seerr."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nie ma uprawnień do złożenia tej prośby. Sprawdź uprawnienia użytkownika w Seerr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não tem permissão para fazer essa solicitação. Verifique as permissões do usuário no Seerr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har ikke tilladelse til at anmode om dette. Tjek brugerens tilladelser i Seerr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ n’a pas l’autorisation de faire cette demande. Vérifiez les autorisations de l’utilisateur dans Seerr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не может отправить этот запрос. Проверьте разрешения пользователя в Seerr."
          }
        }
      }
    },
    "%@ free": {
      "comment": "Free-space amount shown in storage summaries, including the iOS Downloads capacity bar and the player's Disk diagnostics row. %@ is the formatted free-space size.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ vrij"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ wolnego miejsca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ disponíveis"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ledig"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ libres"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ свободно"
          }
        }
      }
    },
    "%@ has no default quality profile or server set. Set one in the Seerr web app, then try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ heeft geen standaard kwaliteitsprofiel of server ingesteld. Stel er een in via de Seerr-webapp en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nie ma ustawionego domyślnego profilu jakości ani serwera. Ustaw je w aplikacji internetowej Seerr, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não tem perfil de qualidade nem servidor padrão definidos. Defina um no app web do Seerr e tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har ingen standardkvalitetsprofil eller server angivet. Angiv en i Seerr-webappen, og prøv igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ n’a aucun profil de qualité ni serveur par défaut définis. Définissez-en un dans l’app web Seerr, puis réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для пользователя %@ не заданы ни сервер, ни профиль качества по умолчанию. Задайте их в веб-приложении Seerr и повторите попытку."
          }
        }
      }
    },
    "%@ has reached the request limit. Try again later or adjust the quota in Seerr.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ heeft de aanvraaglimiet bereikt. Probeer het later opnieuw of pas de limiet aan in Seerr."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ma już wykorzystany limit próśb. Spróbuj ponownie później albo dostosuj limit w Seerr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ atingiu o limite de solicitações. Tente novamente mais tarde ou ajuste a cota no Seerr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ har nået anmodningsgrænsen. Prøv igen senere, eller justér kvoten i Seerr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a atteint la limite de demandes. Réessayez plus tard ou ajustez le quota dans Seerr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для пользователя %@ исчерпан лимит запросов. Повторите попытку позже или измените квоту в Seerr."
          }
        }
      }
    },
    "%@ left": {
      "comment": "Remaining runtime label shown on episode and poster cards and on the in-progress episode watch-state pill. %@ is the formatted remaining time.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozostało %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ restantes"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ tilbage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ restantes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ осталось"
          }
        }
      }
    },
    "%@ of %@": {
      "comment": "Share enrichment progress: items enriched so far out of the pass's total. `done` arrives pre-padded to a fixed width; `total` must stay ungrouped to match.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ of %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ van %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ z %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ de %2$@"
          }
        },
        "da": {
          "stringUnit": {
