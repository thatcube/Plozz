    "Uses intro and credit markers from your server. Requires Plex Pass on Plex, or Media Segments / Intro Skipper on Jellyfin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم علامات المقدمة والنهاية من خادمك. يتطلب Plex Pass على Plex، أو Media Segments / Intro Skipper على Jellyfin."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Използва маркерите за интро и финални надписи от сървъра. Изисква Plex Pass в Plex или Media Segments / Intro Skipper в Jellyfin."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilitza les marques d'introducció i crèdits del teu servidor. Requereix Plex Pass a Plex, o Media Segments / Intro Skipper a Jellyfin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Používá značky úvodů a závěrečných titulků ze serveru. Ve službě Plex vyžaduje Plex Pass, ve službě Jellyfin pak Media Segments / Intro Skipper."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bruger intro- og rulletekstmarkører fra din server. Kræver Plex Pass på Plex eller Media Segments/Intro Skipper på Jellyfin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwendet Intro- und Abspann-Marker von deinem Server. Erfordert Plex Pass bei Plex oder Media Segments / Intro Skipper bei Jellyfin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Χρησιμοποιεί δείκτες εισαγωγής και τίτλων τέλους από τον διακομιστή σας. Απαιτεί Plex Pass στο Plex ή Media Segments / Intro Skipper στο Jellyfin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa marcadores de introducción y créditos de tu servidor. Requiere Plex Pass en Plex, o Segmentos de medios / Intro Skipper en Jellyfin."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "از نشانگرهای آغاز و تیتراژ سرور استفاده می‌کند. در Plex به Plex Pass و در Jellyfin به Media Segments / Intro Skipper نیاز دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käyttää palvelimen intro- ja lopputekstimerkintöjä. Vaatii Plexissä Plex Passin tai Jellyfinissä Media Segments- tai Intro Skipper -toiminnon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilise les marqueurs d’intro et de générique de votre serveur. Nécessite Plex Pass sur Plex, ou Media Segments / Intro Skipper sur Jellyfin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "משתמש בסמני פתיח וקרדיטים מהשרת. דורש Plex Pass ב-Plex, או Media Segments / Intro Skipper ב-Jellyfin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके सर्वर के इंट्रो और क्रेडिट मार्कर इस्तेमाल करता है. Plex पर Plex Pass या Jellyfin पर Media Segments / Intro Skipper चाहिए."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koristi oznake uvoda i odjavne špice s vašeg poslužitelja. Zahtijeva Plex Pass na Plexu ili Media Segments / Intro Skipper na Jellyfinu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A szerveréről származó bevezető- és zárójelezési jelölőket használja. A Plex esetén Plex Pass szükséges, Jellyfin esetén pedig a Media Segments / Intro Skipper bővítmény."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menggunakan penanda intro dan kredit dari server Anda. Memerlukan Plex Pass di Plex, atau Media Segments / Intro Skipper di Jellyfin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
