          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP एन्क्रिप्शन के बिना क्रेडेंशियल्स और मीडिया भेजता है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP šalje vjerodajnice i medije bez šifriranja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az FTP hitelesítő adatokat és médiát titkosítás nélkül küld."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP mengirim kredensial dan media tanpa enkripsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FTP invia credenziali e contenuti senza crittografia."
          }
        },
        "ja" : {
          "stringUnit" : {
