    "Signing in adds the account to this Apple TV. Any profile can then watch as it." : {
      "comment" : "Explains that a signed-in Plex account is shared by the whole device, not owned by one profile.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يضيف تسجيل الدخول الحساب إلى جهاز Apple TV هذا. ويمكن لأي ملف شخصي بعد ذلك المشاهدة باستخدامه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Влизането добавя акаунта към този Apple TV. Всеки профил може след това да гледа през този акаунт."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Iniciar sessió afegeix el compte a aquest Apple TV. Qualsevol perfil podrà mirar amb aquest compte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přihlášením se účet přidá do tohoto zařízení Apple TV. Každý profil pak může sledovat přes tento účet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Når du logger ind, føjes kontoen til dette Apple TV. Enhver profil kan derefter se via kontoen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Durch das Anmelden wird das Konto zu diesem Apple TV hinzugefügt. Jedes Profil kann dann damit schauen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η σύνδεση προσθέτει τον λογαριασμό σε αυτό το Apple TV. Οποιοδήποτε προφίλ μπορεί μετά να παρακολουθεί ως αυτόν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al iniciar sesión, la cuenta se añade a este Apple TV. Después, cualquier perfil puede usarla para ver contenido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ورود، حساب را به این Apple TV اضافه می‌کند. هر نمایه‌ای سپس می‌تواند با آن تماشا کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kirjautuminen lisää tilin tähän Apple TV -laitteeseen. Sen jälkeen mikä tahansa profiili voi katsoa sen kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La connexion ajoute le compte à cette Apple TV. N’importe quel profil peut ensuite l’utiliser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "התחברות מוסיפה את החשבון ל-Apple TV זה. כל פרופיל יוכל לצפות דרכו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "साइन इन करने से यह खाता इस Apple TV में जुड़ जाता है. कोई भी प्रोफ़ाइल फिर इसके रूप में देख सकती है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prijava dodaje račun na ovaj Apple TV. Bilo koji profil tada može gledati pod tim računom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A bejelentkezés hozzáadja a fiókot ehhez az Apple TV-hez. Bármelyik profil használhatja utána."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masuk akan menambahkan akun ke Apple TV ini. Profil mana pun kemudian dapat menonton sebagai akun tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'accesso aggiunge l'account a questo Apple TV. Qualsiasi profilo potrà guardare con questo account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サインインすると、このApple TVにアカウントが追加されます。どのプロファイルでもそのアカウントとして視聴できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "로그인하면 이 Apple TV에 계정이 추가됩니다. 모든 프로필에서 해당 계정으로 시청할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Log masuk menambah akaun ke Apple TV ini. Mana-mana profil kemudian boleh menonton sebagai akaun tersebut."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pålogging legger kontoen til på denne Apple TV-en. Alle profiler kan deretter se som denne kontoen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aanmelden voegt het account toe aan deze Apple TV. Elk profiel kan daarna als dit account kijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zalogowanie dodaje konto do tego Apple TV. Każdy profil może potem oglądać jako to konto."
          }
        },
        "pt-BR" : {
