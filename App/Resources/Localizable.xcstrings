    "%@ support is on the way. This device was detected, but Plozz can’t connect over %@ just yet.": {
      "comment": "Body text on the tvOS coming-soon screen for a detected network share protocol. The first %@ is the transport name in the sentence subject, and the second %@ is the same transport name after 'over'.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ support is on the way. This device was detected, but Plozz can’t connect over %2$@ just yet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ondersteuning voor %1$@ komt eraan. Dit apparaat is gedetecteerd, maar Plozz kan nog geen verbinding maken via %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obsługa %1$@ jest już w drodze. To urządzenie zostało wykryte, ale Plozz nie może się jeszcze połączyć przez %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Em breve, haverá suporte a %1$@. Este dispositivo foi detectado, mas o Plozz ainda não consegue se conectar por %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Understøttelse af %1$@ er på vej. Denne enhed blev fundet, men Plozz kan endnu ikke oprette forbindelse via %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La prise en charge de %1$@ arrive. Cet appareil a été détecté, mais Plozz ne peut pas encore se connecter via %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поддержка %1$@ уже в пути. Это устройство обнаружено, но Plozz пока не может подключаться по %2$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podpora %1$@ se připravuje. Toto zařízení bylo rozpoznáno, ale Plozz se přes %2$@ zatím nemůže připojit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unterstützung für %1$@ ist in Arbeit. Dieses Gerät wurde erkannt, aber Plozz kann sich noch nicht über %2$@ verbinden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il supporto per %1$@ è in arrivo. Questo dispositivo è stato rilevato, ma Plozz non può ancora connettersi tramite %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@-stöd är på väg. Den här enheten upptäcktes, men Plozz kan inte ansluta via %2$@ ännu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podrška za %1$@ je na putu. Ovaj je uređaj otkriven, ali Plozz se još ne može povezati preko %2$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sokongan %1$@ sedang dalam persediaan. Peranti ini telah dikesan, tetapi Plozz belum boleh menyambung melalui %2$@ buat masa ini."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podpora %1$@ už čoskoro. Toto zariadenie bolo zistené, ale Plozz sa zatiaľ nevie pripojiť cez %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підтримка %1$@ уже розробляється. Цей пристрій виявлено, але Plozz поки не може підключитися через %2$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dukungan %1$@ segera hadir. Perangkat ini terdeteksi, tetapi Plozz belum bisa terhubung lewat %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ desteği yakında geliyor. Bu aygıt algılandı ancak Plozz henüz %2$@ üzerinden bağlanamıyor."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La compatibilitat amb %1$@ arribarà aviat. S'ha detectat aquest dispositiu, però Plozz encara no s'hi pot connectar mitjançant %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suportul pentru %1$@ este pe drum. Acest dispozitiv a fost detectat, dar Plozz nu se poate conecta încă prin %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "תמיכה ב-%1$@ בדרך. המכשיר זוהה, אך Plozz עדיין לא יכולה להתחבר דרך %2$@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podpora za %1$@ je na poti. Ta naprava je bila zaznana, vendar se Plozz prek %2$@ še ne more povezati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การรองรับ %1$@ กำลังจะมาเร็วๆ นี้ ตรวจพบอุปกรณ์นี้แล้ว แต่ Plozz ยังไม่สามารถเชื่อมต่อผ่าน %2$@ ได้ในตอนนี้"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поддръжката на %1$@ предстои. Устройството е открито, но Plozz все още не може да се свърже през %2$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tuki on tulossa (%1$@). Laite havaittiin, mutta Plozz ei voi vielä muodostaa yhteyttä (protokolla: %2$@)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Støtte for %1$@ er på vei. Enheten ble funnet, men Plozz kan ennå ikke koble til via %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ 支持即将上线。此设备已被检测到，但 Plozz 还无法通过 %2$@ 连接。"
          }
        }
      }
