    "error.serverUnreachable": {
      "comment": "Shown when the app cannot connect to the user's media server.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reach the server. Check that it’s online and on the same network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el servidor. Comprueba que esté encendido y en la misma red."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan de server niet bereiken. Controleer of deze online is en zich op hetzelfde netwerk bevindt."
