            "value": "Když nelze rozpoznat závěrečné titulky"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn der Abspann nicht erkannt wird"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando i titoli di coda non possono essere rilevati"
          }
        },
        "sv": {
          "stringUnit": {
