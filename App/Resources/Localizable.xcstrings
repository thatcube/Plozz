    "A cinematic, rotating spotlight at the top of Home, with a Continue Watching row tucked under its lower edge.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een filmische, wisselende blikvanger bovenaan Start, met de rij Verder kijken deels onder de onderrand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kinowy, zmieniający się baner u góry strony głównej, z rzędem „Kontynuuj oglądanie” wsuniętym pod jego dolną krawędź."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um destaque cinematográfico e rotativo no topo da tela Início, com uma linha de Continuar Assistindo logo abaixo da borda inferior."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et filmisk, roterende fokusområde øverst på Hjem med rækken Fortsæt med at se placeret under den nederste kant."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un carrousel cinématographique en haut de l’accueil, avec la rangée Continuer à regarder glissée sous son bord inférieur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кинематографичная вращающаяся витрина вверху «Главной», а под её нижним краем — ряд «Продолжить просмотр»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Filmový, rotující výběr v horní části Domů s řádkem Pokračovat ve sledování zasunutým pod jeho spodní hranu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine filmische, wechselnde Titelbühne oben auf „Start“, mit der Reihe „Weiterschauen“ direkt darunter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una vetrina cinematografica a rotazione nella parte superiore di Home, con la riga Continua a guardare subito sotto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ett filmiskt, växlande blickfång högst upp på Hem, med raden Fortsätt titta under nederkanten."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kinematografski, rotirajući istaknuti sadržaj na vrhu Početne, s redom Nastavi gledati smještenim uz donji rub."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorotan bergaya sinematik yang berputar di bahagian atas Laman Utama, dengan baris Terus Menonton terselit di bawah tepinya."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pôsobivý striedajúci sa výber v hornej časti obrazovky Domov s riadkom Pokračovať v pozeraní pod jeho spodným okrajom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кінематична карусель, що обертається, угорі Головної, з рядком «Продовжити перегляд» під нижнім краєм."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorotan sinematik bergilir di bagian atas Beranda, dengan baris Lanjutkan Menonton terselip di bawahnya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ana Sayfa’nın üst kısmında sinematik, dönen bir vitrin; alt kenarının hemen altında “İzlemeye Devam Et” satırı yer alır."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un focus cinematogràfic rotatiu a la part superior d'Inici, amb una filera de Continua veient situada just a sota."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un element evidențiat cinematic, rotativ, în partea de sus a ecranului Acasă, cu un rând Continuă vizionarea sub marginea inferioară."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "זרקור קולנועי מסתובב בראש מסך הבית, עם שורת המשך צפייה מתחת לקצהו התחתון."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kinematografski vrteči se poudarek na vrhu zaslona Domov, pod spodnjim robom pa vrstica Nadaljuj z ogledom."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สปอตไลต์แบบภาพยนตร์หมุนเวียนอยู่ด้านบนของหน้าแรก พร้อมแถวดูต่อซ่อนอยู่ใต้ขอบล่าง"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кинематографичен въртящ се акцент в горната част на Начало, с ред „Продължете гледането“ под долния му край."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elokuvamainen, vaihtuva nosto Koti-näkymän yläosassa ja Jatka katselua -rivi aivan sen alareunan alla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et filmatisk, roterende fokusområde øverst på Hjem med Fortsett å se-raden langs den nedre kanten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "首页顶部显示电影感十足的轮播焦点推荐，“继续观看”内容栏嵌于其下沿。"
          }
        }
      }
    },
