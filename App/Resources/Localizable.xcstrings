    "Your share's library is built on this Apple TV by scanning it while the app is open. New files appear after the next scan.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De bibliotheek van je netwerkshare wordt op deze Apple TV opgebouwd door deze te scannen terwijl de app open is. Nieuwe bestanden verschijnen na de volgende scan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biblioteka tego udziału sieciowego jest tworzona na tym Apple TV podczas skanowania udziału przy otwartej aplikacji. Nowe pliki pojawią się po następnym skanowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A biblioteca do compartilhamento é criada nesta Apple TV enquanto o Plozz examina os arquivos com o app aberto. Novos arquivos aparecem após a próxima verificação."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biblioteket på din netværksdeling opbygges på dette Apple TV ved at scanne delingen, mens appen er åben. Nye filer vises efter næste scanning."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La bibliothèque multimédia de votre partage est créée sur cette Apple TV en l’analysant pendant que l’app est ouverte. Les nouveaux fichiers apparaîtront après la prochaine analyse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Медиатека этого сетевого ресурса создаётся на этом Apple TV при сканировании, пока приложение открыто. Новые файлы появятся после следующего сканирования."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knihovna tohoto sdílení se na této Apple TV vytváří jeho prohledáváním, když je aplikace otevřená. Nové soubory se zobrazí po dalším prohledání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plozz erstellt die Medienbibliothek deiner Freigabe auf diesem Apple TV, indem es sie bei geöffneter App scannt. Neue Dateien erscheinen nach dem nächsten Scan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La libreria della condivisione viene creata su questa Apple TV eseguendone la scansione mentre l’app è aperta. I nuovi file appariranno dopo la scansione successiva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Delningens bibliotek skapas på denna Apple TV genom att delningen skannas medan appen är öppen. Nya filer visas efter nästa skanning."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knjižnica ovog dijeljenja gradi se na ovom Apple TV-u skeniranjem dok je aplikacija otvorena. Nove će se datoteke pojaviti nakon sljedećeg skeniranja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pustaka perkongsian anda dibina pada Apple TV ini dengan mengimbasnya semasa apl dibuka. Fail baharu akan muncul selepas imbasan seterusnya."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knižnica tohto zdieľania sa na tejto Apple TV vytvára prehľadávaním, kým je aplikácia otvorená. Nové súbory sa zobrazia po ďalšom prehľadaní."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Медіатека вашого ресурсу створюється на цьому Apple TV шляхом сканування, поки застосунок відкрито. Нові файли з’являться після наступного сканування."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pustaka folder bersama jaringan Anda dibuat di Apple TV ini dengan memindainya saat aplikasi terbuka. File baru akan muncul setelah pemindaian berikutnya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paylaşımınızın kitaplığı, uygulama açıkken taranarak bu Apple TV’de oluşturulur. Yeni dosyalar bir sonraki taramadan sonra görünür."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La biblioteca del recurs compartit es crea en aquest Apple TV escanejant-lo mentre l'aplicació està oberta. Els fitxers nous apareixen després de l'escaneig següent."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biblioteca media a acestei resurse de rețea este creată pe acest Apple TV prin scanarea ei cât timp aplicația este deschisă. Fișierele noi apar după următoarea scanare."
          }
        }
      }
    },
