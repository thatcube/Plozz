        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paylaşılan ayarları gizler; böylece sunucular ve profiller bu profilden değiştirilemez. İzlenebilecek içeriği filtrelemez."
          }
        },
        "uk" : {
