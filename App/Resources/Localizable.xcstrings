        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan TMDB niet bereiken om de sleutel te controleren. Probeer het straks opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się połączyć z TMDB, aby sprawdzić klucz. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível acessar o TMDB para verificar a chave. Tente novamente em instantes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke få forbindelse til TMDB for at tjekke nøglen. Prøv igen om lidt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de joindre TMDB pour vérifier la clé. Réessayez dans un instant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось связаться с TMDB, чтобы проверить ключ. Повторите попытку чуть позже."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepodařilo se spojit s TMDB kvůli ověření klíče. Zkuste to znovu za chvíli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TMDB konnte nicht erreicht werden, um den Schlüssel zu prüfen. Versuche es gleich noch einmal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile raggiungere TMDB per verificare la chiave. Riprova tra poco."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det gick inte att nå TMDB för att kontrollera nyckeln. Försök igen om en stund."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije se moguće povezati s uslugom TMDB radi provjere ključa. Pokušajte ponovno za trenutak."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat menghubungi TMDB untuk menyemak kunci. Cuba lagi sebentar lagi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepodarilo sa spojiť so službou TMDB a overiť kľúč. Skúste to znova o chvíľu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося зв’язатися з TMDB для перевірки ключа. Спробуйте трохи пізніше."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat menjangkau TMDB untuk memeriksa kunci. Coba lagi sebentar lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anahtarı kontrol etmek için TMDB’ye ulaşılamadı. Birazdan tekrar deneyin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No s’ha pogut contactar amb TMDB per comprovar la clau. Torna-ho a provar d’aquí a un moment."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TMDB nu a putut fi contactat pentru a verifica cheia. Reîncearcă peste câteva momente."
          }
        }
      }
    },
    "Couldn't reach the other device. Make sure both are on the same Wi-Fi.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan het andere apparaat niet bereiken. Zorg dat beide apparaten met hetzelfde wifinetwerk zijn verbonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się połączyć z drugim urządzeniem. Upewnij się, że oba są w tej samej sieci Wi‑Fi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível acessar o outro dispositivo. Verifique se os dois estão no mesmo Wi-Fi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke få forbindelse til den anden enhed. Sørg for, at begge er på samme Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de joindre l’autre appareil. Vérifiez que les deux sont sur le même Wi‑Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось связаться с другим устройством. Убедитесь, что оба подключены к одной сети Wi‑Fi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepodařilo se spojit s druhým zařízením. Ujistěte se, že jsou obě na stejné Wi‑Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das andere Gerät konnte nicht erreicht werden. Stelle sicher, dass beide im selben WLAN sind."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile raggiungere l’altro dispositivo. Assicurati che entrambi siano sulla stessa rete Wi-Fi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det gick inte att nå den andra enheten. Se till att båda är anslutna till samma Wi-Fi."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije se moguće povezati s drugim uređajem. Provjerite jesu li oba uređaja na istoj Wi‑Fi mreži."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat menghubungi peranti lain. Pastikan kedua-duanya berada pada Wi-Fi yang sama."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepodarilo sa spojiť s druhým zariadením. Uistite sa, že obe zariadenia sú v rovnakej sieti Wi‑Fi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося зв’язатися з іншим пристроєм. Переконайтеся, що обидва пристрої в тій самій мережі Wi-Fi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat menjangkau perangkat lain. Pastikan keduanya berada di Wi‑Fi yang sama."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer aygıta ulaşılamadı. İki aygıtın da aynı Wi-Fi ağında olduğundan emin olun."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No s'ha pogut contactar amb l'altre dispositiu. Comprova que tots dos estiguin connectats a la mateixa xarxa Wi-Fi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nu s-a putut contacta celălalt dispozitiv. Asigură-te că ambele sunt în aceeași rețea Wi-Fi."
          }
        }
      }
    },
    "Couldn't reach the server. Check it's on and connected to the same network, then try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan de server niet bereiken. Controleer of deze is ingeschakeld en verbonden met hetzelfde netwerk, en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się połączyć z serwerem. Sprawdź, czy jest włączony i połączony z tą samą siecią, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível acessar o servidor. Verifique se ele está ligado e conectado à mesma rede, depois tente novamente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke få forbindelse til serveren. Tjek, at den er tændt og forbundet til samme netværk, og prøv igen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de joindre le serveur. Vérifiez qu’il est allumé et connecté au même réseau, puis réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось связаться с сервером. Проверьте, что он включён и подключён к той же сети, затем повторите попытку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepodařilo se spojit se serverem. Zkontrolujte, že je zapnutý a připojený ke stejné síti, a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Server konnte nicht erreicht werden. Prüfe, ob er eingeschaltet und mit demselben Netzwerk verbunden ist, und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile raggiungere il server. Verifica che sia acceso e connesso alla stessa rete, quindi riprova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det gick inte att nå servern. Kontrollera att den är på och ansluten till samma nätverk, och försök sedan igen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije se moguće povezati s poslužiteljem. Provjerite je li uključen i povezan na istu mrežu, a zatim pokušajte ponovno."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat menghubungi pelayan. Semak ia dihidupkan dan disambungkan ke rangkaian yang sama, kemudian cuba lagi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepodarilo sa spojiť so serverom. Skontrolujte, či je zapnutý a pripojený k rovnakej sieti, a skúste to znova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося зв’язатися із сервером. Переконайтеся, що він увімкнений і підключений до тієї самої мережі, а потім спробуйте знову."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat menjangkau server. Pastikan server menyala dan terhubung ke jaringan yang sama, lalu coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sunucuya ulaşılamadı. Açık ve aynı ağa bağlı olduğundan emin olup tekrar deneyin."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No s’ha pogut contactar amb el servidor. Comprova que estigui engegat i connectat a la mateixa xarxa, i torna-ho a provar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nu s-a putut contacta serverul. Verifică dacă este pornit și conectat la aceeași rețea, apoi încearcă din nou."
          }
        }
      }
    },
    "Couldn't send — crash reporting isn't active. Turn on Share Crash Reports below and try again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan niet verzenden — crashrapportage is niet actief. Zet Crashrapporten delen hieronder aan en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się wysłać — zgłaszanie awarii nie jest aktywne. Włącz poniżej opcję Udostępniaj raporty o awariach i spróbuj ponownie."
