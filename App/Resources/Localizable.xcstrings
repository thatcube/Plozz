        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile raggiungere quel server. Verifica l’indirizzo e che sia sulla stessa rete, quindi riprova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det gick inte att nå den servern. Kontrollera adressen och att den är på samma nätverk, och försök sedan igen."
