            "state": "needs_review",
            "value": "Коснитесь окна, чтобы вернуть сюда воспроизведение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klepnutím na okno vrátíte přehrávání sem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe auf das Fenster, um die Wiedergabe hierher zurückzuholen."
          }
        },
