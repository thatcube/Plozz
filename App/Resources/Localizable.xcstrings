    "Metadata providers, artwork, and caches are shared by every profile on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُشارك موفرو البيانات الوصفية والرسومات والمخازن المؤقتة بين كل ملفات التعريف على هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
